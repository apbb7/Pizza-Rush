/* ----- pedestrians who get hit: they fly, an ambulance collects the injured ones ----- */
function launchPedestrian(p, px, pz, hard){
  const dirSgn = player.speed >= 0 ? 1 : -1;
  let ax = px-player.x, az = pz-player.z; const al = Math.hypot(ax,az)||1; ax /= al; az /= al;
  const hx = Math.sin(player.angle)*dirSgn, hz = Math.cos(player.angle)*dirSgn;
  const sp = Math.abs(player.speed);
  const hs = hard ? Math.min(30, sp*0.85+2.5) : 2.2;
  let vx = hx*0.65+ax*0.35, vz = hz*0.65+az*0.35; const vl = Math.hypot(vx,vz)||1; vx = vx/vl*hs; vz = vz/vl*hs;
  p.state = 'fly'; p.hard = hard; p.t = 0;
  p.fl = { x:px, z:pz, y:p.mesh.position.y, vx, vz, vy: hard ? 3.5+sp*0.2 : 2.4, spin: hard ? 6+Math.random()*4 : 3 };
  p.mesh.rotation.order = 'YXZ';
}
function stepHitPedestrian(p,dt){
  const m = p.mesh;
  if(p.state==='fly'){
    const f = p.fl;
    f.vy -= 14*dt; f.x += f.vx*dt; f.z += f.vz*dt; f.y += f.vy*dt;
    const gy = terrainHeightAt(f.x,f.z);
    m.rotation.x += f.spin*dt;
    if(f.y <= gy+0.18 && f.vy<0){
      f.y = gy+0.18;
      if(f.vy < -5 && !p.bounced){ p.bounced = true; f.vy = -f.vy*0.3; f.vx *= 0.55; f.vz *= 0.55; }
      else {
        p.bounced = false;
        m.position.set(f.x,f.y,f.z); m.rotation.x = -Math.PI/2;       // lying on the ground
        p.t = 0; p.state = p.hard ? 'down' : 'dazed';
        if(p.hard){
          const em = { x:f.x, z:f.z, building:null, point:{x:f.x,z:f.z}, mesh:buildEmergencyMesh(), severity:1, ambulance:null, t:0, ped:p };
          em.mesh.position.set(f.x, gy+0.1, f.z); scene.add(em.mesh);
          activeEmergencies.push(em);
          toast('🚨 A pedestrian is hurt — an ambulance is on the way','bad');
          dispatchAmbulanceTo(em);
        }
        return;
      }
    }
    m.position.set(f.x,f.y,f.z);
    return;
  }
  if(p.state==='dazed'){          // a light shove: lie there a moment, then get up and carry on
    p.t += dt;
    if(p.t>1.1){ p.state = null; m.rotation.x = 0; m.rotation.z = 0; if(p.fl){
      // rejoin the sidewalk where they stand
      p.pos = Math.max(p.min, Math.min(p.max, (p.axis==='x' ? p.fl.x-p.center : p.fl.z-p.center))); } }
    return;
  }
  if(p.state==='hidden'){
    p.hideT -= dt;
    if(p.hideT<=0){ p.state = null; m.visible = true; m.rotation.x = 0; m.rotation.z = 0; p.pos = p.min+Math.random()*(p.max-p.min); toast('🩹 A pedestrian was discharged from County General', null); }
  }
  // 'down' (waiting for the ambulance): stays where it fell
}

function spawnPedestrians(){
  // Scales with city size, same as traffic. Each pedestrian anchors to a
  // randomly chosen building below, so denser districts already get
  // proportionally more people just from having more entries to pick from.
  // Buildings are cheap now, so this can afford to be a lot busier.
  const count = Math.max(150, Math.min(320, Math.round(buildings.length * 0.75)));
  let tries = 0;
  while(pedestrians.length < count && tries < count*6){
    tries++;
    const b = buildings[Math.floor(Math.random()*buildings.length)];
    if(!b) continue;
    const blockCenterX = b.ix*BLOCK, blockCenterZ = b.iz*BLOCK;
    const sidewalkR = BLOCK_HALF + 0.9;   // hug the building side; trees/lamps/mailboxes stand on the curb side
    const alongX = Math.random()<0.5;
    const side = Math.random()<0.5 ? 1 : -1;
    let axis, cross, center;
    if(alongX){
      axis='x'; center=blockCenterX;
      cross = blockCenterZ + side*sidewalkR;
      if(!isClearZ(cross,2)) cross = blockCenterZ - side*sidewalkR;
    } else {
      axis='z'; center=blockCenterZ;
      cross = blockCenterX + side*sidewalkR;
      if(!isClearX(cross,2)) cross = blockCenterX - side*sidewalkR;
    }
    const sgn = (alongX ? cross-blockCenterZ : cross-blockCenterX) > 0 ? 1 : -1;
    const sideIdx = alongX ? (sgn>0 ? 0 : 1) : (sgn>0 ? 2 : 3);
    if(zoneSidewalks.has(b.ix+','+b.iz+','+sideIdx)) continue;   // that stretch is closed for road work
    const span = BLOCK_HALF - 2;
    const speed = 1.2 + Math.random()*0.9;
    const dir = Math.random()<0.5 ? 1 : -1;
    const t0 = Math.random();
    const mesh = buildPedestrianMesh();
    scene.add(mesh);
    pedestrians.push({
      mesh, axis, cross, center,
      min:-span, max:span,
      pos:-span + t0*span*2,
      speed, dir,
      bob: Math.random()*Math.PI*2
    });
  }
}

