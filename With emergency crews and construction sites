    const active = s.id===ACTIVE_SLOT;
    b.style.cssText = 'flex:1;font-size:13px;padding:10px 12px;text-align:left;'+(active?'':'background:#555;box-shadow:0 4px 0 #333;');
    b.textContent = '💾 '+s.name+' — $'+(s.money||0).toFixed(2)+' · '+(s.deliveries||0)+' deliveries'+(active?'  (selected)':'');
    fastPress(b, async ()=>{ if(active){ startActiveGame(); } else { await writeNav({ slot:s.id, autostart:true }); location.reload(); } });
    const d = document.createElement('button'); d.className = 'btn'; d.textContent = '🗑️'; d.title = 'Delete this saved game';
    d.style.cssText = 'font-size:13px;padding:10px;background:#8a2d2d;box-shadow:0 4px 0 #5a1c1c;';
    fastPress(d, async ()=>{
      if(!confirm('Delete "'+s.name+'" for good?')) return;
      if(window.storage) try{ await window.storage.delete(slotKey(s.id)); }catch(e){}
      slotIndex = slotIndex.filter(x=>x.id!==s.id); await storeSlotIndex();
      await writeNav({ slot:(slotIndex[0]||{}).id || ('n'+Date.now().toString(36)) });
      location.reload();
    });
    row.appendChild(b); row.appendChild(d); list.appendChild(row);
  });
}

