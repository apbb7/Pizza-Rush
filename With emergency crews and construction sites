function spawnPatrolCars(){
  for(let i=0;i<PATROL_COUNT;i++){
    const built = buildPoliceCarMesh();
    const x = policeStationInfo.dispatch.x, z = policeStationInfo.dispatch.z;
    built.mesh.position.set(x, terrainHeightAt(x,z), z);
    scene.add(built.mesh);
    patrolCars.push({
      x, z, angle:-Math.PI/2, speed:0,
      mesh: built.mesh, wheels: built.wheels, beaconR: built.beaconR, beaconB: built.beaconB,
      path:null, pathIndex:0, mode:'pausedPatrol', pauseTimer:0.5+Math.random()*1.5, repathTimer:0
    });
  }
}

function pickNewPatrolRoute(p){
  const dest = pickDestination(null);
  if(!dest){ p.pauseTimer = 2.0; return; }
  const dp = curbsideMarkerPos(dest);
  const path = computeRoadPath(p.x, p.z, dp.x, dp.z);
  if(!path){ p.pauseTimer = 2.0; return; }
  p.path = path; p.pathIndex = 0; p.mode = 'patrol';
}

function tryGoWanted(){
  if(wantedState.active || wantedState.cooldownTimer>0) return;
  let nearest=null, nd=Infinity;
  patrolCars.forEach(p=>{
    if(p.mode!=='patrol' && p.mode!=='pausedPatrol') return;
    const d = Math.hypot(p.x-player.x, p.z-player.z);
    if(d<POLICE_DETECT_RADIUS && d<nd){ nd=d; nearest=p; }
  });
  if(!nearest) return;
  nearest.mode = 'pursuing';
  nearest.path = null;
  nearest.repathTimer = 0;
  wantedState.active = true;
  wantedState.timer = wantedState.duration;
  wantedState.chaser = nearest;
  // backup: every other patrol car within reach joins the chase
  let backup = 0;
  patrolCars.forEach(q=>{
    if(q===nearest || (q.mode!=='patrol' && q.mode!=='pausedPatrol')) return;
    if(Math.hypot(q.x-player.x, q.z-player.z) < 330){ q.mode = 'pursuing'; q.path = null; q.repathTimer = 0; backup++; }
  });
  document.getElementById('police-panel').style.display = 'block';
  toast('🚨 A patrol car spotted you — you\'re wanted!'+(backup ? ' Backup is on the way!' : ''), 'bad');
  SFX.alert();
}

function endPursuit(caught){
  patrolCars.forEach(q=>{ if(q.mode==='pursuing'){ q.mode='pausedPatrol'; q.pauseTimer=1.0+Math.random()*2; q.path=null; } });
  wantedState.active = false;
  wantedState.chaser = null;
  wantedState.cooldownTimer = wantedState.cooldownDuration;
  document.getElementById('police-panel').style.display = 'none';
  if(!caught) toast('🚓 The police called off the chase.', null);
}

function bustPlayer(){
  const fine = Math.min(15, state.money);
  state.money -= fine;
  toast('👮 Busted! -$'+fine.toFixed(2)+' fine', 'bad');
  SFX.busted();
  saveProgress();
  endPursuit(true);
}

function updatePatrolCars(dt){
  if(wantedState.active){
    wantedState.timer -= dt;
    if(wantedState.timer<=0){ endPursuit(false); }
  } else if(wantedState.cooldownTimer>0){
    wantedState.cooldownTimer -= dt;
  }

  for(let i=0;i<patrolCars.length;i++){
    const p = patrolCars[i];

    if(p.mode==='pausedPatrol'){
      p.pauseTimer -= dt;
      if(p.pauseTimer<=0) pickNewPatrolRoute(p);
      continue;
    }

    // 'pursuingCrime' (chasing a bank robbery's getaway car) reuses the
    // exact same repathing/chase logic as 'pursuing' (chasing the
    // player) — just with a different, also-moving target.
    const isChasing = p.mode==='pursuing' || p.mode==='pursuingCrime';
    if(isChasing){
      const chaseTarget = p.mode==='pursuing' ? player : (crimeState.active ? crimeState.getaway : null);
      if(!chaseTarget){ p.mode='pausedPatrol'; p.pauseTimer=1.0; p.path=null; continue; }
      const dCatch = Math.hypot(chaseTarget.x-p.x, chaseTarget.z-p.z);
      if(dCatch < POLICE_CATCH_RADIUS + (p.mode==='pursuing' ? 0 : 2)){
        if(p.mode==='pursuing') bustPlayer(); else resolveCrime('police');
        continue;
      }
      p.repathTimer -= dt;
      if(!p.path || p.path.length===0 || p.pathIndex>=p.path.length || p.repathTimer<=0){
        // aim where the target is going to be, not where it was
        let tx = chaseTarget.x, tz = chaseTarget.z;
        if(p.mode==='pursuing'){ const lead = Math.min(1.1, dCatch/40); tx += Math.sin(player.angle)*player.speed*lead; tz += Math.cos(player.angle)*player.speed*lead; }
        else if(chaseTarget.angle!==undefined){      // getaway car: half the cars chase, half cut it off further down its road
          const lead = (i%2===0) ? Math.min(1.0, dCatch/30) : Math.min(3.2, dCatch/22);
          tx += Math.sin(chaseTarget.angle)*chaseTarget.speed*lead; tz += Math.cos(chaseTarget.angle)*chaseTarget.speed*lead;
        }
        const path = computeRoadPath(p.x, p.z, tx, tz);
        if(path){ p.path = path; p.pathIndex = 0; }
        p.repathTimer = 0.45 + Math.random()*0.2;
      }
    } else if(!p.path || p.path.length===0 || p.pathIndex>=p.path.length){
      p.mode='pausedPatrol'; p.pauseTimer = 1.5+Math.random()*2.5; p.path=null;
      continue;
    }

    if(!p.path) continue;
    const target = p.path[p.pathIndex];
    const dx = target.x-p.x, dz = target.z-p.z;
    const dist = Math.hypot(dx,dz);
    if(dist < 4){
      p.pathIndex++;
      if(p.pathIndex >= p.path.length && !isChasing){
        p.mode='pausedPatrol'; p.pauseTimer = 1.5+Math.random()*2.5; p.path=null;
        continue;
      }
    }

    const bearing = Math.atan2(dx,dz);
    let rel = bearing - p.angle;
    while(rel>Math.PI) rel-=Math.PI*2;
    while(rel<-Math.PI) rel+=Math.PI*2;
    const maxTurn = (isChasing?3.8:2.2)*dt;
    p.angle += Math.max(-maxTurn, Math.min(maxTurn, rel));
    if(p.mode==='pursuing'){
      // keep up with whatever you're driving, and floor it when you've pulled ahead
      const dTo = Math.hypot(player.x-p.x, player.z-p.z);
      const mine = Math.max(20, Math.min(42, baseStats().maxSpeed*0.97));
      p.speed = mine * (dTo>70 ? 1.25 : 1);
    } else if(p.mode==='pursuingCrime' && crimeState.getaway){
      const dTo = Math.hypot(crimeState.getaway.x-p.x, crimeState.getaway.z-p.z);
      p.speed = crimeState.getaway.speed*1.45 * (dTo>80 ? 1.2 : 1);      // clearly faster than the robbers
    } else p.speed = isChasing ? 18 : 9;
    p.x += Math.sin(p.angle)*p.speed*dt;
    p.z += Math.cos(p.angle)*p.speed*dt;
    const gy = terrainHeightAt(p.x,p.z);
    p.mesh.position.set(p.x, gy, p.z);
    p.mesh.rotation.y = p.angle;
    const wheelSpin = p.speed*dt*1.6;
    p.wheels.forEach(w=>{ w.rotation.x += wheelSpin; });
    if(isChasing){
      const blink = Math.sin(performance.now()*0.02+i)>0;
      p.beaconR.material.emissiveIntensity = blink?1.3:0.1;
      p.beaconB.material.emissiveIntensity = blink?0.1:1.3;
    } else {
      p.beaconR.material.emissiveIntensity = 0;
      p.beaconB.material.emissiveIntensity = 0;
    }
  }
}

/* =========================================================
   BANK ROBBERY / CRIME EVENTS — natural follow-up to the police system.
   On its own independent periodic timer (like EMS), a getaway car peels
   out from the bank and flees along the road network, re-picking a new
   far destination every few seconds rather than following one fixed
   route (an escaping driver, not a commuter). Whichever idle patrol car
   is free gets dispatched after it, reusing the exact same
   'pursuingCrime' chase logic in updatePatrolCars() above. The player
   can also end it directly by ramming the getaway car at speed, for a
   bigger reward than leaving it to the police.
========================================================= */
const CRIME_CHECK_MIN = 35, CRIME_CHECK_MAX = 75;
const CRIME_DURATION = 50;
const CRIME_CATCH_RADIUS = 3.2;
const CRIME_RAM_SPEED = 6; // player must be moving at least this fast to "ram" the getaway car
let bankInfo = null;
const crimeState = { active:false, timer:0, duration:CRIME_DURATION, nextCheckIn: CRIME_CHECK_MIN+Math.random()*(CRIME_CHECK_MAX-CRIME_CHECK_MIN), getaway:null };

function buildBankBuilding(x,z){
  const hx=13, hz=10, h=12;
  addBuildingMesh(x,z,hx,hz,h,0xe8e2d2,'flat','glass');
  addCurb(x,z);
  // A row of columns across the front, reading as a grand bank facade.
  const colMat = new THREE.MeshStandardMaterial({color:0xf2efe6, roughness:0.5});
  for(let i=-2;i<=2;i++){
    const col = new THREE.Mesh(new THREE.CylinderGeometry(0.45,0.45,7.5,10), colMat);
    col.position.set(x+i*3.8, 3.75, z+hz+0.5);
    scene.add(col);
  }
  const pediment = new THREE.Mesh(new THREE.BoxGeometry(hx*2+1, 0.9, 2.2), new THREE.MeshStandardMaterial({color:0xd8d2c4}));
  pediment.position.set(x, 7.8, z+hz+0.4);
  scene.add(pediment);
  const dispatch = curbsideMarkerPos({x,z,hx,hz,ix:BANK_IX,iz:BANK_IZ});
  return { x,z,hx,hz,height:h, name:'First Pizza Trust Bank', isBank:true, dispatch };
}

function resolveCrime(by){
  if(!crimeState.active) return;
  if(crimeState.getaway && crimeState.getaway.mesh) scene.remove(crimeState.getaway.mesh);
  patrolCars.forEach(p=>{
    if(p.mode==='pursuingCrime'){ p.mode='pausedPatrol'; p.pauseTimer=1.0; p.path=null; }
  });
  crimeState.active = false;
  crimeState.getaway = null;
  document.getElementById('crime-panel').style.display = 'none';
  if(by==='player'){
    const bonus = 30;
    state.money += bonus;
    toast('🚔 You blocked the getaway car! +$'+bonus.toFixed(2)+' reward', 'good');
    SFX.reward();
    saveProgress();
  } else if(by==='police'){
    toast('🚔 Police caught the getaway car!', 'good');
  } else {
    toast('😤 The crooks got away...', 'bad');
  }
}

function tryTriggerRobbery(){
  if(crimeState.active || !bankInfo) return;
  const mesh = buildCarMesh(0x151515);
  const sp = bankInfo.dispatch;
  mesh.position.set(sp.x, terrainHeightAt(sp.x,sp.z), sp.z);
  scene.add(mesh);
  crimeState.getaway = { x:sp.x, z:sp.z, angle:0, speed:0, mesh, path:null, pathIndex:0, repathTimer:0, t:0 };
  crimeState.active = true;
  crimeState.timer = crimeState.duration;
  document.getElementById('crime-panel').style.display = 'block';
  toast('🚨 Bank robbery in progress — a car is fleeing the scene!', 'bad');
  SFX.alarm();
  let sent = 0;
  patrolCars.forEach(q=>{ if(q.mode==='patrol' || q.mode==='pausedPatrol'){ q.mode='pursuingCrime'; q.path=null; q.repathTimer=0; sent++; } });
  if(sent) toast('🚓 '+(sent>1 ? sent+' patrol cars are' : 'A patrol car is')+' in pursuit!', null);
}

function updateCrime(dt){
  if(!crimeState.active) return;
  const g = crimeState.getaway;
  crimeState.timer -= dt;
  if(crimeState.timer<=0){ resolveCrime('escaped'); return; }

  // The player can end it directly by ramming the getaway car at speed.
  const pd = Math.hypot(player.x-g.x, player.z-g.z);
  if(pd < CRIME_CATCH_RADIUS && Math.abs(player.speed) > CRIME_RAM_SPEED){ resolveCrime('player'); return; }

  // any patrol car that frees up (or finishes with you) joins the hunt
  crimeState.recallT = (crimeState.recallT||0) - dt;
  if(crimeState.recallT<=0){
    crimeState.recallT = 3;
    patrolCars.forEach(q=>{ if(q.mode==='patrol' || q.mode==='pausedPatrol'){ q.mode='pursuingCrime'; q.path=null; q.repathTimer=0; } });
  }
  g.t += dt;
  g.repathTimer -= dt;
  if(!g.path || g.path.length===0 || g.pathIndex>=g.path.length || g.repathTimer<=0){
    const ang = Math.random()*Math.PI*2;
    const tx = Math.max(TOWN_MIN_X+20, Math.min(TOWN_MAX_X-20, g.x+Math.cos(ang)*140));
    const tz = Math.max(TOWN_MIN_Z+20, Math.min(TOWN_MAX_Z-20, g.z+Math.sin(ang)*140));
    const path = computeRoadPath(g.x, g.z, tx, tz);
    if(path){ g.path = path; g.pathIndex = 0; }
    g.repathTimer = 3.5 + Math.random()*2;
  }
  if(!g.path) return;

  const target = g.path[g.pathIndex];
  const dx = target.x-g.x, dz = target.z-g.z;
  const dist = Math.hypot(dx,dz);
  if(dist < 4){
    g.pathIndex++;
    if(g.pathIndex >= g.path.length) g.path = null;
  }
  const bearing = Math.atan2(dx,dz);
  let rel = bearing - g.angle;
  while(rel>Math.PI) rel-=Math.PI*2;
  while(rel<-Math.PI) rel+=Math.PI*2;
  const maxTurn = 2.6*dt;
  g.angle += Math.max(-maxTurn, Math.min(maxTurn, rel));
  g.speed = 15;
  g.x += Math.sin(g.angle)*g.speed*dt;
  g.z += Math.cos(g.angle)*g.speed*dt;
  const gy = terrainHeightAt(g.x,g.z);
  g.mesh.position.set(g.x, gy, g.z);
  g.mesh.rotation.y = g.angle;
}

/* =========================================================
   CONSTRUCTION SITES — a fixed number of ordinary city lots are picked
   at world-gen time (excluding the five reserved special blocks) to be
   active construction sites instead of a normal finished building. Each
   one grows from a bare foundation to its final height over several
   minutes, with a crane, cement mixer, excavator and a couple of workers
   animating the whole time, then "completes" into a normal-looking
   building and stops animating. Collision/terrain-flattening uses the
   site's fixed footprint (hx/hz) from the start — only the visual height
   grows — so this never disturbs pathfinding, deliveries, or the
   terrain pads the way changing a footprint at runtime would.
========================================================= */
const CONSTRUCTION_SITE_COUNT = 3;
const constructionSites = [];

// Picks cells for construction sites, avoiding the five reserved blocks
// and keeping sites spaced at least two blocks apart from each other so
// they don't cluster into one mega-site.
function pickConstructionSiteCells(count){
  const reserved = new Set([
    '0,0',
    FIREHOUSE_IX+','+FIREHOUSE_IZ,
    HOSPITAL_IX+','+HOSPITAL_IZ,
    POLICE_IX+','+POLICE_IZ,
    BANK_IX+','+BANK_IZ
  ]);
  const candidates = [];
  for(let ix=IX_RANGE[0]; ix<=IX_RANGE[1]; ix++){
    for(let iz=IZ_RANGE[0]; iz<=IZ_RANGE[1]; iz++){
      if(ix===0 && iz===0) continue;
      if(reserved.has(ix+','+iz)) continue;
      candidates.push({ix,iz});
    }
  }
  for(let i=candidates.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    const tmp = candidates[i]; candidates[i]=candidates[j]; candidates[j]=tmp;
  }
  const picked = [];
  for(const c of candidates){
    if(picked.length>=count) break;
    const tooClose = picked.some(p=>Math.abs(p.ix-c.ix)<2 && Math.abs(p.iz-c.iz)<2);
    if(!tooClose) picked.push(c);
  }
  return picked;
}

function buildWorkerMesh(){
  // Wraps the existing pedestrian mesh (torso/head/arms) with a hard hat
  // and a safety vest, built as an outer group rather than added inside
  // the pedestrian's own group, so the hat/vest don't inherit its random
  // per-pedestrian height scale and distort.
  const g = new THREE.Group();
  const body = buildPedestrianMesh();
  g.add(body);
  const hat = new THREE.Mesh(new THREE.SphereGeometry(0.19,10,8,0,Math.PI*2,0,Math.PI/2), new THREE.MeshStandardMaterial({color:0xf4c24d, roughness:0.5}));
  hat.position.y = 1.62;
  g.add(hat);
  const vest = new THREE.Mesh(new THREE.CylinderGeometry(0.19,0.16,0.3,8), new THREE.MeshStandardMaterial({color:0xff7a1a}));
  vest.position.y = 1.15;
  g.add(vest);
  castAll(g);
  return g;
}

function buildSiteFence(x,z,gy,hx,hz){
  const group = new THREE.Group();
  const mat = new THREE.MeshStandardMaterial({color:0xff7a1a, roughness:0.6});
  const barH=1.1, barT=0.12;
  const fhx = hx+2.5, fhz = hz+2.5;
  const specs = [
    [x, z-fhz, fhx*2, barT],
    [x, z+fhz, fhx*2, barT],
    [x-fhx, z, barT, fhz*2],
    [x+fhx, z, barT, fhz*2]
  ];
  specs.forEach(([px,pz,sx,sz])=>{
    const bar = new THREE.Mesh(new THREE.BoxGeometry(sx, barH, sz), mat);
    bar.position.set(px, gy+barH/2, pz);
    group.add(bar);
  });
  scene.add(group);
  return group;
}

function buildCraneRig(hx,hz){
  const group = new THREE.Group();
  const mastMat = new THREE.MeshStandardMaterial({color:0xf4c24d, roughness:0.5, metalness:0.3});
  const mastH = 30 + Math.random()*10;
  const mast = new THREE.Mesh(new THREE.BoxGeometry(0.8,mastH,0.8), mastMat);
  mast.position.set(0, mastH/2, 0);
  group.add(mast);
  const jibGroup = new THREE.Group();
  jibGroup.position.set(0, mastH, 0);
  const jibLen = Math.max(hx,hz)*1.3;
  const jib = new THREE.Mesh(new THREE.BoxGeometry(0.45,0.45,jibLen), mastMat);
  jib.position.set(0,0.3,jibLen/2);
  jibGroup.add(jib);
  const hookBaseY = -mastH*0.4;
  const hook = new THREE.Mesh(new THREE.BoxGeometry(0.35,0.35,0.35), new THREE.MeshStandardMaterial({color:0x2c2e33, metalness:0.6}));
  hook.position.set(0, hookBaseY, jibLen-3);
  jibGroup.add(hook);
  group.add(jibGroup);
  castAll(group);
  return { group, jib: jibGroup, hook, hookBaseY, hookAngle: Math.random()*Math.PI*2 };
}

function buildMixerMesh(){
  const g = new THREE.Group();
  const bodyMat = new THREE.MeshStandardMaterial({color:0xd8842a, roughness:0.5, metalness:0.2});
  const body = new THREE.Mesh(new THREE.BoxGeometry(2.0,1.6,4.6), bodyMat);
  body.position.set(0,0.9,0); g.add(body);
  const cab = new THREE.Mesh(new THREE.BoxGeometry(1.8,1.3,1.4), new THREE.MeshStandardMaterial({color:0xe0dace, roughness:0.4}));
  cab.position.set(0,1.2,2.6); g.add(cab);
  const drum = new THREE.Mesh(new THREE.CylinderGeometry(0.75,0.55,2.6,10), new THREE.MeshStandardMaterial({color:0xb0a89a, roughness:0.6, metalness:0.3}));
  drum.rotation.x = Math.PI*0.32;
  drum.position.set(0,1.9,-0.6);
  g.add(drum);
  const wheelMat = new THREE.MeshStandardMaterial({color:0x111111});
  [[1.05,1.6],[-1.05,1.6],[1.05,-1.2],[-1.05,-1.2],[1.05,-2.1],[-1.05,-2.1]].forEach(([wx,wz])=>{
    const w = new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.4,0.34,10), wheelMat);
    w.rotation.z=Math.PI/2; w.position.set(wx,0.4,wz); g.add(w);
  });
  castAll(g);
  return { mesh:g, drum };
}

function buildExcavatorMesh(){
  const g = new THREE.Group();
  const base = new THREE.Mesh(new THREE.BoxGeometry(2.0,0.5,2.6), new THREE.MeshStandardMaterial({color:0xd8842a, roughness:0.6}));
  base.position.set(0,0.4,0); g.add(base);
  const trackMat = new THREE.MeshStandardMaterial({color:0x1c1c1c});
  [1.05,-1.05].forEach(tx=>{
    const track = new THREE.Mesh(new THREE.BoxGeometry(0.5,0.5,3.0), trackMat);
    track.position.set(tx,0.3,0); g.add(track);
  });
  // Cab sits very slightly embedded into the base's top (1.12 vs the
  // base's true top of 1.15... see the 0.03 overlap below) rather than
  // flush, so its bottom face can't land exactly coplanar with the
  // base's top face.
  const cab = new THREE.Mesh(new THREE.BoxGeometry(1.5,1.0,1.7), new THREE.MeshStandardMaterial({color:0xf4c24d, roughness:0.5}));
  cab.position.set(0,1.12,0.1); g.add(cab);
  const armGroup = new THREE.Group();
  armGroup.position.set(0,1.4,0.9);
  g.add(armGroup);
  const arm = new THREE.Mesh(new THREE.BoxGeometry(0.32,0.32,2.2), new THREE.MeshStandardMaterial({color:0xd8842a}));
  arm.position.set(0,0,1.1);
  armGroup.add(arm);
  const bucketGroup = new THREE.Group();
  bucketGroup.position.set(0,0,2.2);
  armGroup.add(bucketGroup);
  const bucket = new THREE.Mesh(new THREE.BoxGeometry(0.6,0.45,0.5), new THREE.MeshStandardMaterial({color:0x555555}));
  bucket.position.set(0,-0.25,0.15);
  bucketGroup.add(bucket);
  castAll(g);
  return { mesh:g, arm: armGroup, bucket: bucketGroup };
}

function buildConstructionSite(cx,cz,ix,iz,dist){
  const hx=20, hz=20;
  const finalHeight = 16 + Math.random()*26;
  // Register before any terrainHeightAt/mesh placement, same as every
  // other building, so the flattening pad is active immediately.
  const building = { x:cx, z:cz, hx, hz, height:finalHeight, ix, iz, dist, isConstructionSite:true, constructionComplete:false };
  registerBuilding(building);

  const pal = palettes[dist] || palettes.downtown;
  const finishColor = jitterColor(pal[Math.floor(Math.random()*pal.length)]);
  const gy = terrainHeightAt(cx,cz);

  const structureMesh = new THREE.Mesh(
    new THREE.BoxGeometry(hx*2, 1, hz*2),
    new THREE.MeshStandardMaterial({color:0x9c9388, roughness:0.85})
  );
  structureMesh.position.set(cx, gy+0.5, cz);
  scene.add(structureMesh);

  const rebarGroup = new THREE.Group();
  const rebarMat = new THREE.MeshStandardMaterial({color:0x8a7a6a, metalness:0.4, roughness:0.6});
  for(let i=0;i<10;i++){
    const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.04,1.4,5), rebarMat);
    rod.position.set((Math.random()*2-1)*hx*0.85, 0.7, (Math.random()*2-1)*hz*0.85);
    rebarGroup.add(rod);
  }
  rebarGroup.position.set(cx, gy+0.5, cz);
  scene.add(rebarGroup);

  const fenceGroup = buildSiteFence(cx, cz, gy, hx, hz);
  cordonSite(cx, cz, hx, hz);

  const craneRig = buildCraneRig(hx, hz);
  craneRig.group.position.set(cx - hx - 3, gy, cz - hz - 3);
  scene.add(craneRig.group);

  const mixerBuilt = buildMixerMesh();
  mixerBuilt.mesh.position.set(cx + hx + 5, gy, cz - hz + 2);
  mixerBuilt.mesh.rotation.y = Math.PI*0.3;
  scene.add(mixerBuilt.mesh);

  const excBuilt = buildExcavatorMesh();
  excBuilt.mesh.position.set(cx - hx - 4, gy, cz + hz - 2);
  excBuilt.mesh.rotation.y = -Math.PI*0.4;
  scene.add(excBuilt.mesh);

  const workers = [];
  for(let i=0;i<2;i++){
    const wm = buildWorkerMesh();
    const wx = cx + (Math.random()*2-1)*hx*0.6, wz = cz + (Math.random()*2-1)*hz*0.6;
    const wgy = terrainHeightAt(wx,wz);
    wm.position.set(wx, wgy, wz);
    wm.rotation.y = Math.random()*Math.PI*2;
    scene.add(wm);
    workers.push({ mesh: wm, t: Math.random()*10, baseY: wgy });
  }

  constructionSites.push({
    building, x:cx, z:cz, hx, hz, finalHeight, finishColor, groundY:gy,
    progress: 0.03, buildDuration: 110+Math.random()*70,
    structureMesh, rebarGroup, fenceGroup,
    crane: craneRig, mixer: mixerBuilt, excavator: excBuilt,
    workers, complete:false
  });
}

function completeConstructionSite(s){
  s.complete = true;
  s.building.constructionComplete = true;
  scene.remove(s.fenceGroup);
  scene.remove(s.rebarGroup);
  scene.remove(s.crane.group);
  scene.remove(s.mixer.mesh);
  scene.remove(s.excavator.mesh);
  s.workers.forEach(w=>scene.remove(w.mesh));
  s.structureMesh.material.color.set(s.finishColor);
  toast('🏗️ Construction finished — a new building is open downtown!', 'good');
}

function updateConstructionSites(dt){
  for(let i=0;i<constructionSites.length;i++){
    const s = constructionSites[i];
    if(s.complete) continue;

    s.progress = Math.min(1, s.progress + dt/s.buildDuration);
    const h = Math.max(1.5, s.finalHeight*s.progress);
    s.structureMesh.scale.y = h;
    s.structureMesh.position.y = s.groundY + h/2;
    s.rebarGroup.position.y = s.groundY + h;

    s.crane.hookAngle += dt*0.22;
    s.crane.jib.rotation.y = s.crane.hookAngle;
    s.crane.hook.position.y = s.crane.hookBaseY + Math.sin(s.crane.hookAngle*2.3)*1.4;

    s.mixer.drum.rotation.z += dt*1.8;

    s.excavator.arm.rotation.x = -0.35 + Math.sin(performance.now()*0.0009+i)*0.3;
    s.excavator.bucket.rotation.x = Math.sin(performance.now()*0.0009+i+0.8)*0.5;

    s.workers.forEach(w=>{
      w.t += dt;
      w.mesh.position.y = w.baseY + Math.abs(Math.sin(w.t*5))*0.12;
      w.mesh.rotation.y += Math.sin(w.t*2)*0.01;
    });

    if(s.progress>=1 && !s.complete) completeConstructionSite(s);
  }
}

/* ----- sky dome ----- */
function buildSky(){
  const cnv = document.createElement('canvas'); cnv.width=8; cnv.height=256;
  const ctx = cnv.getContext('2d');
  const grad = ctx.createLinearGradient(0,0,0,256);
  grad.addColorStop(0, '#3f86d6');
  grad.addColorStop(0.45, '#7fb8e8');
  grad.addColorStop(0.78, '#d6e8ee');
  grad.addColorStop(1, '#ffe9c2');
  ctx.fillStyle = grad; ctx.fillRect(0,0,8,256);
  const tex = new THREE.CanvasTexture(cnv);
  const geo = new THREE.SphereGeometry(1000, 24, 16);
  const mat = new THREE.MeshBasicMaterial({ map:tex, side:THREE.BackSide, fog:false });
  const sky = new THREE.Mesh(geo, mat);
  scene.add(sky);
  // sun glow sprite
  const gcnv = document.createElement('canvas'); gcnv.width=128; gcnv.height=128;
  const gctx = gcnv.getContext('2d');
  const rg = gctx.createRadialGradient(64,64,0,64,64,64);
  rg.addColorStop(0,'rgba(255,250,220,0.9)');
  rg.addColorStop(1,'rgba(255,250,220,0)');
  gctx.fillStyle = rg; gctx.fillRect(0,0,128,128);
  const gtex = new THREE.CanvasTexture(gcnv);
  const glow = new THREE.Sprite(new THREE.SpriteMaterial({ map:gtex, fog:false, transparent:true }));
  glow.scale.set(280,280,1);
  glow.position.copy(sun.position).normalize().multiplyScalar(950);
  scene.add(glow);
}
buildSky();

/* =========================================================
   GROUND TEXTURE (grass + road grid)
========================================================= */
function makeGroundTexture(){
  const T = 512;
  const scale = T/BLOCK;
  const cnv = document.createElement('canvas');
  cnv.width = T; cnv.height = T;
  const ctx = cnv.getContext('2d');

  // base asphalt
  ctx.fillStyle = '#0e0f11';
  ctx.fillRect(0,0,T,T);
  for(let i=0;i<260;i++){
    ctx.fillStyle = 'rgba(255,255,255,'+(Math.random()*0.035)+')';
    ctx.fillRect(Math.random()*T, Math.random()*T, 2,2);
  }

  const grassHalf = BLOCK_HALF*scale;
  const sidewalkW = SIDEWALK_W*scale;
  const gx0 = T/2-grassHalf, gy0 = T/2-grassHalf;

  // sidewalk (concrete) ring around the grass/building lot
  ctx.fillStyle = '#cfc9ba';
  ctx.fillRect(gx0-sidewalkW, gy0-sidewalkW, grassHalf*2+sidewalkW*2, grassHalf*2+sidewalkW*2);
  ctx.strokeStyle = '#9b9684'; ctx.lineWidth = 3;
  ctx.strokeRect(gx0-sidewalkW, gy0-sidewalkW, grassHalf*2+sidewalkW*2, grassHalf*2+sidewalkW*2);

  // grass / lot interior
  ctx.fillStyle = '#5f9a4c';
  ctx.fillRect(gx0,gy0, grassHalf*2, grassHalf*2);
  for(let i=0;i<140;i++){
    ctx.fillStyle = Math.random()<0.5 ? 'rgba(255,255,255,0.05)' : 'rgba(0,40,0,0.06)';
    ctx.fillRect(gx0+Math.random()*grassHalf*2, gy0+Math.random()*grassHalf*2, 3,3);
  }
  ctx.strokeStyle='rgba(0,0,0,0.15)'; ctx.lineWidth=2;
  ctx.strokeRect(gx0,gy0,grassHalf*2,grassHalf*2);

  // Roadside ditch shading: the swale is narrower than the ground mesh's
  // vertex spacing, so its relief can't show in the geometry. Paint a soft
  // dark band (deepest at DITCH_AT) plus a faint lighter rim on the inner
  // lip, so the ditch reads clearly from the driver's seat.
  for(let d=0.3; d<=5.4; d+=0.15){
    const k = (d-2.4)/1.2;
    const a = 0.55*Math.exp(-k*k);
    const rk = (d-4.6)/0.5;
    const rim = 0.10*Math.exp(-rk*rk);
    const off = d*scale;
    if(a > 0.02){
      ctx.strokeStyle = 'rgba(10,25,5,'+a.toFixed(3)+')'; ctx.lineWidth = 0.15*scale+0.6;
      ctx.strokeRect(gx0+off, gy0+off, (grassHalf-off)*2, (grassHalf-off)*2);
    }
    if(rim > 0.01){
      ctx.strokeStyle = 'rgba(255,255,220,'+rim.toFixed(3)+')'; ctx.lineWidth = 0.15*scale+0.6;
      ctx.strokeRect(gx0+off, gy0+off, (grassHalf-off)*2, (grassHalf-off)*2);
    }
  }

  // road lane dashes along centerlines (skip the intersection squares)
  const corner = (ROAD_W/2)*scale;
  ctx.fillStyle = '#ffce2e';
  const dashLen = 24, dashGap = 14, dashW = 2.4;
  for(let yy = corner; yy < T-corner; yy += dashLen+dashGap){
    ctx.fillRect(0-dashW/2, yy, dashW, dashLen);
    ctx.fillRect(T-dashW/2, yy, dashW, dashLen);
  }
  for(let xx = corner; xx < T-corner; xx += dashLen+dashGap){
    ctx.fillRect(xx, 0-dashW/2, dashLen, dashW);
    ctx.fillRect(xx, T-dashW/2, dashLen, dashW);
  }

  // crosswalk zebra stripes at the four intersection corners
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  const stripeW = 7, stripeGap = 7;
  [[0,0],[T,0],[0,T],[T,T]].forEach(([ccx,ccy])=>{
    ctx.save();
    ctx.beginPath();
    ctx.rect(ccx-corner, ccy-corner, corner*2, corner*2);
    ctx.clip();
    for(let s=-corner; s<corner; s+=stripeW+stripeGap){
      ctx.fillRect(ccx+s, ccy-corner, stripeW, corner*2);
    }
    ctx.restore();
  });

  const tex = new THREE.CanvasTexture(cnv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(GROUND_TILE_COUNT, GROUND_TILE_COUNT);
  tex.anisotropy = 8;
  return tex;
}
// GROUND_TILE_COUNT must be an odd integer and the ground plane must be
// exactly GROUND_TILE_COUNT*BLOCK across — that's what guarantees every
// repeated texture tile (one block's worth of grass/sidewalk/road) lines up
// exactly with the actual block grid the buildings are placed on.
const GROUND_TILE_COUNT = 25;
const GROUND_SIZE = BLOCK*GROUND_TILE_COUNT;
// Enough tessellation to carry gentle terrain (rolling yards, roadside
// ditches) — displaced later in boot(), once buildings exist, so the
// flattened pads under them line up correctly.
const GROUND_SEGMENTS = GROUND_TILE_COUNT*12;
const groundGeo = new THREE.PlaneGeometry(GROUND_SIZE,GROUND_SIZE, GROUND_SEGMENTS, GROUND_SEGMENTS);
// vertexColors lets us paint broad, organic tonal variation over the
// repeating tile texture (see applyTerrainDisplacement) so the ground
// doesn't read as one pattern stamped identically at every block.
const groundMat = new THREE.MeshStandardMaterial({ map: makeGroundTexture(), roughness:1, vertexColors:true });
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

/* =========================================================
   WORLD DATA: buildings, obstacles, gates, traffic
========================================================= */
const buildings = [];   // {x,z,hx,hz,height,mesh}
const obstacles  = [];  // {x,z,r,dmg,type,weight,light,mesh}
const flyingDebris = []; // light obstacles currently tumbling through the air after a hit
const drivewayZones = []; // {x,z,hx,hz} - paved driveways that count as full-speed road
const gates      = [];  // {x,z,hx,hz,mesh,id}
const riverWalls = [];  // {x,z,hx,hz} - permanent impassable river segments
const boundaryWalls = []; // {x,z,hx,hz} - the wall ringing the whole playable city
const trafficCars = [];
const pedestrians = [];

/* =========================================================
   TERRAIN — two layers. A handful of broad, gentle hills affect the whole
   city uniformly (roads included — driving over them is the point), plus
   finer rolling/ditch detail confined to yards and lots. Roads/sidewalks/
   driveway/building footprints are still flattened relative to whichever
   hill they're on, so traffic lanes, the A* route the minimap draws, and
   every (2D, height-blind) collision box keep working — the hills are a
   smooth height field, not a rewrite of where anything actually is.
========================================================= */
function smoothstep01(t){ t=Math.max(0,Math.min(1,t)); return t*t*(3-2*t); }

// Cheap large-wavelength value noise (a handful of summed sine waves) —
// no need for a real Perlin/simplex implementation for gentle rolling
// detail. Kept to long wavelengths (see the low frequency multipliers)
// so it reads as broad undulation rather than choppy per-block bumps.
function terrainNoise(x,z){
  return (
    Math.sin(x*0.010 + 1.7)      + Math.sin(z*0.012 - 0.4) +
    Math.sin((x+z)*0.007 + 3.1)*0.6 +
    Math.sin((x-z)*0.008 - 2.2)*0.4
  ) / 3.0;
}

// A few named hills scattered through the outer districts, each a smooth
// dome (zero slope at both the peak and the outer edge, so there's no
// kink where it meets flat ground) — kept well clear of the shop's block,
// the rivers/bridges, and the city wall so those stay completely flat.
const HILLS = [
  { x: 5*BLOCK,    z: 3*BLOCK,  radius:100, amp:3.4 },  // suburbs
  { x: -5*BLOCK,   z: -3*BLOCK, radius:100, amp:3.2 },  // industrial
  { x: 8.5*BLOCK,  z: -2*BLOCK, radius:100, amp:3.0 },  // harbor
  { x: -8.5*BLOCK, z: 2*BLOCK,  radius:100, amp:3.0 },  // old town
  { x: 2*BLOCK,    z: 4*BLOCK,  radius:85,  amp:2.2 },  // a smaller one downtown-adjacent
];
function bigHillHeight(x,z){
  let h = 0;
  for(let i=0;i<HILLS.length;i++){
    const hl = HILLS[i];
    const d = Math.hypot(x-hl.x, z-hl.z);
    if(d < hl.radius){
      const t = d/hl.radius;
      const contrib = hl.amp * (0.5 + 0.5*Math.cos(t*Math.PI));
      if(contrib > h) h = contrib;
    }
  }
  return h;
}

const TERRAIN_AMPLITUDE = 1.6; // metres of gentle rolling relief in open yards
const DITCH_AT = 2.4, DITCH_WIDTH = 2.0, DITCH_DEPTH = 0.55; // roadside swale
const BUILDING_PAD = 3.5; // flat apron kept clear around every building

// Buildings bucketed by block index so the height function can cheaply
// check "is there a building near this point" without scanning the whole
// city per vertex. Kept in sync as buildings are registered (see
// registerBuilding() below) rather than rebuilt afterward, since obstacles
// placed during world-gen need correct heights immediately too.
let buildingsByCell = {};
function registerBuilding(b){
  buildings.push(b);
  const key = b.ix+','+b.iz;
  (buildingsByCell[key] = buildingsByCell[key] || []).push(b);
}

// Fine local detail — rolling micro-terrain plus the roadside ditch —
// confined to the lot interior and flattened near buildings. Returns 0
// on roads/sidewalks so those surfaces only carry the broad hill shape.
function lotDetailHeight(x,z){
  const ix = Math.round(x/BLOCK), iz = Math.round(z/BLOCK);
  const dx = x-ix*BLOCK, dz = z-iz*BLOCK;
  if(Math.abs(dx) > BLOCK_HALF || Math.abs(dz) > BLOCK_HALF) return 0;

  const edgeDist = BLOCK_HALF - Math.max(Math.abs(dx), Math.abs(dz));

  let h = terrainNoise(x,z) * TERRAIN_AMPLITUDE;

  const dEdge = (edgeDist-DITCH_AT)/DITCH_WIDTH;
  h += -DITCH_DEPTH * Math.exp(-dEdge*dEdge);

  h *= smoothstep01(edgeDist/1.2);

  const cellBuildings = buildingsByCell[ix+','+iz];
  if(cellBuildings){
    for(let i=0;i<cellBuildings.length;i++){
      const b = cellBuildings[i];
      const bdx = Math.abs(x-b.x)-b.hx, bdz = Math.abs(z-b.z)-b.hz;
      const dist = Math.max(bdx, bdz);
      if(dist < BUILDING_PAD) h *= smoothstep01(dist/BUILDING_PAD);
    }
  }
  return h;
}

// The ground mesh itself: land everywhere west of the quay, sea floor beyond.
function groundMeshHeightAt(x,z){
  if(x >= QUAY_X) return SEA_FLOOR;
  // Outside the city wall the old ground is tucked just under the farmland plane.
  if(x < TOWN_MIN_X-1 || z < TOWN_MIN_Z-1 || z > TOWN_MAX_Z+1) return -0.3;
  // Paved driveways (currently just the shop's) stay flat pavement,
  // guaranteed, regardless of any hill placement.
  for(let i=0;i<drivewayZones.length;i++){
    const d = drivewayZones[i];
    if(Math.abs(x-d.x)<=d.hx && Math.abs(z-d.z)<=d.hz) return 0;
  }
  return bigHillHeight(x,z) + lotDetailHeight(x,z);
}
// What things stand/drive on: the mesh, plus the quay slab and the piers.
function terrainHeightAt(x,z){
  if(x < TOWN_MIN_X-1 || z < TOWN_MIN_Z-1 || z > TOWN_MAX_Z+1) return x >= QUAY_X ? SEA_FLOOR : 0;   // farmland is flat
  if(x > 813){
    if(x <= QUAY_X+0.6) return QUAY_Y;
    for(let i=0;i<PIERS.length;i++){
      const p = PIERS[i];
      if(x>=p.x0 && x<=p.x1 && z>=p.z0 && z<=p.z1) return PIER_Y;
    }
    return SEA_FLOOR;
  }
  return groundMeshHeightAt(x,z);
}

// Large-wavelength noise used only for ground color variation — a
// different frequency/phase than the height noise so tonal patches don't
// just mirror the hills, which would look too tidy/deliberate.
function groundColorNoise(x,z){
  return (
    Math.sin(x*0.006 - 0.9) + Math.sin(z*0.0075 + 2.1) +
    Math.sin((x-z)*0.004 + 1.2)*0.6
  ) / 2.6;
}

// Displaces the ground mesh to match terrainHeightAt() and paints broad
// tonal variation across it — called from boot() once every building has
// been registered, so the flattened pads line up with the actual city.
function applyTerrainDisplacement(){
  const pos = groundGeo.attributes.position;
  const colors = new Float32Array(pos.count*3);
  for(let i=0;i<pos.count;i++){
    const lx = pos.getX(i), ly = pos.getY(i);
    const wx = lx, wz = -ly;
    // Ground is rotated -90° about X after construction, which maps this
    // local Z displacement to world Y, and local (x,y) to world (x,-z).
    pos.setZ(i, groundMeshHeightAt(wx, wz));

    // Subtle multiplicative tint (roughly ±12%) so the same repeating
    // tile texture reads as patches of drier/lusher ground and slightly
    // aged/fresher asphalt instead of one pattern stamped everywhere.
    const cn = groundColorNoise(wx,wz); // -1..1
    const tint = 1.0 + cn*0.12;
    const warmth = cn*0.035;
    colors[i*3+0] = tint + warmth;
    colors[i*3+1] = tint;
    colors[i*3+2] = tint - warmth;
    if(wx >= QUAY_X-4){ colors[i*3+0] = 0.05; colors[i*3+1] = 0.1; colors[i*3+2] = 0.14; } // sea floor
  }
  pos.needsUpdate = true;
  groundGeo.computeVertexNormals();

  // Bake relief shading (no real shadow maps — those were the lag source):
  // compare each vertex normal with the sun direction. Slopes facing the sun
  // brighten, slopes facing away darken, hollows darken a bit more.
  const nrm = groundGeo.attributes.normal;
  const sl = Math.hypot(220,260,130);
  const Lx = 220/sl, Ly = 260/sl, Lz = 130/sl;   // world-space sun dir
  const flat = Ly;                                // dot() for level ground
  const stride = GROUND_SEGMENTS+1;
  for(let i=0;i<pos.count;i++){
    // local (x,y,z) -> world (x, z, -y)
    const d = nrm.getX(i)*Lx + nrm.getZ(i)*Ly + (-nrm.getY(i))*Lz;
    let shade = 1 + (d-flat)*1.9;
    // concavity: neighbours higher than this vertex => hollow
    const c = i%stride, r = (i/stride)|0;
    if(c>0 && c<stride-1 && r>0 && r<stride-1){
      const avg = (pos.getZ(i-1)+pos.getZ(i+1)+pos.getZ(i-stride)+pos.getZ(i+stride))*0.25;
      shade -= Math.max(-0.12, Math.min(0.25, (avg-pos.getZ(i))*0.35));
    }
    shade = Math.max(0.55, Math.min(1.25, shade));
    colors[i*3] *= shade; colors[i*3+1] *= shade; colors[i*3+2] *= shade;
  }
  groundGeo.setAttribute('color', new THREE.BufferAttribute(colors,3));
}

const palettes = {
  downtown:[0xf2efe6,0xe8e2d2,0x6fb8c4,0x8fcdc2,0xc9d6dc,0xe2836b,0xf0c9a0,0xd8d2c4],
  suburbs:[0xf5e6c8,0xf0c9a0,0xa8d8d0,0xf2b8c6,0xfff2d9,0xf0e6c8],
  industrial:[0x9aa0a8,0x8a8f96,0xb0856a,0x7e8a8f,0xa68a6a],
  harbor:[0xe8e6df,0xc8d2d8,0x3f6e8c,0xb0bcc2,0xd94f3a,0x8a98a0],
  oldtown:[0x8c3f33,0x9c5a3e,0x6e4a38,0xb5705a,0x7a5240,0xa8865f]
