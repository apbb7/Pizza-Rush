  addGroup(g);
  return g;
}

function buildPatio(g,bx,bz,theta,lw,bd,P,brand){
  const slabM = storeMat('slab', ()=>solidMat(0xcfc6b2,0.95));
  const hedgeM = storeMat('hedge', ()=>solidMat(0x3f7f46,0.95));
  mkBox(g,0,-0.35,bd+P/2,lw*2,0.42,P,slabM);               // paved patio (top ~ +0.07), also buries the roadside ditch
  const frontZ = bd+P-0.35, gap = 2.4;
  [-1,1].forEach(s=>{
    const w = lw-gap/2-0.1;
    if(w>0.5) mkBox(g,s*(gap/2+w/2),0.05,frontZ,w,0.8,0.55,hedgeM);
  });
  const c = Math.cos(theta), s = Math.sin(theta);
  const toW = (lx,lz)=>({ x:bx+lx*c+lz*s, z:bz+lz*c-lx*s });
  const baseY = g.position.y + 0.07;
  const usable = lw*2-5, nT = Math.max(1, Math.floor(usable/5.2));
  for(let k=0;k<nT;k++){
    const lx = -lw+2.5+(k+0.5)*usable/nT;
    const p = toW(lx, bd+P*0.45);
    patioTables.push({ x:p.x, y:baseY, z:p.z, col:brand.accent });
    [-1,1].forEach(sg=>{
      const ux = sg*c, uz = -sg*s;                         // table -> chair, in world space
      patioChairs.push({ x:p.x+ux*1.0, y:baseY, z:p.z+uz*1.0, yaw:Math.atan2(ux,uz) });
    });
    obstacles.push({ x:p.x, z:p.z, r:0.85, dmg:2, type:'patio', weight:14, light:false, mesh:null });
  }
}

function buildStoreSegment(cx,cz,ix,iz,alongX,segCenter,segHalf,restaurant){
  const P = restaurant ? 6.5 : 0;
  const sgn = Math.random()<0.5 ? 1 : -1;
  const n = alongX ? {x:0,z:sgn} : {x:sgn,z:0};
  const theta = alongX ? (sgn>0?0:Math.PI) : (sgn>0?Math.PI/2:-Math.PI/2);
  const segC = alongX ? {x:cx+segCenter, z:cz} : {x:cx, z:cz+segCenter};
  const lw = segHalf, bd = BLOCK_HALF-P/2;
  const bx = segC.x - n.x*P/2, bz = segC.z - n.z*P/2;
  const height = restaurant ? 7+Math.random()*5 : 8+Math.random()*9;
  const kind = makeBrand(bx,bz,restaurant);
  const color = kind.wall;
  const hxW = alongX ? lw : bd, hzW = alongX ? bd : lw;
  const curbD = BLOCK_HALF + SIDEWALK_W*0.55;
  if(restaurant){
    // flatten the lot detail under the patio exactly like a building footprint would
    const pcx = segC.x + n.x*(BLOCK_HALF-P/2), pcz = segC.z + n.z*(BLOCK_HALF-P/2);
    (buildingsByCell[ix+','+iz] = buildingsByCell[ix+','+iz] || []).push({ x:pcx, z:pcz, hx:alongX?lw:P/2, hz:alongX?P/2:lw });
  }
  registerBuilding({ x:bx, z:bz, hx:hxW, hz:hzW, height, ix, iz, dist:'downtown', isStore:true,
                     curb:{ x:segC.x+n.x*curbD, z:segC.z+n.z*curbD } });
  const g = buildStorefront(bx,bz,theta,lw,bd,height,color,kind);
  if(restaurant) buildPatio(g,bx,bz,theta,lw,bd,P,kind);
}

function finalizePatios(){
  const N = patioTables.length;
  if(!N) return;
  const mk = (geo,mat,count)=>{ const im = new THREE.InstancedMesh(geo,mat,count); im.frustumCulled = false; im.userData.noCull = true; return im; };
  const white = new THREE.MeshStandardMaterial({color:0xffffff, roughness:0.7});
  const dark  = new THREE.MeshStandardMaterial({color:0x2d2f34, roughness:0.6, metalness:0.3});
  const wood  = new THREE.MeshStandardMaterial({color:0x7a5230, roughness:0.8});
  const topIM  = mk(new THREE.CylinderGeometry(0.62,0.62,0.06,12), wood, N);
  const poleIM = mk(new THREE.CylinderGeometry(0.05,0.05,0.78,6), dark, N);
  const umbIM  = mk(new THREE.ConeGeometry(1.35,0.55,10), white, N);
  const umbPIM = mk(new THREE.CylinderGeometry(0.03,0.03,1.9,5), dark, N);
  const M = new THREE.Matrix4(), q = new THREE.Quaternion(), sc = new THREE.Vector3(1,1,1), p = new THREE.Vector3(), col = new THREE.Color();
  const put = (im,i,x,y,z)=>{ p.set(x,y,z); M.compose(p,q,sc); im.setMatrixAt(i,M); };
  patioTables.forEach((t,i)=>{
    put(topIM,i,t.x,t.y+0.78,t.z); put(poleIM,i,t.x,t.y+0.39,t.z);
    put(umbIM,i,t.x,t.y+2.15,t.z);  put(umbPIM,i,t.x,t.y+0.95,t.z);
    col.setHex(t.col); umbIM.setColorAt(i,col);
  });
  const C = patioChairs.length;
  const seatIM = mk(new THREE.BoxGeometry(0.42,0.07,0.42), wood, C);
  const backIM = mk(new THREE.BoxGeometry(0.42,0.45,0.06), wood, C);
  const legIM  = mk(new THREE.BoxGeometry(0.07,0.45,0.07), dark, C);
  const qy = new THREE.Quaternion(), up = new THREE.Vector3(0,1,0), off = new THREE.Vector3();
  patioChairs.forEach((ch,i)=>{
    qy.setFromAxisAngle(up, ch.yaw);
    p.set(ch.x,ch.y+0.45,ch.z); M.compose(p,qy,sc); seatIM.setMatrixAt(i,M);
    off.set(0,0.7,0.2).applyQuaternion(qy); p.set(ch.x+off.x,ch.y+off.y,ch.z+off.z); M.compose(p,qy,sc); backIM.setMatrixAt(i,M);
    p.set(ch.x,ch.y+0.22,ch.z); M.compose(p,qy,sc); legIM.setMatrixAt(i,M);
  });
  [topIM,poleIM,umbIM,umbPIM,seatIM,backIM,legIM].forEach(im=>{
    im.instanceMatrix.needsUpdate = true;
    if(im.instanceColor) im.instanceColor.needsUpdate = true;
    scene.add(im);
  });
}

/* =========================================================
   HARBOR WATERFRONT — a sea along the east edge of the harbor district with
   a paved quay, wooden piers, a lighthouse, moored and cruising boats, a
   container ship and buoys. Ground vehicles stop at the quay edge and can
   drive out along the piers; the helicopter can fly (and float) anywhere.
========================================================= */
const harborBoats = [];            // {mesh, ph, lane?}
const harborWater = { mat:null, tex:null };
const _boatMats = {};
function boatMat(hex, rough, metal){
  const k = hex+'|'+(rough||0.6)+'|'+(metal||0);
  return _boatMats[k] || (_boatMats[k] = new THREE.MeshStandardMaterial({color:hex, roughness:rough===undefined?0.6:rough, metalness:metal||0}));
}

function groundAllowed(x,z){
  if(x <= QUAY_X-0.6) return true;
  for(let i=0;i<PIERS.length;i++){
    const p = PIERS[i];
    if(x>=p.x0 && x<=p.x1-0.6 && z>=p.z0+0.9 && z<=p.z1-0.9) return true;
  }
  return false;
}

function makeWaterTexture(){
  const S = 256, c = document.createElement('canvas'); c.width = c.height = S;
  const x = c.getContext('2d');
  x.fillStyle = '#2f8fb8'; x.fillRect(0,0,S,S);
  for(let i=0;i<70;i++){
    const px = Math.random()*S, py = Math.random()*S, w = 14+Math.random()*30;
    x.strokeStyle = 'rgba(255,255,255,'+(0.06+Math.random()*0.1).toFixed(3)+')';
    x.lineWidth = 1+Math.random()*1.5;
    for(const ox of [-S,0,S]) for(const oy of [-S,0,S]){
      x.beginPath(); x.arc(px+ox, py+oy, w, Math.PI*1.1, Math.PI*1.9); x.stroke();
    }
  }
  for(let i=0;i<40;i++){
    x.fillStyle = 'rgba(10,50,90,'+(Math.random()*0.08).toFixed(3)+')';
    x.fillRect(Math.random()*S, Math.random()*S, 20+Math.random()*30, 6+Math.random()*10);
  }
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = 4;
  return t;
}
function makeDeckTexture(){
  const S = 128, c = document.createElement('canvas'); c.width = c.height = S;
  const x = c.getContext('2d');
  const cols = ['#8a6a46','#7c5d3c','#94744d','#85663f'];
  for(let i=0;i<8;i++){
    x.fillStyle = cols[i%4]; x.fillRect(0,i*16,S,16);
    x.fillStyle = 'rgba(0,0,0,0.35)'; x.fillRect(0,i*16,S,1.5);
    x.fillStyle = 'rgba(0,0,0,0.12)'; x.fillRect(Math.random()*S,i*16+3,20+Math.random()*30,2);
  }
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = 4;
  return t;
}

// ----- boats (group origin = waterline, bow toward local +z) -----
function hullGeo(hw,len,depth){
  const L = len/2, s = new THREE.Shape();
  s.moveTo(-hw,-L); s.lineTo(hw,-L); s.lineTo(hw,L*0.15);
  s.quadraticCurveTo(hw*0.85,L*0.7,0,L);
  s.quadraticCurveTo(-hw*0.85,L*0.7,-hw,L*0.15);
  s.lineTo(-hw,-L);
  const geo = new THREE.ExtrudeGeometry(s,{ depth:depth, bevelEnabled:false, curveSegments:6 });
  geo.rotateX(-Math.PI/2);
  geo.rotateY(Math.PI);
  geo.translate(0,-depth*0.6,0);
  return geo;
}
function boxAt(g,w,h,d,x,y,z,mat){
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat); m.position.set(x,y,z); g.add(m); return m;
}
function buildMotorBoat(hexHull){
  const g = new THREE.Group();
  g.add(new THREE.Mesh(hullGeo(0.85,4.6,0.9), boatMat(hexHull,0.4,0.1)));
  boxAt(g,1.3,0.7,1.6,0,0.75,-0.2,boatMat(0xf4f1ea,0.5));
  const gl = boxAt(g,1.2,0.4,0.05,0,0.95,0.62,boatMat(0x203a4a,0.1,0.5)); gl.rotation.x = -0.4;
  boxAt(g,0.9,0.1,0.5,0,0.45,-1.5,boatMat(0x8a6a46,0.8));
  boxAt(g,0.3,0.7,0.3,0,0.3,-2.4,boatMat(0x2a2c31,0.5,0.3));
  return g;
}
function buildSailBoat(hexHull){
  const g = new THREE.Group();
  g.add(new THREE.Mesh(hullGeo(0.9,6.8,1.0), boatMat(hexHull,0.4,0.1)));
  boxAt(g,1.1,0.5,1.8,0,0.65,-0.9,boatMat(0xf4f1ea,0.5));
  const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.08,8,6), boatMat(0xcfd3d6,0.4,0.5));
  mast.position.set(0,4.4,0.6); g.add(mast);
  const sh = new THREE.Shape(); sh.moveTo(-0.4,0.9); sh.lineTo(2.6,0.9); sh.lineTo(-0.4,7.6); sh.lineTo(-0.4,0.9);
  const sg = new THREE.ShapeGeometry(sh); sg.rotateY(Math.PI/2);
  const sail = new THREE.Mesh(sg, new THREE.MeshStandardMaterial({color:0xfaf6ea, roughness:0.9, side:THREE.DoubleSide}));
  sail.position.set(0.02,0,0.6); g.add(sail);
  const boom = new THREE.Mesh(new THREE.CylinderGeometry(0.04,0.04,3,5), boatMat(0xcfd3d6,0.4,0.5));
  boom.rotation.x = Math.PI/2; boom.position.set(0,1.0,-0.9); g.add(boom);
  return g;
}
function buildTrawler(hexHull){
  const g = new THREE.Group();
  g.add(new THREE.Mesh(hullGeo(1.7,12,2.2), boatMat(hexHull,0.5,0.1)));
  boxAt(g,2.6,2.4,3.0,0,2.15,-2.6,boatMat(0xf4f1ea,0.5));
  boxAt(g,2.7,0.7,3.1,0,2.5,-2.6,boatMat(0x203a4a,0.15,0.4));
  boxAt(g,3.0,0.15,3.4,0,3.4,-2.6,boatMat(0x2a2c31,0.6));
  const mast = new THREE.Mesh(new THREE.CylinderGeometry(0.09,0.12,6,6), boatMat(0x9aa0a6,0.5,0.4));
  mast.position.set(0,3.6,1.2); g.add(mast);
  const boomL = new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.05,5,5), boatMat(0x9aa0a6,0.5,0.4));
  boomL.rotation.z = 1.2; boomL.position.set(1.8,5.0,1.2); g.add(boomL);
  const crateM = boatMat(0xd9a441,0.8);
  boxAt(g,0.9,0.5,0.9,0.6,1.1,0.6,crateM); boxAt(g,0.9,0.5,0.9,-0.6,1.1,1.6,crateM);
  return g;
}
const CONTAINER_COLORS = [0xc0392b,0x2e86c1,0x27ae60,0xf39c12,0x7d3c98,0x16a085,0xd35400,0xecf0f1];
function buildCargoShip(){
  const g = new THREE.Group();
  g.add(new THREE.Mesh(hullGeo(6.5,70,8), boatMat(0x2b3a4f,0.6,0.2)));
  const deckY = 8*0.4;
  boxAt(g,12.6,0.4,66,0,deckY,-1,boatMat(0x8a8d90,0.9));
  boxAt(g,10,9,8,0,deckY+4.5,-26,boatMat(0xf4f1ea,0.55));
  boxAt(g,10.2,1.8,8.2,0,deckY+7.4,-26,boatMat(0x203a4a,0.15,0.4));
  boxAt(g,10.6,0.5,8.6,0,deckY+9.2,-26,boatMat(0x2a2c31,0.6));
  const funnel = new THREE.Mesh(new THREE.CylinderGeometry(1.5,1.8,5,10), boatMat(0xc0392b,0.5));
  funnel.position.set(0,deckY+11,-28); g.add(funnel);
  for(let bay=0; bay<7; bay++){
    for(let col=-1; col<=1; col++){
      const h = 1+Math.floor(Math.random()*3);
      for(let lv=0; lv<h; lv++){
        const c = boxAt(g,3.6,2.6,5.6,col*4.0,deckY+0.2+1.3+lv*2.7,-14+bay*6.2,boatMat(CONTAINER_COLORS[Math.floor(Math.random()*CONTAINER_COLORS.length)],0.7));
        c.userData.container = true;
      }
    }
  }
  return g;
}
function addBoat(mesh,x,z,yaw,opts){
  mesh.position.set(x,SEA_Y,z); mesh.rotation.y = yaw;
  scene.add(mesh);
  harborBoats.push(Object.assign({ mesh, ph:Math.random()*6.28, baseYaw:yaw, amp:1 }, opts||{}));
}

function buildLighthouse(x,z){
  const g = new THREE.Group();
  g.position.set(x, PIER_Y, z);
  const red = boatMat(0xc0392b,0.7), white = boatMat(0xf4f1ea,0.7);
  const base = new THREE.Mesh(new THREE.CylinderGeometry(2.3,2.6,1.2,12), boatMat(0x8c8a85,0.9)); base.position.y = 0.6; g.add(base);
  for(let i=0;i<4;i++){
    const r0 = 1.9-i*0.18, r1 = 1.9-(i+1)*0.18;
    const seg = new THREE.Mesh(new THREE.CylinderGeometry(r1,r0,3,12), i%2?white:red);
    seg.position.y = 1.2+1.5+i*3; g.add(seg);
  }
  const gal = new THREE.Mesh(new THREE.CylinderGeometry(1.7,1.7,0.25,12), boatMat(0x2a2c31,0.6)); gal.position.y = 13.3; g.add(gal);
  const lamp = new THREE.Mesh(new THREE.CylinderGeometry(0.9,0.9,1.4,10), new THREE.MeshStandardMaterial({color:0xfff2a8, emissive:0xffe27a, emissiveIntensity:1.0}));
  lamp.position.y = 14.1; g.add(lamp);
  const cap = new THREE.Mesh(new THREE.ConeGeometry(1.2,1.2,10), red); cap.position.y = 15.4; g.add(cap);
  scene.add(g);
  obstacles.push({ x, z, r:2.5, dmg:8, type:'lighthouse', weight:600, light:false, mesh:null });
}

function buildHarborFront(){
  const zLen = TOWN_MAX_Z-TOWN_MIN_Z+40;
  const apronX0 = 813, apronW = QUAY_X-apronX0;

  // ---- sea ----
  harborWater.tex = makeWaterTexture();
  harborWater.tex.repeat.set(40000/20, 40000/20);
  harborWater.mat = new THREE.MeshStandardMaterial({ map:harborWater.tex, roughness:0.2, metalness:0.15 });
  const sea = new THREE.Mesh(new THREE.PlaneGeometry(40000,40000), harborWater.mat);
  sea.rotation.x = -Math.PI/2; sea.position.set(QUAY_X+20000, SEA_Y, 0);
  sea.userData.noCull = true;
  scene.add(sea);

  // ---- quay: harbour road slab, concrete edge and a vertical wall into the water ----
  const slab = new THREE.Mesh(new THREE.BoxGeometry(apronW,3.6,zLen), boatMat(0x3a3c40,0.95));
  slab.position.set(apronX0+apronW/2, QUAY_Y-1.8, 0); scene.add(slab);
  const edge = new THREE.Mesh(new THREE.BoxGeometry(3,0.1,zLen), boatMat(0xbdb7a8,0.9));
  edge.position.set(QUAY_X-1.5, QUAY_Y+0.01, 0); scene.add(edge);
  const wall = new THREE.Mesh(new THREE.BoxGeometry(0.6,4.2,zLen), boatMat(0x8c8a85,0.9));
  wall.position.set(QUAY_X+0.3, QUAY_Y-2.1, 0); scene.add(wall);
  // lane marking along the harbour road
  const dashM = boatMat(0xffce2e,0.8);
  for(let z=TOWN_MIN_Z; z<TOWN_MAX_Z; z+=8){
    const d = new THREE.Mesh(new THREE.BoxGeometry(0.25,0.02,4), dashM);
    d.position.set(apronX0+5, QUAY_Y+0.011, z+2); scene.add(d);
  }

  // ---- piers ----
  const deckTexBase = makeDeckTexture();
  const pileGeo = new THREE.CylinderGeometry(0.22,0.26,PIER_Y-SEA_FLOOR+0.2,7);
  const pilePos = [], bollardPos = [];
  PIERS.forEach(p=>{
    const len = p.x1-p.x0, w = p.z1-p.z0;
    const tex = deckTexBase.clone(); tex.needsUpdate = true; tex.repeat.set(len/3, w/3);
    const deck = new THREE.Mesh(new THREE.BoxGeometry(len,0.3,w), new THREE.MeshStandardMaterial({map:tex, roughness:0.9}));
    deck.position.set((p.x0+p.x1)/2, PIER_Y-0.15, p.z); scene.add(deck);
    [-1,1].forEach(sg=>{
      const rail = new THREE.Mesh(new THREE.BoxGeometry(len,0.12,0.3), boatMat(0x5a4128,0.9));
      rail.position.set((p.x0+p.x1)/2, PIER_Y+0.05, p.z+sg*(w/2-0.15)); scene.add(rail);
      for(let x=p.x0+3; x<p.x1; x+=6) pilePos.push([x, p.z+sg*(w/2-0.5)]);
      for(let x=p.x0+6; x<p.x1; x+=9) bollardPos.push([x, p.z+sg*(w/2-0.5)]);
    });
    if(p.lamps) for(let x=p.x0+10; x<p.x1-6; x+=p.lamps) addObstacle(x, p.z-(w/2-0.9), 'lamp');
  });
  // quay-edge bollards, skipping the pier mouths
  for(let z=TOWN_MIN_Z+10; z<TOWN_MAX_Z-10; z+=13){
    if(PIERS.some(p=>Math.abs(z-p.z)<p.z1-p.z+1)) continue;
    bollardPos.push([QUAY_X-0.7, z]);
  }
  const pileIM = new THREE.InstancedMesh(pileGeo, boatMat(0x4a3722,0.95), pilePos.length);
  const bolIM  = new THREE.InstancedMesh(new THREE.CylinderGeometry(0.2,0.24,0.7,8), boatMat(0x22252a,0.6,0.3), bollardPos.length);
  const M = new THREE.Matrix4(), q = new THREE.Quaternion(), sc = new THREE.Vector3(1,1,1), pv = new THREE.Vector3();
  pilePos.forEach(([x,z],i)=>{ pv.set(x,(PIER_Y+SEA_FLOOR)/2-0.1,z); M.compose(pv,q,sc); pileIM.setMatrixAt(i,M); });
  bollardPos.forEach(([x,z],i)=>{ const y = (x>QUAY_X?PIER_Y:QUAY_Y)+0.35; pv.set(x,y,z); M.compose(pv,q,sc); bolIM.setMatrixAt(i,M); });
  [pileIM,bolIM].forEach(im=>{ im.instanceMatrix.needsUpdate = true; im.frustumCulled = false; im.userData.noCull = true; scene.add(im); });

  // quay lamps (mid-block, away from the roads)
  for(let k=IZ_RANGE[0]; k<=IZ_RANGE[1]; k++) addObstacle(QUAY_X-2.4, k*BLOCK, 'lamp');

  // ---- lighthouse at the end of the longest pier ----
  const lp = PIERS.reduce((a,b)=> (b.x1>a.x1?b:a));
  buildLighthouse(lp.x1-3.5, lp.z);

  // ---- moored boats ----
  const hulls = [0xf4f1ea,0xe3402c,0x2e86c1,0xf4c24d,0x27ae60,0x1b2a4a,0xffffff];
  const pickHull = ()=>hulls[Math.floor(Math.random()*hulls.length)];
  PIERS.forEach(p=>{
    const len = p.x1-p.x0;
    const fr = len>=70 ? [0.22,0.5,0.78] : [0.3,0.72];
    [-1,1].forEach(sg=>{
      fr.forEach(f=>{
        const r = Math.random();
        const x = p.x0+len*f;
        if(r<0.4){ addBoat(buildMotorBoat(pickHull()), x, p.z+sg*(4+1.2), Math.PI/2, {}); }
        else if(r<0.7){ addBoat(buildSailBoat(pickHull()), x, p.z+sg*(4+1.3), Math.PI/2, {}); }
        else { addBoat(buildTrawler([0x1b2a4a,0xb3202a,0x2b6f4a,0x2e86c1][Math.floor(Math.random()*4)]), x, p.z+sg*(4+2.2), Math.PI/2, {}); }
      });
    });
  });
  // anchored in the bay
  addBoat(buildSailBoat(0xffffff), 872, -55, 1.1, {});
  addBoat(buildSailBoat(0x2e86c1), 880, 60, -0.6, {});
  // cruising boats shuttle up and down short stretches of the bay, clear of the ship corridors
  [
    { build:()=>buildMotorBoat(0xe3402c), x:921, z0:-150, z1:-48,  dir: 1, v:9 },
    { build:()=>buildSailBoat(0xffffff),  x:927, z0:48,   z1:150,  dir:-1, v:4 },
    { build:()=>buildTrawler(0x1b2a4a),   x:927, z0:250,  z1:470,  dir: 1, v:5 },
    { build:()=>buildMotorBoat(0xf4c24d), x:921, z0:-470, z1:-250, dir:-1, v:8.5 }
  ].forEach(c=>{ const zs = (c.z0+c.z1)/2; addBoat(c.build(), c.x, zs, c.dir>0?0:Math.PI, { cruise:{ dir:c.dir, v:c.v, z0:c.z0, z1:c.z1 } }); });

  // ---- buoys ----
  const buoyGeo = new THREE.SphereGeometry(0.5,8,8);
  const buoyPts = [[850,-390],[850,-95],[850,95],[850,390]];
  const buoyIM = new THREE.InstancedMesh(buoyGeo, new THREE.MeshStandardMaterial({color:0xffffff, roughness:0.5}), buoyPts.length);
  buoyPts.forEach(([x,z],i)=>{ pv.set(x,SEA_Y+0.05,z); M.compose(pv,q,sc); buoyIM.setMatrixAt(i,M); buoyIM.setColorAt(i,new THREE.Color(i%2?0xe3402c:0xf4f1ea)); });
  buoyIM.instanceMatrix.needsUpdate = true; buoyIM.frustumCulled = false; buoyIM.userData.noCull = true;
  scene.add(buoyIM);
  buildPort();
}

/* =========================================================
   WORKING PORT — three berths along the quay. Each has a gantry crane, a
   container yard fenced off from traffic, and dockworkers. Cargo ships sail
   in from the open sea, tie up, get unloaded then loaded by the crane, sail
   away, and after a pause a new ship arrives at the berth.
========================================================= */
const portDyn = [];                         // animated objects (excluded from static freezing)
const portBerths = [];
const PORT_CR = { xL:820.4, xS:829.2, H:21 };
const PORT_SHIP_X = QUAY_X + 7.4;           // ship centre when alongside the quay
const PORT_APPROACH_X = 885, PORT_FAR_X = 1160;
const YARD_COLS = [823.2, 826.8];
const SHIP_DECK_Y = 8*0.4;                  // deck height above waterline
const CONT_COLORS_PORT = [0xc0392b,0x2e86c1,0x27ae60,0xf39c12,0x7d3c98,0x16a085,0xd35400,0xecf0f1,0x1f618d,0xb03a2e];
let _contGeo = null;
function contMesh(hex){
  _contGeo = _contGeo || new THREE.BoxGeometry(3.2,2.6,5.8);
  return new THREE.Mesh(_contGeo, boatMat(hex===undefined?CONT_COLORS_PORT[Math.floor(Math.random()*CONT_COLORS_PORT.length)]:hex,0.7));
}
const SHIP_BAYS = 5, SHIP_BAY_Z0 = -15, SHIP_BAY_DZ = 6.4;
function shipSlotLocal(bay,col,lvl){ return { x:(col-1)*4.0, y:SHIP_DECK_Y+0.2+1.3+lvl*2.7, z:SHIP_BAY_Z0+bay*SHIP_BAY_DZ }; }

function buildPortShip(){
  const hullHex = [0x2b3a4f,0x7a2a24,0x23423a,0x39325a,0x3b3b40][Math.floor(Math.random()*5)];
  const g = new THREE.Group();
  g.add(new THREE.Mesh(hullGeo(6.5,70,8), boatMat(hullHex,0.6,0.2)));
  boxAt(g,12.6,0.4,66,0,SHIP_DECK_Y,-1,boatMat(0x8a8d90,0.9));
  boxAt(g,10,9,8,0,SHIP_DECK_Y+4.5,-26,boatMat(0xf4f1ea,0.55));
  boxAt(g,10.2,1.8,8.2,0,SHIP_DECK_Y+7.4,-26,boatMat(0x203a4a,0.15,0.4));
  boxAt(g,10.6,0.5,8.6,0,SHIP_DECK_Y+9.2,-26,boatMat(0x2a2c31,0.6));
  const funnel = new THREE.Mesh(new THREE.CylinderGeometry(1.5,1.8,5,10), boatMat([0xc0392b,0x1f618d,0xf39c12,0x27ae60][Math.floor(Math.random()*4)],0.5));
  funnel.position.set(0,SHIP_DECK_Y+11,-28); g.add(funnel);
  const grid = []; let count = 0;
  for(let bay=0; bay<SHIP_BAYS; bay++){
    grid[bay] = [];
    for(let col=0; col<3; col++){
      const stack = [], h = Math.floor(Math.random()*3);          // 0..2 high at arrival
      for(let lv=0; lv<h; lv++){
        const m = contMesh(), p = shipSlotLocal(bay,col,lv);
        m.position.set(p.x,p.y,p.z); g.add(m); stack.push(m); count++;
      }
      grid[bay][col] = stack;
    }
  }
  if(count < 6){ // make sure there is always something to unload
    for(let bay=0; bay<3; bay++){ const st = grid[bay][1]; if(st.length<1){ const m=contMesh(), p=shipSlotLocal(bay,1,0); m.position.set(p.x,p.y,p.z); g.add(m); st.push(m); count++; } }
  }
  return { group:g, grid, count, count0:Math.max(count,8) };
}

function buildGantryCrane(zb){
  const { xL, xS, H } = PORT_CR;
  const yel = boatMat(0xe8b020,0.5,0.3), gry = boatMat(0x6b6f73,0.6,0.4), dk = boatMat(0x2a2c31,0.6,0.3);
  const G = new THREE.Group(); G.position.set(0,0,zb);
  const base = QUAY_Y;
  [[xL,-5.5],[xL,5.5],[xS,-5.5],[xS,5.5]].forEach(([x,z])=> boxAt(G,0.9,H,0.9,x,base+H/2,z,yel));
  [xL,xS].forEach(x=> boxAt(G,0.9,0.9,12,x,base+H-0.45,0,yel));
  [-5.5,5.5].forEach(z=> boxAt(G,xS-xL,0.8,0.8,(xL+xS)/2,base+H-0.4,z,yel));
  [-5.5,5.5].forEach(z=>[xL,xS].forEach(x=> boxAt(G,0.7,0.7,0.7,x,base+0.35,z,dk)));   // wheel blocks
  [-1.5,1.5].forEach(z=> boxAt(G,34,1.1,0.7,835,base+H+0.6,z,yel));                      // boom girders
  boxAt(G,34,0.3,3.6,835,base+H+1.2,0,gry);                                              // boom deck
  boxAt(G,5,3,4.2,823,base+H+2.4,0,gry);                                                 // machinery house
  boxAt(G,2.6,0.5,2.6,818.2,base+H+1.4,0,dk);                                            // counterweight
  const TOP = base+H+0.05;
  const T = new THREE.Group(); T.position.set(PORT_CR.xL+4, TOP, 0); G.add(T);
  boxAt(T,2.2,0.6,3.4,0,0,0,dk);
  const ropeGeo = new THREE.CylinderGeometry(0.05,0.05,1,5), ropeM = boatMat(0x15161a,0.8);
  const ropes = [[-1.3,-2.6],[1.3,-2.6],[-1.3,2.6],[1.3,2.6]].map(([x,z])=>{ const r = new THREE.Mesh(ropeGeo,ropeM); r.position.x=x; r.position.z=z; T.add(r); return r; });
  const S = new THREE.Group(); T.add(S);
  boxAt(S,3.4,0.4,6.2,0,0.2,0,boatMat(0xcf2a1d,0.5,0.2));
  scene.add(G);
  portDyn.push(G);
  // static rails
  [xL,xS].forEach(x=>{ const r = new THREE.Mesh(new THREE.BoxGeometry(0.5,0.12,64), dk); r.position.set(x,QUAY_Y+0.06,zb); scene.add(r); });
  return { G, T, S, ropes, TOP, zg:zb, xt:PORT_CR.xL+4, ys:TOP-8, job:null, steps:null, step:0, held:null, wait:0 };
}

function craneSetPose(c){
  c.G.position.z = c.zg;
  c.T.position.x = c.xt;
  const len = c.TOP - c.ys;
  c.S.position.y = -len;
  for(let i=0;i<c.ropes.length;i++){ c.ropes[i].scale.y = len; c.ropes[i].position.y = -len/2; }
}
function _toward(cur,tgt,step){ const d = tgt-cur; return Math.abs(d)<=step ? tgt : cur+Math.sign(d)*step; }

function yardPos(b,k,c,lvl){ return { x:YARD_COLS[c], z:b.z+(k-3)*6.4, y:QUAY_Y+1.3+lvl*2.7 }; }
function shipSlotWorld(b,bay,col,lvl){ const p = shipSlotLocal(bay,col,lvl), s = b.ship.group.position; return { x:s.x+p.x, z:s.z+p.z, y:SEA_Y+0.05+p.y }; }
const CRANE_CARRY_Y = 16;

function planPortJob(b){
  const sh = b.ship; if(!sh) return null;
  const yardCount = b.yard.reduce((a,row)=>a+row[0].length+row[1].length,0);
  if(b.mode==='unload'){
    const cols = [];
    for(let bay=0; bay<SHIP_BAYS; bay++) for(let col=0; col<3; col++) if(sh.grid[bay][col].length) cols.push([bay,col]);
    if(!cols.length) return null;
    const free = [];
    b.yard.forEach((row,k)=>row.forEach((st,c)=>{ if(st.length<2) free.push([k,c]); }));
    if(!free.length) return null;
    const [bay,col] = cols[Math.floor(Math.random()*cols.length)];
    const [k,c] = free[Math.floor(Math.random()*free.length)];
    const lvl = sh.grid[bay][col].length-1, src = shipSlotWorld(b,bay,col,lvl), dst = yardPos(b,k,c,b.yard[k][c].length);
    return { kind:'unload', bay,col,lvl,k,c, src, dst };
  }
  const stacks = [];
  b.yard.forEach((row,k)=>row.forEach((st,c)=>{ if(st.length) stacks.push([k,c]); }));
  const slots = [];
  for(let bay=0; bay<SHIP_BAYS; bay++) for(let col=0; col<3; col++) if(sh.grid[bay][col].length<3) slots.push([bay,col]);
  if(!stacks.length || !slots.length || sh.count>=sh.count0) return null;
  const [k,c] = stacks[Math.floor(Math.random()*stacks.length)];
  slots.sort((a,b2)=>sh.grid[a[0]][a[1]].length-sh.grid[b2[0]][b2[1]].length);
  const [bay,col] = slots[Math.floor(Math.random()*Math.min(4,slots.length))];
  const lvl = sh.grid[bay][col].length;
  return { kind:'load', bay,col,lvl,k,c, src:yardPos(b,k,c,b.yard[k][c].length-1), dst:shipSlotWorld(b,bay,col,lvl) };
}

function updateCrane(b,dt){
  const c = b.crane;
  const vz=12, vx=12, vUp=13, vDn=9;
  if(!c.job){
    if(b.phase==='dock' && b.mode){
      const j = planPortJob(b);
      if(j){
        c.job = j; c.step = 0;
        c.steps = [
          { z:j.src.z, x:j.src.x, y:CRANE_CARRY_Y },
          { y:j.src.y+1.3, act:'grab' },
          { y:CRANE_CARRY_Y },
          { z:j.dst.z, x:j.dst.x, y:CRANE_CARRY_Y },
          { y:j.dst.y+1.3, act:'release' },
          { y:CRANE_CARRY_Y }
        ];
      } else if(b.workIdle === undefined){ b.workIdle = 0; }
      else b.workIdle += dt;
    }
    if(!c.job){                       // idle: park high over the berth
      c.zg = _toward(c.zg, b.z, vz*dt); c.xt = _toward(c.xt, PORT_CR.xL+4, vx*dt); c.ys = _toward(c.ys, CRANE_CARRY_Y+2, vUp*dt);
      craneSetPose(c);
      return;
    }
  }
  b.workIdle = undefined;
  const st = c.steps[c.step];
  const lo = Math.max(b.z-22, Math.min(b.z+22, st.z===undefined?c.zg:st.z));
  if(st.z !== undefined) c.zg = _toward(c.zg, lo, vz*dt);
  if(st.x !== undefined) c.xt = _toward(c.xt, st.x, vx*dt);
  if(st.y !== undefined) c.ys = _toward(c.ys, st.y, (st.y>c.ys?vUp:vDn)*dt);
  craneSetPose(c);
  const arrived = (st.z===undefined || Math.abs(c.zg-lo)<0.02) && (st.x===undefined || Math.abs(c.xt-st.x)<0.02) && (st.y===undefined || Math.abs(c.ys-st.y)<0.02);
  if(!arrived) return;
  if(st.act==='grab'){
    const j = c.job, sh = b.ship;
    const m = j.kind==='unload' ? sh.grid[j.bay][j.col].pop() : b.yard[j.k][j.c].pop();
    if(j.kind==='unload') sh.count--;
    c.S.attach(m); m.position.set(0,-1.3,0); m.rotation.set(0,0,0);
    c.held = m;
  } else if(st.act==='release'){
    const j = c.job, sh = b.ship, m = c.held;
    if(j.kind==='unload'){ scene.attach(m); m.position.set(j.dst.x,j.dst.y,j.dst.z); b.yard[j.k][j.c].push(m); }
    else { sh.group.attach(m); const p = shipSlotLocal(j.bay,j.col,j.lvl); m.position.set(p.x,p.y,p.z); sh.grid[j.bay][j.col].push(m); sh.count++; }
    m.rotation.set(0,0,0);
    c.held = null;
  }
  c.step++;
  if(c.step >= c.steps.length){ c.job = null; c.steps = null; }
}

function buildPortBerth(zb, startMode){
  const b = { z:zb, phase:'idle', t:0, stage:0, q:0, mode:null, ship:null, boat:null, x:PORT_FAR_X, yaw:0, yard:[], crane:null, workers:[] };
  for(let k=0;k<7;k++) b.yard.push([[],[]]);
  b.crane = buildGantryCrane(zb);
  // starting yard stock
  let n = 5;
  while(n>0){ const k = Math.floor(Math.random()*7), c = Math.floor(Math.random()*2); if(b.yard[k][c].length>=2) continue;
    const p = yardPos(b,k,c,b.yard[k][c].length), m = contMesh(); m.position.set(p.x,p.y,p.z); scene.add(m); portDyn.push(m); b.yard[k][c].push(m); n--; }
  // fence around the yard (visual + solid)
  const fz0 = zb-31, fz1 = zb+31, fx = 818.6;
  const stripe = boatMat(0xe8b020,0.7);
  const fenceL = new THREE.Mesh(new THREE.BoxGeometry(0.4,0.9,fz1-fz0), stripe); fenceL.position.set(fx,QUAY_Y+0.45,(fz0+fz1)/2); scene.add(fenceL);
  [fz0,fz1].forEach(z=>{ const f = new THREE.Mesh(new THREE.BoxGeometry(QUAY_X-fx-0.6,0.9,0.4), stripe); f.position.set((fx+QUAY_X-0.6)/2,QUAY_Y+0.45,z); scene.add(f); });
  for(let z=fz0; z<=fz1+0.01; z+=2.4) obstacles.push({ x:fx, z, r:1.3, dmg:3, type:'fence', weight:200, light:false, mesh:null });
  [fz0,fz1].forEach(z=>{ for(let x=fx+2.4; x<QUAY_X-0.6; x+=2.4) obstacles.push({ x, z, r:1.3, dmg:3, type:'fence', weight:200, light:false, mesh:null }); });
  // dockworkers patrolling inside the yard
  for(let i=0;i<3;i++){
    const w = buildWorkerMesh();
    const z0 = zb-26+i*4, wx = 819.5+(i%2)*0.2;
    w.position.set(wx, QUAY_Y, z0); scene.add(w); portDyn.push(w);
    b.workers.push({ mesh:w, z:z0, dir:i%2?1:-1, lo:zb-27, hi:zb+27, v:1.1+Math.random()*0.5, t:Math.random()*10, pause:0 });
  }
  portBerths.push(b);
  if(startMode==='docked') portSpawnShip(b,true);
  else if(startMode==='arriving'){ portSpawnShip(b,false); b.x = 980; }
  else { b.phase='idle'; b.t = 6+Math.random()*6; }
  return b;
}

function portSpawnShip(b,docked){
  const sh = buildPortShip();
  b.ship = sh;
  b.x = docked ? PORT_SHIP_X : PORT_FAR_X; b.yaw = docked ? 0 : -Math.PI/2;
  sh.group.position.set(b.x,SEA_Y+0.05,b.z); sh.group.rotation.y = b.yaw;
  scene.add(sh.group);
  b.boat = { mesh:sh.group, ph:Math.random()*6.28, amp:docked?0:0.3, ctrl:true };
  harborBoats.push(b.boat);
  if(docked){ b.phase='dock'; b.mode='unload'; b.stage=0; }
  else { b.phase='arrive'; b.stage=0; b.q=0; b.mode=null; }
}
const _ss = u=>u*u*(3-2*u);
function updatePortBerth(b,dt){
  const sh = b.ship;
  if(b.phase==='idle'){
    b.t -= dt;
    if(b.t<=0) portSpawnShip(b,false);
  } else if(b.phase==='arrive'){
    if(b.stage===0){ b.x -= 12*dt; if(b.x<=PORT_APPROACH_X){ b.x = PORT_APPROACH_X; b.stage=1; b.q=0; } }
    else { b.q = Math.min(1,b.q+dt/14); const e=_ss(b.q); b.x = PORT_APPROACH_X+(PORT_SHIP_X-PORT_APPROACH_X)*e; b.yaw = -Math.PI/2*(1-e);
      if(b.q>=1){ b.phase='dock'; b.mode='unload'; b.boat.amp = 0; b.yaw = 0; b.x = PORT_SHIP_X; b.dockT = 0; } }
    sh.group.position.x = b.x; sh.group.rotation.y = b.yaw;
  } else if(b.phase==='dock'){
    b.dockT = (b.dockT||0)+dt;
    const c = b.crane;
    if(!c.job && b.workIdle !== undefined && b.workIdle > 1.5){
      if(b.mode==='unload'){ b.mode='load'; b.workIdle = undefined; }
      else { b.phase='depart'; b.stage=0; b.q=0; b.mode=null; b.workIdle = undefined; b.boat.amp = 0.3; }
    }
    if(b.dockT > 420 && !c.job){ b.phase='depart'; b.stage=0; b.q=0; b.mode=null; b.boat.amp = 0.3; }
  } else if(b.phase==='depart'){
    if(b.stage===0){ b.q = Math.min(1,b.q+dt/14); const e=_ss(b.q); b.x = PORT_SHIP_X+(PORT_APPROACH_X-PORT_SHIP_X)*e; b.yaw = Math.PI/2*e; if(b.q>=1){ b.stage=1; } }
    else { b.x += 12*dt; if(b.x>PORT_FAR_X){
      scene.remove(sh.group); const i = harborBoats.indexOf(b.boat); if(i>=0) harborBoats.splice(i,1);
      b.ship = null; b.boat = null; b.phase='idle'; b.t = 12+Math.random()*14; return; } }
    sh.group.position.x = b.x; sh.group.rotation.y = b.yaw;
  }
}
function updatePort(dt){
  for(let i=0;i<portBerths.length;i++){
    const b = portBerths[i];
    updatePortBerth(b,dt);
    updateCrane(b,dt);
    for(let k=0;k<b.workers.length;k++){
      const w = b.workers[k];
      w.t += dt;
      if(w.pause>0){ w.pause -= dt; w.mesh.position.y = QUAY_Y; continue; }
      w.z += w.dir*w.v*dt;
      if(w.z>w.hi){ w.z=w.hi; w.dir=-1; w.pause=1+Math.random()*3; }
      else if(w.z<w.lo){ w.z=w.lo; w.dir=1; w.pause=1+Math.random()*3; }
      w.mesh.position.z = w.z;
      w.mesh.rotation.y = w.dir>0 ? 0 : Math.PI;
      w.mesh.position.y = QUAY_Y + Math.abs(Math.sin(w.t*6))*0.05;
    }
  }
}

function buildPort(){
  buildPortBerth(-195,'docked');
  buildPortBerth(0,'arriving');
  buildPortBerth(195,'idle');
}

function updateHarbor(dt){
  if(!harborWater.tex) return;
  harborWater.tex.offset.x += dt*0.004;
  harborWater.tex.offset.y += dt*0.0025;
  const t = performance.now()*0.001;
  for(let i=0;i<harborBoats.length;i++){
    const b = harborBoats[i], m = b.mesh;
    if(b.cruise){
      const cr = b.cruise;
      m.position.z += cr.dir*cr.v*dt;
      if(m.position.z > cr.z1){ m.position.z = cr.z1; cr.dir = -1; }
      else if(m.position.z < cr.z0){ m.position.z = cr.z0; cr.dir = 1; }
      const target = cr.dir>0 ? 0 : Math.PI;
      m.rotation.y += (target-m.rotation.y)*Math.min(1,dt*1.5);
    }
    m.position.y = SEA_Y + 0.05 + Math.sin(t*1.3+b.ph)*0.08*b.amp;
    m.rotation.z = Math.sin(t*0.9+b.ph*1.7)*0.035*b.amp;
    m.rotation.x = Math.sin(t*0.7+b.ph*0.6)*0.02*b.amp;
  }
  updatePort(dt);
}

function buildDowntownBlock(cx,cz,ix,iz){
  const pal = palettes.downtown;
  const splitAlongX = Math.random()<0.5;
  const segCount = Math.random()<0.6 ? 2 : 3;
  const full = BLOCK_HALF*2;
  let weights = Array.from({length:segCount}, ()=>0.6+Math.random()*0.8);
  const wsum = weights.reduce((a,b)=>a+b,0);
  weights = weights.map(w=>w/wsum*full);
  let cursor = -BLOCK_HALF;
  weights.forEach(segLen=>{
    const segHalf = segLen/2;
    const segCenter = cursor + segHalf;
    const height = Math.random()<0.12 ? 70+Math.random()*55 : 14 + Math.random()*46;
    const color = jitterColor(pal[Math.floor(Math.random()*pal.length)]);
    let bx,bz,hx,hz;
    if(splitAlongX){ bx = cx+segCenter; bz = cz; hx = segHalf; hz = BLOCK_HALF; }
    else { bx = cx; bz = cz+segCenter; hx = BLOCK_HALF; hz = segHalf; }
    const roll = Math.random();
    if(roll < 0.5 || segHalf < 7){
      registerBuilding({x:bx,z:bz,hx,hz,height,ix,iz,dist:'downtown'});
      addBuildingMesh(bx,bz,hx,hz,height,color,'flat','glass');
    } else {
      buildStoreSegment(cx,cz,ix,iz,splitAlongX,segCenter,segHalf, roll >= 0.78);
    }
    cursor += segLen;
  });
  streetFurniture(cx,cz,ix,iz,{trees:2, lamps:2, mail:0.35, cars:3.2});
}

const districtBuildConfig = {
  suburbs:    { hxMin:7,  hxMax:12, heightMin:5,  heightMax:9,  roofStyle:'gable', wallStyle:'house',      parkChance:0.12 },
  industrial: { hxMin:10, hxMax:20, heightMin:10, heightMax:32, roofStyle:'flat',  wallStyle:'industrial', parkChance:0 },
  harbor:     { hxMin:10, hxMax:20, heightMin:8,  heightMax:22, roofStyle:'flat',  wallStyle:'harbor',     parkChance:0 },
  oldtown:    { hxMin:8,  hxMax:14, heightMin:8,  heightMax:22, roofStyle:'flat',  wallStyle:'oldtown',    parkChance:0.08 }
};

// Several buildings share each non-downtown block now, packed around the block's middle with a
// ~7 m alley between neighbours (close, but not touching) and a clear margin to the sidewalks.
function spacedLayout(dist){
  const R = (lo,hi)=>lo+Math.random()*(hi-lo), G = 3.5;      // G = half the gap between neighbours
  const r = Math.random();
  const rects = [];
  const S = {
    suburbs:    { a:[5,8],     b:[5,8]    },
    oldtown:    { a:[6,10],    b:[6,10]   },
    industrial: { a:[7,11.5],  b:[9,18]   },
    harbor:     { a:[7,11.5],  b:[9,18]   }
  }[dist];
  let mode;
  if(dist==='suburbs')         mode = r<0.75 ? '2x2' : (r<0.9 ? '2x1' : '1x2');
  else if(dist==='oldtown')    mode = r<0.5 ? '2x2' : (r<0.7 ? '2x1' : (r<0.9 ? '1x2' : '3x1'));
  else                         mode = r<0.4 ? '2x1' : (r<0.8 ? '1x2' : (r<0.9 ? '3x1' : '1x3'));
  if(mode==='2x2'){
    [-1,1].forEach(sx=>[-1,1].forEach(sz=>{ const hx = R(S.a[0],S.a[1]), hz = R(S.a[0],S.a[1]); rects.push({ox:sx*(hx+G), oz:sz*(hz+G), hx, hz}); }));
  } else if(mode==='2x1'){            // two side by side along x
    [-1,1].forEach(sx=>{ const hx = R(S.a[0],S.a[1]), hz = Math.min(R(S.b[0],S.b[1]), 22); rects.push({ox:sx*(hx+G), oz:R(-3,3), hx, hz}); });
  } else if(mode==='1x2'){            // two along z
    [-1,1].forEach(sz=>{ const hz = R(S.a[0],S.a[1]), hx = Math.min(R(S.b[0],S.b[1]), 22); rects.push({ox:R(-3,3), oz:sz*(hz+G), hx, hz}); });
  } else {                            // three in a row (x or z): a slimmer set
    const alongX = mode==='3x1', w = ()=>R(5,6.5), d = ()=>R(7,13);
    const m = w(), l = w(), rr = w();
    const spots = [[0,m],[-(m+2*G+l),l],[m+2*G+rr,rr]];
    spots.forEach(([off,half])=>{ const dd = d(); rects.push(alongX ? {ox:off, oz:R(-2,2), hx:half, hz:dd} : {ox:R(-2,2), oz:off, hx:dd, hz:half}); });
  }
  return rects;
}
function curbFor(cx,cz,r){
  const sidewalkR = BLOCK_HALF + SIDEWALK_W*0.55, margin = 2;
  if(Math.abs(r.oz) >= Math.abs(r.ox)){
    const s = r.oz>=0 ? 1 : -1;
    let pz = cz + s*sidewalkR; if(!isClearZ(pz,margin)) pz = cz - s*sidewalkR;
    return { x:cx+r.ox, z:pz };
  }
  const s = r.ox>=0 ? 1 : -1;
  let px = cx + s*sidewalkR; if(!isClearX(px,margin)) px = cx - s*sidewalkR;
  return { x:px, z:cz+r.oz };
}
function addLawnPropMulti(cx,cz,rects){
  for(let tries=0; tries<20; tries++){
    const ang = Math.random()*Math.PI*2, rad = BLOCK_HALF*0.35 + Math.random()*BLOCK_HALF*0.55;
    const ox = cx + Math.cos(ang)*rad, oz = cz + Math.sin(ang)*rad;
    const free = rects.every(r=> Math.abs(ox-(cx+r.ox)) >= r.hx+2.5 || Math.abs(oz-(cz+r.oz)) >= r.hz+2.5);
    const onLawn = Math.abs(ox-cx) <= BLOCK_HALF-3 && Math.abs(oz-cz) <= BLOCK_HALF-3;
    if(free && onLawn){ addObstacle(ox,oz); return; }
  }
}

function buildSpacedBlock(cx,cz,ix,iz,dist){
  const cfg = districtBuildConfig[dist];
  if(Math.random()<cfg.parkChance){
    buildPark(cx,cz);
    streetFurniture(cx,cz,ix,iz,{trees:1, lamps:2, mail:0, cars:0.6});
    return;
  }
  const pal = palettes[dist];
  const rects = spacedLayout(dist);
  const _c0 = scene.children.length;
  rects.forEach(r=>{
    const height = cfg.heightMin + Math.random()*(cfg.heightMax-cfg.heightMin);
    const color = jitterColor(pal[Math.floor(Math.random()*pal.length)]);
    const bx = cx+r.ox, bz = cz+r.oz;
    registerBuilding({x:bx,z:bz,hx:r.hx,hz:r.hz,height,ix,iz,dist,curb:curbFor(cx,cz,r)});
    addBuildingMesh(bx,bz,r.hx,r.hz,height,color,cfg.roofStyle,cfg.wallStyle);
  });
  // more buildings per block means more to draw: the smaller ones drop out of view a little sooner
  for(let i=_c0;i<scene.children.length;i++) scene.children[i].userData.cullDist = (dist==='suburbs') ? 430 : 600;

  const lawnProps = (Math.random()<0.7 ? (Math.random()<0.4 ? 2 : 1) : 0) + (rects.length>2 ? 1 : 0);
  for(let k=0;k<lawnProps;k++) addLawnPropMulti(cx,cz,rects);
  const furn = {
    suburbs:    { trees:1+(Math.random()<0.5?1:0), lamps:1+(Math.random()<0.5?1:0), mail:1,    cars:1.6  },
    industrial: { trees:1,                         lamps:2,                         mail:0.2,  cars:1.2  },
    harbor:     { trees:1,                         lamps:2,                         mail:0.25, cars:1.2  },
    oldtown:    { trees:1+(Math.random()<0.5?1:0), lamps:2,                         mail:0.4,  cars:2.2  }
  }[dist];
  streetFurniture(cx,cz,ix,iz,furn);
}

function buildPark(cx,cz){
  const count = 3 + Math.floor(Math.random()*3);
  for(let i=0;i<count;i++){
    const ang = Math.random()*Math.PI*2;
    const rad = Math.random()*BLOCK_HALF*0.7;
    addObstacle(cx+Math.cos(ang)*rad, cz+Math.sin(ang)*rad);
  }
}

function buildParkedCar(x,z,rotY){
  const colors = [0x4d8fe3,0xc23123,0xf4c24d,0x6b6b6b,0x8a5a9c,0x2c8a5a,0xffffff];
  const builders = [buildCarMesh, buildHatchbackMesh, buildSUVMesh, buildPickupMesh];
  const build = builders[Math.floor(Math.random()*builders.length)];
  const mesh = build(colors[Math.floor(Math.random()*colors.length)]);
  mesh.position.set(x,terrainHeightAt(x,z),z);
  mesh.rotation.y = rotY;
  mesh.userData.cullDist = 350;
  scene.add(mesh);
