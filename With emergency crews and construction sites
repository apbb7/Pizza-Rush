function dispatchAmbulanceTo(emergency, amb){
  amb = amb || ambulances.find(a=>a.mode==='garaged');
  if(!amb) return; // every ambulance is busy — the call waits until one frees up
  const dp = emergency.point || curbsideMarkerPos(emergency.building);
  const path = computeRoadPath(amb.x, amb.z, dp.x, dp.z);
  if(!path){
    amb.mode='garaged'; amb.mesh.visible=false;
    return;
  }
  amb.path = path;
  amb.pathIndex = 0;
  amb.emergency = emergency;
  emergency.ambulance = amb;
  amb.mode = 'toScene';
  amb.mesh.visible = true;
  toast('🚑 An ambulance is responding!', null);
}

function sendAmbulanceToHospital(amb){
  const path = computeRoadPath(amb.x, amb.z, hospitalInfo.dispatch.x, hospitalInfo.dispatch.z);
  if(!path){ amb.mode='garaged'; amb.mesh.visible=false; return; }
  amb.path = path;
  amb.pathIndex = 0;
  amb.mode = 'toHospital';
}

function tryTriggerEmergency(){
  if(activeEmergencies.length >= MAX_ACTIVE_EMERGENCIES) return;
  const candidates = buildings.filter(b=>!b.isShop && !b.isFirehouse && !b.isHospital && !b.isPoliceStation && !b.isBank && !b.underRepair && !activeEmergencies.some(e=>e.building===b));
  if(!candidates.length) return;
  startEmergencyAt(candidates[Math.floor(Math.random()*candidates.length)]);
}

function startEmergencyAt(b){
  const mesh = buildEmergencyMesh();
  const ex = b.x + (Math.random()<0.5?-1:1)*b.hx*0.55;
  const ez = b.z + (Math.random()<0.5?-1:1)*b.hz*0.55;
  mesh.position.set(ex, terrainHeightAt(ex,ez), ez);
  scene.add(mesh);
  const emergency = { x:ex, z:ez, building:b, mesh, severity:1, ambulance:null, t:0 };
  activeEmergencies.push(emergency);
  toast('🚨 Medical emergency reported!', 'bad');
  dispatchAmbulanceTo(emergency);
}

function updateEmergencies(dt){
  for(let i=0;i<activeEmergencies.length;i++){
    const e = activeEmergencies[i];
    e.t += dt;
    const flick = 1 + Math.sin(e.t*7)*0.1;
    const sc = 2.6*flick;
    e.mesh.userData.sprite.scale.set(sc,sc,1);
    e.mesh.position.set(e.x, terrainHeightAt(e.x,e.z)+0.1, e.z);
  }
}

function updateAmbulances(dt){
  for(let i=0;i<ambulances.length;i++){
    const a = ambulances[i];
    if(a.mode==='garaged') continue;

    if(a.mode==='treating'){
      if(!a.emergency){ a.mode='garaged'; a.mesh.visible=false; continue; }
      a.emergency.severity -= dt/6;
      if(a.emergency.severity<=0){
        scene.remove(a.emergency.mesh);
        if(a.emergency.ped){ const pp = a.emergency.ped; pp.state = 'hidden'; pp.mesh.visible = false; pp.hideT = 60; }   // off to County General
        const idx = activeEmergencies.indexOf(a.emergency);
        if(idx!==-1) activeEmergencies.splice(idx,1);
        toast(a.emergency.ped ? '🚑 The injured pedestrian is on board — heading to County General' : '🚑 Patient loaded — heading to County General', null);
        a.emergency = null;
        sendAmbulanceToHospital(a);
      }
      continue;
    }

    if(!a.path || a.path.length===0){
      if(a.mode==='toScene'){
        a.mode='treating';
      } else if(a.mode==='toHospital'){
        a.mode='garaged'; a.mesh.visible=false;
        toast('✅ Patient delivered safely.', 'good');
        const waiting = activeEmergencies.find(e=>!e.ambulance);
        if(waiting) dispatchAmbulanceTo(waiting, a);
      }
      continue;
    }

    const target = a.path[a.pathIndex];
    const dx = target.x-a.x, dz = target.z-a.z;
    const dist = Math.hypot(dx,dz);
    if(dist < 4){
      a.pathIndex++;
      if(a.pathIndex >= a.path.length){
        a.path = null;
        if(a.mode==='toScene'){
          a.mode='treating';
        } else if(a.mode==='toHospital'){
          a.mode='garaged'; a.mesh.visible=false;
          toast('✅ Patient delivered safely.', 'good');
          const waiting = activeEmergencies.find(e=>!e.ambulance);
          if(waiting) dispatchAmbulanceTo(waiting, a);
        }
        continue;
      }
    }

    const bearing = Math.atan2(dx,dz);
    let rel = bearing - a.angle;
    while(rel>Math.PI) rel-=Math.PI*2;
    while(rel<-Math.PI) rel+=Math.PI*2;
    const maxTurn = 2.4*dt;
    a.angle += Math.max(-maxTurn, Math.min(maxTurn, rel));
    a.speed = 12.5;
    a.x += Math.sin(a.angle)*a.speed*dt;
    a.z += Math.cos(a.angle)*a.speed*dt;
    const gy = terrainHeightAt(a.x,a.z);
    a.mesh.position.set(a.x, gy, a.z);
    a.mesh.rotation.y = a.angle;
    const wheelSpin = a.speed*dt*1.6;
    a.wheels.forEach(w=>{ w.rotation.x += wheelSpin; });
    const blink = Math.sin(performance.now()*0.012+i)>0;
    a.beaconR.material.emissiveIntensity = blink?1.2:0.2;
    a.beaconB.material.emissiveIntensity = blink?0.2:1.2;
  }
}

/* =========================================================
   POLICE — station + pursuit AI only in this pass (no traffic-law
   detection beyond speeding/reckless collisions yet, no crime events).
   Patrol cars roam continuously between random destinations (unlike the
   fire trucks/ambulances, which stay garaged until dispatched) using the
   same pickDestination()/curbsideMarkerPos()/computeRoadPath() machinery
   as deliveries and the rival driver. Speed past a threshold for too
   long, or plow into traffic/pedestrians, within range of a patrolling
   car, and it breaks off to chase you — periodically re-pathing toward
   your current position (not a one-shot path, since you're a moving
   target) until it catches you or the chase times out.
========================================================= */
const PATROL_COUNT = 4;
const POLICE_DETECT_RADIUS = 90;
const POLICE_CATCH_RADIUS = 4.2;
const SPEEDING_FRACTION = 0.86;   // of the current vehicle's max speed
const SPEEDING_TRIGGER = 1.2;     // seconds sustained before it counts
let policeStationInfo = null;
const patrolCars = []; // {x,z,angle,speed,mesh,wheels,beaconR,beaconB,path,pathIndex,mode,pauseTimer,repathTimer}
const wantedState = { active:false, timer:0, duration:60, cooldownTimer:0, cooldownDuration:10, chaser:null };
let speedingTimer = 0;

