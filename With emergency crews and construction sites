function _hsl(h,s,l){ return 'hsl('+((h%360+360)%360).toFixed(0)+','+s.toFixed(0)+'%,'+l.toFixed(0)+'%)'; }
function _hslHex(h,s,l){ return new THREE.Color(_hsl(h,s,l)).getHex(); }

// Farthest-point colour scheme: try many candidates, keep the one most unlike every scheme used so far.
function pickScheme(){
  let best = null, bestScore = -1;
  for(let i=0;i<48;i++){
    const h = Math.random()*360, dark = Math.random()<0.5;
    const s = 50+Math.random()*35, l = dark ? 20+Math.random()*12 : 86+Math.random()*8;
    let score = 9;
    for(const u of brandState.usedSchemes){
      let dh = Math.abs(h-u.h); dh = Math.min(dh,360-dh)/180;
      const d = dh + (dark===u.dark?0:0.35) + Math.abs(s-u.s)/300;
      if(d < score) score = d;
    }
    if(score > bestScore){ bestScore = score; best = {h,s,l,dark}; }
  }
  brandState.usedSchemes.push(best);
  const {h,s,l,dark} = best;
  const accentH = h + (Math.random()<0.5?150:210) + Math.random()*40-20;
  return {
    bg: _hsl(h,s,l),
    fg: dark ? _hsl(h+20,40,92) : _hsl(h,s,16),
    accent: _hsl(accentH,70+Math.random()*20,52+Math.random()*8),
    accentHex: _hslHex(accentH,75,55),
    wallHex: _hslHex(h+Math.random()*30-15, 30+Math.random()*25, 62+Math.random()*18),
    awA: _hsl(h,s,dark?38:42), awB: dark ? _hsl(h,25,92) : _hsl(accentH,70,58)
  };
}

function drawLogo(c, cat, x, y, r, fg, ac){
  c.save(); c.translate(x,y); c.lineJoin = c.lineCap = 'round';
