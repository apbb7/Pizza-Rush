    case 'GROCER': ell(0,r*0.15,r*0.75,r*0.7,true); c.fillStyle=ac; c.beginPath(); c.moveTo(r*0.05,-r*0.5); c.quadraticCurveTo(r*0.6,-r*0.95,r*0.7,-r*0.4); c.quadraticCurveTo(r*0.2,-r*0.3,r*0.05,-r*0.5); c.fill(); break;
