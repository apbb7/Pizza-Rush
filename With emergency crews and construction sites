    built.mesh.position.set(x, terrainHeightAt(x,z), z);
    scene.add(built.mesh);
    fireTrucks.push({
      x, z, angle:-Math.PI/2, speed:0,
      mesh: built.mesh, wheels: built.wheels, beacon: built.beacon,
      path:null, pathIndex:0, mode:'garaged', fire:null
    });
  }
}

function dispatchTruckTo(fire, truck){
  truck = truck || fireTrucks.find(t=>t.mode==='garaged');
  if(!truck){
    dispatchRescueHeli(fire); // every truck's busy — the backup unit flies straight there, no road needed
    return;
  }
  const dp = curbsideMarkerPos(fire.building);
  const path = computeRoadPath(truck.x, truck.z, dp.x, dp.z);
  if(!path){
    truck.mode='garaged'; truck.mesh.visible=false;
    return;
  }
  truck.path = path;
  truck.pathIndex = 0;
  truck.fire = fire;
  fire.truck = truck;
  truck.mode = 'toFire';
  truck.mesh.visible = true;
  toast('🚒 A fire truck is responding!', null);
}

function returnTruckHome(t){
  const path = computeRoadPath(t.x, t.z, firehouseInfo.dispatch.x, firehouseInfo.dispatch.z);
  if(!path){ t.mode='garaged'; t.mesh.visible=false; return; }
  t.path = path;
  t.pathIndex = 0;
  t.mode = 'returning';
}

function tryIgniteFire(){
  if(activeFires.length >= MAX_ACTIVE_FIRES) return;
  if(Math.random() > FIRE_IGNITE_CHANCE) return;
  const candidates = buildings.filter(b=>!b.isShop && !b.isFirehouse && !b.isHospital && !b.isPoliceStation && !b.isBank && !b.underRepair && !activeFires.some(f=>f.building===b));
  if(!candidates.length) return;
  startFireAt(candidates[Math.floor(Math.random()*candidates.length)]);
}

function startFireAt(b){
  const mesh = buildFireMesh();
  const fx = b.x + (Math.random()<0.5?-1:1)*b.hx*0.55;
  const fz = b.z + (Math.random()<0.5?-1:1)*b.hz*0.55;
  mesh.position.set(fx, terrainHeightAt(fx,fz), fz);
  scene.add(mesh);
  const fire = { x:fx, z:fz, building:b, mesh, intensity:1, truck:null, t:Math.random()*10, dmgCooldown:0 };
  activeFires.push(fire);
  toast("🔥 Lightning struck — a building's on fire!", 'bad');
  dispatchTruckTo(fire);
}

function updateFires(dt){
  for(let i=activeFires.length-1;i>=0;i--){
    const f = activeFires[i];
    f.t += dt;
    const flick = 1 + Math.sin(f.t*9)*0.08 + Math.sin(f.t*17)*0.04;
    const scale = 3.2*flick*Math.max(0.15, f.intensity);
    f.mesh.userData.sprite.scale.set(scale,scale,1);
    f.mesh.position.set(f.x, terrainHeightAt(f.x,f.z)+0.2+Math.sin(f.t*9)*0.05, f.z);
    f.dmgCooldown -= dt;
    const dist = Math.hypot(player.x-f.x, player.z-f.z);
    if(dist < 3 && f.dmgCooldown<=0){
      applyDamage(3);
      f.dmgCooldown = 1.2;
    }
    if(f.intensity<=0){
      scene.remove(f.mesh);
      startBuildingRepair(f.building);
      activeFires.splice(i,1);
    }
  }
}

function updateFireTrucks(dt){
  for(let i=0;i<fireTrucks.length;i++){
    const t = fireTrucks[i];
    if(t.mode==='garaged') continue;

    if(t.mode==='extinguishing'){
      if(!t.fire || activeFires.indexOf(t.fire)===-1){
        t.fire = null;
        returnTruckHome(t);
        continue;
      }
      t.fire.intensity -= dt/9;
      if(t.fire.intensity<=0){
        toast('🚒 The fire department put out the blaze!', 'good');
        t.fire = null;
        returnTruckHome(t);
      }
      continue;
    }

    if(!t.path || t.path.length===0){
      if(t.mode==='toFire'){
        t.mode='extinguishing';
      } else if(t.mode==='returning'){
        t.mode='garaged'; t.mesh.visible=false;
        const waiting = activeFires.find(f=>!f.truck);
        if(waiting) dispatchTruckTo(waiting, t);
      }
      continue;
    }

    const target = t.path[t.pathIndex];
    const dx = target.x-t.x, dz = target.z-t.z;
    const dist = Math.hypot(dx,dz);
    if(dist < 4){
      t.pathIndex++;
      if(t.pathIndex >= t.path.length){
        t.path = null;
        if(t.mode==='toFire'){
          t.mode='extinguishing';
        } else if(t.mode==='returning'){
          t.mode='garaged'; t.mesh.visible=false;
          const waiting = activeFires.find(f=>!f.truck);
          if(waiting) dispatchTruckTo(waiting, t);
        }
        continue;
      }
    }

    const bearing = Math.atan2(dx,dz);
    let rel = bearing - t.angle;
    while(rel>Math.PI) rel-=Math.PI*2;
    while(rel<-Math.PI) rel+=Math.PI*2;
    const maxTurn = 2.2*dt;
    t.angle += Math.max(-maxTurn, Math.min(maxTurn, rel));
    t.speed = 11;
    t.x += Math.sin(t.angle)*t.speed*dt;
    t.z += Math.cos(t.angle)*t.speed*dt;
    const gy = terrainHeightAt(t.x,t.z);
    t.mesh.position.set(t.x, gy, t.z);
    t.mesh.rotation.y = t.angle;
    const wheelSpin = t.speed*dt*1.5;
    t.wheels.forEach(w=>{ w.rotation.x += wheelSpin; });
    t.beacon.material.emissiveIntensity = 0.6 + Math.sin(performance.now()*0.02+i)*0.5;
  }
}

