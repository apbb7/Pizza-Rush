      c.strokeStyle=ac; c.lineWidth=r*0.1; c.beginPath(); c.moveTo(-r*0.4,0); c.lineTo(r*0.4,0); c.moveTo(0,-r*0.4); c.lineTo(0,r*0.4); c.stroke(); break;
