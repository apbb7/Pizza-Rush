function cropMat(kind){
  const M = farmMats();
  if(M.crops[kind]) return M.crops[kind];
  const s = CROP_STYLES[kind], c = document.createElement('canvas'); c.width = c.height = 128;
  const x = c.getContext('2d');
  x.fillStyle = s.base; x.fillRect(0,0,128,128);
  for(let i=0;i<8;i++){ x.fillStyle = s.row; x.fillRect(i*16+2,0,6,128); }
  for(let i=0;i<110;i++){ x.fillStyle = s.fleck; x.globalAlpha = 0.35+Math.random()*0.4; x.fillRect(Math.random()*128, Math.random()*128, 2, 2+Math.random()*3); }
  x.globalAlpha = 1;
  const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = 4;
  return (M.crops[kind] = new THREE.MeshStandardMaterial({ map:t, roughness:1, polygonOffset:true, polygonOffsetFactor:-2, polygonOffsetUnits:-2 }));
