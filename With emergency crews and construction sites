// Menu buttons act the instant the pointer goes DOWN (a normal click waits for release, and is lost
// if the button shifts under the finger or the page hitches). Keyboard/programmatic clicks still work.
function fastPress(el, fn){
  let lastDown = -1e9;
  el.addEventListener('pointerdown', e=>{ if(e.button>0) return; lastDown = performance.now(); e.preventDefault(); fn(e); });
  el.addEventListener('click', e=>{ if(performance.now()-lastDown < 900) return; fn(e); });
}
fastPress(document.getElementById('start-btn'), ()=>{
  if(document.getElementById('start-overlay').classList.contains('hidden')) return;
  document.getElementById('start-overlay').classList.add('hidden');
  state.running = true;
  SFX.init(); SFX.engineStart();
  // Fade the control hint out once the player's had a chance to read it,
  // instead of leaving it on screen for the whole session.
  setTimeout(()=>{ document.getElementById('hint').classList.add('faded'); }, 9000);
});

