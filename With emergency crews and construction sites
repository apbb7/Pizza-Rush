const camState = { yaw:0, pitch:0.5, dist:7.5, dragging:false, lastX:0, lastY:0 };
renderer.domElement.style.touchAction = 'none';
renderer.domElement.addEventListener('pointerdown', e=>{
  camState.dragging = true; camState.lastX = e.clientX; camState.lastY = e.clientY;
});
window.addEventListener('pointerup', ()=>{ camState.dragging=false; });
window.addEventListener('pointercancel', ()=>{ camState.dragging=false; });
window.addEventListener('pointermove', e=>{
  if(!camState.dragging) return;
  const dx = e.clientX-camState.lastX, dy = e.clientY-camState.lastY;
  camState.lastX = e.clientX; camState.lastY = e.clientY;
  camState.yaw -= dx*0.006;
  camState.pitch = Math.max(0.1, Math.min(1.3, camState.pitch - dy*0.004));
});
renderer.domElement.addEventListener('wheel', e=>{
  camState.dist = Math.max(4, Math.min(18, camState.dist + e.deltaY*0.01));
}, { passive:true });

