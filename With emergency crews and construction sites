function buildStorefront(bx,bz,theta,lw,bd,height,color,kind){
  const g = new THREE.Group();
  g.position.set(bx, terrainHeightAt(bx,bz), bz);
  g.rotation.y = theta;
  const wallM = texMat('house', color, lw, height);
  const trimM = solidMat(new THREE.Color(color).multiplyScalar(0.68).getHex(), 0.8);
  mkBox(g,0,0,0,lw*2,height,bd*2,wallM);
  mkRoundedBox(g,0,height,0,lw*2+0.5,0.5,bd*2+0.5,trimM);
  const gh = 3.4;
  const glassM = storeMat('glass', ()=>new THREE.MeshStandardMaterial({color:0x9fc9d8, roughness:0.1, metalness:0.5, emissive:0x1a3340, emissiveIntensity:0.55}));
  const frameM = storeMat('frame', ()=>solidMat(0x2a2c31,0.5,0.3));
  const doorM  = storeMat('door',  ()=>solidMat(0x6b4a2e,0.7));
  const shopW = lw*2-1.8;
  mkBox(g,0,0.15,bd+0.05,shopW,gh-0.7,0.12,glassM);
  mkBox(g,0,0,bd+0.04,shopW+0.4,0.15,0.2,frameM);
  mkBox(g,0,gh-0.6,bd+0.04,shopW+0.4,0.2,0.2,frameM);
  const panes = Math.max(1,Math.round(shopW/2.4));
  for(let i=0;i<=panes;i++) mkBox(g,-shopW/2+i*shopW/panes,0.15,bd+0.1,0.12,gh-0.7,0.1,frameM);
  const dx = (Math.random()<0.5?-1:1)*Math.random()*Math.max(0,lw*0.4);
  mkBox(g,dx,0,bd+0.13,1.3,2.6,0.1,solidMat(kind.accent,0.6));
  const aw = new THREE.Mesh(new THREE.BoxGeometry(shopW+0.6,0.1,2.3), kind.awningMat);
  aw.position.set(0,gh-0.05,bd+1.1); aw.rotation.x = 0.3; g.add(aw);
  const signW = Math.min(shopW,8.5), signH = Math.max(0.9,signW*0.25);
  const sign = new THREE.Mesh(new THREE.PlaneGeometry(signW,signH), kind.signMat);
  sign.position.set(0,gh+0.45+signH/2,bd+0.07); g.add(sign);
