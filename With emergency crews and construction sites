  }
};

function baseStats(){
  const v = vehicleDefs[state.currentVehicle];
  return {
    maxSpeed: v.maxSpeed + state.upgrades.engine.level*4,
    accel: v.accel + state.upgrades.engine.level*3,
    turnRate: v.turnRate + state.upgrades.handling.level*0.35,
    armor: v.armor * (1 - state.upgrades.handling.level*0.12),           // damage multiplier
    decay: (100/95) * v.decayMul * (1 - state.upgrades.insulation.level*0.22) // freshness pts/sec
  };
}

/* =========================================================
   SAVE / LOAD — persists across sessions.
========================================================= */
const SAVE_KEY = 'pizza-rush-save-v1';

async function saveProgress(){
  if(!window.storage) return;
  try{
    await window.storage.set(SAVE_KEY, JSON.stringify({
      money:          state.money,
      deliveries:     state.deliveries,
      unlocked:       state.unlocked,
      upgrades: {
        engine:     state.upgrades.engine.level,
        handling:   state.upgrades.handling.level,
        insulation: state.upgrades.insulation.level
      },
      ownedVehicles:  state.ownedVehicles,
      currentVehicle: state.currentVehicle,
      decal:          state.decal
    }));
  } catch(e){}
}

async function loadAndApply(){
  if(!window.storage) return;
  try{
    const res = await window.storage.get(SAVE_KEY);
    if(!res || !res.value) return;
    const sv = JSON.parse(res.value);
    if(sv.money        != null) state.money        = sv.money;
    if(sv.deliveries   != null) state.deliveries   = sv.deliveries;
    if(sv.unlocked)  Object.keys(sv.unlocked).forEach(k=>{ if(sv.unlocked[k]) state.unlocked[k] = true; });
    if(sv.upgrades){
      ['engine','handling','insulation'].forEach(k=>{
        if(sv.upgrades[k] != null)
          state.upgrades[k].level = Math.min(state.upgrades[k].max, sv.upgrades[k]);
      });
    }
    if(sv.ownedVehicles) Object.assign(state.ownedVehicles, sv.ownedVehicles);
    if(sv.currentVehicle && state.ownedVehicles[sv.currentVehicle])
      state.currentVehicle = sv.currentVehicle;
    if(sv.decal) state.decal = sv.decal;
  } catch(e){}
}

/* =========================================================
   THREE SETUP
========================================================= */
const container = document.getElementById('game-container');
const scene = new THREE.Scene();
scene.fog = new THREE.Fog(0xcfe3ee, 200, 1100);

const camera = new THREE.PerspectiveCamera(62, window.innerWidth/window.innerHeight, 0.1, 1200);
camera.position.set(0, 14, -16);

const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1, 1.5));
// PERF FIX: shadow mapping was doubling the draw-call count every frame
// (once for the camera, once for the shadow-casting light) on top of an
// already huge mesh count from the procedural buildings below. That
// combination was the main cause of multi-second frame times. Turning
// shadows off is the single biggest win here.
renderer.shadowMap.enabled = false;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;
renderer.outputEncoding = THREE.sRGBEncoding;
container.appendChild(renderer.domElement);

window.addEventListener('resize', ()=>{
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

function castAll(obj){ obj.traverse(o=>{ if(o.isMesh) o.castShadow = true; }); }

const hemi = new THREE.HemisphereLight(0xfff0d6, 0x4a6b3a, 0.85);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff1d0, 1.7);
sun.position.set(220, 260, 130);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left = -900; sun.shadow.camera.right = 900;
sun.shadow.camera.top = 900; sun.shadow.camera.bottom = -900;
sun.shadow.camera.near = 10; sun.shadow.camera.far = 1800;
sun.shadow.bias = -0.0015;
scene.add(sun);
scene.add(sun.target);
const fillLight = new THREE.AmbientLight(0xffffff, 0.22);
scene.add(fillLight);

/* =========================================================
   STORM — darkens the sky, dims the lights, and (elsewhere) adds wind
   and road debris. Blended via a single 0..1 factor that eases in when
   a storm starts and back out when it ends, rather than snapping, so it
   reads as weather rolling in rather than a light switch.
========================================================= */
const CLEAR_SKY = { fogColor:0xcfe3ee, fogNear:200, fogFar:1100, hemi:0.85, sun:1.7, fill:0.22, exposure:1.15 };
const STORM_SKY = { fogColor:0x3a4048, fogNear:70,  fogFar:520,  hemi:0.26, sun:0.32, fill:0.12, exposure:0.72 };
const APOCALYPSE_SKY = { fogColor:0x3d4a34, fogNear:60, fogFar:420, hemi:0.22, sun:0.38, fill:0.10, exposure:0.68 };
[CLEAR_SKY, STORM_SKY, APOCALYPSE_SKY].forEach(p=>{ p._color = new THREE.Color(p.fogColor); });
function applySkyBlend(t, target){
  target = target || STORM_SKY;
  const lerp=(a,b)=>a+(b-a)*t;
  scene.fog.color.copy(CLEAR_SKY._color).lerp(target._color, t);
  scene.fog.near = lerp(CLEAR_SKY.fogNear, target.fogNear);
  scene.fog.far  = lerp(CLEAR_SKY.fogFar,  target.fogFar);
  hemi.intensity = lerp(CLEAR_SKY.hemi, target.hemi);
  sun.intensity  = lerp(CLEAR_SKY.sun,  target.sun);
  fillLight.intensity = lerp(CLEAR_SKY.fill, target.fill);
  renderer.toneMappingExposure = lerp(CLEAR_SKY.exposure, target.exposure);
}

const stormState = {
  active:false, timer:0, duration:75,
  cooldownTimer:0, cooldownDuration:45,
  skyBlend:0,           // eased 0..1, drives applySkyBlend and rain opacity
  windPhase:0, windStrength:3.2,
  nextFlashIn:5
};

// Rain — a single THREE.Points cloud kept centered on the player, so a
// modest particle count (one draw call) reads as rain everywhere the
// player goes rather than needing a city-spanning particle field.
const RAIN_COUNT = 1100;
let rainPoints = null;
function buildRain(){
  const geo = new THREE.BufferGeometry();
  const positions = new Float32Array(RAIN_COUNT*3);
  for(let i=0;i<RAIN_COUNT;i++){
    positions[i*3+0] = (Math.random()*2-1)*55;
    positions[i*3+1] = Math.random()*40;
    positions[i*3+2] = (Math.random()*2-1)*55;
  }
  geo.setAttribute('position', new THREE.BufferAttribute(positions,3));
  const mat = new THREE.PointsMaterial({ color:0xaac8e0, size:0.3, transparent:true, opacity:0, depthWrite:false });
  rainPoints = new THREE.Points(geo, mat);
  rainPoints.frustumCulled = false;
  scene.add(rainPoints);
}
function updateRain(dt){
  if(!rainPoints) return;
  rainPoints.material.opacity = stormState.skyBlend*0.5;
  if(stormState.skyBlend<=0) return;
  const pos = rainPoints.geometry.attributes.position;
  for(let i=0;i<RAIN_COUNT;i++){
    let y = pos.getY(i) - 42*dt;
    if(y<0) y = 40;
    pos.setY(i,y);
  }
  pos.needsUpdate = true;
  rainPoints.position.set(player.x, 0, player.z);
}

function triggerLightning(){
  const el = document.getElementById('lightning-flash');
  el.style.transition = 'none';
  el.style.opacity = String(0.75*stormState.skyBlend);
  const boostedSun = sun.intensity;
  sun.intensity = boostedSun + 1.4*stormState.skyBlend;
  requestAnimationFrame(()=>{
    el.style.transition = 'opacity 0.4s ease-out';
    el.style.opacity = '0';
  });
  setTimeout(()=>{ sun.intensity = boostedSun; }, 90);
  tryIgniteFire();
}

// Rubble piles — "building parts in the street." Chunky, irregular,
// clearly not a clean geometric obstacle, unlike the tidy rocks/cones.
function buildDebrisPile(x,z){
  const g = new THREE.Group();
  const colors = [0x8f8a80,0x716d64,0xa39d8f,0x5f5b53];
  for(let i=0;i<3;i++){
    const mat = new THREE.MeshStandardMaterial({color:colors[Math.floor(Math.random()*colors.length)], roughness:0.92, flatShading:true});
    const r = 0.35+Math.random()*0.35;
    const chunk = new THREE.Mesh(new THREE.DodecahedronGeometry(r,0), mat);
    chunk.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);
    chunk.scale.set(1, 0.6+Math.random()*0.3, 1);
    const ang = Math.random()*Math.PI*2, rad = Math.random()*0.5;
    chunk.position.set(Math.cos(ang)*rad, r*0.4, Math.sin(ang)*rad);
    g.add(chunk);
  }
  const rebar = new THREE.Mesh(new THREE.CylinderGeometry(0.03,0.03,1.1,5), new THREE.MeshStandardMaterial({color:0x6b5f52, roughness:0.6, metalness:0.5}));
  rebar.rotation.z = 0.6; rebar.position.set(0.2,0.5,0.1);
  g.add(rebar);
  g.position.set(x, terrainHeightAt(x,z), z);
  castAll(g);
  scene.add(g);
  return g;
}

const stormDebris = []; // {x,z,r,dmg,mesh} — collides like a heavy obstacle
function spawnStormDebris(){
  clearStormDebris();
  const unlockedCount = Object.values(state.unlocked).filter(Boolean).length;
  const count = 10 + unlockedCount*3;
  let placed = 0, attempts = 0;
  while(placed<count && attempts<count*6){
    attempts++;
    let x,z;
    if(lineXsGlobal.length && Math.random()<0.5){
      x = lineXsGlobal[Math.floor(Math.random()*lineXsGlobal.length)];
      z = TOWN_MIN_Z + Math.random()*(TOWN_MAX_Z-TOWN_MIN_Z);
      x += (Math.random()<0.5?-1:1) * (ROAD_W*0.22);
    } else if(lineZsGlobal.length) {
      z = lineZsGlobal[Math.floor(Math.random()*lineZsGlobal.length)];
      x = TOWN_MIN_X + Math.random()*(TOWN_MAX_X-TOWN_MIN_X);
      z += (Math.random()<0.5?-1:1) * (ROAD_W*0.22);
    } else break;
    if(Math.hypot(x,z) < 45) continue; // keep the shop/driveway clear
    if(Math.abs(Math.abs(x)-RIVER_X)<15 || Math.abs(Math.abs(x)-RIVER_X2)<15) continue; // keep bridges clear
    const mesh = buildDebrisPile(x,z);
    stormDebris.push({x,z,r:1.05,dmg:7,mesh});
    placed++;
  }
}
function clearStormDebris(){
  stormDebris.forEach(d=>{ if(d.mesh) scene.remove(d.mesh); });
  stormDebris.length = 0;
  // Force-cancel any debris cleanup crews still mid-job (e.g. a fresh storm
  // rolling in before the last one's wreckage finished getting cleared) so
  // nothing is left posed over debris that no longer exists.
  for(let i=repairCrews.length-1;i>=0;i--){
    if(repairCrews[i].type==='debris'){
      scene.remove(repairCrews[i].group);
      repairCrews.splice(i,1);
    }
  }
}

/* =========================================================
   POST-DISASTER REPAIR CREWS — small cosmetic worker-and-gear props that
   show up after the chaos: on a fire-scarred building once the blaze is
   out, and on each storm-debris pile once the storm itself has passed.
   Reuses the construction worker mesh. Debris crews deliberately keep
   their pile in `stormDebris` (and therefore still AI-avoided for routing,
   see hSegPassable/vSegPassable) until their own timer finishes, so the
   "road's blocked" effect lingers a little past the storm itself — closer
   to how a real cleanup would read.
========================================================= */
const repairCrews = []; // {type:'building'|'debris', x,z, t, duration, group, worker, building?, debris?}

function buildRepairCrewMesh(){
  const group = new THREE.Group();
  const barMat = new THREE.MeshStandardMaterial({color:0xff7a1a, roughness:0.6});
  const horse = new THREE.Mesh(new THREE.BoxGeometry(1.1,0.12,0.12), barMat);
  horse.position.set(0,0.55,0);
  group.add(horse);
  const leg1 = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.65,0.08), barMat);
  leg1.position.set(-0.4,0.3,0.25); leg1.rotation.z=0.35;
  group.add(leg1);
  const leg2 = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.65,0.08), barMat);
  leg2.position.set(0.4,0.3,0.25); leg2.rotation.z=-0.35;
  group.add(leg2);
  const toolbox = new THREE.Mesh(new THREE.BoxGeometry(0.5,0.3,0.3), new THREE.MeshStandardMaterial({color:0x4a4a4a, roughness:0.5, metalness:0.4}));
  toolbox.position.set(0.95,0.15,0.35);
  group.add(toolbox);
  const worker = buildWorkerMesh();
  worker.position.set(-0.7,0,0.45);
  worker.rotation.y = -0.6;
  group.add(worker);
  castAll(group);
  return { group, worker };
}

function startBuildingRepair(b){
  if(!b || b.underRepair) return;
  b.underRepair = true;
  const side = Math.random()<0.5 ? -1 : 1;
  const rx = b.x + side*b.hx*0.6;
  const rz = b.z + (Math.random()<0.5?-1:1)*b.hz*0.3;
  const rig = buildRepairCrewMesh();
  rig.group.position.set(rx, terrainHeightAt(rx,rz), rz);
  rig.group.rotation.y = Math.random()*Math.PI*2;
  scene.add(rig.group);
  repairCrews.push({ type:'building', x:rx, z:rz, t:0, duration: 30+Math.random()*15, group:rig.group, worker:rig.worker, building:b });
  toast('🛠️ A repair crew is patching up the fire damage.', null);
}

function startDebrisCleanupCrews(){
  stormDebris.forEach(d=>{
    const rig = buildRepairCrewMesh();
    rig.group.position.set(d.x, terrainHeightAt(d.x,d.z), d.z);
    rig.group.rotation.y = Math.random()*Math.PI*2;
    scene.add(rig.group);
    repairCrews.push({ type:'debris', x:d.x, z:d.z, t:0, duration: 8+Math.random()*7, group:rig.group, worker:rig.worker, debris:d });
  });
  if(stormDebris.length) toast('🛠️ Cleanup crews are clearing the storm wreckage.', null);
}

function updateRepairCrews(dt){
  for(let i=repairCrews.length-1;i>=0;i--){
    const c = repairCrews[i];
    c.t += dt;
    if(c.worker) c.worker.position.y = Math.abs(Math.sin(c.t*4.5))*0.07;
    if(c.t >= c.duration){
      scene.remove(c.group);
      if(c.type==='building' && c.building) c.building.underRepair = false;
      if(c.type==='debris' && c.debris){
        const di = stormDebris.indexOf(c.debris);
        if(di!==-1){
          if(c.debris.mesh) scene.remove(c.debris.mesh);
          stormDebris.splice(di,1);
        }
      }
      repairCrews.splice(i,1);
    }
  }
}

function startStorm(){
  stormState.active = true;
  stormState.timer = stormState.duration;
  stormState.nextFlashIn = 3+Math.random()*4;
  spawnStormDebris();
  document.getElementById('storm-panel').style.display = 'block';
  toast('⛈️ A supercell is rolling in! Watch the wind and the wreckage.', 'bad');
  newsHeliReport('News 9: a supercell is rolling in over downtown — expect debris in the streets.');
}
function endStorm(survived){
  stormState.active = false;
  stormState.cooldownTimer = stormState.cooldownDuration;
  startDebrisCleanupCrews();
  document.getElementById('storm-panel').style.display = 'none';
  if(survived){
    state.money += 25;
    toast('☀️ The storm passed. +$25 survivor bonus!', 'good');
    saveProgress();
  }
}

/* =========================================================
   AI HELICOPTERS — two non-player choppers, neither one road-bound (they
   just fly straight lines over everything, no A* needed):
     - News chopper: pure ambient flavor, loops downtown and calls out
       the big weather events as a "traffic report" follow-up toast.
     - Rescue chopper: based on the hospital roof, backs up the fire
       department whenever every truck is already out on a call.
   buildHelicopterMesh/makeHeliLabelTexture are defined with the other
   vehicle-mesh builders further down — fine to call from here since
   function declarations hoist.
========================================================= */
const newsHeli = { x:0, z:0, angle:0, alt:60, mesh:null, rotor:null, tailRotor:null, t:Math.random()*100, radius:130+Math.random()*30, spinSpeed:0.11+Math.random()*0.04 };
function spawnNewsHeli(){
  const built = buildHelicopterMesh(0x2b6fd1, 'NEWS 9', '#0c1f3d');
  newsHeli.mesh = built.mesh;
  newsHeli.rotor = built.rotor;
  newsHeli.tailRotor = built.tailRotor;
  if(built.pizzaBox) built.pizzaBox.visible = false;
  scene.add(newsHeli.mesh);
}
function updateNewsHeli(dt){
  if(!newsHeli.mesh) return;
  newsHeli.t += dt*newsHeli.spinSpeed;
  const nx = Math.cos(newsHeli.t)*newsHeli.radius;
  const nz = Math.sin(newsHeli.t)*newsHeli.radius*0.7;
  newsHeli.angle = Math.atan2(nx-newsHeli.x, nz-newsHeli.z) || newsHeli.angle;
  newsHeli.x = nx; newsHeli.z = nz;
  const gy = terrainHeightAt(newsHeli.x, newsHeli.z);
  newsHeli.mesh.position.set(newsHeli.x, gy+newsHeli.alt, newsHeli.z);
  newsHeli.mesh.rotation.y = newsHeli.angle;
  newsHeli.rotor.rotation.y += dt*26;
  newsHeli.tailRotor.rotation.z += dt*38;
}
function newsHeliReport(msg){
  if(!newsHeli.mesh) return;
  setTimeout(()=>toast('📻 '+msg, null), 1200);
}

const rescueHeli = { x:0, z:0, angle:0, alt:0, mesh:null, rotor:null, tailRotor:null, mode:'parked', fire:null, home:{x:0,z:0,alt:0} };
function spawnRescueHeli(){
  const built = buildHelicopterMesh(0xd81e1e, 'RESCUE', '#7a0d0d');
  rescueHeli.mesh = built.mesh;
  rescueHeli.rotor = built.rotor;
  rescueHeli.tailRotor = built.tailRotor;
  if(built.pizzaBox) built.pizzaBox.visible = false;
  rescueHeli.home.x = hospitalInfo.x; rescueHeli.home.z = hospitalInfo.z; rescueHeli.home.alt = hospitalInfo.height+3;
  rescueHeli.x = rescueHeli.home.x; rescueHeli.z = rescueHeli.home.z; rescueHeli.alt = rescueHeli.home.alt;
  rescueHeli.mesh.position.set(rescueHeli.x, terrainHeightAt(rescueHeli.x,rescueHeli.z)+rescueHeli.alt, rescueHeli.z);
  scene.add(rescueHeli.mesh);
}
function dispatchRescueHeli(fire){
  if(!rescueHeli.mesh || rescueHeli.mode!=='parked') return false; // already out, or not built yet
  rescueHeli.mode = 'toFire';
  rescueHeli.fire = fire;
  fire.truck = rescueHeli; // reused purely as a truthy "already being handled" marker, same as a real truck
  toast('🚁 Every truck is out — the rescue chopper is responding!', null);
  return true;
}
function updateRescueHeli(dt){
  if(!rescueHeli.mesh) return;
  if(rescueHeli.mode==='parked'){
    rescueHeli.rotor.rotation.y += dt*5; // idles slowly on the pad
    return;
  }
  rescueHeli.rotor.rotation.y += dt*30;
  rescueHeli.tailRotor.rotation.z += dt*42;
  const FLY_SPEED=24, HOVER_ALT=10, ARRIVE_RADIUS=1.5;

  if(rescueHeli.mode==='toFire'){
    if(!rescueHeli.fire || activeFires.indexOf(rescueHeli.fire)===-1){
      rescueHeli.fire = null; rescueHeli.mode = 'returning';
    } else {
      rescueHeli.alt += (HOVER_ALT-rescueHeli.alt) * Math.min(1, dt*1.5);
      const dx=rescueHeli.fire.x-rescueHeli.x, dz=rescueHeli.fire.z-rescueHeli.z, dist=Math.hypot(dx,dz);
      if(dist > ARRIVE_RADIUS){
        rescueHeli.x += (dx/dist)*FLY_SPEED*dt; rescueHeli.z += (dz/dist)*FLY_SPEED*dt;
        rescueHeli.angle = Math.atan2(dx,dz);
      } else {
        rescueHeli.mode = 'extinguishing';
      }
    }
  } else if(rescueHeli.mode==='extinguishing'){
    if(!rescueHeli.fire || activeFires.indexOf(rescueHeli.fire)===-1){
      rescueHeli.fire = null; rescueHeli.mode = 'returning';
    } else {
      rescueHeli.fire.intensity -= dt/6; // a bit faster than a single truck — it's the elite backup unit
      if(rescueHeli.fire.intensity<=0){
        toast('🚁 The rescue chopper knocked down the blaze!', 'good');
        rescueHeli.fire = null; rescueHeli.mode = 'returning';
      }
    }
  } else if(rescueHeli.mode==='returning'){
    const dx=rescueHeli.home.x-rescueHeli.x, dz=rescueHeli.home.z-rescueHeli.z, dist=Math.hypot(dx,dz);
    rescueHeli.alt += (rescueHeli.home.alt-rescueHeli.alt) * Math.min(1, dt*1.2);
    if(dist > ARRIVE_RADIUS){
      rescueHeli.x += (dx/dist)*FLY_SPEED*dt; rescueHeli.z += (dz/dist)*FLY_SPEED*dt;
      rescueHeli.angle = Math.atan2(dx,dz);
    } else {
      rescueHeli.mode = 'parked';
    }
  }
  rescueHeli.mesh.position.set(rescueHeli.x, terrainHeightAt(rescueHeli.x,rescueHeli.z)+rescueHeli.alt, rescueHeli.z);
  rescueHeli.mesh.rotation.y = rescueHeli.angle;
}

/* =========================================================
   ZOMBIE APOCALYPSE — pedestrians vanish, the sky sickens, and fast
   zombies converge on the player from every direction. No pathfinding
   (would be expensive with a couple dozen of them) — they just beeline
   straight for the player's current position across open ground, which
   reads fine for a shambling-but-fast horde and keeps this cheap.
========================================================= */
const zombies = [];
const zombieState = {
  active:false, timer:0, duration:120,
  cooldownTimer:0, cooldownDuration:60,
  skyBlend:0,
  chaseSpeed:13, count:20,
  toastCooldown:0
};

function buildZombieMesh(){
  const g = new THREE.Group();
  const skinTones = [0x6b7a5e,0x5a6b4f,0x7a8a6e,0x4f5c46];
  const tatterColors = [0x3a3f30,0x4a4a3a,0x2f3528];
  const skin = skinTones[Math.floor(Math.random()*skinTones.length)];
  const tatter = tatterColors[Math.floor(Math.random()*tatterColors.length)];
  const legs = new THREE.Mesh(new THREE.CylinderGeometry(0.13,0.12,0.8,6), new THREE.MeshStandardMaterial({color:tatter, roughness:1}));
  legs.position.y=0.4; g.add(legs);
  const torso = new THREE.Mesh(new THREE.CylinderGeometry(0.19,0.16,0.55,8), new THREE.MeshStandardMaterial({color:tatter, roughness:1}));
  torso.position.y=1.02; torso.rotation.x=0.25; g.add(torso); // hunched forward
  const head = new THREE.Mesh(new THREE.SphereGeometry(0.16,10,10), new THREE.MeshStandardMaterial({color:skin, roughness:1}));
  head.position.set(0,1.42,0.08); g.add(head);
  const eyeMat = new THREE.MeshStandardMaterial({color:0xff3b30, emissive:0xff3b30, emissiveIntensity:1.2});
  [-0.06,0.06].forEach(ex=>{
    const eye = new THREE.Mesh(new THREE.SphereGeometry(0.025,6,6), eyeMat);
    eye.position.set(ex,1.44,0.21); g.add(eye);
  });
  const armMat = new THREE.MeshStandardMaterial({color:skin, roughness:1});
  [-0.24,0.24].forEach(sx=>{
    const arm = new THREE.Mesh(new THREE.CylinderGeometry(0.05,0.05,0.55,6), armMat);
    arm.position.set(sx,1.05,0.15);
    arm.rotation.x = -0.9; // arms reaching forward
    g.add(arm);
  });
  castAll(g);
  return g;
}

function spawnZombies(){
  clearZombies();
  for(let i=0;i<zombieState.count;i++){
    const ang = Math.random()*Math.PI*2;
    const rad = 40+Math.random()*160; // scattered around the player, not right on top of them
    const x = player.x + Math.cos(ang)*rad;
    const z = player.z + Math.sin(ang)*rad;
    const mesh = buildZombieMesh();
    mesh.position.set(x, terrainHeightAt(x,z), z);
    scene.add(mesh);
    zombies.push({x,z,angle:0,mesh,biteTimer:0});
  }
}
function clearZombies(){
  zombies.forEach(z=>{ if(z.mesh) scene.remove(z.mesh); });
  zombies.length = 0;
}

function updateZombies(dt){
  if(!zombieState.active) return;
  zombieState.toastCooldown = Math.max(0, zombieState.toastCooldown-dt);
  const BITE_RANGE = 2.0;
  for(let i=0;i<zombies.length;i++){
    const z = zombies[i];
    const dx = player.x-z.x, dz = player.z-z.z;
    const dist = Math.hypot(dx,dz)||0.001;
    const dirX=dx/dist, dirZ=dz/dist;
    z.x += dirX*zombieState.chaseSpeed*dt;
    z.z += dirZ*zombieState.chaseSpeed*dt;
    z.angle = Math.atan2(dirX,dirZ);
    const gy = terrainHeightAt(z.x,z.z);
    z.mesh.position.set(z.x, gy, z.z);
    z.mesh.rotation.y = z.angle;
    z.biteTimer -= dt;
    if(dist < BITE_RANGE && z.biteTimer<=0){
      applyDamage(6);
      z.biteTimer = 0.8;
      if(zombieState.toastCooldown<=0){
        toast('🧟 Zombies are clawing at your vehicle!', 'bad');
        zombieState.toastCooldown = 1.5;
      }
    }
  }
}

function startApocalypse(){
  zombieState.active = true;
  zombieState.timer = zombieState.duration;
  zombieState.toastCooldown = 0;
  pedestrians.forEach(p=>{ p.mesh.visible=false; });
  spawnZombies();
  document.getElementById('zombie-panel').style.display = 'block';
  toast('🧟 THE DEAD ARE RISING! Survive 2 minutes for a bonus!', 'bad');
  newsHeliReport('News 9: stay indoors — the streets downtown are not safe right now.');
}
function endApocalypse(survived){
  zombieState.active = false;
  zombieState.cooldownTimer = zombieState.cooldownDuration;
  clearZombies();
  pedestrians.forEach(p=>{ p.mesh.visible=true; });
  document.getElementById('zombie-panel').style.display = 'none';
  if(survived){
    state.money += 40;
    toast('🌅 Dawn breaks. You survived the apocalypse! +$40', 'good');
    saveProgress();
  }
}

/* =========================================================
   FIRE DEPARTMENT — building fires, triggered by storm lightning
   (see triggerLightning() above). A small firehouse garages a couple of
   trucks; when a fire starts, an idle truck paths to the nearest curb
   next to the burning building (reusing the same aStar/computeRoadPath
   machinery as the rival driver) and extinguishes it over a few seconds,
   then heads home. Independent of the storm's own active/inactive state
   once lit — a fire keeps burning, and gets fought, even after the storm
   itself has passed.
========================================================= */
const FIRETRUCK_COUNT = 2;
const MAX_ACTIVE_FIRES = 2;
const FIRE_IGNITE_CHANCE = 0.35; // per lightning flash, while a slot is free
let firehouseInfo = null;
const fireTrucks = [];   // {x,z,angle,speed,mesh,wheels,beacon,path,pathIndex,mode,fire}
const activeFires = [];  // {x,z,building,mesh,intensity,truck,t,dmgCooldown}

