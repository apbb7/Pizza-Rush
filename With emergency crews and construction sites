function terrainFrictionAt(x,z){
  for(let i=0;i<drivewayZones.length;i++){
    const d = drivewayZones[i];
    if(Math.abs(x-d.x)<=d.hx && Math.abs(z-d.z)<=d.hz) return 1.0;
  }
  const ix = Math.round(x/BLOCK), iz = Math.round(z/BLOCK);
  const dx = x-ix*BLOCK, dz = z-iz*BLOCK;
  if(Math.abs(dx)<=BLOCK_HALF && Math.abs(dz)<=BLOCK_HALF){
    return 0.62;
  }
  return 1.0;
}

