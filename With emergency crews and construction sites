let gateSuburbs, gateIndustrial, gateHarbor, gateOldtown;

// Rough masonry-block texture for the city wall — replaces a flat solid
// gray box with something that reads as stacked stone.
function makeStoneWallTexture(){
  const w=128,h=64;
  const cnv=document.createElement('canvas'); cnv.width=w; cnv.height=h;
  const ctx=cnv.getContext('2d');
  ctx.fillStyle='#4d4740'; ctx.fillRect(0,0,w,h);
  const rows=4, cols=6, cw=w/cols, rh=h/rows;
  for(let r=0;r<rows;r++){
    const offset = (r%2)*(cw/2);
    for(let c=-1;c<=cols;c++){
      const bx=c*cw+offset, by=r*rh;
      const shade = 0.75+Math.random()*0.4;
      ctx.fillStyle = `rgb(${Math.floor(108*shade)},${Math.floor(100*shade)},${Math.floor(90*shade)})`;
      ctx.fillRect(bx+1.2, by+1.2, cw-2.4, rh-2.4);
    }
  }
  const tex = new THREE.CanvasTexture(cnv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  return tex;
}

/* =========================================================
   ENDLESS FARMLAND beyond the city wall.
   • The ground outside the wall is one huge textured plane (country roads every
     390 units — 5x further apart than city streets — lining up with some of the
     city's roads, which pass through gaps in the wall; the rest dead-end at it).
   • The farms themselves (fields, pastures, farmsteads with barns, silos,
     farmhouses, animals, tractors and farmers) are generated per 390x390 cell,
     deterministically from the cell's coordinates, and streamed in/out around
     the player — so the countryside never runs out.
========================================================= */
const FARM_C = 390, FARM_O = 39, FARM_ROAD_W = 12;
const FARM_LOAD_R = 2, FARM_KEEP_R = 3;
const farm = { chunks:new Map(), queue:[], mats:null, animMats:null, geo:null, t:0 };
const FARM_GATES = { N:[39,-741], S:[-351,429], W:[39,429] };   // road lines that pass through the wall
const FARM_GAP_W = 18;

function farmCell(v){ return Math.floor((v-FARM_O)/FARM_C); }
function farmAllowed(x,z){ return !(x > TOWN_MIN_X-24 && z > TOWN_MIN_Z-24 && z < TOWN_MAX_Z+24) && x < QUAY_X-28; }
function farmHash(i,j){ let h = Math.imul(i,73856093) ^ Math.imul(j,19349663) ^ 0x9e3779b9; h = Math.imul(h ^ (h>>>15), 2246822507); h ^= h>>>13; h = Math.imul(h,3266489909); return (h ^ (h>>>16))>>>0; }
function farmRng(seed){ let a = seed|0; return function(){ a = a+0x6D2B79F5|0; let t = Math.imul(a^a>>>15,1|a); t = t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }

/* ----- tiny geometry merger: lets a whole barn / animal / tractor be ONE draw call ----- */
function farmGeos(){
  if(farm.geo) return farm.geo;
  return (farm.geo = {
    box:new THREE.BoxGeometry(1,1,1), cyl:new THREE.CylinderGeometry(1,1,1,8), cone:new THREE.ConeGeometry(1,1,8),
    sph:new THREE.SphereGeometry(1,8,6), hemi:new THREE.SphereGeometry(1,8,5,0,Math.PI*2,0,Math.PI/2)
  });
}
function Merger(){
  this.pos = []; this.nor = []; this.col = [];
  this._m = new THREE.Matrix4(); this._q = new THREE.Quaternion(); this._e = new THREE.Euler(); this._p = new THREE.Vector3(); this._s = new THREE.Vector3(); this._c = new THREE.Color();
}
Merger.prototype.add = function(geo,x,y,z,sx,sy,sz,color,rx,ry,rz){
  this._e.set(rx||0,ry||0,rz||0); this._q.setFromEuler(this._e);
  this._p.set(x,y,z); this._s.set(sx,sy,sz); this._m.compose(this._p,this._q,this._s);
  const g = geo.index ? geo.toNonIndexed() : geo.clone();
  g.applyMatrix4(this._m);
  const p = g.attributes.position.array, n = g.attributes.normal.array;
  this._c.set(color);
  for(let i=0;i<p.length;i++){ this.pos.push(p[i]); this.nor.push(n[i]); }
  for(let i=0;i<p.length/3;i++) this.col.push(this._c.r,this._c.g,this._c.b);
  g.dispose();
};
Merger.prototype.box  = function(w,h,d,x,y,z,color,rx,ry,rz){ this.add(farmGeos().box,x,y,z,w,h,d,color,rx,ry,rz); };
Merger.prototype.cyl  = function(r,h,x,y,z,color,rx,ry,rz){ this.add(farmGeos().cyl,x,y,z,r,h,r,color,rx,ry,rz); };
Merger.prototype.cone = function(r,h,x,y,z,color,rx,ry,rz){ this.add(farmGeos().cone,x,y,z,r,h,r,color,rx,ry,rz); };
Merger.prototype.sph  = function(rx_,ry_,rz_,x,y,z,color){ this.add(farmGeos().sph,x,y,z,rx_,ry_,rz_,color); };
Merger.prototype.hemi = function(r,x,y,z,color){ this.add(farmGeos().hemi,x,y,z,r,r,r,color); };
Merger.prototype.shape = function(geo,x,y,z,color,ry){ this.add(geo,x,y,z,1,1,1,color,0,ry||0,0); };
Merger.prototype.build = function(){
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(this.pos,3));
  g.setAttribute('normal',   new THREE.Float32BufferAttribute(this.nor,3));
  g.setAttribute('color',    new THREE.Float32BufferAttribute(this.col,3));
  return g;
};
function farmMats(){
  if(farm.mats) return farm.mats;
  return (farm.mats = {
    solid: new THREE.MeshStandardMaterial({ vertexColors:true, roughness:0.88, polygonOffset:true, polygonOffsetFactor:-2, polygonOffsetUnits:-2 }),
    prop:  new THREE.MeshStandardMaterial({ vertexColors:true, roughness:0.85 }),
    crops: {}
  });
}

/* ----- ground ----- */
function makeFarmGroundTexture(){
  const T = 512, k = T/FARM_C, c = document.createElement('canvas'); c.width = c.height = T;
  const x = c.getContext('2d');
  x.fillStyle = '#6c9a45'; x.fillRect(0,0,T,T);
  for(let i=0;i<220;i++){
    x.fillStyle = Math.random()<0.5 ? 'rgba(255,255,200,0.06)' : 'rgba(20,60,10,0.07)';
    x.fillRect(Math.random()*T, Math.random()*T, 6+Math.random()*26, 6+Math.random()*26);
  }
  const rw = FARM_ROAD_W*k, shoulder = 2.2*k;
  const strip = (col,w)=>{ x.fillStyle = col; x.fillRect(-w/2,0,w,T); x.fillRect(T-w/2,0,w,T); x.fillRect(0,-w/2,T,w); x.fillRect(0,T-w/2,T,w); };
  strip('#8d7a57', rw+shoulder*2);
  strip('#2b2d31', rw);
  x.fillStyle = '#ffce2e';
  const dl = 22*k, dg = 14*k, dw = 2.2*k;
  for(let y=rw/2+2; y<T-rw/2; y+=dl+dg){ x.fillRect(-dw/2,y,dw,dl); x.fillRect(T-dw/2,y,dw,dl); }
  for(let xx=rw/2+2; xx<T-rw/2; xx+=dl+dg){ x.fillRect(xx,-dw/2,dl,dw); x.fillRect(xx,T-dw/2,dl,dw); }
  // intersections: clean asphalt squares
  x.fillStyle = '#2b2d31';
  [[0,0],[T,0],[0,T],[T,T]].forEach(([cx,cy])=> x.fillRect(cx-rw/2,cy-rw/2,rw,rw));
  const t = new THREE.CanvasTexture(c);
  t.wrapS = t.wrapT = THREE.RepeatWrapping; t.anisotropy = 8;
  return t;
}
function buildFarmGround(){
  const L = 20000;
  const pts = [[-L,-L],[QUAY_X,-L],[QUAY_X,TOWN_MIN_Z],[TOWN_MIN_X,TOWN_MIN_Z],[TOWN_MIN_X,TOWN_MAX_Z],[QUAY_X,TOWN_MAX_Z],[QUAY_X,L],[-L,L]];
  // shape lives in (x, -z) so that rotateX(-90deg) lands it on world (x, z)
  const sh = new THREE.Shape(); pts.forEach(([x,z],i)=>{ if(i) sh.lineTo(x,-z); else sh.moveTo(x,-z); });
  const geo = new THREE.ShapeGeometry(sh);
  const p = geo.attributes.position, uv = new Float32Array(p.count*2);
  for(let i=0;i<p.count;i++){ uv[i*2] = (p.getX(i)-FARM_O)/FARM_C; uv[i*2+1] = (-p.getY(i)-FARM_O)/FARM_C; }
  geo.setAttribute('uv', new THREE.BufferAttribute(uv,2));
  geo.rotateX(-Math.PI/2);
  const mesh = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({ map:makeFarmGroundTexture(), roughness:1 }));
  mesh.userData.noCull = true; mesh.frustumCulled = false;
  scene.add(mesh);
  // the coastline continues past the city: a retaining wall holds the farmland above the sea
  const sand = new THREE.MeshStandardMaterial({ color:0xb9ad8f, roughness:0.95 });
  [[TOWN_MAX_Z,L],[-L,TOWN_MIN_Z]].forEach(([z0,z1])=>{
    const w = new THREE.Mesh(new THREE.BoxGeometry(1.2,4.4,z1-z0), sand);
    w.position.set(QUAY_X+0.6,-2.0,(z0+z1)/2); w.userData.noCull = true; w.frustumCulled = false; scene.add(w);
  });
}

