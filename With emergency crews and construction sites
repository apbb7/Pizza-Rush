function buildGuideArrow(){
  const shape = new THREE.Shape();
  shape.moveTo(0, 1.15);
  shape.lineTo(-0.62, 0.05);
  shape.lineTo(-0.24, 0.05);
  shape.lineTo(-0.24, -0.75);
  shape.lineTo( 0.24, -0.75);
  shape.lineTo( 0.24,  0.05);
  shape.lineTo( 0.62,  0.05);
  shape.closePath();
  const geo = new THREE.ShapeGeometry(shape);
  geo.rotateX(-Math.PI/2);
  const mat = new THREE.MeshBasicMaterial({ color:0xfff04d, side:THREE.DoubleSide, transparent:true, opacity:0.95, depthTest:false, fog:false });
  const arrow = new THREE.Mesh(geo, mat);
  const outGeo = new THREE.ShapeGeometry(shape);
  outGeo.scale(1.25,1.25,1.25);
  outGeo.rotateX(-Math.PI/2);
  const outMat = new THREE.MeshBasicMaterial({ color:0x1b1f2e, side:THREE.DoubleSide, transparent:true, opacity:0.5, depthTest:false, fog:false });
  const outline = new THREE.Mesh(outGeo, outMat);
  outline.position.y = -0.02;
  const group = new THREE.Group();
  group.add(outline); group.add(arrow);
  group.renderOrder = 999;
  scene.add(group);
  return group;
}
