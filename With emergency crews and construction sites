// Vehicle-local (lx,lz) -> world, matching Three's rotation.y convention.
function _loadWorld(A,lx,lz){
  const c = Math.cos(A.angle), sn = Math.sin(A.angle);
  return { x: A.x + lx*c + lz*sn, z: A.z + lz*c - lx*sn };
}
function trunkSpot(A){
  const L = A.load;
  return _loadWorld(A, L.spot[0]*L.d, L.spot[1]*L.d);
}
function _setLid(A,u){
  A.load.hinges.forEach(h=>{ h.g.rotation[h.axis] = h.open*u; });
}
function cancelLoadSeq(A){
  A = A || player;
  if(!A.seq) return;
  scene.remove(A.seq.chef); scene.remove(A.seq.box);
  if(A.load) _setLid(A,0);
  A.seq = null;
}
function startLoadSeq(A,opts){
  opts = opts || {};
  if(A.seq || !A.load) return;
  const chef = buildChefMesh(opts.apron, opts.hatBand);
  const door = shopInfo ? { x: shopInfo.x - shopInfo.hx - 0.8, z: shopInfo.z } : { x:-11.8, z:0 };
  chef.position.set(door.x, 0.22, door.z);
  scene.add(chef);
  const box = new THREE.Mesh(new THREE.BoxGeometry(0.5,0.1*Math.max(1,opts.boxes||1),0.5), new THREE.MeshStandardMaterial({color:0xf4c24d, emissive:0xf4c24d, emissiveIntensity:0.3}));
  scene.add(box);
  A.seq = { phase:'walkIn', t:0, chef, box, door, from:null, walk:0, mul:opts.mul||1, sfx:!!opts.sfx };
}
function _chefWalk(L, dt, tx, tz, speed){
  const c = L.chef;
  const dx = tx-c.position.x, dz = tz-c.position.z, dist = Math.hypot(dx,dz);
  if(dist > 0.05){
    const step = Math.min(dist, speed*dt);
    c.position.x += dx/dist*step; c.position.z += dz/dist*step;
    c.rotation.y = Math.atan2(dx,dz);
  }
  L.walk += dt*speed*2.2;
  const sw = Math.sin(L.walk)*0.7;
  c.userData.legs[0].rotation.x = sw; c.userData.legs[1].rotation.x = -sw;
  return dist - speed*dt;
}
function _chefPose(L, armAngle, swing){
  const a = L.chef.userData.arms;
  if(swing){ const sw = Math.sin(L.walk)*0.7; a[0].rotation.x = -sw; a[1].rotation.x = sw; }
  else { a[0].rotation.x = armAngle; a[1].rotation.x = armAngle; }
}
function chefSpeedMul(){ return 1 + state.upgrades.chef.level*0.45; }
function updateLoadSeq(A,dt){
  const L = A.seq; if(!L) return;
  dt *= L.mul;
  if(!A.load){ cancelLoadSeq(A); return; }
  L.t += dt;
  const c = L.chef;
  const spot = trunkSpot(A);
  const handsAt = ()=>({ x:c.position.x+Math.sin(c.rotation.y)*0.42, y:c.position.y+1.0, z:c.position.z+Math.cos(c.rotation.y)*0.42 });
  const bx = A.load.box; const trunkAt = A.mesh.localToWorld(new THREE.Vector3(bx[0],bx[1],bx[2]));
  if(L.phase==='walkIn'){
    const left = _chefWalk(L, dt, spot.x, spot.z, 4.2);
    _chefPose(L, -1.25, false);
    const h = handsAt(); L.box.position.set(h.x,h.y,h.z); L.box.rotation.y = c.rotation.y;
    if(left <= 0.02 && L.t > 0.4){
      L.phase='open'; L.t=0;
      c.rotation.y = Math.atan2(A.x-c.position.x, A.z-c.position.z);
      c.userData.legs[0].rotation.x = c.userData.legs[1].rotation.x = 0;
    }
  } else if(L.phase==='open'){
    c.position.x = spot.x; c.position.z = spot.z;
    c.rotation.y = Math.atan2(A.x-c.position.x, A.z-c.position.z);
    const u = Math.min(1, L.t/0.6);
    _setLid(A,u*(2-u));
    const h = handsAt(); L.box.position.set(h.x,h.y,h.z);
    _chefPose(L, -1.25, false);
    if(u>=1){ L.phase='place'; L.t=0; L.from = h; }
  } else if(L.phase==='place'){
    const u = Math.min(1, L.t/1.0);
    const e = u*u*(3-2*u);
    L.box.position.set(
      L.from.x + (trunkAt.x-L.from.x)*e,
      L.from.y + (trunkAt.y-L.from.y)*e + 0.45*Math.sin(Math.PI*u),
      L.from.z + (trunkAt.z-L.from.z)*e);
    L.box.rotation.y = A.angle;
    _chefPose(L, -1.25 - 0.5*Math.sin(Math.PI*u), false);
    if(u>=1){ L.phase='close'; L.t=0; }
  } else if(L.phase==='close'){
    const u = Math.min(1, L.t/0.6);
    L.box.visible = u < 0.3;
    if(u<0.3) L.box.position.set(trunkAt.x, trunkAt.y, trunkAt.z);
    _setLid(A,(1-u)*(1-u));
    _chefPose(L, -1.25*(1-u), false);
    if(u>=1){
      _setLid(A,0);
      scene.remove(L.box); L.phase='away'; L.t=0; // the vehicle may leave now
      if(L.sfx && typeof SFX!=='undefined' && SFX.pickup) SFX.pickup();
    }
  } else if(L.phase==='away'){
    const left = _chefWalk(L, dt, L.door.x, L.door.z, 3.6);
    _chefPose(L, 0, true);
    if(left <= 0.02 || L.t > 12){ scene.remove(c); A.seq = null; }
  }
}

