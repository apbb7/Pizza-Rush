function districtOf(ix){
  if(ix>=7) return 'harbor';
  if(ix>=4) return 'suburbs';
  if(ix<=-7) return 'oldtown';
  if(ix<=-4) return 'industrial';
  return 'downtown';
}

function makeWallTexture(style){
  style = style || 'glass';
  const w=128,h=256;
  const cnv=document.createElement('canvas'); cnv.width=w; cnv.height=h;
  const ctx=cnv.getContext('2d');
  ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,w,h);

  if(style==='industrial'){
    // corrugated metal siding with sparse small high windows
    const bandH = h/22;
    for(let r=0;r<22;r++){
      ctx.fillStyle = r%2===0 ? 'rgba(15,17,22,0.16)' : 'rgba(0,0,0,0.04)';
      ctx.fillRect(0, r*bandH, w, bandH*0.5);
    }
    const rows=4, cols=3;
    for(let r=0;r<rows;r++) for(let c=0;c<cols;c++){
      if(Math.random()<0.35){
        const cw=w/cols, rh=h/rows;
        ctx.fillStyle='rgba(20,22,28,0.55)';
        ctx.fillRect(c*cw+cw*0.32, r*rh+rh*0.3, cw*0.36, rh*0.32);
      }
    }
  } else if(style==='house'){
    // punched windows with white frames + crossed mullions
    const cols=2, rows=3;
    const cw=w/cols, rh=h/rows;
    for(let r=0;r<rows;r++) for(let c=0;c<cols;c++){
      const lit = Math.random()<0.22;
      const pad=cw*0.24;
      const fx=c*cw+pad-3, fy=r*rh+pad*1.3-3, fw=cw-pad*2+6, fh=rh-pad*2.2+6;
      ctx.fillStyle='rgba(250,248,242,0.85)';
      ctx.fillRect(fx,fy,fw,fh);
      ctx.fillStyle = lit?'rgba(255,221,150,0.95)':'rgba(58,70,88,0.55)';
      ctx.fillRect(c*cw+pad, r*rh+pad*1.3, cw-pad*2, rh-pad*2.2);
      ctx.strokeStyle='rgba(250,248,242,0.9)'; ctx.lineWidth=2.2;
      const mx=c*cw+cw/2, my0=r*rh+pad*1.3, my1=r*rh+rh-pad*0.9;
      ctx.beginPath(); ctx.moveTo(mx,my0); ctx.lineTo(mx,my1); ctx.stroke();
      const myMid=(my0+my1)/2;
      ctx.beginPath(); ctx.moveTo(c*cw+pad,myMid); ctx.lineTo(c*cw+cw-pad,myMid); ctx.stroke();
    }
  } else {
    // glass curtain wall — downtown commercial towers
    const cols=4, rows=8;
    const cw=w/cols, rh=h/rows;
    for(let r=0;r<rows;r++){
      for(let c=0;c<cols;c++){
        const roll = Math.random();
        let col;
        if(roll<0.14) col='rgba(255,225,150,0.9)';
        else if(roll<0.6) col='rgba(140,180,212,0.55)';
        else col='rgba(45,55,68,0.55)';
        ctx.fillStyle = col;
        const pad=cw*0.08;
        ctx.fillRect(c*cw+pad, r*rh+pad*0.6, cw-pad*2, rh-pad*1.2);
      }
    }
    ctx.strokeStyle='rgba(15,17,22,0.45)'; ctx.lineWidth=1.6;
    for(let c=0;c<=cols;c++){ ctx.beginPath(); ctx.moveTo(c*cw,0); ctx.lineTo(c*cw,h); ctx.stroke(); }
    for(let r=0;r<=rows;r++){ ctx.beginPath(); ctx.moveTo(0,r*rh); ctx.lineTo(w,r*rh); ctx.stroke(); }
  }

  const tex = new THREE.CanvasTexture(cnv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  return tex;
}

/* =========================================================
   ARCHITECTURAL BUILDING SYSTEM
========================================================= */
const roofShingleColors = [0xb9583a,0xc46b42,0xa84a32,0xcf7a4a,0x9c4530];

function mkBox(group, ox, baseY, oz, w, h, d, mat){
  if(w<=0||h<=0||d<=0) return;
  const m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);
  m.position.set(ox, baseY+h/2, oz);
  m.castShadow=true; m.receiveShadow=true;
  group.add(m); return m;
}
function mkCyl(group, ox, baseY, oz, rTop, rBot, h, segs, mat){
  const m = new THREE.Mesh(new THREE.CylinderGeometry(rTop,rBot,h,segs), mat);
  m.position.set(ox, baseY+h/2, oz);
  m.castShadow=true; m.receiveShadow=true;
  group.add(m); return m;
}
// Rounded-corner box for solid-color trim, cornices, parapets, roofs, decks
// and similar detail pieces — gives those flat slabs a chamfered, crafted
// edge instead of a sharp cube corner. Kept low-poly (curveSegments:4, no
// vertical bevel) so it's cheap: same one-mesh-per-call cost as mkBox, just
// a bit more geometry to build once at boot. Deliberately NOT used on the
// textured curtain-wall/window volumes — those rely on standard box UVs
// for their tiling wall textures, and an extruded rounded shape maps UVs
// very differently, which would visibly distort the window patterns.
function roundedBoxGeometry(w, h, d, radius){
  const hw = w/2, hd = d/2;
  const r = Math.max(0.03, Math.min(radius, hw*0.5, hd*0.5));
  const shape = new THREE.Shape();
  shape.moveTo(-hw+r, -hd);
  shape.lineTo(hw-r, -hd);
  shape.quadraticCurveTo(hw, -hd, hw, -hd+r);
  shape.lineTo(hw, hd-r);
  shape.quadraticCurveTo(hw, hd, hw-r, hd);
  shape.lineTo(-hw+r, hd);
  shape.quadraticCurveTo(-hw, hd, -hw, hd-r);
  shape.lineTo(-hw, -hd+r);
  shape.quadraticCurveTo(-hw, -hd, -hw+r, -hd);
  const geo = new THREE.ExtrudeGeometry(shape, { depth:h, bevelEnabled:false, curveSegments:4 });
  geo.rotateX(-Math.PI/2);
  return geo;
}
function mkRoundedBox(group, ox, baseY, oz, w, h, d, mat, radius){
  if(w<=0||h<=0||d<=0) return;
  if(radius===undefined) radius = Math.min(w,d)*0.08;
  const geo = roundedBoxGeometry(w,h,d,radius);
  const m = new THREE.Mesh(geo, mat);
  m.position.set(ox, baseY, oz);
  m.castShadow=true; m.receiveShadow=true;
  group.add(m); return m;
}
function solidMat(hex, rough=0.88, metal=0){
  return new THREE.MeshStandardMaterial({color:hex,roughness:rough,metalness:metal});
}
// Nudges a palette color's hue/lightness/saturation by a small random
// amount so buildings drawing the same palette entry don't come out
// visually identical — cheap (one Color object) and reads as natural
// material variation rather than a repeated swatch.
function jitterColor(hex){
  const c = new THREE.Color(hex);
  c.offsetHSL((Math.random()-0.5)*0.03, (Math.random()-0.5)*0.08, (Math.random()-0.5)*0.06);
  return c.getHex();
}
const wallTexCache = {};
function texMat(style, color, hx, height){
  const repX=Math.max(1,Math.round((hx*2)/2.2));
  const repY=Math.max(1,Math.round(height/2.4));
  const key = style+'|'+repX+'|'+repY+'|'+Math.floor(Math.random()*3);
  let t = wallTexCache[key];
  if(!t){ t = makeWallTexture(style); t.repeat.set(repX,repY); t.anisotropy = 4; wallTexCache[key] = t; }
  return new THREE.MeshStandardMaterial({map:t,color,roughness:0.85});
}
function addGroup(group){
  group.castShadow=true;
  scene.add(group);
  return group;
}

function buildTower(x,z,hx,hz,height,color){
  const g=new THREE.Group(); g.position.set(x,terrainHeightAt(x,z),z);
  const wallM=texMat('glass',color,hx,height);
  const concreteM=solidMat(new THREE.Color(color).multiplyScalar(0.78).getHex(),0.9);
  const darkM=solidMat(0x2a2c30,0.6);
  const podH=Math.max(5, height*0.22);
  mkBox(g,0,0,0,hx*2,podH,hz*2,wallM);
  mkRoundedBox(g,0,podH,0,hx*2+0.7,0.55,hz*2+0.7,concreteM);
  const entW=Math.min(hx*0.7, 5), entD=1.4, entH=Math.min(4,podH*0.65);
  mkBox(g,0,0,hz+0.05,entW,entH,entD*2,darkM);
  mkRoundedBox(g,0,entH,hz+entD*0.5,entW+0.6,0.5,entD+0.6,concreteM);
  [0.4,0.8,1.2].forEach((sh,i)=>{
    mkBox(g,0,(2-i)*0.3,hz+entD+0.2+i*0.3, entW-i*0.4, 0.3, 0.6+i*0.3, concreteM);
  });
  [-entW*0.4,entW*0.4].forEach(px=>{
    mkCyl(g,px,0,hz,0.22,0.25,entH*0.9,10,concreteM);
  });
  const s1H=height*0.38, s1Y=podH;
  const s1hx=hx*0.85, s1hz=hz*0.85;
  mkBox(g,0,s1Y,0,s1hx*2,s1H,s1hz*2,wallM);
  // PERF FIX: balconies used to spawn a full row every 4.2m with a rail
  // post every 1.5m — on a 100m+ tower that alone was hundreds of tiny
  // box meshes per building. Wider spacing keeps the look with far fewer meshes.
  const balSpacing=13, balD=1.1, balT=0.22;
  const balM=solidMat(0xd0ccc4,0.8);
  const railM=solidMat(0x9aa0a8,0.6,0.3);
  let by=s1Y+3;
  while(by+balT < s1Y+s1H-2){
    [[0,s1hz+balD/2],[0,-s1hz-balD/2]].forEach(([bx,bz])=>{
      mkRoundedBox(g,bx,by,bz,s1hx*1.1,balT,balD,balM);
      mkBox(g,bx,by+0.85,bz,s1hx*1.1,0.06,0.06,railM);
      for(let p=-s1hx*0.5;p<=s1hx*0.5;p+=4.5){
        mkBox(g,p,by+0.45,bz,0.06,0.9,0.06,railM);
      }
    });
    by+=balSpacing;
  }
  for(let b=s1Y+3;b<s1Y+s1H-1;b+=9){
    mkRoundedBox(g,0,b,0,s1hx*2+0.18,0.2,s1hz*2+0.18,concreteM);
  }
  mkRoundedBox(g,0,s1Y+s1H,0,s1hx*2+0.6,0.5,s1hz*2+0.6,concreteM);
  const s2H=height*0.22, s2Y=s1Y+s1H;
  const s2hx=hx*0.6, s2hz=hz*0.6;
  mkBox(g,0,s2Y,0,s2hx*2,s2H,s2hz*2,wallM);
  const finM=solidMat(new THREE.Color(color).multiplyScalar(0.7).getHex(),0.75);
  [[s2hx,-s2hz],[s2hx,s2hz],[-s2hx,-s2hz],[-s2hx,s2hz]].forEach(([fx,fz])=>{
    mkBox(g,fx,s2Y,fz, 0.5, s2H, 0.5, finM);
  });
  const parH=1.2;
  mkRoundedBox(g,0,s2Y+s2H+parH/2,0,s2hx*2+0.4,parH,s2hz*2+0.4,concreteM);
  mkRoundedBox(g,0,s2Y+s2H+parH/2,0,s2hx*2-0.5,parH,s2hz*2-0.5,darkM);
  const mphW=s2hx*0.7, mphH=Math.min(6,height*0.08);
  mkRoundedBox(g,0,s2Y+s2H+parH,0,mphW*2,mphH,mphW*2,solidMat(0x3a3c40,0.85));
  mkCyl(g,0,s2Y+s2H+parH+mphH,0,0.05,0.12,height*0.08,8,solidMat(0x888888,0.5,0.4));
  const bMesh=new THREE.Mesh(new THREE.SphereGeometry(0.18,8,8),
    solidMat(0xff3b30,0.4)); bMesh.material.emissive.setHex(0xff3b30); bMesh.material.emissiveIntensity=0.9;
  bMesh.position.set(0,s2Y+s2H+parH+mphH+height*0.08,0);
  g.add(bMesh);
  addGroup(g);
}

function buildMidrise(x,z,hx,hz,height,color){
