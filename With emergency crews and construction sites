// ----- Decals -----
// A small flag-style plate mounted beside the pizza box rack (a spot every
// vehicle already keeps clear, since the box itself proves it's open air)
// rather than trying to fit a hood/roof decal to six different body
// shapes — sidesteps needing six more sets of hand-tuned mount points.
const DECAL_DEFS = [
  { id:'none',    name:'No Decal' },
  { id:'stripe',  name:'Racing Stripe' },
  { id:'flames',  name:'Flames' },
  { id:'pizza',   name:'Pizza Logo' },
  { id:'checker', name:'Checkered' },
  { id:'bolt',    name:'Lightning Bolt' }
];
function makeDecalTexture(type){
  const w=256,h=160;
  const cnv=document.createElement('canvas'); cnv.width=w; cnv.height=h;
  const ctx=cnv.getContext('2d');
  ctx.clearRect(0,0,w,h);
  if(type==='stripe'){
    ctx.fillStyle='#ffffff'; ctx.fillRect(w*0.36,0,w*0.10,h);
    ctx.fillStyle='#e3402c'; ctx.fillRect(w*0.48,0,w*0.07,h);
  } else if(type==='flames'){
    for(let i=0;i<4;i++){
      const cx=w*0.18+i*w*0.22, base=h*0.92;
      ctx.fillStyle='#ff8a3d';
      ctx.beginPath();
      ctx.moveTo(cx-16,base);
      ctx.quadraticCurveTo(cx-24,base-50,cx-4,base-88);
      ctx.quadraticCurveTo(cx+2,base-62,cx+12,base-74);
      ctx.quadraticCurveTo(cx+22,base-36,cx+16,base);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle='#ffd23d';
      ctx.beginPath();
      ctx.moveTo(cx-7,base);
      ctx.quadraticCurveTo(cx-10,base-30,cx-1,base-52);
      ctx.quadraticCurveTo(cx+5,base-30,cx+7,base);
      ctx.closePath(); ctx.fill();
    }
  } else if(type==='pizza'){
    ctx.save(); ctx.translate(w/2,h/2);
    const r=h*0.42;
    ctx.fillStyle='#f4c24d';
    ctx.beginPath(); ctx.moveTo(0,0); ctx.arc(0,0,r,-0.55,0.55); ctx.closePath(); ctx.fill();
    ctx.strokeStyle='#c9962f'; ctx.lineWidth=3; ctx.stroke();
    ctx.fillStyle='#e3402c';
    for(let i=0;i<5;i++){
      const a=-0.4+i*0.2, rr=r*0.55;
      ctx.beginPath(); ctx.arc(Math.cos(a)*rr,Math.sin(a)*rr,r*0.07,0,Math.PI*2); ctx.fill();
    }
    ctx.restore();
  } else if(type==='checker'){
    const cell=h/4;
    for(let cx=0; cx<w; cx+=cell){
      for(let cy=0; cy<h; cy+=cell){
        if(Math.round((cx/cell)+(cy/cell))%2===0){
          ctx.fillStyle='#1b1f2e'; ctx.fillRect(cx,cy,cell,cell);
        }
      }
    }
  } else if(type==='bolt'){
    ctx.fillStyle='#ffd23d';
    ctx.beginPath();
    ctx.moveTo(w*0.58,0); ctx.lineTo(w*0.34,h*0.52); ctx.lineTo(w*0.48,h*0.52);
    ctx.lineTo(w*0.28,h); ctx.lineTo(w*0.68,h*0.46); ctx.lineTo(w*0.5,h*0.46);
    ctx.closePath(); ctx.fill();
  }
  const tex = new THREE.CanvasTexture(cnv);
  return tex;
}
function attachDecal(){
  if(player.decalMesh){ player.mesh.remove(player.decalMesh); player.decalMesh = null; }
  if(state.decal === 'none' || !player.pizzaBox) return;
  const tex = makeDecalTexture(state.decal);
  const mat = new THREE.MeshBasicMaterial({ map:tex, transparent:true, side:THREE.DoubleSide, depthWrite:false });
  const plate = new THREE.Mesh(new THREE.PlaneGeometry(0.55,0.34), mat);
  const p = player.pizzaBox.position;
  plate.position.set(p.x+0.36, p.y, p.z);
  plate.renderOrder = 5;
  player.mesh.add(plate);
  player.decalMesh = plate;
}
