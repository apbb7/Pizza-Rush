function animate(){
  requestAnimationFrame(animate);
  // Real time, capped at 0.1 s per frame. (It used to be capped at 0.033 s, so on any machine running
  // under 30 fps the whole game — every timer included — ran slower than the clock on the wall.)
  const dt = Math.min(0.1, clock.getDelta());
  if(state.running) update(dt);
  SFX.update(dt);
  updateStaticCulling();
  renderer.render(scene, camera);
}

