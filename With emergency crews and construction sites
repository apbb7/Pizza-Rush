    case 'PHARMACY': c.fillRect(-r*0.25,-r*0.85,r*0.5,r*1.7); c.fillRect(-r*0.85,-r*0.25,r*1.7,r*0.5); c.fillStyle=ac; ell(0,0,r*0.16,r*0.16,true); break;
    case 'FLOWERS': for(let i=0;i<6;i++){ const a=i*Math.PI/3; ell(Math.cos(a)*r*0.5,Math.sin(a)*r*0.5,r*0.32,r*0.32,true); } c.fillStyle=ac; ell(0,0,r*0.28,r*0.28,true); break;
    case 'DELI': c.beginPath(); c.moveTo(-r*0.9,r*0.55); c.lineTo(r*0.9,r*0.55); c.lineTo(r*0.9,-r*0.1); c.lineTo(-r*0.2,-r*0.7); c.closePath(); c.fill();
