function isClearX(x, margin){
  if(x > TOWN_MAX_X-margin || x < TOWN_MIN_X+margin) return false;
  if(Math.abs(Math.abs(x)-RIVER_X)  < RIVER_HALF_WIDTH+margin) return false;
  if(Math.abs(Math.abs(x)-RIVER_X2) < RIVER_HALF_WIDTH+margin) return false;
  return true;
}
function isClearZ(z, margin){
  return z <= TOWN_MAX_Z-margin && z >= TOWN_MIN_Z+margin;
}

function curbsideMarkerPos(b){
  const blockCenterX = b.ix*BLOCK, blockCenterZ = b.iz*BLOCK;
  const sidewalkR = BLOCK_HALF + SIDEWALK_W*0.55;
  const margin = 2;
  if(Math.abs(b.hz - BLOCK_HALF) < 0.5){
    let pz = blockCenterZ + sidewalkR;
    if(!isClearZ(pz, margin)) pz = blockCenterZ - sidewalkR;
    return { x:b.x, z:pz };
  }
  if(Math.abs(b.hx - BLOCK_HALF) < 0.5){
    let px = blockCenterX + sidewalkR;
    if(!isClearX(px, margin)) px = blockCenterX - sidewalkR;
    return { x:px, z:b.z };
  }
  let pz = blockCenterZ + sidewalkR;
  if(!isClearZ(pz, margin)) pz = blockCenterZ - sidewalkR;
  return { x:blockCenterX, z:pz };
}

function pickDestination(excludeBuildings){
  const pool = buildings.filter(b=>{
    if(b.isShop) return false; // never deliver back to the shop itself
    if(b.isConstructionSite && !b.constructionComplete) return false; // nothing to deliver to yet
    if(b.underRepair) return false; // a repair crew's working the scene, give them room
    if(excludeBuildings && excludeBuildings.has(b)) return false; // no two active orders to the same address
    if(b.dist==='suburbs' && !state.unlocked.suburbs) return false;
    if(b.dist==='industrial' && !state.unlocked.industrial) return false;
    if(b.dist==='harbor' && !state.unlocked.harbor) return false;
    if(b.dist==='oldtown' && !state.unlocked.oldtown) return false;
    return true;
  });
  return pool[Math.floor(Math.random()*pool.length)];
}

// Fills up to the current vehicle's capacity in one visit — a delivery
// van pulling in loads up to 4 pizzas at once rather than making the
// player shuttle back and forth for each one.
function fillOrders(){
  const cap = currentCapacity();
  const already = new Set(state.orders.map(o=>o.dest));
  let added = 0;
  while(state.orders.length < cap){
    const dest = pickDestination(already);
    if(!dest){ break; }
    already.add(dest);
    const dropPoint = curbsideMarkerPos(dest);
    const marker = makeBeacon(dropPoint.x, dropPoint.z, 0xe3402c, '🏠', 0);
    const dist = Math.hypot(dest.x-0, dest.z-0);
    const basePay = 6 + dist*0.16;
    state.orders.push({ dest, dropPoint, freshness:100, basePay, marker });
    added++;
  }
  if(added===0){
    if(state.orders.length===0) toast("No deliveries available yet!", null);
    return;
  }
  player.pizzaBox.visible = true;
  const label = state.orders.length>1 ? `🏠 Delivering ${state.orders.length} pizzas` : '🏠 Delivering to: '+districtLabel(state.orders[0].dest.dist)+' block';
  document.getElementById('order-line').textContent = label;
  document.getElementById('fresh-track').style.display = 'block';
  document.getElementById('compass-row').style.display = 'flex';
  toast(added>1 ? `Loaded up ${added} orders! Get them there fresh 🔥` : 'Order picked up! Get it there fresh 🔥', 'good');
}

function districtLabel(d){
  if(d==='suburbs') return '🏡 Suburbs';
  if(d==='industrial') return '🏭 Industrial';
  return '🏙️ Downtown';
}

// Returns the active order that most needs attention right now (lowest
// freshness) — this is what the guide arrow, compass, and freshness bar
// all track, so they stay pointed at the same thing.
function mostUrgentOrder(){
  if(state.orders.length===0) return null;
  let best = state.orders[0];
  for(let i=1;i<state.orders.length;i++) if(state.orders[i].freshness < best.freshness) best = state.orders[i];
  return best;
}

function completeOrder(order){
  const freshBonus = order.freshness>=85 ? 1.3 : 1.0;
  const pay = order.basePay * (order.freshness/100) * freshBonus;
  state.money += pay;
  state.deliveries++;
  rivalRound.playerCount++;
  toast('Delivered! +$'+pay.toFixed(2)+(freshBonus>1?'  🔥 Hot & Fresh bonus!':''), 'good');
  if(order.marker){ scene.remove(order.marker); order.marker=null; }
  const idx = state.orders.indexOf(order);
  if(idx>=0) state.orders.splice(idx,1);
  if(state.orders.length===0){ player.pizzaBox.visible = false; resetOrderUI(); }
  else document.getElementById('order-line').textContent = state.orders.length>1 ? `🏠 Delivering ${state.orders.length} pizzas` : '🏠 Delivering to: '+districtLabel(state.orders[0].dest.dist)+' block';
  saveProgress();
}

function ruinOrder(order){
  toast('A pizza went cold and was ruined! 🥶', 'bad');
  if(order.marker){ scene.remove(order.marker); order.marker=null; }
  const idx = state.orders.indexOf(order);
  if(idx>=0) state.orders.splice(idx,1);
  if(state.orders.length===0){ player.pizzaBox.visible = false; resetOrderUI(); }
  else document.getElementById('order-line').textContent = state.orders.length>1 ? `🏠 Delivering ${state.orders.length} pizzas` : '🏠 Delivering to: '+districtLabel(state.orders[0].dest.dist)+' block';
}

function resetOrderUI(){
  document.getElementById('order-line').textContent = "🍕 Head to the shop's driveway";
  document.getElementById('fresh-track').style.display = 'none';
  document.getElementById('compass-row').style.display = 'flex';
}

const districtShopConfig = {
  suburbs:    { label:'🏡 Suburbs',          cost:35,  requires:null,        gate:()=>gateSuburbs },
  industrial: { label:'🏭 Industrial District', cost:60, requires:null,     gate:()=>gateIndustrial },
  harbor:     { label:'⚓ Harbor District',   cost:90,  requires:'suburbs',  gate:()=>gateHarbor },
  oldtown:    { label:'🏘️ Old Town',         cost:130, requires:'industrial', gate:()=>gateOldtown }
};

function unlockDistrict(key){
  state.unlocked[key] = true;
  const gate = districtShopConfig[key].gate();
  if(gate) scene.remove(gate.mesh, gate.sprite);
  removeCrossing(key);
  toast('🎉 New area unlocked: '+districtShopConfig[key].label.replace(/^\S+\s/,'')+'!', 'good');
}

function resolveBoxCollision(px,pz,box,radius){
  const closeX = Math.max(box.x-box.hx, Math.min(px, box.x+box.hx));
  const closeZ = Math.max(box.z-box.hz, Math.min(pz, box.z+box.hz));
  let dx = px-closeX, dz = pz-closeZ;
  const distSq = dx*dx+dz*dz;
  if(distSq < radius*radius){
    let dist = Math.sqrt(distSq);
    if(dist < 0.0001){
      const oxX = box.hx - Math.abs(px-box.x);
      const oxZ = box.hz - Math.abs(pz-box.z);
      if(oxX < oxZ){ dx = px>box.x ? oxX+radius : -(oxX+radius); dz = 0; }
      else          { dx = 0; dz = pz>box.z ? oxZ+radius : -(oxZ+radius); }
      dist = Math.abs(dx||dz);
    }
    const nx = dx/dist, nz = dz/dist;
    const push = radius-dist;
    return { hit:true, nx, nz, push };
  }
  return { hit:false };
}

function applyDamage(amount){
  const stats = baseStats();
  // Speed now swings damage much more widely — crawling into something
  // costs relatively little, but a fast hit costs noticeably more than
  // it used to (floor 0.3x, ceiling 1.4x, up from a narrow 0.5x-1.0x).
  const speedFrac = Math.abs(player.speed)/Math.max(1,stats.maxSpeed);
  const speedMul = Math.max(0.3, Math.min(1.4, speedFrac));
  const scaled = amount * 2.2 * speedMul * stats.armor;
  state.damage = Math.max(0, state.damage - scaled);
  updateDamageUI();
  if(state.damage<=0) breakdown();
}

// Sends a light obstacle (cone, mailbox) tumbling away from the impact.
// Launch speed scales with how fast the player was going and inversely
// with the object's weight, so a cone (weight 1) flies much farther than
// a mailbox (weight 3) hit at the same speed.
const DEBRIS_GRAVITY = 14;
function launchDebris(o, impactSpeed){
  if(!o.mesh) return;
  const dirX = Math.sin(player.angle), dirZ = Math.cos(player.angle);
  const launchSpeed = Math.min(16, Math.abs(impactSpeed)*1.3 / Math.max(1,o.weight));
  flyingDebris.push({
    mesh:o.mesh,
    vx: dirX*launchSpeed + (Math.random()-0.5)*1.5,
    vy: 3+Math.random()*2,
    vz: dirZ*launchSpeed + (Math.random()-0.5)*1.5,
    avx:(Math.random()-0.5)*10, avy:(Math.random()-0.5)*10, avz:(Math.random()-0.5)*10,
    life:0, maxLife:1.6
  });
}

const BREAKDOWN_FEE = 5;

function breakdown(){
  if(state.paused) return;
  state.paused = true;
  const fee = Math.min(BREAKDOWN_FEE, state.money);
  state.pendingFee = fee;
  document.getElementById('breakdown-fee').textContent =
    '-$'+fee.toFixed(2) + (fee<BREAKDOWN_FEE ? ' (that was all you had)' : '');
  document.getElementById('breakdown-overlay').classList.remove('hidden');
  // Breaking down ruins everything you were carrying, not just one order.
  state.orders.slice().forEach(o=>ruinOrder(o));
}

document.getElementById('breakdown-btn').addEventListener('click', ()=>{
  state.money -= (state.pendingFee||0);
  state.damage = 100;
  saveProgress();
  player.x = SHOP_DRIVEWAY_X; player.z = SHOP_DRIVEWAY_Z; player.angle = -Math.PI/2; player.speed = 0;
  player.steerInput = 0; player.smoothFriction = 1.0;
  updateDamageUI();
  updateHUD();
  document.getElementById('breakdown-overlay').classList.add('hidden');
  state.paused = false;
});

function updateDamageUI(){
  const fill = document.getElementById('damage-fill');
  fill.style.width = state.damage+'%';
  fill.style.background = state.damage>55 ? '#3e8e5b' : state.damage>25 ? '#f4c24d' : '#e3402c';
}

const clock = new THREE.Clock();

function update(dt){
  if(state.paused){ return; }
  const stats = baseStats();

  // ----- Storm tick: sky blend easing, timer, lightning, rain -----
  const skyTargetBlend = stormState.active ? 1 : 0;
  stormState.skyBlend += (skyTargetBlend - stormState.skyBlend) * Math.min(1, dt*0.6);
  updateRain(dt);
  if(stormState.active){
    stormState.timer -= dt;
    stormState.nextFlashIn -= dt;
    if(stormState.nextFlashIn<=0){
      triggerLightning();
      stormState.nextFlashIn = 4+Math.random()*7;
    }
    if(stormState.timer<=0){ endStorm(true); }
    stats.maxSpeed *= 0.85; // harder to hold a line in the storm
  } else if(stormState.cooldownTimer>0){
    stormState.cooldownTimer -= dt;
  }

  // ----- Zombie apocalypse tick -----
  const zombieTargetBlend = zombieState.active ? 1 : 0;
  zombieState.skyBlend += (zombieTargetBlend - zombieState.skyBlend) * Math.min(1, dt*0.6);
  if(zombieState.active){
    zombieState.timer -= dt;
    if(zombieState.timer<=0){ endApocalypse(true); }
  } else if(zombieState.cooldownTimer>0){
    zombieState.cooldownTimer -= dt;
  }
  updateZombies(dt);

  // ----- Fire department tick: independent of storm active/inactive —
  // once a building's alight it keeps burning (and keeps getting fought)
  // even after the storm itself has passed. -----
  updateFires(dt);
  updateFireTrucks(dt);

  // ----- EMS tick: on its own independent periodic timer, not tied to
  // the storm system at all. -----
  emergencyState.nextCheckIn -= dt;
  if(emergencyState.nextCheckIn<=0){
    emergencyState.nextCheckIn = 25+Math.random()*30;
    // Chaos drives up call volume — a storm roughly doubles the odds each check-in fires.
    if(Math.random() < (stormState.active ? 0.85 : 0.5)) tryTriggerEmergency();
  }
  updateEmergencies(dt);
  updateAmbulances(dt);

  // ----- Police tick: patrol cars roam continuously; speeding or a
  // reckless collision (hooked in below, near those collision blocks)
  // can put you on their radar if one's close enough. -----
  if(Math.abs(player.speed) > stats.maxSpeed*SPEEDING_FRACTION){
    speedingTimer += dt;
    if(speedingTimer > SPEEDING_TRIGGER) tryGoWanted();
  } else {
    speedingTimer = Math.max(0, speedingTimer - dt*2);
  }
  updatePatrolCars(dt);

  // ----- Crime tick: its own independent periodic timer, same pattern
  // as EMS. -----
  if(!crimeState.active){
    crimeState.nextCheckIn -= dt;
    if(crimeState.nextCheckIn<=0){
      // Crooks love cover of a storm — checks come around faster while one's raging.
      crimeState.nextCheckIn = (CRIME_CHECK_MIN+Math.random()*(CRIME_CHECK_MAX-CRIME_CHECK_MIN)) * (stormState.active ? 0.6 : 1);
      tryTriggerRobbery();
    }
  }
  updateCrime(dt);

  // ----- Construction sites: always ticking, independent of every other
  // event system. -----
  updateConstructionSites(dt);

  // ----- Post-disaster repair crews: fire scars and lingering storm
  // debris both tick down on their own timers here. -----
  updateRepairCrews(dt);

  // ----- AI helicopters: ambient news chopper, backup rescue chopper. -----
  updateNewsHeli(dt);
  updateRescueHeli(dt);

  // Only one event's atmosphere applies at a time (mutually exclusive by
  // the trigger buttons below), so whichever still has any blend showing
  // wins; with neither active this settles back to fully clear.
  if(stormState.skyBlend > zombieState.skyBlend) applySkyBlend(stormState.skyBlend, STORM_SKY);
  else applySkyBlend(zombieState.skyBlend, APOCALYPSE_SKY);

  if(state.keys.f)       player.speed += stats.accel * dt;
  else if(state.keys.b)  player.speed -= stats.accel * 0.85 * dt;
  else                   player.speed *= Math.max(0, 1 - 2.0*dt);

  const rawFriction = terrainFrictionAt(player.x, player.z);
  player.smoothFriction += (rawFriction - player.smoothFriction) * Math.min(1, dt * 6);
  const curMax = stats.maxSpeed * player.smoothFriction;

  if(player.speed > curMax){
    player.speed -= (player.speed - curMax) * Math.min(1, dt * 8);
  }
  player.speed = Math.max(-stats.maxSpeed * 0.4, player.speed);

  const rawSteer = (state.keys.l?1:0) - (state.keys.r?1:0);
  const steerSpeed = 7.0;
  const steerReturn = 10.0;
  if(rawSteer !== 0){
    player.steerInput += (rawSteer - player.steerInput) * Math.min(1, dt * steerSpeed);
  } else {
    player.steerInput *= Math.max(0, 1 - dt * steerReturn);
  }

  if(Math.abs(player.steerInput) > 0.01){
    const speedFactor = Math.min(1, 0.3 + Math.abs(player.speed) / stats.maxSpeed);
    player.angle += player.steerInput * stats.turnRate * dt * speedFactor * (player.speed < 0 ? -1 : 1);
  }

  player.x += Math.sin(player.angle) * player.speed * dt;
  player.z += Math.cos(player.angle) * player.speed * dt;

  // Storm wind — a slow primary gust plus a faster smaller ripple on top,
  // so it reads as buffeting rather than a constant sideways conveyor.
  if(stormState.active){
    const t = clock.elapsedTime;
    const windX = Math.sin(t*0.6)*stormState.windStrength + Math.sin(t*2.3)*stormState.windStrength*0.4;
    const windZ = Math.cos(t*0.5)*stormState.windStrength*0.6;
    player.x += windX*dt;
    player.z += windZ*dt;
  }

  if(state.invuln>0) state.invuln -= dt;
  let collided = false;
  const MARGIN = 6;
  const isAircraft = !!vehicleDefs[state.currentVehicle].isAircraft;

  // FIX: this used to be `player.speed -= dot`, which — since dot is
  // negative when driving into a wall — actually INCREASED speed on
  // every impact instead of cancelling the inward component. That was
  // the main cause of the jittery/erratic collisions throughout the game.
  function cancelIntoWall(nx,nz){
    const dot = Math.sin(player.angle)*player.speed*nx + Math.cos(player.angle)*player.speed*nz;
    if(dot < 0) player.speed += dot;
  }
  // A real bounce-back off solid things (buildings, walls, heavy
  // obstacles) — reverses and dampens speed so the car visibly recoils
  // instead of just stopping dead or being able to creep forward through
  // it by holding the throttle. Not used for traffic (vehicles) or light
  // obstacles, which get their own, gentler responses below.
  function applyBounce(factor){
    player.speed = -player.speed * factor;
  }
  // An immediate, guaranteed physical push backward (2.5-4m, along the
  // direction the car was actually facing) on top of whatever the box
  // resolution already did — makes a hard impact snap the car back
  // right away instead of only relying on the speed reversal to drift it
  // back over the next few frames.
  function applyKnockback(){
    const kb = 2.5 + Math.random()*1.5;
    player.x -= Math.sin(player.angle)*kb;
    player.z -= Math.cos(player.angle)*kb;
  }

  // A helicopter in the air flies clean over every ground-level obstacle
  // below — buildings, gates, rivers, the boundary wall, cones/mailboxes,
  // storm debris — none of it applies while airborne. (It still can't
  // pick up or drop off without landing — see the altitude gate further
  // down on fillOrders/completeOrder.)
  if(!isAircraft){
  for(let i=0;i<buildings.length;i++){
    const b = buildings[i];
    if(Math.abs(player.x-b.x)>b.hx+MARGIN || Math.abs(player.z-b.z)>b.hz+MARGIN) continue;
    const res = resolveBoxCollision(player.x, player.z, b, PLAYER_RADIUS);
    if(res.hit){
      player.x += res.nx*res.push; player.z += res.nz*res.push;
      cancelIntoWall(res.nx,res.nz);
      if(!collided && state.invuln<=0){ applyDamage(8); state.invuln=0.6; toast('Crashed into a building! 🏢','bad'); applyBounce(0.55); applyKnockback(); }
      collided = true;
    }
  }
  [[gateSuburbs,'suburbs'],[gateIndustrial,'industrial'],[gateHarbor,'harbor'],[gateOldtown,'oldtown']].forEach(([g,key])=>{
    if(!g || state.unlocked[key]) return;
    const res = resolveBoxCollision(player.x, player.z, g, PLAYER_RADIUS);
    if(res.hit){
      player.x += res.nx*res.push; player.z += res.nz*res.push;
      cancelIntoWall(res.nx,res.nz);
      if(!collided && state.invuln<=0){ applyDamage(9); state.invuln=0.6; toast('That area is locked!','bad'); applyBounce(0.55); }
      collided = true;
    }
  });
  for(let i=0;i<riverWalls.length;i++){
    const w = riverWalls[i];
    if(Math.abs(player.x-w.x)>w.hx+MARGIN || Math.abs(player.z-w.z)>w.hz+MARGIN) continue;
    const res = resolveBoxCollision(player.x, player.z, w, PLAYER_RADIUS);
    if(res.hit){
      player.x += res.nx*res.push; player.z += res.nz*res.push;
      cancelIntoWall(res.nx,res.nz);
      if(!collided && state.invuln<=0){ applyDamage(9); state.invuln=0.6; toast("Can't cross the river here — find the bridge!",'bad'); applyBounce(0.55); }
      collided = true;
    }
  }
  for(let i=0;i<boundaryWalls.length;i++){
    const w = boundaryWalls[i];
    if(Math.abs(player.x-w.x)>w.hx+MARGIN || Math.abs(player.z-w.z)>w.hz+MARGIN) continue;
    const res = resolveBoxCollision(player.x, player.z, w, PLAYER_RADIUS);
    if(res.hit){
      player.x += res.nx*res.push; player.z += res.nz*res.push;
      cancelIntoWall(res.nx,res.nz);
      if(!collided && state.invuln<=0){ applyDamage(9); state.invuln=0.6; toast("That's the edge of town!",'bad'); applyBounce(0.55); }
      collided = true;
    }
  }
  for(let i=0;i<obstacles.length;i++){
    const o = obstacles[i];
    const dx = player.x-o.x, dz = player.z-o.z;
    const rad = PLAYER_RADIUS+o.r;
    if(dx*dx+dz*dz < rad*rad){
      const dist = Math.hypot(dx,dz)||0.001;
      const nx=(dx/dist), nz=(dz/dist);
      player.x += nx*(rad-dist); player.z += nz*(rad-dist);
      if(o.light){
        // Cones, mailboxes: barely register on the car — a bit of damage,
        // a light speed check, and the object goes flying off instead of
        // stopping you. No bounce (matches "unless it's a vehicle" logic:
        // this isn't solid enough to bounce off of either).
        if(state.invuln<=0){
          launchDebris(o, player.speed);
          applyDamage(o.dmg);
          state.invuln = 0.4;
          toast('Sent a '+o.type+' flying!','bad');
        }
        player.speed *= 0.92;
        obstacles.splice(i,1); i--;
      } else {
        cancelIntoWall(nx,nz);
        if(!collided && state.invuln<=0){ applyDamage(o.dmg); state.invuln=0.5; toast('Bumped a '+o.type+'!','bad'); applyBounce(0.55); }
        collided = true;
      }
    }
  }
  for(let i=0;i<stormDebris.length;i++){
    const o = stormDebris[i];
    const dx = player.x-o.x, dz = player.z-o.z;
    const rad = PLAYER_RADIUS+o.r;
    if(dx*dx+dz*dz < rad*rad){
      const dist = Math.hypot(dx,dz)||0.001;
      const nx=(dx/dist), nz=(dz/dist);
      player.x += nx*(rad-dist); player.z += nz*(rad-dist);
      cancelIntoWall(nx,nz);
      if(!collided && state.invuln<=0){ applyDamage(o.dmg); state.invuln=0.5; toast('Hit storm debris in the road!','bad'); applyBounce(0.55); }
      collided = true;
    }
  }
  if(collided) player.speed *= 0.65;
  } // end if(!isAircraft) ground-collision block

  // Animate any flying debris (cones/mailboxes knocked away) — simple
  // projectile motion with gravity and tumbling rotation, removed once it
  // lands or its lifespan runs out.
  for(let i=flyingDebris.length-1;i>=0;i--){
    const d = flyingDebris[i];
    d.life += dt;
    d.vy -= DEBRIS_GRAVITY*dt;
    d.mesh.position.x += d.vx*dt;
    d.mesh.position.y += d.vy*dt;
    d.mesh.position.z += d.vz*dt;
    d.mesh.rotation.x += d.avx*dt;
    d.mesh.rotation.y += d.avy*dt;
    d.mesh.rotation.z += d.avz*dt;
    const groundY = terrainHeightAt(d.mesh.position.x, d.mesh.position.z);
    if(d.mesh.position.y <= groundY || d.life > d.maxLife){
      scene.remove(d.mesh);
      flyingDebris.splice(i,1);
    }
  }

  lightClock += dt;
  updateTrafficLightVisuals();

  updateRival(dt);
  rivalRound.timer -= dt;
  if(rivalRound.timer<=0){
    settleRivalRound();
    rivalRound.timer = rivalRound.duration;
  }

  const lightPhase = currentLightPhase();
  for(let i=0;i<trafficCars.length;i++){
    const c = trafficCars[i];
    let carX,carZ;
    if(c.axis==='x'){ carX=c.pos; carZ=c.cross; } else { carX=c.cross; carZ=c.pos; }

    const aheadDist = (c.axis==='x') ? (player.x-carX)*c.dir : (player.z-carZ)*c.dir;
    const lateral = (c.axis==='x') ? Math.abs(player.z-carZ) : Math.abs(player.x-carX);
    const BRAKE_ZONE=9, STOP_ZONE=3.6, LANE_TOL=2.3;
    let targetSpeed = c.speed;
    if(lateral < LANE_TOL && aheadDist > 0 && aheadDist < BRAKE_ZONE){
      const t = Math.max(0, (aheadDist-STOP_ZONE)/(BRAKE_ZONE-STOP_ZONE));
      targetSpeed = c.speed * Math.min(1, t);
    }

    const myLightState = (c.axis==='x') ? lightPhase.x : lightPhase.z;
    if(myLightState!=='green'){
      const lines = (c.axis==='x') ? lineXsGlobal : lineZsGlobal;
      let nearestAhead = Infinity;
      for(let li=0; li<lines.length; li++){
        const d = (lines[li]-c.pos)*c.dir;
        if(d>0 && d<nearestAhead) nearestAhead = d;
      }
      const LIGHT_WINDOW=20, LIGHT_STOP=ROAD_W/2+2;
      if(nearestAhead < LIGHT_WINDOW){
        const t = Math.max(0, (nearestAhead-LIGHT_STOP)/(LIGHT_WINDOW-LIGHT_STOP));
        targetSpeed = Math.min(targetSpeed, c.speed*Math.min(1,t));
      }
    }

    if(c.curSpeed < targetSpeed) c.curSpeed = Math.min(targetSpeed, c.curSpeed + 10*dt);
    else c.curSpeed = Math.max(targetSpeed, c.curSpeed - 20*dt);

    c.pos += c.curSpeed*c.dir*dt;
    const span = c.max-c.min;
    if(c.pos>c.max) c.pos -= span;
    if(c.pos<c.min) c.pos += span;
    let cx,cz,ang;
    if(c.axis==='x'){ cx=c.pos; cz=c.cross; ang = c.dir>0? Math.PI/2 : -Math.PI/2; }
    else { cx=c.cross; cz=c.pos; ang = c.dir>0? 0 : Math.PI; }
    c.mesh.position.set(cx,0,cz);
    c.mesh.rotation.y = ang;
    const res = resolveBoxCollision(player.x, player.z, {x:cx,z:cz,hx:c.hx,hz:c.hz}, PLAYER_RADIUS);
    if(res.hit && !isAircraft){
      player.x += res.nx*res.push; player.z += res.nz*res.push;
      cancelIntoWall(res.nx,res.nz);
      player.speed *= 0.65;
      if(state.invuln<=0){
        applyDamage(c.dmg); state.invuln=0.6;
        applyKnockback();
        toast(c.type==='truck' ? 'Crashed into a truck! 🚚' : 'Crashed into traffic! 🚗', 'bad');
        tryGoWanted(); // reckless driving — a nearby patrol car may give chase
      }
    }
  }

  if(!zombieState.active){
    for(let i=0;i<pedestrians.length;i++){
      const p = pedestrians[i];
      p.pos += p.speed*p.dir*dt;
      if(p.pos>p.max){ p.pos=p.max; p.dir=-1; }
      if(p.pos<p.min){ p.pos=p.min; p.dir=1; }
      let px,pz,ang;
      if(p.axis==='x'){ px=p.center+p.pos; pz=p.cross; ang = p.dir>0?Math.PI/2:-Math.PI/2; }
      else { px=p.cross; pz=p.center+p.pos; ang = p.dir>0?0:Math.PI; }
      p.bob += dt*7;
      p.mesh.position.set(px, Math.abs(Math.sin(p.bob))*0.05, pz);
      p.mesh.rotation.y = ang;
      const pdx=player.x-px, pdz=player.z-pz;
      const prad = PLAYER_RADIUS+0.4;
      if(!isAircraft && pdx*pdx+pdz*pdz < prad*prad){
        const dist = Math.hypot(pdx,pdz)||0.001;
        const pnx=pdx/dist, pnz=pdz/dist;
        player.x += pnx*(prad-dist); player.z += pnz*(prad-dist);
        cancelIntoWall(pnx,pnz);
        player.speed *= 0.75;
        if(state.invuln<=0){
          applyDamage(3); state.invuln=0.5;
          toast('Watch out for pedestrians! 🚶','bad');
          tryGoWanted(); // reckless driving — a nearby patrol car may give chase
        }
      }
    }
  }

  const groundY = terrainHeightAt(player.x, player.z);

  // ----- Helicopter altitude: manual. Space/E climbs, Shift/Q descends
  // (on-screen ▲▲/▼▼ buttons on touch). Releasing both holds altitude.
  // Pickup/delivery below are gated on actually being landed, so flying
  // over a pad doesn't auto-complete anything — set down on it first.
  const HELI_MAX_ALT = 40, HELI_LAND_ALT = 1.5, HELI_CLIMB_SPEED = 9;
  if(isAircraft){
    const vert = (state.keys.u?1:0) - (state.keys.d?1:0);
    player.alt = Math.max(0, Math.min(HELI_MAX_ALT, player.alt + vert*HELI_CLIMB_SPEED*dt));
    // Town bounds double as the aircraft's only boundary, since it skips
    // the physical boundary-wall collision entirely.
    const M=15;
    player.x = Math.max(TOWN_MIN_X+M, Math.min(TOWN_MAX_X-M, player.x));
    player.z = Math.max(TOWN_MIN_Z+M, Math.min(TOWN_MAX_Z-M, player.z));
  } else {
    player.alt = 0;
  }
  const dispY = groundY + player.alt;
  player.mesh.position.set(player.x, dispY, player.z);
  player.mesh.rotation.y = player.angle;
  const wheelSpin = player.speed*dt*1.6;
  player.wheels.forEach(w=>{ w.rotation.x += wheelSpin; });
  if(player.rotor) player.rotor.rotation.y += dt*(26+Math.abs(player.speed));
  if(player.tailRotor) player.tailRotor.rotation.z += dt*40;

  const landed = !isAircraft || player.alt < HELI_LAND_ALT;
  if(landed && state.orders.length < currentCapacity() && shopInfo && shopInfo.driveway){
    const dw = shopInfo.driveway;
    const margin = 2.5; // a little slack around the driveway strip so it isn't pixel-precise
    if(Math.abs(player.x-dw.x)<=dw.hx+margin && Math.abs(player.z-dw.z)<=dw.hz+margin){ fillOrders(); }
  }
  // Iterate a snapshot since completing/ruining an order splices it out
  // of state.orders mid-loop.
  for(const order of state.orders.slice()){
    order.freshness -= stats.decay*dt;
    if(order.freshness<=0){ ruinOrder(order); }
    else{
      const dp = order.dropPoint;
      const dx = player.x-dp.x, dz = player.z-dp.z;
      if(landed && Math.hypot(dx,dz) < 5.5){ completeOrder(order); }
    }
  }
  const urgentOrder = mostUrgentOrder();
  const navTarget = urgentOrder ? urgentOrder.dropPoint : (shopInfo && shopInfo.driveway ? shopInfo.driveway : shopInfo);
  if(navTarget) updateOrderUI(navTarget, urgentOrder);

  // Camera and guide arrow ride the player's actual height (ground level,
  // or ground+altitude while flying), so they stay anchored over hills —
  // and climb with the helicopter — instead of drifting relative to it.
  const yaw = player.angle + camState.yaw;
  const horizDist = camState.dist*Math.cos(camState.pitch);
  const camY = dispY + 1.2 + camState.dist*Math.sin(camState.pitch);
  const cfx = Math.sin(yaw), cfz = Math.cos(yaw);
  const desired = new THREE.Vector3(player.x-cfx*horizDist, camY, player.z-cfz*horizDist);
  camera.position.lerp(desired, Math.min(1, dt*9));
  const lookAt = new THREE.Vector3(player.x, dispY + 1.1, player.z);
  camera.lookAt(lookAt);

  state.orders.forEach(o=>{
    const m = o.marker;
    if(!m) return;
    m.userData.bob += dt*2;
    m.userData.sprite.position.y = m.userData.baseY + Math.sin(m.userData.bob)*0.4;
  });

  if(navTarget){
    const tdx = navTarget.x-player.x, tdz = navTarget.z-player.z;
    const bearing = Math.atan2(tdx, tdz);
    guideArrow.position.set(player.x, dispY + 3.8 + Math.sin(clock.elapsedTime*3)*0.18, player.z);
    guideArrow.rotation.y = bearing + Math.PI;
  }

  updateHUD();
}

function updateOrderUI(target, order){
  if(order){
    document.getElementById('fresh-fill').style.width = Math.max(0,order.freshness)+'%';
    document.getElementById('fresh-fill').style.background = order.freshness>50?'#f4c24d':'#e3402c';
  }
  const dx = target.x-player.x, dz = target.z-player.z;
  const distM = Math.hypot(dx,dz);
  document.getElementById('dist-text').textContent = Math.round(distM)+'m';
  const targetAngle = Math.atan2(dx,dz);
  let rel = targetAngle - player.angle;
  while(rel>Math.PI) rel-=Math.PI*2;
  while(rel<-Math.PI) rel+=Math.PI*2;
  document.getElementById('compass-arrow').style.transform = 'rotate('+(rel*180/Math.PI)+'deg)';
}

const NUM_COLS = IX_RANGE[1]-IX_RANGE[0]+2;
const NUM_ROWS = IZ_RANGE[1]-IZ_RANGE[0]+2;
function nodeX(c){ return (IX_RANGE[0]+c-0.5)*BLOCK; }
function nodeZ(r){ return (IZ_RANGE[0]+r-0.5)*BLOCK; }
function worldToNode(wx,wz){
  const c = Math.max(0,Math.min(NUM_COLS-1, Math.round(wx/BLOCK-IX_RANGE[0]+0.5)));
  const r = Math.max(0,Math.min(NUM_ROWS-1, Math.round(wz/BLOCK-IZ_RANGE[0]+0.5)));
  return {c,r};
}

// Storm debris sits right on a road's centerline (±a small lane offset) and
// the player can always still thread past it (see spawnStormDebris's
// clearance guarantees) — but emergency/AI vehicles treat a debris-covered
// segment as "the road's blocked here" and route around it instead, the
// same way they already route around an un-bridged river. Only consulted
// while a storm is actually active (stormDebris is empty otherwise, so the
// check would always be free, but the explicit guard keeps intent clear).
function debrisBlocksSegment(x1,z1,x2,z2){
  if(!stormDebris.length) return false;
  const MARGIN=3; // keep intersections themselves clear so adjoining edges aren't affected
  const vertical = (x1===x2);
  for(let i=0;i<stormDebris.length;i++){
    const d=stormDebris[i];
    if(vertical){
      if(Math.abs(d.x-x1) < ROAD_W*0.5 && d.z>Math.min(z1,z2)+MARGIN && d.z<Math.max(z1,z2)-MARGIN) return true;
    } else {
      if(Math.abs(d.z-z1) < ROAD_W*0.5 && d.x>Math.min(x1,x2)+MARGIN && d.x<Math.max(x1,x2)-MARGIN) return true;
    }
  }
  return false;
}

function hSegPassable(c,r){
  const xL=nodeX(c), xR=nodeX(c+1), zr=nodeZ(r);
  const rivers=[
    {x:-RIVER_X2, key:'oldtown'   },
    {x:-RIVER_X,  key:'industrial'},
    {x: RIVER_X,  key:'suburbs'   },
    {x: RIVER_X2, key:'harbor'    }
  ];
  for(const {x:rx,key} of rivers){
    if(rx>xL && rx<xR){
      if(!state.unlocked[key] && Math.abs(zr-BRIDGE_Z)>BRIDGE_HALF_LEN) return false;
      break;
    }
  }
  if(stormState.active && debrisBlocksSegment(xL,zr,xR,zr)) return false;
  return true;
}

function vSegPassable(c,r){
  if(!stormState.active) return true;
  const x=nodeX(c), zB=nodeZ(r), zT=nodeZ(r+1);
  return !debrisBlocksSegment(x,zB,x,zT);
}

function aStar(sc,sr,ec,er){
  if(sc===ec && sr===er) return [{c:sc,r:sr}];
  const N=NUM_COLS, total=NUM_COLS*NUM_ROWS;
  const INF=1e9;
  const g=new Float32Array(total).fill(INF);
  const f=new Float32Array(total).fill(INF);
  const prev=new Int16Array(total).fill(-1);
  const inOpen=new Uint8Array(total);
  const H=(c,r)=>Math.abs(c-ec)+Math.abs(r-er);
  const sk=sr*N+sc, ek=er*N+ec;
  g[sk]=0; f[sk]=H(sc,sr); inOpen[sk]=1;
  const open=[sk];
  const dirs=[{dc:1,dr:0},{dc:-1,dr:0},{dc:0,dr:1},{dc:0,dr:-1}];
  while(open.length){
    let mi=0;
    for(let i=1;i<open.length;i++) if(f[open[i]]<f[open[mi]]) mi=i;
    const cur=open[mi]; open.splice(mi,1); inOpen[cur]=0;
    if(cur===ek){
      const path=[]; let n=cur;
      while(n!==sk){ path.unshift({c:n%N,r:Math.floor(n/N)}); n=prev[n]; }
      path.unshift({c:sc,r:sr});
      return path;
    }
    const cc=cur%N, cr=Math.floor(cur/N);
    for(const {dc,dr} of dirs){
      const nc=cc+dc, nr=cr+dr;
      if(nc<0||nc>=NUM_COLS||nr<0||nr>=NUM_ROWS) continue;
      if(dc!==0 && !hSegPassable(dc>0?cc:nc, cr)) continue;
      if(dr!==0 && !vSegPassable(cc, dr>0?cr:nr)) continue;
      const nk=nr*N+nc, tg=g[cur]+1;
      if(tg<g[nk]){
        prev[nk]=cur; g[nk]=tg; f[nk]=tg+H(nc,nr);
        if(!inOpen[nk]){ inOpen[nk]=1; open.push(nk); }
      }
    }
  }
  return null;
}

/* =========================================================
   RIVAL DRIVER — an AI competitor that actually drives the road network
   (reusing the same A* used for the minimap route) picking up and
   delivering its own pizzas in parallel with the player. No collision
   with the player/traffic/buildings — it's a scripted path-follower, not
   a physically simulated car, which keeps it from ever getting stuck.
========================================================= */
const rival = {
  x: SHOP_DRIVEWAY_X, z: 0, angle: -Math.PI/2, speed: 0,
  mesh: null, wheels: [],
  path: null, pathIndex: 0,
  mode: 'pausedAtShop', pauseTimer: 2.0,
  cruiseSpeed: 13
};
const rivalRound = { playerCount:0, rivalCount:0, timer:100, duration:100 };

function spawnRival(){
  const built = buildRivalCarMesh();
  rival.mesh = built.mesh;
  rival.wheels = built.wheels;
  rival.mesh.position.set(rival.x, terrainHeightAt(rival.x,rival.z), rival.z);
  rival.mesh.rotation.y = rival.angle;
  scene.add(rival.mesh);
}

function computeRoadPath(fromX,fromZ,toX,toZ){
  const sn = worldToNode(fromX,fromZ), en = worldToNode(toX,toZ);
  const nodePath = aStar(sn.c,sn.r,en.c,en.r);
  if(!nodePath) return null;
  return nodePath.map(n=>({x:nodeX(n.c), z:nodeZ(n.r)}));
}

function settleRivalRound(){
  const p = rivalRound.playerCount, r = rivalRound.rivalCount;
  if(p > r){
    const bonus = 10 + (p-r)*4;
    state.money += bonus;
    toast(`🏆 You beat Rico's Pizza this round! +$${bonus.toFixed(2)}`, 'good');
  } else if(r > p){
    const penalty = Math.min(state.money, 8 + (r-p)*3);
    state.money -= penalty;
    toast(`😤 Rico's Pizza beat you this round! -$${penalty.toFixed(2)}`, 'bad');
  } else {
    toast("🤝 Tied with Rico's Pizza this round.", null);
  }
  rivalRound.playerCount = 0;
  rivalRound.rivalCount = 0;
  saveProgress();
}

function updateRival(dt){
  if(!rival.mesh) return;

  if(rival.mode==='pausedAtShop' || rival.mode==='pausedAtDropoff'){
    rival.pauseTimer -= dt;
    if(rival.pauseTimer<=0){
      if(rival.mode==='pausedAtShop'){
        const already = new Set(state.orders.map(o=>o.dest));
        const dest = pickDestination(already);
        if(dest){
          const dp = curbsideMarkerPos(dest);
          rival.path = computeRoadPath(rival.x, rival.z, dp.x, dp.z);
          rival.pathIndex = 0;
          rival.mode = rival.path ? 'toDropoff' : 'pausedAtShop';
          if(!rival.path) rival.pauseTimer = 1.0;
        } else {
          rival.pauseTimer = 1.0; // nothing available yet — try again shortly
        }
      } else {
        rival.path = computeRoadPath(rival.x, rival.z, SHOP_DRIVEWAY_X, 0);
        rival.pathIndex = 0;
        rival.mode = rival.path ? 'toShop' : 'pausedAtDropoff';
        if(!rival.path) rival.pauseTimer = 1.0;
      }
    }
    return;
  }

  if(!rival.path || rival.path.length===0){
    rival.pauseTimer = 1.0;
    rival.mode = (rival.mode==='toDropoff') ? 'pausedAtDropoff' : 'pausedAtShop';
    return;
  }

  const target = rival.path[rival.pathIndex];
  const dx = target.x-rival.x, dz = target.z-rival.z;
  const dist = Math.hypot(dx,dz);
  if(dist < 4){
    rival.pathIndex++;
    if(rival.pathIndex >= rival.path.length){
      if(rival.mode==='toDropoff'){
        rivalRound.rivalCount++;
        toast("🏎️ Rico's Pizza made a delivery!", null);
        rival.mode='pausedAtDropoff'; rival.pauseTimer=1.5;
      } else {
        rival.mode='pausedAtShop'; rival.pauseTimer=1.2;
      }
      rival.path=null;
      return;
    }
  }

  const bearing = Math.atan2(dx,dz);
  let rel = bearing - rival.angle;
  while(rel>Math.PI) rel-=Math.PI*2;
  while(rel<-Math.PI) rel+=Math.PI*2;
  const maxTurn = 2.6*dt;
  rival.angle += Math.max(-maxTurn, Math.min(maxTurn, rel));
  rival.speed = rival.cruiseSpeed;
  rival.x += Math.sin(rival.angle)*rival.speed*dt;
  rival.z += Math.cos(rival.angle)*rival.speed*dt;
  const gy = terrainHeightAt(rival.x, rival.z);
  rival.mesh.position.set(rival.x, gy, rival.z);
  rival.mesh.rotation.y = rival.angle;
  const wheelSpin = rival.speed*dt*1.6;
  rival.wheels.forEach(w=>{ w.rotation.x += wheelSpin; });
}

let _pathCache=null, _pathTargetKey='', _pathFrame=0, _mmFrame=0;
function getRoutePath(){
  _mmFrame++;
  const urgent = mostUrgentOrder();
  const tgt = urgent ? urgent.dropPoint : {x:0,z:0};
  const tgtKey=`${Math.round(tgt.x)},${Math.round(tgt.z)}`;
  if(tgtKey!==_pathTargetKey || _mmFrame-_pathFrame>20){
    _pathTargetKey=tgtKey; _pathFrame=_mmFrame;
    const sn=worldToNode(player.x,player.z);
    const en=worldToNode(tgt.x,tgt.z);
    _pathCache=aStar(sn.c,sn.r,en.c,en.r);
  }
  return {path:_pathCache, tgt};
}

const minimapCnv = document.getElementById('minimap');
const mctx = minimapCnv.getContext('2d');
const MM_W = minimapCnv.width, MM_H = minimapCnv.height, MM_PAD = 6;
function mapX(x){ return MM_PAD + ((x-TOWN_MIN_X)/(TOWN_MAX_X-TOWN_MIN_X))*(MM_W-MM_PAD*2); }
function mapZ(z){ return MM_PAD + (1-(z-TOWN_MIN_Z)/(TOWN_MAX_Z-TOWN_MIN_Z))*(MM_H-MM_PAD*2); }

function drawMinimap(){
  mctx.clearRect(0,0,MM_W,MM_H);

  const GM = {
    land:       '#f2f1ee',
    landSub:    '#e8f5e9',
    landHarbor: '#e3f0f5',
    landOld:    '#f5ede6',
    landInd:    '#eeeeee',
    landLocked: '#d8d4cf',
    block:      '#f2f1ee',
    building:   '#dedad5',
    buildStroke:'#c8c4bd',
    road:       '#ffffff',
    roadStroke: '#d6d3ce',
    roadMinor:  '#ffffff',
    water:      '#aad3df',
    waterStroke:'#8ec6d8',
    park:       '#c8e6c9',
    lock:       'rgba(220,217,212,0.72)',
  };

  mctx.save();
  const R = 10;
  mctx.beginPath();
  mctx.roundRect ? mctx.roundRect(0,0,MM_W,MM_H,R) : mctx.rect(0,0,MM_W,MM_H);
  mctx.clip();

  for(let ix=IX_RANGE[0]; ix<=IX_RANGE[1]; ix++){
    const dist = districtOf(ix);
    const locked = dist!=='downtown' && !state.unlocked[dist];
    let col = locked ? GM.landLocked :
              dist==='suburbs'    ? GM.landSub :
              dist==='harbor'     ? GM.landHarbor :
              dist==='oldtown'    ? GM.landOld :
              dist==='industrial' ? GM.landInd : GM.land;
    const x0 = mapX((ix-0.5)*BLOCK), x1 = mapX((ix+0.5)*BLOCK);
    const z0 = mapZ((IZ_RANGE[1]+0.5)*BLOCK), z1 = mapZ((IZ_RANGE[0]-0.5)*BLOCK);
    mctx.fillStyle = col;
    mctx.fillRect(x0, z0, x1-x0, z1-z0);
  }

  const rHalfPx = Math.max(2, (RIVER_HALF_WIDTH/(TOWN_MAX_X-TOWN_MIN_X))*(MM_W));
  [RIVER_X,-RIVER_X,RIVER_X2,-RIVER_X2].forEach(rx=>{
    const cx = mapX(rx);
    mctx.fillStyle = GM.water;
    mctx.fillRect(cx-rHalfPx, 0, rHalfPx*2, MM_H);
    mctx.strokeStyle = GM.waterStroke; mctx.lineWidth = 0.8;
    mctx.beginPath(); mctx.moveTo(cx-rHalfPx,0); mctx.lineTo(cx-rHalfPx,MM_H); mctx.stroke();
    mctx.beginPath(); mctx.moveTo(cx+rHalfPx,0); mctx.lineTo(cx+rHalfPx,MM_H); mctx.stroke();
  });

  const roadPxW = Math.max(3, (ROAD_W/(TOWN_MAX_X-TOWN_MIN_X))*(MM_W));

  for(let ix=IX_RANGE[0]; ix<=IX_RANGE[1]+1; ix++){
    const cx = mapX((ix-0.5)*BLOCK);
    mctx.fillStyle = GM.roadStroke;
    mctx.fillRect(cx-roadPxW/2-0.8, 0, roadPxW+1.6, MM_H);
    mctx.fillStyle = GM.road;
    mctx.fillRect(cx-roadPxW/2, 0, roadPxW, MM_H);
  }
  for(let iz=IZ_RANGE[0]; iz<=IZ_RANGE[1]+1; iz++){
    const cz = mapZ((iz-0.5)*BLOCK);
    mctx.fillStyle = GM.roadStroke;
    mctx.fillRect(0, cz-roadPxW/2-0.8, MM_W, roadPxW+1.6);
    mctx.fillStyle = GM.road;
    mctx.fillRect(0, cz-roadPxW/2, MM_W, roadPxW);
  }

  for(let i=0;i<buildings.length;i++){
    const b = buildings[i];
    if(b.isShop) continue; // already drawn as its own pin below
    const dist = districtOf(b.ix);
    if(dist!=='downtown' && !state.unlocked[dist]) continue;
    const bx = mapX(b.x), bz = mapZ(b.z);
    const bhx = Math.max(1.2, (b.hx/(TOWN_MAX_X-TOWN_MIN_X))*MM_W);
    const bhz = Math.max(1.2, (b.hz/(TOWN_MAX_Z-TOWN_MIN_Z))*MM_H);
    mctx.fillStyle = GM.building;
    mctx.fillRect(bx-bhx, bz-bhz, bhx*2, bhz*2);
    mctx.strokeStyle = GM.buildStroke; mctx.lineWidth = 0.6;
    mctx.strokeRect(bx-bhx+0.3, bz-bhz+0.3, bhx*2-0.6, bhz*2-0.6);
  }

  for(const [x0,x1,key] of [
    [RIVER_X,RIVER_X2,'suburbs'],[-RIVER_X2,-RIVER_X,'industrial'],
    [RIVER_X2,TOWN_MAX_X,'harbor'],[TOWN_MIN_X,-RIVER_X2,'oldtown']
  ]){
    if(!state.unlocked[key]){
      const mx0=mapX(x0), mx1=mapX(x1);
      mctx.fillStyle = GM.lock;
      mctx.fillRect(mx0, 0, mx1-mx0, MM_H);
      const stripCx=(mx0+mx1)/2, stripCy=MM_H/2;
      mctx.font='11px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
      mctx.fillText('🔒', stripCx, stripCy-7);
      mctx.font='bold 6px "Arial",sans-serif';
      mctx.fillStyle='#888'; mctx.fillText('LOCKED', stripCx, stripCy+6);
    }
  }

  for(let i=0;i<trafficCars.length;i++){
    const c=trafficCars[i];
    let cx,cz;
    if(c.axis==='x'){cx=c.pos;cz=c.cross;}else{cx=c.cross;cz=c.pos;}
    const tx=mapX(cx), tz=mapZ(cz);
    mctx.fillStyle=c.type==='truck'?'#aaa':'#bbb';
    mctx.fillRect(tx-1.5,tz-1,3,2);
  }

  const {path:routePath, tgt:routeTgt} = getRoutePath();
  if(routePath && routePath.length>0){
    const rpx=mapX(player.x), rpz=mapZ(player.z);
    const rtx=mapX(routeTgt.x), rtz=mapZ(routeTgt.z);
    const pts=[[rpx,rpz]];
    for(const n of routePath) pts.push([mapX(nodeX(n.c)),mapZ(nodeZ(n.r))]);
    pts.push([rtx,rtz]);
    mctx.strokeStyle='rgba(255,255,255,0.9)';
    mctx.lineWidth=5; mctx.lineCap='round'; mctx.lineJoin='round';
    mctx.setLineDash([]);
    mctx.beginPath(); mctx.moveTo(pts[0][0],pts[0][1]);
    for(let i=1;i<pts.length;i++) mctx.lineTo(pts[i][0],pts[i][1]);
    mctx.stroke();
    mctx.strokeStyle='#4285f4';
    mctx.lineWidth=3;
    mctx.beginPath(); mctx.moveTo(pts[0][0],pts[0][1]);
    for(let i=1;i<pts.length;i++) mctx.lineTo(pts[i][0],pts[i][1]);
    mctx.stroke();
  }

  const shopMx=mapX(0), shopMz=mapZ(0);
  mctx.fillStyle='#0f9d58';
  mctx.beginPath();
  mctx.arc(shopMx, shopMz-2, 5, 0, Math.PI*2);
  mctx.fill();
  mctx.fillStyle='rgba(0,0,0,0.18)';
  mctx.beginPath();
  mctx.ellipse(shopMx, shopMz+4, 3, 1.2, 0, 0, Math.PI*2);
  mctx.fill();
  mctx.font='6px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
  mctx.fillText('🍕', shopMx, shopMz-2);

  activeFires.forEach(fire=>{
    const fx=mapX(fire.x), fz=mapZ(fire.z);
    mctx.fillStyle='#ff5a1f';
    mctx.beginPath();
    mctx.arc(fx, fz-2, 4.5, 0, Math.PI*2);
    mctx.fill();
    mctx.font='6px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
    mctx.fillText('🔥', fx, fz-2);
  });

  activeEmergencies.forEach(e=>{
    const ex=mapX(e.x), ez=mapZ(e.z);
    mctx.fillStyle='#3d96ff';
    mctx.beginPath();
    mctx.arc(ex, ez-2, 4.5, 0, Math.PI*2);
    mctx.fill();
    mctx.font='6px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
    mctx.fillText('🚨', ex, ez-2);
  });

  if(wantedState.active && wantedState.chaser){
    const cx2=mapX(wantedState.chaser.x), cz2=mapZ(wantedState.chaser.z);
    mctx.fillStyle='#ff3d3d';
    mctx.beginPath();
    mctx.arc(cx2, cz2-2, 4.5, 0, Math.PI*2);
    mctx.fill();
    mctx.font='6px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
    mctx.fillText('🚓', cx2, cz2-2);
  }

  if(crimeState.active && crimeState.getaway){
    const gx2=mapX(crimeState.getaway.x), gz2=mapZ(crimeState.getaway.z);
    mctx.fillStyle='#ffc43d';
    mctx.beginPath();
    mctx.arc(gx2, gz2-2, 4.5, 0, Math.PI*2);
    mctx.fill();
    mctx.font='6px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
    mctx.fillText('🏎️', gx2, gz2-2);
  }

  state.orders.forEach(order=>{
    const dpx=mapX(order.dropPoint.x), dpz=mapZ(order.dropPoint.z);
    const isUrgent = order===mostUrgentOrder();
    mctx.fillStyle='#ea4335';
    mctx.beginPath();
    mctx.arc(dpx, dpz-2, isUrgent?5:4, 0, Math.PI*2);
    mctx.fill();
    mctx.fillStyle='rgba(0,0,0,0.18)';
    mctx.beginPath();
    mctx.ellipse(dpx, dpz+4, 3, 1.2, 0, 0, Math.PI*2);
    mctx.fill();
    mctx.fillStyle='#fff'; mctx.font='6px sans-serif'; mctx.textAlign='center'; mctx.textBaseline='middle';
    mctx.fillText('🏠', dpx, dpz-2);
    if(isUrgent){
      mctx.strokeStyle='rgba(234,67,53,0.45)'; mctx.lineWidth=1.5;
      mctx.beginPath(); mctx.arc(dpx,dpz-2,7+Math.sin(Date.now()*0.004)*1.5,0,Math.PI*2); mctx.stroke();
    }
  });

  if(rival.mesh){
    const rx=mapX(rival.x), rz=mapZ(rival.z);
    mctx.fillStyle='#8a5a9c';
    mctx.beginPath(); mctx.arc(rx,rz,4.5,0,Math.PI*2); mctx.fill();
    mctx.strokeStyle='#fff'; mctx.lineWidth=1; mctx.stroke();
  }

  const px=mapX(player.x), pz=mapZ(player.z);
  mctx.fillStyle='rgba(66,133,244,0.15)';
  mctx.beginPath(); mctx.arc(px,pz,14,0,Math.PI*2); mctx.fill();
  mctx.fillStyle='#fff';
  mctx.beginPath(); mctx.arc(px,pz,6.5,0,Math.PI*2); mctx.fill();
  mctx.fillStyle='#4285f4';
  mctx.beginPath(); mctx.arc(px,pz,5,0,Math.PI*2); mctx.fill();
  const fwdX = Math.sin(player.angle);
  const fwdY = -Math.cos(player.angle);
  mctx.save();
  mctx.translate(px, pz);
  mctx.fillStyle = 'rgba(66,133,244,0.82)';
  mctx.strokeStyle = '#fff';
  mctx.lineWidth = 0.8;
  mctx.beginPath();
  const coneAngle = Math.atan2(fwdX, -fwdY);
  mctx.save();
  mctx.translate(px, pz);
  mctx.rotate(coneAngle);
  mctx.beginPath();
  mctx.moveTo(0, -14);
  mctx.lineTo( 6, -3);
  mctx.lineTo( 0, -6);
  mctx.lineTo(-6, -3);
  mctx.closePath();
  mctx.fill(); mctx.stroke();
  mctx.restore();

  mctx.restore();

  mctx.font = 'bold 7px "Arial",sans-serif';
  mctx.textAlign = 'center'; mctx.textBaseline = 'top';
  const labelDefs=[
    [-RIVER_X,RIVER_X,'DOWNTOWN',null,true],
    [RIVER_X,RIVER_X2,'SUBURBS','suburbs',false],
    [-RIVER_X2,-RIVER_X,'INDUSTRIAL','industrial',false],
    [RIVER_X2,TOWN_MAX_X,'HARBOR','harbor',false],
    [TOWN_MIN_X,-RIVER_X2,'OLD TOWN','oldtown',false]
  ];
  labelDefs.forEach(([x0,x1,label,key])=>{
    if(key && !state.unlocked[key]) return;
    const lx=(mapX(x0)+mapX(x1))/2;
    mctx.fillStyle='rgba(255,255,255,0.88)';
    const tw=mctx.measureText(label).width;
    mctx.fillRect(lx-tw/2-2, 3, tw+4, 11);
    mctx.fillStyle='#666';
    mctx.fillText(label, lx, 4);
  });

  mctx.strokeStyle='rgba(0,0,0,0.18)'; mctx.lineWidth=1;
  mctx.strokeRect(0.5,0.5,MM_W-1,MM_H-1);
}

function updateHUD(){
  document.getElementById('money-text').textContent = '$'+state.money.toFixed(2);
  document.getElementById('speed-num').textContent = Math.round(Math.abs(player.speed)*3.4);
  document.getElementById('rival-you').textContent = rivalRound.playerCount;
  document.getElementById('rival-them').textContent = rivalRound.rivalCount;
  document.getElementById('rival-timer-fill').style.width = Math.max(0, (rivalRound.timer/rivalRound.duration)*100)+'%';
  if(stormState.active) document.getElementById('storm-timer').textContent = Math.ceil(stormState.timer);
  if(zombieState.active) document.getElementById('zombie-timer').textContent = Math.ceil(zombieState.timer);
  document.getElementById('fire-panel').style.display = activeFires.length>0 ? 'block' : 'none';
  if(activeFires.length>0) document.getElementById('fire-count').textContent = activeFires.length;
  document.getElementById('ems-panel').style.display = activeEmergencies.length>0 ? 'block' : 'none';
  if(activeEmergencies.length>0) document.getElementById('ems-count').textContent = activeEmergencies.length;
  document.getElementById('police-panel').style.display = wantedState.active ? 'block' : 'none';
  if(wantedState.active) document.getElementById('police-timer').textContent = Math.ceil(wantedState.timer);
  drawMinimap();
}

function animate(){
  requestAnimationFrame(animate);
  const dt = Math.min(0.033, clock.getDelta());
  if(state.running) update(dt);
  renderer.render(scene, camera);
}

const upgradeMeta = {
  engine:{ name:'⚙️ Engine Tune', desc:'Higher top speed & acceleration' },
  handling:{ name:'🛞 Handling Kit', desc:'Sharper turns & less crash damage' },
  insulation:{ name:'🧊 Insulated Bag', desc:'Pizzas stay hot much longer' }
};

function renderShop(){
  document.getElementById('shop-money').textContent = '$'+state.money.toFixed(2);

  const stats = baseStats();
  const readout = document.getElementById('stat-readout');
  readout.innerHTML = `
    <div class="stat-chip"><div class="v">${Math.round(stats.maxSpeed*3.4)}</div><div class="l">Top MPH</div></div>
    <div class="stat-chip"><div class="v">${state.upgrades.handling.level}/${state.upgrades.handling.max}</div><div class="l">Handling</div></div>
    <div class="stat-chip"><div class="v">${Math.round((1-stats.armor)*100)}%</div><div class="l">Armor</div></div>
    <div class="stat-chip"><div class="v">${Math.round(state.upgrades.insulation.level*22)}%</div><div class="l">Insulated</div></div>`;

  const list = document.getElementById('shop-list');
  list.innerHTML = '';
  Object.keys(state.upgrades).forEach(key=>{
    const u = state.upgrades[key];
    const meta = upgradeMeta[key];
    const maxed = u.level>=u.max;
    const cost = maxed?0:u.cost[u.level];
    const row = document.createElement('div');
    row.className = 'shop-row';
    const segs = Array.from({length:u.max}).map((_,i)=>`<div class="gauge-seg ${i<u.level?'on':''}"></div>`).join('');
    row.innerHTML = `
      <div class="shop-info">
        <div class="shop-name">${meta.name}</div>
        <div class="shop-desc">${meta.desc}</div>
        <div class="gauge-row">${segs}</div>
      </div>
      <button class="btn ${maxed?'':'basil'}" ${maxed||state.money<cost?'disabled':''} data-key="${key}">
        ${maxed?'MAXED':'$'+cost}
      </button>`;
    list.appendChild(row);
  });
  list.querySelectorAll('button[data-key]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.getAttribute('data-key');
      const u = state.upgrades[key];
      const cost = u.cost[u.level];
      if(state.money>=cost && u.level<u.max){
        state.money -= cost;
        u.level++;
        saveProgress();
        toast(upgradeMeta[key].name+' upgraded!', 'good');
        renderShop();
        updateHUD();
      }
    });
  });
}

function renderVehicles(){
  document.getElementById('shop-money').textContent = '$'+state.money.toFixed(2);
  const list = document.getElementById('vehicle-list');
  list.innerHTML = '';
  Object.keys(vehicleDefs).forEach(key=>{
    const v = vehicleDefs[key];
    const owned = state.ownedVehicles[key];
    const selected = state.currentVehicle===key;
    const armorPct = Math.round((1-v.armor)*100);
    const desc = `Top ${Math.round(v.maxSpeed*3.4)} mph &middot; Handling ${v.turnRate.toFixed(1)} &middot; Armor ${armorPct>=0?'+':''}${armorPct}%`;
    const row = document.createElement('div');
    row.className = 'shop-row';
    let btnHtml;
    if(selected){
      btnHtml = `<button class="btn" disabled>IN USE</button>`;
    } else if(owned){
      btnHtml = `<button class="btn basil" data-select="${key}">SELECT</button>`;
    } else {
      const affordable = state.money>=v.cost;
      btnHtml = `<button class="btn ${affordable?'basil':''}" ${affordable?'':'disabled'} data-buy="${key}">$${v.cost}</button>`;
    }
    row.innerHTML = `
      <div class="shop-info">
        <div class="shop-name">${v.name}</div>
        <div class="shop-desc">${desc}</div>
      </div>
      ${btnHtml}`;
    list.appendChild(row);
  });
  list.querySelectorAll('button[data-buy]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.getAttribute('data-buy');
      const v = vehicleDefs[key];
      if(state.money>=v.cost){
        state.money -= v.cost;
        state.ownedVehicles[key] = true;
        state.currentVehicle = key;
        applyVehicleMesh(key);
        saveProgress();
        toast(v.name+' purchased — enjoy the ride!', 'good');
        renderVehicles(); renderShop(); updateHUD();
      }
    });
  });
  list.querySelectorAll('button[data-select]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.getAttribute('data-select');
      state.currentVehicle = key;
      applyVehicleMesh(key);
      saveProgress();
      toast('Switched to '+vehicleDefs[key].name, 'good');
      renderVehicles(); renderShop();
    });
  });
}

function renderDecals(){
  const list = document.getElementById('decal-list');
  list.innerHTML = '';
  const grid = document.createElement('div');
  grid.className = 'decal-grid';
  DECAL_DEFS.forEach(d=>{
    const swatch = document.createElement('div');
    swatch.className = 'decal-swatch' + (state.decal===d.id ? ' selected' : '');
    swatch.innerHTML = `<div class="dv">${d.id==='none'?'🚫':'🎨'}</div>${d.name}`;
    swatch.addEventListener('click', ()=>{
      applyDecal(d.id);
      toast(d.id==='none' ? 'Decal removed' : d.name+' applied!', 'good');
      renderDecals();
    });
    grid.appendChild(swatch);
  });
  list.appendChild(grid);
}

document.getElementById('shop-btn').addEventListener('click', ()=>{
  state.paused = true;
  renderVehicles();
  renderDecals();
  renderShop();
  document.getElementById('shop-overlay').classList.remove('hidden');
});
document.getElementById('shop-close').addEventListener('click', ()=>{
  document.getElementById('shop-overlay').classList.add('hidden');
  state.paused = false;
});

function renderDistrictsShop(){
  document.getElementById('districts-money').textContent = '$'+state.money.toFixed(2);
  const list = document.getElementById('districts-list');
  list.innerHTML = '';
  Object.keys(districtShopConfig).forEach(key=>{
    const cfg = districtShopConfig[key];
    const owned = state.unlocked[key];
    const reqOk = !cfg.requires || state.unlocked[cfg.requires];
    const affordable = state.money >= cfg.cost;
    const row = document.createElement('div');
    row.className = 'shop-row';
    let desc, btnHtml;
    if(owned){
      desc = 'Owned';
      btnHtml = `<button class="btn" disabled>OWNED</button>`;
    } else if(!reqOk){
      desc = 'Must own '+districtShopConfig[cfg.requires].label.replace(/^\S+\s/,'')+' first';
      btnHtml = `<button class="btn" disabled>LOCKED</button>`;
    } else {
      desc = 'Adjacent to a district you own';
      btnHtml = `<button class="btn ${affordable?'basil':''}" ${affordable?'':'disabled'} data-key="${key}">$${cfg.cost}</button>`;
    }
    row.innerHTML = `
      <div class="shop-info">
        <div class="shop-name">${cfg.label}</div>
        <div class="shop-desc">${desc}</div>
      </div>
      ${btnHtml}`;
    list.appendChild(row);
  });
  list.querySelectorAll('button[data-key]').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const key = btn.getAttribute('data-key');
      const cfg = districtShopConfig[key];
      if(state.money>=cfg.cost && !state.unlocked[key]){
        state.money -= cfg.cost;
        unlockDistrict(key);
        saveProgress();
        renderDistrictsShop();
        updateHUD();
      }
    });
  });
}

document.getElementById('districts-btn').addEventListener('click', ()=>{
  state.paused = true;
  renderDistrictsShop();
  document.getElementById('districts-overlay').classList.remove('hidden');
});
document.getElementById('districts-close').addEventListener('click', ()=>{
  document.getElementById('districts-overlay').classList.add('hidden');
  state.paused = false;
});

const STORM_COST = 60;
document.getElementById('storm-btn').addEventListener('click', ()=>{
  if(stormState.active){ toast('A storm is already raging!', 'bad'); return; }
  if(zombieState.active){ toast('Deal with the apocalypse first!', 'bad'); return; }
  if(stormState.cooldownTimer>0){ toast('Storm system recharging — '+Math.ceil(stormState.cooldownTimer)+'s left', 'bad'); return; }
  if(state.money < STORM_COST){ toast('Need $'+STORM_COST.toFixed(2)+' to call in a storm', 'bad'); return; }
  state.money -= STORM_COST;
  startStorm();
});

const ZOMBIE_COST = 80;
document.getElementById('zombie-btn').addEventListener('click', ()=>{
  if(zombieState.active){ toast('The dead are already loose!', 'bad'); return; }
  if(stormState.active){ toast('Wait for the storm to clear first!', 'bad'); return; }
  if(zombieState.cooldownTimer>0){ toast('The graveyard is quiet for now — '+Math.ceil(zombieState.cooldownTimer)+'s left', 'bad'); return; }
  if(state.money < ZOMBIE_COST){ toast('Need $'+ZOMBIE_COST.toFixed(2)+' to raise the dead', 'bad'); return; }
  state.money -= ZOMBIE_COST;
  startApocalypse();
});

document.getElementById('start-btn').addEventListener('click', ()=>{
  document.getElementById('start-overlay').classList.add('hidden');
  state.running = true;
  // Fade the control hint out once the player's had a chance to read it,
  // instead of leaving it on screen for the whole session.
  setTimeout(()=>{ document.getElementById('hint').classList.add('faded'); }, 9000);
});

document.getElementById('newgame-btn').addEventListener('click', async ()=>{
  if(!confirm('Delete your saved progress and start fresh?')) return;
  if(window.storage) try{ await window.storage.delete(SAVE_KEY); }catch(e){}
  location.reload();
});

async function boot(){
  let hasSave = false;
  if(window.storage){
    try{
      const res = await window.storage.get(SAVE_KEY);
      if(res && res.value){
        const sv = JSON.parse(res.value);
        if(sv.money        != null) state.money        = sv.money;
        if(sv.deliveries   != null) state.deliveries   = sv.deliveries;
        if(sv.unlocked)  Object.keys(sv.unlocked).forEach(k=>{ if(sv.unlocked[k]) state.unlocked[k] = true; });
        if(sv.upgrades){
          ['engine','handling','insulation'].forEach(k=>{
            if(sv.upgrades[k] != null)
              state.upgrades[k].level = Math.min(state.upgrades[k].max, sv.upgrades[k]);
          });
        }
        if(sv.ownedVehicles) Object.assign(state.ownedVehicles, sv.ownedVehicles);
        if(sv.currentVehicle && state.ownedVehicles[sv.currentVehicle])
          state.currentVehicle = sv.currentVehicle;
        if(sv.decal) state.decal = sv.decal;
        hasSave = true;
      }
    } catch(e){}
  }

  const saveEl = document.getElementById('save-status');
  const newBtn = document.getElementById('newgame-btn');
  if(hasSave){
    saveEl.textContent = '💾 Save found — $'+state.money.toFixed(2)+' · '+state.deliveries+' deliveries';
    newBtn.style.display = 'inline-block';
  } else {
    saveEl.textContent = 'No save found — starting fresh.';
  }

  buildTown();
  // Displace the ground now that every building (and the shop's driveway)
  // is registered, so flattened pads under buildings and the driveway
  // line up correctly with the terrain.
  applyTerrainDisplacement();
  buildTraffic();
  spawnPedestrians();
  buildRiverCrossing(RIVER_X, BRIDGE_Z, 'suburbs');
  buildRiverCrossing(-RIVER_X, BRIDGE_Z, 'industrial');
  buildRiverCrossing(RIVER_X2, BRIDGE_Z, 'harbor');
  buildRiverCrossing(-RIVER_X2, BRIDGE_Z, 'oldtown');
  gateSuburbs    = buildLockGate(RIVER_X,  BRIDGE_Z, 'suburbs',    'Suburbs — buy in city map');
  gateIndustrial = buildLockGate(-RIVER_X, BRIDGE_Z, 'industrial', 'Industrial — buy in city map');
  gateHarbor     = buildLockGate(RIVER_X2, BRIDGE_Z, 'harbor',     'Harbor — buy in city map');
  gateOldtown    = buildLockGate(-RIVER_X2,BRIDGE_Z, 'oldtown',    'Old Town — buy in city map');
  buildCityPerimeterWall();

  Object.keys(state.unlocked).forEach(key=>{
    if(state.unlocked[key]){
      const gate = {suburbs:()=>gateSuburbs, industrial:()=>gateIndustrial, harbor:()=>gateHarbor, oldtown:()=>gateOldtown}[key];
      if(gate){ const g=gate(); if(g) scene.remove(g.mesh, g.sprite); }
      removeCrossing(key);
    }
  });

  applyVehicleMesh(state.currentVehicle);
  spawnRival();
  spawnFireTrucks();
  spawnAmbulances();
  spawnPatrolCars();
  spawnNewsHeli();
  spawnRescueHeli();
  buildRain();

  updateDamageUI();
  updateHUD();
  animate();
}
boot();

})();
</script>
