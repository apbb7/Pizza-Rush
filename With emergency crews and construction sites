function buildHouse(x,z,hx,hz,height,color){
  const g=new THREE.Group(); g.position.set(x,terrainHeightAt(x,z),z);
  const wallM=texMat('house',color,hx,height);
  const foundM=solidMat(0xb0aa9c,0.9);
  const trimM=solidMat(0xf5f0e8,0.7);
  const darkM=solidMat(0x1e2028,0.6);
  mkRoundedBox(g,0,0,0,hx*2+0.6,0.55,hz*2+0.6,foundM);
  mkBox(g,0,0.55,0,hx*2,height,hz*2,wallM);
  [[hx,0],[-hx,0],[0,hz],[0,-hz]].forEach(([cx,cz])=>{
    const isX=Math.abs(cx)>Math.abs(cz);
    const tw=0.22,th=height;
    mkBox(g,cx,0.55,cz,isX?tw:hx*2+0.1,th,isX?hz*2+0.1:tw,trimM);
  });
  mkRoundedBox(g,0,0.55+height,0,hx*2+0.3,0.3,hz*2+0.3,trimM);
  const ridgeAlongZ=Math.random()<0.5;
  const halfW=(ridgeAlongZ?hx:hz)+0.4;
  const halfLen=(ridgeAlongZ?hz:hx)+0.4;
  const rH=2.2+Math.random()*1.0;
  const shingleColor=roofShingleColors[Math.floor(Math.random()*roofShingleColors.length)];
  const rfM=solidMat(shingleColor,0.88);
  const shape=new THREE.Shape();
  shape.moveTo(-halfW,0); shape.lineTo(0,rH); shape.lineTo(halfW,0); shape.lineTo(-halfW,0);
  // Small bevel rounds off the sharp ridge and eave lines instead of a
  // knife-edge extrusion — cheap since it's one mesh per roof either way.
  const rGeo=new THREE.ExtrudeGeometry(shape,{depth:halfLen*2,bevelEnabled:true,bevelThickness:0.12,bevelSize:0.1,bevelSegments:1});
  rGeo.translate(0,0,-halfLen);
  if(!ridgeAlongZ) rGeo.rotateY(Math.PI/2);
  const rMesh=new THREE.Mesh(rGeo,rfM);
  rMesh.position.set(0,0.55+height,0);
  rMesh.castShadow=true; rMesh.receiveShadow=true;
  g.add(rMesh);
  const gutM=solidMat(0x7a8080,0.6,0.2);
  const gW=hx*2+0.6, gD=hz*2+0.6;
  [[0, hz+0.3],[0,-(hz+0.3)]].forEach(([gx,gz])=>{
    mkBox(g,gx,0.55+height,gz,gW,0.2,0.25,gutM);
  });
  [[hx+0.3,0],[-(hx+0.3),0]].forEach(([gx,gz])=>{
    mkBox(g,gx,0.55+height,gz,0.25,0.2,gD,gutM);
  });
  const porchW=Math.min(hx*1.1,4.5), porchD=2.0, porchH=Math.min(2.8,height*0.55);
  mkRoundedBox(g,0,0.55,hz+porchD/2,porchW*2,0.22,porchD,foundM);
  mkRoundedBox(g,0,0.55+porchH,hz+porchD/2,porchW*2+0.3,0.18,porchD+0.3,trimM);
  const colM=solidMat(0xf5f0e8,0.7);
  [-porchW*0.6,porchW*0.6].forEach(cpx=>{
    mkCyl(g,cpx,0.55,hz+porchD*0.9,0.18,0.2,porchH,10,colM);
    mkRoundedBox(g,cpx,0.55,hz+porchD*0.9,0.45,0.2,0.45,colM);
    mkRoundedBox(g,cpx,0.55+porchH-0.2,hz+porchD*0.9,0.45,0.2,0.45,colM);
  });
  mkBox(g,0,0.55+0.9,hz+porchD,porchW*2,0.06,0.06,trimM);
  for(let rp=-porchW*0.85;rp<=porchW*0.85;rp+=0.7){
    mkBox(g,rp,0.55,hz+porchD,0.06,0.95,0.06,trimM);
  }
  [0,1,2].forEach(i=>{
    mkBox(g,0,(2-i)*0.22,hz+porchD+0.2+i*0.25,porchW*1.8-i*0.3,0.22,0.35,foundM);
  });
  mkBox(g,0,0.55,hz+0.06,1.1,2.4,0.15,darkM);
  const chM=solidMat(0x8c3f33,0.9);
  const chX=(Math.random()<0.5?1:-1)*hx*0.5;
  mkBox(g,chX,0,0,1.0,height+rH*0.75,1.0,chM);
  mkRoundedBox(g,chX,height+rH*0.75,0,1.2,0.5,1.2,solidMat(0x6a2e28,0.9));
  if(Math.random()<0.4){
    const garW=4.5, garH=height*0.6, garD=4.2;
    const garX=(Math.random()<0.5?1:-1)*(hx+garW/2+0.1);
    mkBox(g,garX,0.55,0,garW,garH,garD*2,wallM);
    mkBox(g,garX,0.55+garH-1.5,0+garD*0.5,garW*0.85,1.8,0.15,darkM);
    mkRoundedBox(g,garX,0.55+garH,0,garW+0.3,0.35,garD*2+0.3,solidMat(shingleColor,0.88));
  }
  addGroup(g);
}

function buildWarehouse(x,z,hx,hz,height,color){
  const g=new THREE.Group(); g.position.set(x,terrainHeightAt(x,z),z);
  const wallM=texMat('industrial',color,hx,height);
  const conM=solidMat(0x9aa0a8,0.9);
  const dkM=solidMat(0x22242a,0.5);
  const steelM=solidMat(0x7a8088,0.5,0.3);
  mkBox(g,0,0,0,hx*2,height,hz*2,wallM);
  for(let b=2;b<height-0.5;b+=5.5){ // PERF FIX: fewer corrugation bands
    mkBox(g,0,b,0,hx*2+0.1,0.12,hz*2+0.1,steelM);
  }
  const dockW=Math.min(hx*1.2,8), dockH=2.0, dockD=2.5, rampL=3.5;
  mkRoundedBox(g,0,0,hz-dockD/2,dockW,dockH,dockD,conM);
  mkBox(g,0,dockH/2,hz+0.05,dockW*0.75,dockH,0.18,dkM);
  [-dockW*0.3,dockW*0.3].forEach(bx=>{
    mkBox(g,bx,dockH*0.4,hz,0.3,dockH*0.5,0.4,solidMat(0x2a2a2a,0.6));
  });
  const rampGeo=new THREE.BoxGeometry(dockW*0.7,0.2,rampL);
  const rampMesh=new THREE.Mesh(rampGeo,conM);
  rampMesh.rotation.x=Math.atan2(dockH,rampL);
  rampMesh.position.set(0,dockH/2,hz+dockD/2+rampL*0.45);
  rampMesh.castShadow=true; g.add(rampMesh);
  const winM=solidMat(0x223344,0.3,0.1);
  for(let wh=height*0.55;wh<height-1.5;wh+=3.5){
    mkBox(g,-hx-0.05,wh,0,0.25,2.2,hz*1.2,winM);
    mkBox(g, hx+0.05,wh,0,0.25,2.2,hz*1.2,winM);
  }
  const teeth=Math.max(2,Math.floor(hx/4));
  const toothW=(hx*2)/teeth;
  const rfM=solidMat(0x7a8088,0.7,0.2);
  const skyM=solidMat(0x223344,0.3,0.1);
  for(let t=0;t<teeth;t++){
    const tx=-hx+t*toothW+toothW/2;
    const toothH=Math.min(2.8,height*0.22);
    const sShape=new THREE.Shape();
    sShape.moveTo(-toothW/2,0); sShape.lineTo(toothW/2,toothH); sShape.lineTo(toothW/2,0); sShape.lineTo(-toothW/2,0);
    const sGeo=new THREE.ExtrudeGeometry(sShape,{depth:hz*2-0.4,bevelEnabled:true,bevelThickness:0.1,bevelSize:0.08,bevelSegments:1});
    sGeo.translate(0,0,-hz+0.2);
    const sMesh=new THREE.Mesh(sGeo,rfM);
    sMesh.position.set(tx,height,0);
    sMesh.castShadow=true; g.add(sMesh);
    mkBox(g,tx+toothW/2-0.12,height+toothH/2,0,0.25,toothH,hz*1.8,skyM);
  }
  const stackM=solidMat(0x5a5e62,0.7,0.2);
  [[hx*0.6,0],[hx*0.6,hz*0.5]].forEach(([sx,sz])=>{
    const sh=4+Math.random()*3;
    mkCyl(g,sx,height,sz,0.35,0.4,sh,10,stackM);
    mkCyl(g,sx,height+sh,sz,0.55,0.3,0.4,10,stackM);
  });
  const escM=solidMat(0x6a6e72,0.6,0.3);
  let ey=0;
  while(ey<height-3){
    const nextY=Math.min(ey+4,height);
    const side=ey%8<4?1:-1;
    mkBox(g,-(hx+0.6),ey+(nextY-ey)/2,side*hz*0.4,0.1,nextY-ey,1.8,escM);
    mkBox(g,-(hx+0.6),nextY,side*hz*0.4,0.1,0.12,1.8,escM);
    ey=nextY;
  }
  addGroup(g);
}

function buildHarborBuilding(x,z,hx,hz,height,color){
  const g=new THREE.Group(); g.position.set(x,terrainHeightAt(x,z),z);
  const wallM=texMat('industrial',color,hx,height);
  const metalM=solidMat(0x7a8488,0.5,0.3);
  const conM=solidMat(0xb0b4b8,0.85);
  mkBox(g,0,0,0,hx*2,height,hz*2,wallM);
  const rfM=solidMat(0x4a5055,0.7,0.2);
  const lowerH=height*0.25, upperH=height*0.2;
  const midW=hx*0.55;
  const slopeGeo=(w1,w2,sh,len)=>{
    const sh2=new THREE.Shape();
    sh2.moveTo(-w1,0); sh2.lineTo(-w2,sh); sh2.lineTo(w2,sh); sh2.lineTo(w1,0); sh2.lineTo(-w1,0);
    return new THREE.ExtrudeGeometry(sh2,{depth:len*2,bevelEnabled:true,bevelThickness:0.1,bevelSize:0.08,bevelSegments:1});
  };
  const sg=slopeGeo(hx,midW,lowerH,hz); sg.translate(0,0,-hz);
  const sm=new THREE.Mesh(sg,rfM); sm.position.set(0,height,0); sm.castShadow=true; g.add(sm);
  const sg2=slopeGeo(midW,midW*0.1,upperH,hz); sg2.translate(0,0,-hz);
  const sm2=new THREE.Mesh(sg2,rfM); sm2.position.set(0,height+lowerH,0); sm2.castShadow=true; g.add(sm2);
  [[0,hz+0.05,Math.min(hx*1.3,8),Math.min(height*0.55,5)]].forEach(([dx,dz,dw,dh])=>{
    mkBox(g,dx,0,dz,dw,dh,0.2,solidMat(0x3a3c42,0.6));
    mkRoundedBox(g,dx,dh/2,dz,dw+0.5,0.3,0.3,metalM);
    [-dw/2,dw/2].forEach(fx=>mkBox(g,dx+fx,dh/2,dz,0.3,dh,0.3,metalM));
  });
  const craneM=solidMat(0xe8b020,0.5,0.3);
  const cH=height+4;
  mkCyl(g,hx*0.7,0,hz*0.7,0.3,0.35,cH,10,craneM);
  mkBox(g,hx*0.7-2,cH,hz*0.7,4,0.3,0.3,craneM);
  mkBox(g,hx*0.7-4.1,cH-2,hz*0.7,0.2,2,0.2,metalM);
  for(let mz=-hz+2;mz<hz;mz+=3){
    mkBox(g,hx+0.25,0.3,mz,0.5,0.35,0.7,metalM);
  }
  [[0,hz],[0,-hz],[hx,0],[-hx,0]].forEach(([tx,tz])=>{
    const isX=Math.abs(tx)>Math.abs(tz);
    mkBox(g,tx,height*0.5,tz,isX?0.15:hx*2+0.2,height*0.9,isX?hz*2+0.2:0.15,metalM);
  });
  addGroup(g);
}

function buildOldtownBuilding(x,z,hx,hz,height,color){
  const g=new THREE.Group(); g.position.set(x,terrainHeightAt(x,z),z);
  const brickM=texMat('house',color,hx,height);
  const stoneM=solidMat(new THREE.Color(color).lerp(new THREE.Color(0xc8c0b0),0.45).getHex(),0.85);
  const darkM=solidMat(0x1a1c20,0.5);
  const trimM=solidMat(0xd8d0bc,0.8);
  mkBox(g,0,0,0,hx*2,height,hz*2,brickM);
  const baseH=Math.min(5, height*0.3);
  mkRoundedBox(g,0,0,0,hx*2+0.05,baseH,hz*2+0.05,stoneM);
  mkRoundedBox(g,0,baseH,0,hx*2+0.4,0.45,hz*2+0.4,trimM);
  mkRoundedBox(g,0,height,0,hx*2+0.9,0.55,hz*2+0.9,trimM);
  mkRoundedBox(g,0,height+0.55,0,hx*2+0.6,0.4,hz*2+0.6,trimM);
  mkRoundedBox(g,0,height+0.95,0,hx*2+0.35,0.3,hz*2+0.35,trimM);
  const parH=1.8;
  mkBox(g,0,height+1.25,0,hx*2+0.6,parH,hz*2+0.6,brickM);
  const bW=1.2, bGap=0.8;
  for(let bx=-hx+0.6;bx<hx-0.3;bx+=bW+bGap){
    mkBox(g,bx,height+1.25+parH*0.45,hz+0.35,bW,parH*0.55,0.7,darkM);
  }
  const winH=Math.min(2.8,height*0.22), winW=Math.min(1.4,hx*0.55);
  // PERF FIX: window count used to scale with building width (up to 20+ per
  // floor, 5 meshes each — 600+ meshes on a single wide old-town building).
  // Capped the count, skip every other floor, and merged the stone surround
  // (lintel + 2 jambs + keystone) into a single frame box.
  const wCount=Math.max(1,Math.min(4,Math.round(hx*1.5/5)));
  const wSpacing=hx*2/(wCount+1);
  for(let floor=1;floor<Math.floor(height/3)-1;floor+=2){
    const wy=baseH+floor*3+0.3;
    for(let w=1;w<=wCount;w++){
      const wx=-hx+w*wSpacing;
      mkBox(g,wx,wy,hz+0.06,winW,winH,0.3,darkM);
      mkBox(g,wx,wy+winH/2+0.15,hz+0.25,winW+0.5,0.35,0.18,stoneM);
    }
  }
  const sfH=baseH*0.85, sfW=Math.min(hx*1.5,5.5);
  mkBox(g,0,0,hz+0.06,sfW,sfH,0.35,darkM);
  mkRoundedBox(g,0,sfH,hz+0.22,sfW+0.5,0.5,0.5,stoneM);
  mkBox(g,0,0,hz+0.5,1.0,sfH*0.8,0.5,darkM);
  [0,1].forEach(i=>mkBox(g,0,(1-i)*0.22,hz+0.6+i*0.2,1.4-i*0.2,0.22,0.3,stoneM));
  const qM=solidMat(0xd0c8b4,0.82);
  for(let qy=0;qy<height-1;qy+=4.5){
    const big=qy%3<1.5;
    mkBox(g, hx+0.05,qy, hz*0.5, big?0.35:0.2, big?0.6:0.45, big?0.45:0.3, qM);
    mkBox(g,-hx-0.05,qy, hz*0.5, big?0.35:0.2, big?0.6:0.45, big?0.45:0.3, qM);
  }
  addGroup(g);
}

function addBuildingMesh(x,z,hx,hz,height,color,roofStyle,wallStyle){
  if(wallStyle==='house')          buildHouse(x,z,hx,hz,height,color);
  else if(wallStyle==='harbor')    buildHarborBuilding(x,z,hx,hz,height,color);
  else if(wallStyle==='oldtown')   buildOldtownBuilding(x,z,hx,hz,height,color);
  else if(wallStyle==='industrial')buildWarehouse(x,z,hx,hz,height,color);
  else{
    if(height>30) buildTower(x,z,hx,hz,height,color);
    else          buildMidrise(x,z,hx,hz,height,color);
  }
  return null;
}

function makeShopBuilding(x,z){
  const hx=11, hz=11, h=9;
  addBuildingMesh(x,z,hx,hz,h,0xc23123,'flat','glass');
  addCurb(x,z);
  const driveway = buildDriveway(x,z,hx,hz);
  const awnGeo = new THREE.BoxGeometry(hx*2+1.4, 0.5, 2.6);
  const awnMat = new THREE.MeshStandardMaterial({ color:0xf4c24d });
  const awn = new THREE.Mesh(awnGeo, awnMat);
  awn.position.set(x, 4.2, z+hz+0.8);
  scene.add(awn);
  // Beacon now marks the driveway pickup spot itself, not the building —
  // that's where the player actually needs to stop to grab the order.
  scene.add(makeBeacon(driveway.x, driveway.z, 0x3e8e5b, '🍕', 0));
  return { x,z,hx,hz,height:h, name:"Tony's Pizza", isShop:true, driveway };
}

function buildDriveway(x,z,hx,hz){
  const driveWidth = 7;
  const startX = x - hx;
  const endX = x - (BLOCK_HALF + SIDEWALK_W + 3);
  const len = startX - endX;
  const mat = new THREE.MeshStandardMaterial({ color:0xb7b0a0, roughness:0.95 });
  const drive = new THREE.Mesh(new THREE.BoxGeometry(len, 0.06, driveWidth), mat);
  drive.position.set((startX+endX)/2, 0.19, z);
  drive.receiveShadow = true;
  scene.add(drive);
  const jointMat = new THREE.MeshStandardMaterial({ color:0x8d8674, roughness:1 });
  const joints = 4;
  for(let i=1;i<joints;i++){
    const jx = endX + (len/joints)*i;
    const joint = new THREE.Mesh(new THREE.BoxGeometry(0.08,0.07,driveWidth-0.4), jointMat);
    joint.position.set(jx, 0.2, z);
    scene.add(joint);
  }
  const zone = { x:(startX+endX)/2, z, hx:len/2, hz:driveWidth/2 };
  drivewayZones.push(zone);
  return zone;
}

function addCurb(cx,cz){
  const half = BLOCK_HALF + SIDEWALK_W;
  const curbMat = new THREE.MeshStandardMaterial({ color:0xb9b3a0, roughness:0.9 });
  const t = 0.18, hgt = 0.16;
  const specs = [
    [cx, cz-half, half*2, t],
    [cx, cz+half, half*2, t],
    [cx-half, cz, t, half*2],
    [cx+half, cz, t, half*2]
  ];
  specs.forEach(([px,pz,sx,sz])=>{
    const curb = new THREE.Mesh(new THREE.BoxGeometry(sx, hgt, sz), curbMat);
    curb.position.set(px, terrainHeightAt(px,pz)+hgt/2, pz);
    curb.receiveShadow = true;
    scene.add(curb);
  });
}

function makeBeacon(x,z,color,emoji,baseHeight){
  baseHeight = baseHeight || 0;
  const group = new THREE.Group();
  const pillarLen = 8;
  const pillarGeo = new THREE.CylinderGeometry(0.18,0.18,pillarLen,8);
  const pillarMat = new THREE.MeshBasicMaterial({ color, transparent:true, opacity:0.45, depthTest:false, fog:false });
  const pillar = new THREE.Mesh(pillarGeo, pillarMat);
  pillar.position.y = baseHeight + pillarLen/2;
  pillar.renderOrder = 900;
  group.add(pillar);

  const ringGeo = new THREE.RingGeometry(1.5,2.1,28);
  const ringMat = new THREE.MeshBasicMaterial({ color, transparent:true, opacity:0.55, side:THREE.DoubleSide, depthTest:false, fog:false });
  const ring = new THREE.Mesh(ringGeo, ringMat);
  ring.rotation.x = -Math.PI/2;
  ring.position.y = 0.08;
  ring.renderOrder = 899;
  group.add(ring);

  const cnv = document.createElement('canvas'); cnv.width=64; cnv.height=64;
  const ctx = cnv.getContext('2d');
  ctx.font = '46px sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.fillText(emoji, 32, 36);
  const tex = new THREE.CanvasTexture(cnv);
  const spriteMat = new THREE.SpriteMaterial({ map:tex, depthTest:false, fog:false });
  const sprite = new THREE.Sprite(spriteMat);
  sprite.scale.set(3.4,3.4,1);
  sprite.position.y = baseHeight + pillarLen + 1.2;
  sprite.renderOrder = 901;
  group.add(sprite);

  group.position.set(x,0,z);
  group.userData.bob = Math.random()*Math.PI*2;
  group.userData.sprite = sprite;
  group.userData.baseY = sprite.position.y;
  scene.add(group);
  return group;
}

let shopInfo = null;

function buildTown(){
  // Register the shop's footprint before building its mesh so the
  // terrain-flattening pad is already active when the building positions
  // itself (same fix applied to every other building below).
  registerBuilding({x:0, z:0, hx:11, hz:11, height:9, ix:0, iz:0, dist:'downtown', isShop:true});
  shopInfo = makeShopBuilding(0,0);
  // Same reservation pattern as the shop, one block over: register the
  // firehouse's footprint before its mesh goes up, then skip its cell in
  // the main generation loop below.
  registerBuilding({x:FIREHOUSE_IX*BLOCK, z:FIREHOUSE_IZ*BLOCK, hx:13, hz:10, height:11, ix:FIREHOUSE_IX, iz:FIREHOUSE_IZ, dist:'downtown', isFirehouse:true});
  firehouseInfo = buildFirehouseBuilding(FIREHOUSE_IX*BLOCK, FIREHOUSE_IZ*BLOCK);
  // Same pattern again for the hospital, on its own reserved block.
  registerBuilding({x:HOSPITAL_IX*BLOCK, z:HOSPITAL_IZ*BLOCK, hx:14, hz:11, height:13, ix:HOSPITAL_IX, iz:HOSPITAL_IZ, dist:'downtown', isHospital:true});
  hospitalInfo = buildHospitalBuilding(HOSPITAL_IX*BLOCK, HOSPITAL_IZ*BLOCK);
  // Fourth reserved block, on another diagonal from the shop: the police
  // station.
  registerBuilding({x:POLICE_IX*BLOCK, z:POLICE_IZ*BLOCK, hx:13, hz:10, height:10, ix:POLICE_IX, iz:POLICE_IZ, dist:'downtown', isPoliceStation:true});
  policeStationInfo = buildPoliceStationBuilding(POLICE_IX*BLOCK, POLICE_IZ*BLOCK);
  // Fifth and last reserved block, rounding out all four diagonals around
  // the shop: the bank (a robbery target for the crime-event system).
  registerBuilding({x:BANK_IX*BLOCK, z:BANK_IZ*BLOCK, hx:13, hz:10, height:12, ix:BANK_IX, iz:BANK_IZ, dist:'downtown', isBank:true});
  bankInfo = buildBankBuilding(BANK_IX*BLOCK, BANK_IZ*BLOCK);

  // A handful of ordinary lots (picked now, excluding the five reserved
  // blocks above) become active construction sites instead of a normal
  // building when the main loop below reaches their cell.
  const siteCells = pickConstructionSiteCells(CONSTRUCTION_SITE_COUNT);
  const siteCellKeys = new Set(siteCells.map(c=>c.ix+','+c.iz));
  planWorkZones(14, siteCellKeys);

  for(let ix=IX_RANGE[0]; ix<=IX_RANGE[1]; ix++){
    for(let iz=IZ_RANGE[0]; iz<=IZ_RANGE[1]; iz++){
      if(ix===0 && iz===0) continue;
      if(ix===FIREHOUSE_IX && iz===FIREHOUSE_IZ) continue;
      if(ix===HOSPITAL_IX && iz===HOSPITAL_IZ) continue;
      if(ix===POLICE_IX && iz===POLICE_IZ) continue;
      if(ix===BANK_IX && iz===BANK_IZ) continue;
      const cx = ix*BLOCK, cz = iz*BLOCK;
      const dist = districtOf(ix);
      addCurb(cx,cz);
      if(siteCellKeys.has(ix+','+iz)){
        buildConstructionSite(cx,cz,ix,iz,dist);
      } else if(dist==='downtown'){
        buildDowntownBlock(cx,cz,ix,iz);
      } else {
        buildSpacedBlock(cx,cz,ix,iz,dist);
      }
      const _wz = workZonePlan[ix+','+iz];
      if(_wz) buildWorkZone(cx,cz,ix,iz,_wz);
    }
  }
  finalizePatios();
  buildHarborFront();
}


/* =========================================================
   SENSIBLE PLACEMENT — props live where they'd really be:
   sidewalk trees sit in green tree pits, lamps and mailboxes stand on the
   sidewalk, parked cars sit along the curb, cones only appear around
   construction/road-work areas, and lawn trees/rocks only go on grass.
   Every block has four sides; each side has a few "slots" along its
   sidewalk (clear of the corner crosswalks and traffic lights).
========================================================= */
const SIDEWALK_MID = BLOCK_HALF + SIDEWALK_W/2;     // middle of the sidewalk ring
const SLOT_OFFS = [-22,-11,0,11,22];
const workZonePlan = {};                            // 'ix,iz' -> {side, off}
const workZones = [];                               // animated builders
const zoneSidewalks = new Set();                    // 'ix,iz,side' - pedestrians skip these
const _isRiverCorridor = c => Math.abs(Math.abs(c)-RIVER_X)<0.01 || Math.abs(Math.abs(c)-RIVER_X2)<0.01;

// side 0:+z  1:-z  2:+x  3:-x  — does a real road run along that side of the block?
function sideHasRoad(ix,iz,side){
  if(side===0) return iz < IZ_RANGE[1];
  if(side===1) return iz > IZ_RANGE[0];
  if(side===2) return ix < IX_RANGE[1] && !_isRiverCorridor((ix+0.5)*BLOCK);
  return ix > IX_RANGE[0] && !_isRiverCorridor((ix-0.5)*BLOCK);
}
function sidePoint(cx,cz,side,off,d){
  if(side===0) return {x:cx+off, z:cz+d};
  if(side===1) return {x:cx+off, z:cz-d};
  if(side===2) return {x:cx+d,   z:cz+off};
  return {x:cx-d, z:cz+off};
}
function makeSlots(ix,iz,zone){
  const out = [];
  for(let side=0;side<4;side++){
    const roadOK = sideHasRoad(ix,iz,side);
    for(const off of SLOT_OFFS){
      if(zone && zone.side===side && Math.abs(off-zone.off)<8) continue;
      out.push({side, off, roadOK});
    }
  }
  for(let i=out.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    const t = out[i]; out[i] = out[j]; out[j] = t;
  }
  return out;
}

const PIT_GEO = new THREE.BoxGeometry(1.8, 0.12, 1.8);
const PIT_MAT = new THREE.MeshStandardMaterial({ color:0x4f9b45, roughness:1 });
function placeSidewalkTree(cx,cz,sl){
  const p = sidePoint(cx,cz,sl.side,sl.off,SIDEWALK_MID+0.6);
  const tile = new THREE.Mesh(PIT_GEO, PIT_MAT);
  tile.position.set(p.x, terrainHeightAt(p.x,p.z)+0.06, p.z);
  scene.add(tile);
  addObstacle(p.x, p.z, 'tree');
}
function placeParkedCar(cx,cz,sl){
  const p = sidePoint(cx,cz,sl.side,sl.off,34.0);          // just off the curb, beside the traffic lane
  const rot = [Math.PI/2, -Math.PI/2, 0, Math.PI][sl.side]; // facing the same way as the lane beside it
  buildParkedCar(p.x, p.z, rot);
  const dx = Math.sin(rot), dz = Math.cos(rot);
  [-1.3,1.3].forEach(t=>obstacles.push({x:p.x+dx*t, z:p.z+dz*t, r:1.0, dmg:6, type:'parked car', weight:150, light:false, mesh:null}));
}
// Trees in pits, lamps and mailboxes on the sidewalk, parked cars at the curb.
function streetFurniture(cx,cz,ix,iz,cfg){
  const slots = makeSlots(ix,iz,workZonePlan[ix+','+iz]);
  const take = needRoad=>{
    for(let i=slots.length-1;i>=0;i--){
      if(!needRoad || slots[i].roadOK) return slots.splice(i,1)[0];
    }
    return null;
  };
  for(let i=0;i<cfg.trees;i++){ const sl = take(false); if(sl) placeSidewalkTree(cx,cz,sl); }
  for(let i=0;i<cfg.lamps;i++){
    const sl = take(false);
    if(sl){ const p = sidePoint(cx,cz,sl.side,sl.off,SIDEWALK_MID+0.8); addObstacle(p.x,p.z,'lamp'); }
  }
  if(Math.random()<cfg.mail){
    const sl = take(false);
    if(sl){ const p = sidePoint(cx,cz,sl.side,sl.off,SIDEWALK_MID+0.8); addObstacle(p.x,p.z,'mailbox'); }
  }
  const nCars = Math.floor(cfg.cars) + (Math.random() < cfg.cars%1 ? 1 : 0);
  for(let i=0;i<nCars;i++){ const sl = take(true); if(sl) placeParkedCar(cx,cz,sl); }
}

// A lawn tree or rock somewhere on the grass, never inside the building footprint.
function addLawnProp(cx,cz,hx,hz){
  for(let tries=0; tries<16; tries++){
    const ang = Math.random()*Math.PI*2;
    const rad = BLOCK_HALF*0.5 + Math.random()*BLOCK_HALF*0.4;
    const ox = cx + Math.cos(ang)*rad, oz = cz + Math.sin(ang)*rad;
    const outsideBuilding = Math.abs(ox-cx) >= hx+2.5 || Math.abs(oz-cz) >= hz+2.5;
    const onLawn = Math.abs(ox-cx) <= BLOCK_HALF-3 && Math.abs(oz-cz) <= BLOCK_HALF-3;
    if(outsideBuilding && onLawn){ addObstacle(ox,oz); return; }
  }
}

// ---- cones & road work ----
// A cone ring around a construction site's fence, so the whole lot reads as closed off.
function cordonSite(cx,cz,hx,hz){
  const rx = hx+4.2, rz = hz+4.2, n = 6;
  for(let i=0;i<=n;i++){
    const tx = -rx + 2*rx*i/n, tz = -rz + 2*rz*i/n;
    addObstacle(cx+tx, cz-rz, 'cone');
    addObstacle(cx+tx, cz+rz, 'cone');
    if(i>0 && i<n){
      addObstacle(cx-rx, cz+tz, 'cone');
      addObstacle(cx+rx, cz+tz, 'cone');
    }
  }
}

const BARRIER_MAT = (()=>{
  const c = document.createElement('canvas'); c.width = 64; c.height = 16;
  const g = c.getContext('2d');
  g.fillStyle = '#f3f0e8'; g.fillRect(0,0,64,16);
  g.fillStyle = '#ff7a1a';
  for(let x=-16;x<80;x+=16){ g.beginPath(); g.moveTo(x,16); g.lineTo(x+8,16); g.lineTo(x+16,0); g.lineTo(x+8,0); g.closePath(); g.fill(); }
  const t = new THREE.CanvasTexture(c); t.wrapS = THREE.RepeatWrapping; t.repeat.set(5,1);
  return new THREE.MeshStandardMaterial({ map:t, roughness:0.7 });
})();
const DIRT_MAT = new THREE.MeshStandardMaterial({ color:0x5a4330, roughness:1 });
const HOLE_MAT = new THREE.MeshStandardMaterial({ color:0x1b1511, roughness:1 });
const PIPE_MAT = new THREE.MeshStandardMaterial({ color:0x8c9096, roughness:0.5, metalness:0.4 });
const SIGN_MAT = new THREE.MeshStandardMaterial({ color:0xff8a1a, roughness:0.5 });
const WORK_L = 5.5;   // half-length of a work zone along the road

// Pick which blocks get a road-work zone, and on which side, before any block is built
// so the sidewalk props on that side know to leave room.
function planWorkZones(count, exclude){
  const reserved = new Set(['0,0', FIREHOUSE_IX+','+FIREHOUSE_IZ, HOSPITAL_IX+','+HOSPITAL_IZ, POLICE_IX+','+POLICE_IZ, BANK_IX+','+BANK_IZ]);
  const cands = [];
  for(let ix=IX_RANGE[0]; ix<=IX_RANGE[1]; ix++){
    for(let iz=IZ_RANGE[0]; iz<=IZ_RANGE[1]; iz++){
      const key = ix+','+iz;
      if(reserved.has(key) || exclude.has(key)) continue;
      for(let side=0;side<4;side++) if(sideHasRoad(ix,iz,side)) cands.push({ix,iz,side});
    }
  }
  for(let i=cands.length-1;i>0;i--){
    const j = Math.floor(Math.random()*(i+1));
    const t = cands[i]; cands[i] = cands[j]; cands[j] = t;
  }
  const picked = [];
  for(const c of cands){
    if(picked.length >= count) break;
    if(picked.some(q=>Math.abs(q.ix-c.ix)<2 && Math.abs(q.iz-c.iz)<2)) continue;
    picked.push(c);
    workZonePlan[c.ix+','+c.iz] = { side:c.side, off:[-11,0,11][Math.floor(Math.random()*3)] };
  }
}

// A cordoned patch of sidewalk and road shoulder with an open hole, a dirt pile,
// a pipe, a warning sign, a striped barrier, a ring of cones — and builders at work.
function buildWorkZone(cx,cz,ix,iz,zn){
  const base = sidePoint(cx,cz,zn.side,zn.off,0);
  const mid = sidePoint(cx,cz,zn.side,zn.off,31.7);
  const gy = terrainHeightAt(mid.x, mid.z);
  const g = new THREE.Group();
  g.position.set(base.x, gy, base.z);
  g.rotation.y = [0, Math.PI, Math.PI/2, -Math.PI/2][zn.side];   // local +z points away from the block
  const add = (geo, mat, x, y, z)=>{ const m = new THREE.Mesh(geo, mat); m.position.set(x,y,z); g.add(m); return m; };

  add(new THREE.BoxGeometry(WORK_L*2-0.6, 0.1, 2.6), DIRT_MAT, 0, 0.07, 31.7);                 // torn-up ground
  add(new THREE.BoxGeometry(3.2, 0.02, 1.4), HOLE_MAT, -0.4, 0.13, 31.7);                       // the hole
  const mound = new THREE.DodecahedronGeometry(0.7, 0);
  const m1 = add(mound, DIRT_MAT, 2.6, 0.2, 31.5); m1.scale.set(1.3,0.55,1);
  const m2 = add(mound, DIRT_MAT, -3.2, 0.18, 32.2); m2.scale.set(1.0,0.5,0.9);
  const pipe = add(new THREE.CylinderGeometry(0.22,0.22,3.2,10), PIPE_MAT, -0.4, 0.32, 30.9);   // a pipe along the hole
  pipe.rotation.z = Math.PI/2;
  add(new THREE.BoxGeometry(WORK_L*2, 0.35, 0.08), BARRIER_MAT, 0, 0.75, 34.6);                 // striped barrier along the road side
  add(new THREE.CylinderGeometry(0.04,0.04,2.2,6), PIPE_MAT, -WORK_L-0.9, 1.1, 31.2);           // warning sign
  const sign = add(new THREE.BoxGeometry(0.9,0.9,0.06), SIGN_MAT, -WORK_L-0.9, 2.3, 31.2);
  sign.rotation.z = Math.PI/4;
  scene.add(g);

  // cone ring: along the road side, and across both ends
  const at = (t,d)=>sidePoint(cx,cz,zn.side,zn.off+t,d);
  for(let t=-WORK_L; t<=WORK_L+0.01; t+=2.2){ const q = at(t,34.6); addObstacle(q.x,q.z,'cone'); }
  [31.2,32.9].forEach(d=>[-WORK_L,WORK_L].forEach(t=>{ const q = at(t,d); addObstacle(q.x,q.z,'cone'); }));
  // the dig itself is solid so nobody drives through the builders
  [-3.3,0,3.3].forEach(t=>{ const q = at(t,31.7); obstacles.push({x:q.x,z:q.z,r:1.6,dmg:5,type:'work zone',weight:150,light:false,mesh:null}); });

  // builders
  const workers = [];
  [[-2.0,31.6],[2.4,32.0]].forEach(([t,d],i)=>{
    const q = at(t,d), wm = buildWorkerMesh(), wgy = terrainHeightAt(q.x,q.z);
    wm.position.set(q.x, wgy, q.z);
    wm.rotation.y = Math.random()*Math.PI*2;
    scene.add(wm);
    workers.push({ mesh:wm, t:Math.random()*10, baseY:wgy, ry:wm.rotation.y, ph:i*1.7 });
  });
  workZones.push({ workers });
  zoneSidewalks.add(ix+','+iz+','+zn.side);
}
function updateWorkZones(dt){
  for(let i=0;i<workZones.length;i++){
    const ws = workZones[i].workers;
    for(let k=0;k<ws.length;k++){
      const w = ws[k];
      w.t += dt;
      w.mesh.position.y = w.baseY + Math.abs(Math.sin(w.t*4.2 + w.ph))*0.1;
      w.mesh.rotation.y = w.ry + Math.sin(w.t*1.1 + w.ph)*0.55;
    }
  }
}

