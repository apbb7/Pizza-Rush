  } else {
    // Deciduous — a main canopy plus 1-2 smaller offset clumps so the
    // silhouette isn't a single perfect sphere every time.
    const baseR = 0.8+Math.random()*0.4;
    const main = new THREE.Mesh(new THREE.SphereGeometry(baseR,8,7), folMat);
