function updateRunner(dt,y){
  const r = foot.runner; if(!r) return;
  r.position.set(player.x, y, player.z);
  r.rotation.y = player.angle;
  const sp = Math.abs(player.speed);
  foot.phase += dt*(2+sp*1.5);
  const sw = Math.sin(foot.phase)*0.85*Math.min(1,sp/3);
  const U = r.userData, carrying = state.orders.length>0;
  U.legs[0].rotation.x = sw; U.legs[1].rotation.x = -sw;
  U.box.visible = carrying;
  if(carrying){ U.arms[0].rotation.x = U.arms[1].rotation.x = -1.15; }
  else { U.arms[0].rotation.x = -sw; U.arms[1].rotation.x = sw; }
  r.position.y += Math.abs(Math.sin(foot.phase))*0.05*Math.min(1,sp/3);
  player.pizzaBox.visible = false;
}
function toggleFoot(){
  if(!state.running || state.paused) return;
  if(foot.on){
    const d = Math.hypot(player.x-foot.vx, player.z-foot.vz);
    if(dive.on){ toast('Open your parachute with H!','bad'); return; }
    if(foot.air){ toast('Your helicopter is still coming down on autopilot…', null); return; }
    if(d>5.5){ toast('Too far from your vehicle — run back to the 🚗 marker','bad'); return; }
    boardVehicle();
    toast('🚗 Back behind the wheel','good');
    return;
  }
  if(vehicleDefs[state.currentVehicle].isAircraft && (player.alt||0) >= 3){ startSkydive(); return; }   // bail out of a flying helicopter
  if(loadLocked()){ toast('Wait for the chef to finish loading! 👨‍🍳', null); return; }
  if(Math.abs(player.speed) > 9){ toast('Slow down before you jump out!','bad'); return; }
  foot.on = true;
  foot.vx = player.x; foot.vz = player.z; foot.vang = player.angle; foot.vy = terrainHeightAt(player.x,player.z);
  const c = Math.cos(player.angle), s = Math.sin(player.angle);
  player.x += -2.1*c; player.z += 2.1*s;          // step out on the driver's side
  player.speed = 0; player.steerInput = 0;
  if(!foot.runner){ foot.runner = buildRunnerMesh(); }
  scene.add(foot.runner);
  foot.beacon = makeBeacon(foot.vx, foot.vz, 0x35a7ff, '🚗', 0);
  toast('🚶 On foot! Deliver the pizza, then press F by your 🚗 to drive again','good');
}
// After you bail out, the helicopter flies itself down (drifting clear of any rooftop first).
function updateParkedHeli(dt){
  if(!foot.air) return;
  const gy = terrainHeightAt(foot.vx,foot.vz);
  for(let i=0;i<buildings.length;i++){
    const b = buildings[i], dx = foot.vx-b.x, dz = foot.vz-b.z;
    if(Math.abs(dx)<b.hx+3.5 && Math.abs(dz)<b.hz+3.5 && foot.vy < terrainHeightAt(b.x,b.z)+b.height+8){
      const ex = b.hx+3.5-Math.abs(dx), ez = b.hz+3.5-Math.abs(dz);
      if(ex<ez) foot.vx += Math.sign(dx||1)*6*dt; else foot.vz += Math.sign(dz||1)*6*dt;
      break;
    }
  }
  foot.vy = Math.max(gy, foot.vy - 7*dt);
  if(foot.vy <= gy+0.01) foot.air = false;
}
function boardVehicle(){
  if(!foot.on) return;
  foot.on = false; foot.air = false; endDiveState();
  player.x = foot.vx; player.z = foot.vz; player.angle = foot.vang; player.speed = 0; player.steerInput = 0;
  if(foot.runner) scene.remove(foot.runner);
  if(foot.beacon){ scene.remove(foot.beacon); foot.beacon = null; }
  if(player.pizzaBox) player.pizzaBox.visible = state.orders.length>0 && !player.load;
  if(state.orders.length===0) resetOrderUI();
}
