  await loadSlotIndex();
  const nav = await readNavAsync();
  ACTIVE_SLOT = nav.slot || (slotIndex.slice().sort((x,y)=>(y.t||0)-(x.t||0))[0]||{}).id || 'main';
  if(window.storage){
    try{
      const res = await window.storage.get(slotKey(ACTIVE_SLOT));
      if(res && res.value){
        const sv = JSON.parse(res.value);
        if(sv.money        != null) state.money        = sv.money;
        if(sv.debt         != null) state.debt         = sv.debt;
    if(sv.debt         != null) state.debt         = sv.debt;
        if(sv.deliveries   != null) state.deliveries   = sv.deliveries;
        if(sv.unlocked)  Object.keys(sv.unlocked).forEach(k=>{ if(sv.unlocked[k]) state.unlocked[k] = true; });
        if(sv.upgrades){
          ['engine','handling','insulation','chef'].forEach(k=>{
            if(sv.upgrades[k] != null)
              state.upgrades[k].level = Math.min(state.upgrades[k].max, sv.upgrades[k]);
          });
        }
        if(sv.ownedVehicles) Object.assign(state.ownedVehicles, sv.ownedVehicles);
        if(sv.currentVehicle && state.ownedVehicles[sv.currentVehicle])
          state.currentVehicle = sv.currentVehicle;
        loadDecalsFrom(sv);
        hasSave = true;
      }
    } catch(e){}
  }

  const saveEl = document.getElementById('save-status');
  const newBtn = document.getElementById('newgame-btn');
  if(hasSave){
    const m = slotIndex.find(s=>s.id===ACTIVE_SLOT);
    saveEl.textContent = '💾 '+(m?m.name:'Saved game')+' loaded — $'+state.money.toFixed(2)+' · '+state.deliveries+' deliveries';
  } else {
    saveEl.textContent = 'New game — starting fresh.';
  }
  renderSlots();

  const _sceneBeforeTown = scene.children.length;
  buildTown();
  const _townObjects = scene.children.slice(_sceneBeforeTown);
  // Displace the ground now that every building (and the shop's driveway)
  // is registered, so flattened pads under buildings and the driveway
  // line up correctly with the terrain.
  applyTerrainDisplacement();
  buildTraffic();
  spawnPedestrians();
  buildRiverCrossing(RIVER_X, BRIDGE_Z, 'suburbs');
  buildRiverCrossing(-RIVER_X, BRIDGE_Z, 'industrial');
  buildRiverCrossing(RIVER_X2, BRIDGE_Z, 'harbor');
  buildRiverCrossing(-RIVER_X2, BRIDGE_Z, 'oldtown');
  gateSuburbs    = buildLockGate(RIVER_X,  BRIDGE_Z, 'suburbs',    'Suburbs — buy in city map');
  gateIndustrial = buildLockGate(-RIVER_X, BRIDGE_Z, 'industrial', 'Industrial — buy in city map');
  gateHarbor     = buildLockGate(RIVER_X2, BRIDGE_Z, 'harbor',     'Harbor — buy in city map');
  gateOldtown    = buildLockGate(-RIVER_X2,BRIDGE_Z, 'oldtown',    'Old Town — buy in city map');
  buildCityPerimeterWall();

  Object.keys(state.unlocked).forEach(key=>{
    if(state.unlocked[key]){
      const gate = {suburbs:()=>gateSuburbs, industrial:()=>gateIndustrial, harbor:()=>gateHarbor, oldtown:()=>gateOldtown}[key];
      if(gate){ const g=gate(); if(g) scene.remove(g.mesh, g.sprite); }
      removeCrossing(key);
    }
  });

  applyVehicleMesh(state.currentVehicle);
  spawnRival();
  spawnFireTrucks();
  spawnAmbulances();
  spawnPatrolCars();
  spawnNewsHeli();
  spawnRescueHeli();
  buildRain();

  freezeStaticTown(_townObjects);
  { const sb = document.getElementById('sound-btn'); if(sb){ sb.textContent = SFX.isMuted() ? '🔇' : '🔊'; sb.addEventListener('click', ()=>SFX.toggleMute()); } }
  updateDamageUI();
  updateHUD();
  animate();
  if(nav.autostart){ writeNav({ slot:ACTIVE_SLOT }); startActiveGame(); }
}


/* =========================================================
   SOUND — everything is synthesized with the Web Audio API (no audio files).
   Engines (yours + nearby traffic), sirens, rotors, weather, and one-shot
   effects. Mute with the speaker button or the M key.
========================================================= */
const SFX = (function(){
  let ctx=null, master=null, comp=null, noiseBuf=null, muted=false;
  let engineStartAt=0, lastUnlock=0, frameN=0, P=null;
  try{ muted = localStorage.getItem('pizza-rush-muted')==='1'; }catch(e){}
  const VOL = 0.7;
  const carVoices=[], sirenVoices=[], heliVoices=[];

  const ENGINES = {
    scooter:    { idle:62, top:230, cut:[700,2400],  vol:0.85, buzz:0.25 },
    cargotrike: { idle:52, top:170, cut:[600,1600],  vol:0.9,  buzz:0.2  },
    sportbike:  { idle:85, top:360, cut:[1100,3800], vol:1.0,  buzz:0.1  },
    pizzacar:   { idle:48, top:190, cut:[500,1800],  vol:0.9,  buzz:0.1  },
    deliveryvan:{ idle:38, top:130, cut:[350,1100],  vol:1.0,  buzz:0.35 },
    musclecar:  { idle:34, top:165, cut:[400,1500],  vol:1.1,  buzz:0.45 }
  };

  function T(param, v, tc){ param.setTargetAtTime(v, ctx.currentTime, tc||0.06); }
  function osc(type, f){ const o = ctx.createOscillator(); o.type = type; o.frequency.value = f; return o; }
  function gain(v){ const g = ctx.createGain(); g.gain.value = v; return g; }
  function filt(type, f, q){ const b = ctx.createBiquadFilter(); b.type = type; b.frequency.value = f; if(q) b.Q.value = q; return b; }
  function noiseSrc(){ const n = ctx.createBufferSource(); n.buffer = noiseBuf; n.loop = true; n.start(0, Math.random()*1.5); return n; }
  function pan(){
    if(ctx.createStereoPanner) return ctx.createStereoPanner();
    const g = ctx.createGain(); g.pan = { value:0, setTargetAtTime(){} }; return g;
  }

  function init(){
    if(ctx){ if(ctx.state==='suspended') ctx.resume(); return; }
    const AC = window.AudioContext || window.webkitAudioContext;
    if(!AC) return;
    try{ ctx = new AC(); }catch(e){ ctx = null; return; }
    comp = ctx.createDynamicsCompressor();
    master = ctx.createGain(); master.gain.value = muted ? 0 : VOL;
    master.connect(comp); comp.connect(ctx.destination);
    const n = ctx.sampleRate*2;
    noiseBuf = ctx.createBuffer(1, n, ctx.sampleRate);
    const d = noiseBuf.getChannelData(0);
    for(let i=0;i<n;i++) d[i] = Math.random()*2-1;
    build();
    document.addEventListener('visibilitychange', ()=>{
      if(!ctx) return;
      if(document.hidden) ctx.suspend(); else ctx.resume();
    });
  }

  function build(){
    P = {};
    // --- your engine (cars / bikes) ---
    const e = P.eng = {};
    e.a = osc('sawtooth', 50); e.b = osc('square', 25);
    e.filter = filt('lowpass', 800, 1.2);
    e.gain = gain(0);
    const sub = gain(0.35);
    e.a.connect(e.filter); e.b.connect(sub); sub.connect(e.filter);
    e.filter.connect(e.gain); e.gain.connect(master);
    e.lfo = osc('sine', 12); e.depth = gain(0);
    e.lfo.connect(e.depth); e.depth.connect(e.gain.gain);
    e.a.start(); e.b.start(); e.lfo.start();

    // --- your rotor (helicopter) ---
    const h = P.heli = {};
    h.noise = noiseSrc(); h.bp = filt('bandpass', 200, 0.9); h.gain = gain(0);
    h.noise.connect(h.bp); h.bp.connect(h.gain); h.gain.connect(master);
    h.lfo = osc('sine', 10); h.depth = gain(0);
    h.lfo.connect(h.depth); h.depth.connect(h.gain.gain);
    h.sub = osc('sine', 48); h.subGain = gain(0); h.sub.connect(h.subGain); h.subGain.connect(master);
    h.whine = osc('sine', 300); h.whineGain = gain(0); h.whine.connect(h.whineGain); h.whineGain.connect(master);
    h.lfo.start(); h.sub.start(); h.whine.start();

    // --- tire squeal ---
    P.skidGain = gain(0);
    { const s = noiseSrc(), b = filt('bandpass', 1700, 4); s.connect(b); b.connect(P.skidGain); P.skidGain.connect(master); }

    // --- ambience: city hum, rain, wind ---
    P.humGain = gain(0);
    { const s = noiseSrc(), l = filt('lowpass', 220); s.connect(l); l.connect(P.humGain); P.humGain.connect(master); }
    P.rainGain = gain(0);
    { const s = noiseSrc(), hp = filt('highpass', 900), lp = filt('lowpass', 7000); s.connect(hp); hp.connect(lp); lp.connect(P.rainGain); P.rainGain.connect(master); }
    P.windGain = gain(0);
    { const s = noiseSrc(), b = filt('bandpass', 380, 0.7); s.connect(b); b.connect(P.windGain); P.windGain.connect(master); }

    // --- zombie growl ---
    { const g = P.zombie = {};
      g.o = osc('sawtooth', 68); g.f = filt('lowpass', 360); g.gain = gain(0);
      g.o.connect(g.f); g.f.connect(g.gain); g.gain.connect(master);
      g.lfo = osc('sine', 4.5); g.depth = gain(0); g.lfo.connect(g.depth); g.depth.connect(g.gain.gain);
      g.o.start(); g.lfo.start(); }

    // --- pooled voices for nearby traffic, sirens, other helicopters ---
    for(let i=0;i<6;i++){
      const v = { o:osc('sawtooth', 60), f:filt('lowpass', 600), g:gain(0), p:pan() };
      v.o.connect(v.f); v.f.connect(v.g); v.g.connect(v.p); v.p.connect(master); v.o.start();
      carVoices.push(v);
    }
    for(let i=0;i<3;i++){
      const v = { o:osc('square', 800), f:filt('lowpass', 2200), g:gain(0), p:pan() };
      v.o.connect(v.f); v.f.connect(v.g); v.g.connect(v.p); v.p.connect(master); v.o.start();
      sirenVoices.push(v);
    }
    for(let i=0;i<2;i++){
      const v = { n:noiseSrc(), b:filt('bandpass', 190, 0.9), g:gain(0), p:pan(), l:osc('sine', 11), d:gain(0) };
      v.n.connect(v.b); v.b.connect(v.g); v.g.connect(v.p); v.p.connect(master);
      v.l.connect(v.d); v.d.connect(v.g.gain); v.l.start();
      heliVoices.push(v);
    }
  }

  // ---------- one-shot helpers ----------
  function tone(freq, dur, type, vol, o){
    if(!ctx) return; o = o || {};
    const t0 = ctx.currentTime + (o.delay||0), at = o.attack||0.008;
    const os = osc(type||'sine', freq), g = ctx.createGain();
    os.frequency.setValueAtTime(freq, t0);
    if(o.to) os.frequency.exponentialRampToValueAtTime(o.to, t0+dur);
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.exponentialRampToValueAtTime(Math.max(0.0002,vol), t0+at);
    g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
    os.connect(g); g.connect(o.out || master);
    os.start(t0); os.stop(t0+dur+0.05);
  }
  function noise(dur, vol, ftype, f0, f1, o){
    if(!ctx) return; o = o || {};
    const t0 = ctx.currentTime + (o.delay||0);
    const src = ctx.createBufferSource(); src.buffer = noiseBuf;
    const f = filt(ftype||'lowpass', f0||1000, o.q||0.8), g = ctx.createGain();
    f.frequency.setValueAtTime(f0||1000, t0);
    if(f1) f.frequency.exponentialRampToValueAtTime(f1, t0+dur);
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.exponentialRampToValueAtTime(Math.max(0.0002,vol), t0+(o.attack||0.005));
    g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
    src.connect(f); f.connect(g); g.connect(master);
    src.start(t0, Math.random()*1.5, dur+0.1);
  }

  const fx = {
    click(){ tone(900, 0.05, 'square', 0.04); },
    pickup(){ tone(660, 0.12, 'triangle', 0.16); tone(990, 0.2, 'triangle', 0.16, {delay:0.09}); },
    deliver(bonus){
      noise(0.05, 0.12, 'highpass', 3000, 3000);
      [1319,1568,2093].forEach((f,i)=>tone(f, 0.45, 'triangle', 0.13, {delay:0.05+i*0.07}));
      if(bonus) tone(2637, 0.6, 'sine', 0.1, {delay:0.28});
      tone(180, 0.1, 'square', 0.05);
    },
    ruin(){ tone(330, 0.5, 'sawtooth', 0.09, {to:110}); tone(247, 0.6, 'triangle', 0.1, {to:82, delay:0.12}); },
    purchase(){
      tone(988, 0.09, 'square', 0.08); tone(1319, 0.28, 'square', 0.08, {delay:0.08});
      noise(0.3, 0.05, 'highpass', 5000, 7000, {delay:0.08});
    },
    unlock(){
      const now = ctx ? ctx.currentTime : 0;
      if(now - lastUnlock < 0.6) return; lastUnlock = now;
      [523,659,784,1047].forEach((f,i)=>tone(f, 0.35, 'triangle', 0.13, {delay:i*0.1}));
      tone(1047, 0.8, 'sine', 0.1, {delay:0.4});
    },
    reward(){ [784,988,1175].forEach((f,i)=>tone(f, 0.3, 'triangle', 0.12, {delay:i*0.09})); },
    crash(frac, metal){
      const v = 0.25 + 0.65*Math.min(1, frac||0.5);
      noise(0.28, v*0.9, 'lowpass', 1600, 160);
      tone(150, 0.2, 'sine', v, {to:42});
      if(metal){ tone(1850, 0.14, 'square', 0.04*v); tone(2450, 0.1, 'square', 0.03*v, {delay:0.02}); }
    },
    tick(){ noise(0.07, 0.2, 'bandpass', 2500, 1200); tone(900, 0.08, 'triangle', 0.08, {to:400}); },
    thump(){ tone(190, 0.13, 'sine', 0.3, {to:70}); noise(0.06, 0.15, 'lowpass', 900, 300); },
    zombieBite(){ tone(95, 0.3, 'sawtooth', 0.12, {to:55}); noise(0.18, 0.12, 'bandpass', 700, 300); },
    burn(){ noise(0.35, 0.14, 'highpass', 1800, 900); },
    busted(){
      [0,1,2,3].forEach(i=>tone(i%2?760:1000, 0.18, 'square', 0.07, {delay:i*0.2}));
      tone(110, 0.5, 'sine', 0.2, {to:60});
    },
    alert(){ tone(900, 0.2, 'square', 0.07, {to:1400}); tone(900, 0.2, 'square', 0.07, {to:1400, delay:0.25}); },
    alarm(){ for(let i=0;i<6;i++) tone(1500, 0.11, 'square', 0.05, {delay:i*0.18}); },
    breakdown(){
      tone(140, 0.9, 'sawtooth', 0.14, {to:28});
      for(let i=0;i<4;i++) noise(0.08, 0.1, 'lowpass', 600, 300, {delay:0.15+i*0.18});
      noise(0.6, 0.06, 'highpass', 4000, 2000, {delay:0.5});
    },
    lightning(){
      noise(0.14, 0.7, 'highpass', 3500, 1500);
      noise(2.4, 0.5, 'lowpass', 500, 55, {delay:0.2, attack:0.3, q:0.7});
      tone(48, 1.8, 'sine', 0.3, {to:30, delay:0.25, attack:0.2});
    },
    stormStart(){ noise(3.2, 0.25, 'lowpass', 300, 60, {attack:0.9}); },
    zombieRoar(){
      tone(90, 1.1, 'sawtooth', 0.14, {to:50, attack:0.2});
      tone(135, 0.9, 'sawtooth', 0.08, {to:70, delay:0.15, attack:0.2});
      noise(1.0, 0.1, 'bandpass', 500, 220, {attack:0.2});
    },
    honk(c){
      if(!ctx || !state.running || state.paused) return;
      const now = ctx.currentTime;
      if(c._honkAt && now - c._honkAt < 3) return;
      const dx = c.mesh.position.x - camera.position.x, dz = c.mesh.position.z - camera.position.z;
      const d = Math.hypot(dx, dz);
      if(d > 40) return;
      c._honkAt = now + Math.random()*1.5;
      const v = 0.07*(1-d/40);
      const f0 = c.type==='truck' ? 190 : 400;
      tone(f0, 0.28, 'square', v, {attack:0.01}); tone(f0*1.26, 0.28, 'square', v*0.8, {attack:0.01});
    },
    engineStart(){
      if(!ctx) return;
      const key = state.currentVehicle;
      if(vehicleDefs[key] && vehicleDefs[key].isAircraft){
        tone(110, 1.5, 'sawtooth', 0.05, {to:650, attack:0.3});
        tone(70, 1.5, 'sine', 0.1, {to:200, attack:0.3});
        noise(1.5, 0.07, 'bandpass', 250, 700, {attack:0.4});
        engineStartAt = ctx.currentTime + 1.1;
        return;
      }
      const prof = ENGINES[key] || ENGINES.scooter;
      for(let i=0;i<4;i++) noise(0.09, 0.14, 'bandpass', 520, 380, {delay:i*0.13, q:2});
      tone(prof.idle*0.5, 0.55, 'sawtooth', 0.07, {to:prof.idle*0.9});
      tone(prof.idle, 0.55, 'sawtooth', 0.11, {to:prof.top*0.55, delay:0.6, attack:0.05});
      tone(prof.top*0.55, 0.35, 'sawtooth', 0.09, {to:prof.idle, delay:1.1});
      engineStartAt = ctx.currentTime + 0.7;
    }
  };

  function toggleMute(){
    muted = !muted;
    try{ localStorage.setItem('pizza-rush-muted', muted?'1':'0'); }catch(e){}
    if(ctx) T(master.gain, muted?0:VOL, 0.03);
    const b = document.getElementById('sound-btn');
    if(b) b.textContent = muted ? '🔇' : '🔊';
    return muted;
  }

  // ---------- per-frame mixing ----------
  function update(dt){
    if(!ctx || ctx.state!=='running' || !P) return;
    frameN++;
    const running = state.running;
    const active = running && !state.paused;
    const key = state.currentVehicle, def = vehicleDefs[key];
    const isHeli = !!(def && def.isAircraft);
    const now = ctx.currentTime;
    const maxSpeed = Math.max(1, baseStats().maxSpeed);
    const frac = Math.min(1.2, Math.abs(player.speed)/maxSpeed);
    const thr = (state.keys.f || state.keys.b) ? 1 : 0;
    const started = now >= engineStartAt;

    // your car/bike engine
    const e = P.eng;
    if(active && started && !isHeli){
      const prof = ENGINES[key] || ENGINES.scooter;
      const gears = 4, gi = Math.min(gears-1, Math.floor(frac*gears)), within = Math.min(1, frac*gears-gi);
      const rpm = frac < 0.015 ? (thr ? 0.22 : 0) : 0.28 + 0.72*within;
      const f = prof.idle + (prof.top-prof.idle)*rpm*(0.62+0.13*gi);
      const g = (0.035 + 0.04*thr + 0.05*Math.min(1,frac)) * prof.vol;
      T(e.a.frequency, f, 0.05); T(e.b.frequency, f*0.5, 0.05);
      T(e.filter.frequency, prof.cut[0] + (prof.cut[1]-prof.cut[0])*Math.min(1, rpm*0.6+thr*0.4), 0.08);
      T(e.gain.gain, g, 0.06);
      T(e.depth.gain, g*prof.buzz*0.6, 0.1);
      T(e.lfo.frequency, 9 + rpm*12, 0.1);
    } else {
      T(e.gain.gain, 0, 0.08); T(e.depth.gain, 0, 0.08);
    }

    // your rotor
    const h = P.heli;
    if(active && isHeli){
      const v = 0.35 + 0.65*Math.min(1, player.alt/6 + frac);
      const amp = started ? 0.12*v : 0.0;
      T(h.gain.gain, amp, 0.15); T(h.depth.gain, amp*0.9, 0.15);
      T(h.lfo.frequency, 8 + 4*v + frac*3, 0.2);
      T(h.bp.frequency, 180 + frac*220, 0.2);
      T(h.subGain.gain, started ? 0.14*v : 0, 0.15); T(h.sub.frequency, 46 + frac*12, 0.2);
      T(h.whineGain.gain, started ? 0.012 + 0.025*frac : 0, 0.2); T(h.whine.frequency, 280 + frac*620 + Math.min(player.alt,40)*3, 0.2);
    } else {
      T(h.gain.gain, 0, 0.1); T(h.depth.gain, 0, 0.1); T(h.subGain.gain, 0, 0.1); T(h.whineGain.gain, 0, 0.1);
    }

    // tire squeal
    const skid = (active && !isHeli) ? Math.max(0, Math.abs(player.steerInput)*frac - 0.45) : 0;
    T(P.skidGain.gain, Math.min(0.05, skid*0.12), 0.05);

    // ambience
    T(P.humGain.gain, running ? 0.02 : 0, 0.5);
    T(P.rainGain.gain, running ? 0.09*stormState.skyBlend : 0, 0.4);
    T(P.windGain.gain, running ? 0.07*Math.max(zombieState.skyBlend, stormState.skyBlend*0.6) + (isHeli ? 0.05*Math.min(1,frac) : 0) : 0, 0.4);

    // nearby voices run at ~20 Hz instead of every frame
    if(frameN % 3 !== 0) return;
    if(!active){
      carVoices.forEach(v=>T(v.g.gain, 0, 0.1));
      sirenVoices.forEach(v=>T(v.g.gain, 0, 0.1));
      heliVoices.forEach(v=>{ T(v.g.gain, 0, 0.1); T(v.d.gain, 0, 0.1); });
      T(P.zombie.gain.gain, 0, 0.1); T(P.zombie.depth.gain, 0, 0.1);
      return;
    }
    const cx = camera.position.x, cz = camera.position.z;
    const me = camera.matrixWorld.elements, rx = me[0], rz = me[2];
    const panOf = (dx,dz,d)=> Math.max(-1, Math.min(1, (dx*rx + dz*rz)/Math.max(d,1)));

    // traffic engines: the nearest few cars
    const R = 75, near = [];
    for(let i=0;i<trafficCars.length;i++){
      const c = trafficCars[i], p = c.mesh.position;
      const dx = p.x-cx, dz = p.z-cz, d2 = dx*dx+dz*dz;
      if(d2 < R*R) near.push({c, dx, dz, d2});
    }
    near.sort((a,b)=>a.d2-b.d2);
    for(let i=0;i<carVoices.length;i++){
      const v = carVoices[i], n = near[i];
      if(!n){ T(v.g.gain, 0, 0.1); continue; }
      const d = Math.sqrt(n.d2), c = n.c, truck = c.type==='truck';
      const f = truck ? 34 + c.curSpeed*10 : 46 + c.curSpeed*8;
      const vol = (truck ? 0.1 : 0.075) * Math.pow(1-d/R, 2);
      T(v.o.frequency, f, 0.08); T(v.f.frequency, 450 + c.curSpeed*60, 0.1);
      T(v.g.gain, vol, 0.08); T(v.p.pan, panOf(n.dx, n.dz, d), 0.08);
    }

    // sirens
    const src = [];
    for(let i=0;i<fireTrucks.length;i++){ const t = fireTrucks[i]; if(t.mesh.visible && (t.mode==='toFire'||t.mode==='returning')) src.push({x:t.x, z:t.z, k:0}); }
    for(let i=0;i<ambulances.length;i++){ const a = ambulances[i]; if(a.mesh.visible && (a.mode==='toScene'||a.mode==='toHospital')) src.push({x:a.x, z:a.z, k:1}); }
    for(let i=0;i<patrolCars.length;i++){ const q = patrolCars[i]; if(q.mode==='pursuing'||q.mode==='pursuingCrime') src.push({x:q.x, z:q.z, k:2}); }
    src.forEach(s=>{ const dx=s.x-cx, dz=s.z-cz; s.dx=dx; s.dz=dz; s.d=Math.hypot(dx,dz); });
    src.sort((a,b)=>a.d-b.d);
    for(let i=0;i<sirenVoices.length;i++){
      const v = sirenVoices[i], s = src[i];
      if(!s || s.d > 150){ T(v.g.gain, 0, 0.1); continue; }
      let f;
      if(s.k===2) f = 650 + 900*((now*2.6)%1);                       // police yelp
      else if(s.k===1) f = (Math.floor(now*1.8)%2) ? 960 : 720;      // ambulance hi-lo
      else f = 520 + 380*(0.5+0.5*Math.sin(now*2.2));                // fire wail
      T(v.o.frequency, f, 0.02);
      T(v.g.gain, 0.09*Math.pow(1-s.d/150, 2), 0.1);
      T(v.p.pan, panOf(s.dx, s.dz, s.d), 0.1);
    }

    // helicopters overhead: news chopper always, rescue chopper when it's out
    const hs = [ newsHeli.mesh ? newsHeli : null, (rescueHeli.mesh && rescueHeli.mode!=='parked') ? rescueHeli : null ];
    for(let i=0;i<heliVoices.length;i++){
      const v = heliVoices[i], o = hs[i];
      if(!o){ T(v.g.gain, 0, 0.2); T(v.d.gain, 0, 0.2); continue; }
      const dx = o.x-cx, dz = o.z-cz, d = Math.hypot(dx, dz, o.alt||0);
      const amp = d < 280 ? 0.11*Math.pow(1-d/280, 2) : 0;
      T(v.g.gain, amp, 0.2); T(v.d.gain, amp*0.9, 0.2);
      T(v.p.pan, panOf(dx, dz, d), 0.2);
    }

    // zombie growl: louder as the nearest one closes in
    const zg = P.zombie;
    if(zombieState.active && zombies.length){
      let dm = Infinity;
      for(let i=0;i<zombies.length;i++){ const d = Math.hypot(zombies[i].x-player.x, zombies[i].z-player.z); if(d<dm) dm = d; }
      const amp = dm < 70 ? 0.16*Math.pow(1-dm/70, 2) : 0;
      T(zg.gain.gain, amp, 0.15); T(zg.depth.gain, amp*0.7, 0.15);
      T(zg.o.frequency, 62 + 10*Math.sin(now*3), 0.1);
    } else {
      T(zg.gain.gain, 0, 0.15); T(zg.depth.gain, 0, 0.15);
    }
  }

  return Object.assign({ init, update, toggleMute, isMuted:()=>muted }, fx);
})();

// Browsers only allow audio after a click/key press, so wake it up on the first one.
['pointerdown','keydown'].forEach(ev=>window.addEventListener(ev, ()=>SFX.init(), true));
document.addEventListener('click', e=>{
  if(e.target.closest && e.target.closest('.btn,.icon-btn,.decal-swatch')) SFX.click();
});
window.addEventListener('keydown', e=>{ if(e.code==='KeyM' && !e.ctrlKey && !e.metaKey && !e.altKey) SFX.toggleMute(); });

// Buildings, curbs, trees, lamps and parked cars never move, so stop three.js
// from rebuilding thousands of matrices every frame, and hide the ones that are
// beyond fog range (which is what makes storms so much cheaper to render).
const cullList = [];
function freezeStaticTown(objs){
  const skip = new Set();
  obstacles.forEach(o=>{ if(o.mesh) skip.add(o.mesh); }); // cones/mailboxes can be knocked flying
  constructionSites.forEach(s=>{
    [s.structureMesh, s.rebarGroup, s.fenceGroup, s.crane.group, s.mixer.mesh, s.excavator.mesh].forEach(x=>{ if(x) skip.add(x); });
    s.workers.forEach(w=>skip.add(w.mesh));
  });
  workZones.forEach(z=>z.workers.forEach(w=>skip.add(w.mesh)));
  harborBoats.forEach(b=>skip.add(b.mesh));
  portDyn.forEach(o=>skip.add(o));
  const box = new THREE.Box3(), size = new THREE.Vector3(), ctr = new THREE.Vector3();
  objs.forEach(o=>{
    if(skip.has(o) || o.userData.noCull) return;
    o.updateMatrixWorld(true);
    o.traverse(c=>{ c.matrixAutoUpdate = false; });
    box.setFromObject(o);
    box.getSize(size); box.getCenter(ctr);
    cullList.push({ obj:o, x:ctr.x, z:ctr.z, r:Math.max(size.x,size.z)/2, lim:o.userData.cullDist || 0 });
  });
}
let _cullFrame = 0;
function updateStaticCulling(){
  if((_cullFrame++ & 3) !== 0) return;
  const lim = scene.fog.far + 60;
  const cx = camera.position.x, cz = camera.position.z;
  for(let i=0;i<cullList.length;i++){
    const c = cullList[i];
    const vis = Math.hypot(cx-c.x, cz-c.z) - c.r < (c.lim ? Math.min(c.lim, lim) : lim);
    if(c.obj.visible !== vis) c.obj.visible = vis;
  }
  const actorLim = Math.min(lim, 420);
  for(let i=0;i<trafficCars.length;i++){
    const m = trafficCars[i].mesh, p = m.position;
    const vis = Math.hypot(cx-p.x, cz-p.z) < actorLim;
    if(m.visible !== vis) m.visible = vis;
  }
  if(!zombieState.active){
    for(let i=0;i<pedestrians.length;i++){
      const m = pedestrians[i].mesh, p = m.position;
      const vis = pedestrians[i].state!=='hidden' && Math.hypot(cx-p.x, cz-p.z) < actorLim;
      if(m.visible !== vis) m.visible = vis;
    }
  }
}
boot();

})();
