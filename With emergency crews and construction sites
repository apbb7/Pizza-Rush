// ----- Decals -----
// A small flag-style plate mounted beside the pizza box rack (a spot every
// vehicle already keeps clear, since the box itself proves it's open air)
// rather than trying to fit a hood/roof decal to six different body
// shapes — sidesteps needing six more sets of hand-tuned mount points.
const DECAL_DEFS = [
  { id:'stripe',  name:'Racing Stripe',  price:120, slot:'roof',  where:'Roof' },
  { id:'flames',  name:'Flames',         price:200, slot:'left',  where:'Left side' },
  { id:'pizza',   name:'Pizza Logo',     price:160, slot:'right', where:'Right side' },
  { id:'checker', name:'Checkered',      price:140, slot:'rear',  where:'Back' },
  { id:'bolt',    name:'Lightning Bolt', price:240, slot:'front', where:'Front' }
];
function loadDecalsFrom(sv){
  if(sv.ownedDecals && typeof sv.ownedDecals==='object') Object.assign(state.ownedDecals, sv.ownedDecals);
  if(sv.equippedDecals && typeof sv.equippedDecals==='object') Object.assign(state.equippedDecals, sv.equippedDecals);
  // old saves had a single free decal: keep it, owned and on
  if(typeof sv.decal==='string' && sv.decal!=='none' && DECAL_DEFS.some(d=>d.id===sv.decal)){
    state.ownedDecals[sv.decal]=true; state.equippedDecals[sv.decal]=true;
  }
}
// Draws the decal artwork on a canvas (used for the 3D texture and the garage picture).
function makeDecalCanvas(type){
  const w=256,h=160;
  const cnv=document.createElement('canvas'); cnv.width=w; cnv.height=h;
  const ctx=cnv.getContext('2d');
  ctx.clearRect(0,0,w,h);
  if(type==='stripe'){
    ctx.fillStyle='#ffffff'; ctx.fillRect(w*0.36,0,w*0.10,h);
    ctx.fillStyle='#e3402c'; ctx.fillRect(w*0.48,0,w*0.07,h);
  } else if(type==='flames'){
    for(let i=0;i<4;i++){
      const cx=w*0.18+i*w*0.22, base=h*0.92;
      ctx.fillStyle='#ff8a3d';
      ctx.beginPath();
      ctx.moveTo(cx-16,base);
      ctx.quadraticCurveTo(cx-24,base-50,cx-4,base-88);
      ctx.quadraticCurveTo(cx+2,base-62,cx+12,base-74);
      ctx.quadraticCurveTo(cx+22,base-36,cx+16,base);
      ctx.closePath(); ctx.fill();
      ctx.fillStyle='#ffd23d';
      ctx.beginPath();
      ctx.moveTo(cx-7,base);
      ctx.quadraticCurveTo(cx-10,base-30,cx-1,base-52);
      ctx.quadraticCurveTo(cx+5,base-30,cx+7,base);
      ctx.closePath(); ctx.fill();
    }
  } else if(type==='pizza'){
    ctx.save(); ctx.translate(w/2,h/2);
    const r=h*0.42;
    ctx.fillStyle='#f4c24d';
    ctx.beginPath(); ctx.moveTo(0,0); ctx.arc(0,0,r,-0.55,0.55); ctx.closePath(); ctx.fill();
    ctx.strokeStyle='#c9962f'; ctx.lineWidth=3; ctx.stroke();
    ctx.fillStyle='#e3402c';
    for(let i=0;i<5;i++){
      const a=-0.4+i*0.2, rr=r*0.55;
      ctx.beginPath(); ctx.arc(Math.cos(a)*rr,Math.sin(a)*rr,r*0.07,0,Math.PI*2); ctx.fill();
    }
    ctx.restore();
  } else if(type==='checker'){
    const cell=h/4;
    for(let cx=0; cx<w; cx+=cell){
      for(let cy=0; cy<h; cy+=cell){
        if(Math.round((cx/cell)+(cy/cell))%2===0){
          ctx.fillStyle='#1b1f2e'; ctx.fillRect(cx,cy,cell,cell);
        }
      }
    }
  } else if(type==='bolt'){
    ctx.fillStyle='#ffd23d';
    ctx.beginPath();
    ctx.moveTo(w*0.58,0); ctx.lineTo(w*0.34,h*0.52); ctx.lineTo(w*0.48,h*0.52);
    ctx.lineTo(w*0.28,h); ctx.lineTo(w*0.68,h*0.46); ctx.lineTo(w*0.5,h*0.46);
    ctx.closePath(); ctx.fill();
  }
  return cnv;
}
function makeDecalTexture(type){
  return new THREE.CanvasTexture(makeDecalCanvas(type));
}
// Decals sit on the body: sides, front, back and roof, each decal in its own spot
// so all five can be on at once. Positions come from the built mesh's bounds.
function attachDecal(){
  if(player.decalGroup){
    player.mesh.remove(player.decalGroup);
    player.decalGroup.traverse(o=>{ if(o.material){ if(o.material.map) o.material.map.dispose(); o.material.dispose(); } if(o.geometry) o.geometry.dispose(); });
    player.decalGroup = null;
  }
  const on = DECAL_DEFS.filter(d=>state.ownedDecals[d.id] && state.equippedDecals[d.id]);
  if(!on.length || !player.mesh) return;
  // bounds of the body only (skip wheels, pizza box, rotors), measured with the mesh at the origin
  const m = player.mesh;
  const sp=m.position.clone(), sr=m.rotation.clone(), ss=m.scale.clone();
  m.position.set(0,0,0); m.rotation.set(0,0,0); m.scale.set(1,1,1); m.updateMatrixWorld(true);
  const skip = new Set([player.pizzaBox, player.rotor, player.tailRotor].concat(player.wheels||[]));
  const box = new THREE.Box3(), tmp = new THREE.Box3();
  m.children.forEach(c=>{
    if(skip.has(c) || c.visible===false) return;
    if(c.geometry && c.geometry.type==='CylinderGeometry' && c.rotation.z && Math.abs(Math.abs(c.rotation.z)-Math.PI/2)<0.01) return; // wheel-like
    tmp.setFromObject(c);
    if(tmp.isEmpty()) return;
    const sz=new THREE.Vector3(); tmp.getSize(sz);
    if(sz.x>6||sz.z>8) return; // ignore oversized helpers (rotor discs etc.)
    box.union(tmp);
  });
  m.position.copy(sp); m.rotation.copy(sr); m.scale.copy(ss); m.updateMatrixWorld(true);
  if(box.isEmpty()) return;
  const size=new THREE.Vector3(), ctr=new THREE.Vector3(); box.getSize(size); box.getCenter(ctr);
  const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
  const grp = new THREE.Group();
  on.forEach(d=>{
    const mat = new THREE.MeshBasicMaterial({ map:makeDecalTexture(d.id), transparent:true, side:THREE.DoubleSide,
      depthWrite:false, polygonOffset:true, polygonOffsetFactor:-2, polygonOffsetUnits:-2 });
    let pw, ph, pos=new THREE.Vector3(), rot=new THREE.Euler();
    const off=0.025;
    if(d.slot==='left'||d.slot==='right'){
      pw=clamp(size.z*0.55,0.6,1.9); ph=Math.min(pw*0.625, Math.max(0.25,size.y*0.55));
      const sgn=d.slot==='right'?1:-1;
      pos.set(sgn>0?box.max.x+off:box.min.x-off, box.min.y+size.y*0.48, ctr.z);
      rot.set(0, sgn*Math.PI/2, 0);
    } else if(d.slot==='front'||d.slot==='rear'){
      pw=clamp(size.x*0.8,0.4,1.6); ph=Math.min(pw*0.625, Math.max(0.25,size.y*0.5));
      const fr=d.slot==='front';
      pos.set(ctr.x, box.min.y+size.y*0.45, fr?box.max.z+off:box.min.z-off);
      rot.set(0, fr?0:Math.PI, 0);
    } else { // roof, image top toward the nose
      pw=clamp(size.x*0.55,0.35,1.2); ph=clamp(size.z*0.6,0.6,2.2);
      pos.set(ctr.x, box.max.y+off, ctr.z);
      rot.set(-Math.PI/2, 0, Math.PI);
    }
    const plate=new THREE.Mesh(new THREE.PlaneGeometry(pw,ph), mat);
    plate.position.copy(pos); plate.rotation.copy(rot); plate.renderOrder=5;
    grp.add(plate);
  });
  m.add(grp);
  player.decalGroup = grp;
}
function buyDecal(id){
  const d=DECAL_DEFS.find(x=>x.id===id); if(!d||state.ownedDecals[id]) return false;
  if(state.money<d.price){ toast('Not enough money for '+d.name+' ($'+d.price+')','bad'); return false; }
  state.money-=d.price; state.ownedDecals[id]=true; state.equippedDecals[id]=true;
  attachDecal(); saveProgress(); updateHUD();
  toast(d.name+' bought and equipped!','good');
  try{ SFX.purchase(); }catch(e){}
  return true;
}
function toggleDecal(id){
  const d=DECAL_DEFS.find(x=>x.id===id); if(!d||!state.ownedDecals[id]) return;
  state.equippedDecals[id]=!state.equippedDecals[id];
  attachDecal(); saveProgress();
  toast(d.name+(state.equippedDecals[id]?' equipped':' removed'),'good');
}

