function makeBrand(wx,wz,restaurant){
  const cats = BRAND_CATS[restaurant?'restaurant':'shop'];
  const keys = Object.keys(cats);
  // prefer categories with no same-type store nearby, then the least-used ones
  const near = new Set(brandState.placed.filter(p=>Math.hypot(p.x-wx,p.z-wz) < 190).map(p=>p.cat));
  let pool = keys.filter(k=>!near.has(k));
  if(!pool.length) pool = keys;
  const minCount = Math.min(...pool.map(k=>brandState.catCount[k]||0));
  let cands = pool.filter(k=>(brandState.catCount[k]||0) <= minCount+1);
  const cat = cands[Math.floor(Math.random()*cands.length)];
  brandState.catCount[cat] = (brandState.catCount[cat]||0)+1;
  brandState.placed.push({x:wx,z:wz,cat});
  const def = cats[cat];
  // unique name
  let name = def.names.find(n=>!brandState.usedNames.has(n) && Math.random()<0.6) || def.names.find(n=>!brandState.usedNames.has(n));
  if(!name){
    const sfx = ['II','Express','& Sons','Corner','Original','Annex','Junction'];
    let tries = 0;
    do{ name = def.names[Math.floor(Math.random()*def.names.length)]+' '+sfx[Math.floor(Math.random()*sfx.length)]; } while(brandState.usedNames.has(name) && ++tries<20);
  }
  brandState.usedNames.add(name);
  const sc = pickScheme();
  const font = BRAND_FONTS[Math.floor(Math.random()*BRAND_FONTS.length)];
  const iconLeft = Math.random()<0.65, badge = Math.floor(Math.random()*3), border = Math.floor(Math.random()*3);
  const tag = def.tag[Math.floor(Math.random()*def.tag.length)];

  const W = 512, H = 128, c = document.createElement('canvas'); c.width = W; c.height = H;
  const x = c.getContext('2d');
  x.fillStyle = sc.bg; x.fillRect(0,0,W,H);
  x.strokeStyle = sc.fg; x.fillStyle = sc.accent;
  if(border===0){ x.lineWidth = 6; x.strokeRect(5,5,W-10,H-10); }
  else if(border===1){ x.lineWidth = 3; x.strokeRect(6,6,W-12,H-12); x.strokeRect(14,14,W-28,H-28); }
  else { x.fillRect(0,H-14,W,14); x.fillRect(0,0,W,8); }
  const bx = iconLeft ? 74 : W-74, by = H/2-(border===2?3:0), br = 44;
  x.fillStyle = sc.accent;
  if(badge===0){ x.beginPath(); x.arc(bx,by,br,0,Math.PI*2); x.fill(); }
  else if(badge===1){ const r=14; x.beginPath(); x.moveTo(bx-br+r,by-br); x.arcTo(bx+br,by-br,bx+br,by+br,r); x.arcTo(bx+br,by+br,bx-br,by+br,r); x.arcTo(bx-br,by+br,bx-br,by-br,r); x.arcTo(bx-br,by-br,bx+br,by-br,r); x.fill(); }
  else { x.beginPath(); for(let i=0;i<6;i++){ const a=Math.PI/6+i*Math.PI/3; x.lineTo(bx+Math.cos(a)*br*1.05,by+Math.sin(a)*br*1.05); } x.closePath(); x.fill(); }
  drawLogo(x, cat, bx, by, br*0.62, sc.bg, '#ffffff');
  const cxText = iconLeft ? 313 : 199, tMax = 340;
  x.fillStyle = sc.fg; x.textAlign = 'center'; x.textBaseline = 'middle';
  x.font = font; x.fillText(name, cxText, H*0.42, tMax);
  x.font = 'bold 20px sans-serif'; x.globalAlpha = 0.85; x.fillText(tag, cxText, H*0.74-(border===2?4:0), tMax); x.globalAlpha = 1;
  const t = new THREE.CanvasTexture(c); t.anisotropy = 4;
  const awc = document.createElement('canvas'); awc.width = 64; awc.height = 16;
  const ax = awc.getContext('2d');
  for(let i=0;i<8;i++){ ax.fillStyle = i&1 ? sc.awB : sc.awA; ax.fillRect(i*8,0,8,16); }
  const at = new THREE.CanvasTexture(awc); at.wrapS = THREE.RepeatWrapping; at.repeat.set(5,1);
  return {
    name, cat,
    signMat: new THREE.MeshBasicMaterial({ map:t }),
    awningMat: new THREE.MeshStandardMaterial({ map:at, roughness:0.85, side:THREE.DoubleSide }),
    wall: sc.wallHex, accent: sc.accentHex
  };
}

