/* =========================================================
   SKYDIVING — press F in a flying helicopter to bail out, H to open the parachute.
   Hit the ground fast and it hurts (or kills); a late chute still saves you.
========================================================= */
const dive = { on:false, y:0, vy:0, h:0, chute:false, mesh:null };
const DEATH_FEE = 100;
function isAirNow(){ return !foot.on && !!vehicleDefs[state.currentVehicle].isAircraft; }

function startSkydive(){
  if(loadLocked()){ toast('Wait for the chef to finish loading! 👨‍🍳', null); return; }
  foot.on = true; foot.air = true;
  foot.vx = player.x; foot.vz = player.z; foot.vang = player.angle;
  foot.vy = terrainHeightAt(player.x,player.z) + player.alt;
  dive.on = true; dive.chute = false; dive.y = foot.vy; dive.vy = 0; dive.h = player.alt;
  const sg = player.speed >= 0 ? 1 : -1;
  player.speed = sg*Math.min(Math.abs(player.speed), 14); player.alt = 0; player.steerInput = 0;
  player._sx = player.x; player._sz = player.z;
  if(!foot.runner) foot.runner = buildRunnerMesh();
  scene.add(foot.runner);
  foot.beacon = makeBeacon(foot.vx, foot.vz, 0x35a7ff, '🚁', 0);
  toast('🪂 You bailed out! Press H to open your parachute!','bad');
}
function openChute(){
  if(!dive.on || dive.chute) return;
  dive.chute = true;
  if(!dive.mesh){
    const g = new THREE.Group();
    const canopy = new THREE.Mesh(new THREE.SphereGeometry(1.9,14,7,0,Math.PI*2,0,Math.PI/2), new THREE.MeshStandardMaterial({color:0xe3402c, side:THREE.DoubleSide, roughness:0.8}));
    canopy.position.y = 3.3; g.add(canopy);
    const stripe = new THREE.Mesh(new THREE.SphereGeometry(1.93,14,7,0,Math.PI*2,0.45,0.35), new THREE.MeshStandardMaterial({color:0xf4f1ea, side:THREE.DoubleSide, roughness:0.8}));
    stripe.position.y = 3.3; g.add(stripe);
    const lineM = new THREE.MeshBasicMaterial({color:0x222222});
    [[1,1],[1,-1],[-1,1],[-1,-1]].forEach(([sx,sz])=>{
      const l = new THREE.Mesh(new THREE.CylinderGeometry(0.012,0.012,3.2,4), lineM);
      l.position.set(sx*0.45, 2.0, sz*0.45); l.rotation.z = -sx*0.28; l.rotation.x = sz*0.28; g.add(l);
    });
    dive.mesh = g;
  }
  foot.runner.add(dive.mesh);
  toast('🪂 Parachute open!','good');
}
function endDiveState(){
  dive.on = false; dive.chute = false; dive.h = 0;
  if(dive.mesh && dive.mesh.parent) dive.mesh.parent.remove(dive.mesh);
  const el = document.getElementById('dive-hud'); if(el) el.style.display = 'none';
}
function diveFloor(){
  let floor = terrainHeightAt(player.x,player.z), roof = null;
  for(let i=0;i<buildings.length;i++){
    const b = buildings[i];
    if(Math.abs(player.x-b.x)<b.hx && Math.abs(player.z-b.z)<b.hz){
      const top = terrainHeightAt(b.x,b.z)+b.height+0.6;
      if(top>floor){ floor = top; roof = b; }
    }
  }
  return { floor, roof };
}
function updateDive(dt){
  if(!dive.on) return;
  if(dive.chute) dive.vy += (-11 - dive.vy)*Math.min(1, dt*3);
  else dive.vy = Math.max(-46, dive.vy - 14*dt);
  dive.y += dive.vy*dt;
  const { floor, roof } = diveFloor();
  const el = document.getElementById('dive-hud');
  if(dive.y <= floor){ landDive(-dive.vy, roof, floor); return; }
  dive.h = dive.y - terrainHeightAt(player.x,player.z);
  if(el){
    el.style.display = 'block';
    el.innerHTML = dive.chute ? '🪂 Gliding down — '+Math.round(dive.y-floor)+' m' : '🪂 FREEFALL — '+Math.round(dive.y-floor)+' m<br><span style="font-weight:600;font-size:12px">Press H to open your parachute!</span>';
    el.style.background = dive.chute ? 'rgba(47,125,79,.92)' : 'rgba(190,35,25,.92)';
  }
}
function landDive(v, roof, floor){
  const overWater = terrainHeightAt(player.x,player.z) < -0.5;
  const chuted = dive.chute;
  endDiveState();
  if(overWater){
    toast('💦 Splashdown! You swim to the quay','good');
    player.x = QUAY_X-3; player._sx = player.x; player._sz = player.z;
    return;
  }
  if(roof){        // came down on a rooftop — take the stairs
    const dx = player.x-roof.x, dz = player.z-roof.z;
    const ex = roof.hx-Math.abs(dx), ez = roof.hz-Math.abs(dz);
    if(ex<ez) player.x = roof.x + Math.sign(dx||1)*(roof.hx+1.2); else player.z = roof.z + Math.sign(dz||1)*(roof.hz+1.2);
    toast('🏢 Landed on a rooftop — taking the stairs down','good');
  }
  if(v < 9 || (chuted && v < 14)){ toast(dive_msgSoft(v),'good'); return; }      // a canopy absorbs the 11 m/s descent
  const dmg = Math.min(1.3,(v-9)/21)*90;
  if(v >= 30 || dmg >= state.damage){ diedFromFall(); return; }
  state.damage -= dmg; updateDamageUI(); SFX.crash(Math.min(1,v/30), true);
  toast('💥 Hard landing! -'+Math.round(dmg)+'% health','bad');
}
function dive_msgSoft(v){ return v<6 ? '🪂 Perfect landing!' : '🪂 Soft landing'; }
function diedFromFall(){
  state.diedFall = true;
  state.damage = 0; updateDamageUI();
  breakdown('died');
}
