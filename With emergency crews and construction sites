  if(Math.random()<0.6){
    const smallR = mainR*0.55;
    const small = new THREE.Mesh(new THREE.DodecahedronGeometry(smallR,0), mat);
    small.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);
    small.position.set(mainR*0.7, smallR*0.35, mainR*0.35);
    g.add(small);
  }
  g.position.set(x,terrainHeightAt(x,z),z);
  castAll(g); scene.add(g);
}

const riverCrossings = {};

function buildRiverCrossing(boundaryX, bridgeZ, key){
  const meshes = [];
  const add = (m)=>{ scene.add(m); meshes.push(m); return m; };

  const riverMat = new THREE.MeshStandardMaterial({ color:0x1fa3b8, roughness:0.2, metalness:0.15, transparent:true, opacity:0.9 });
  const river = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2, 0.5, RIVER_REACH*2), riverMat);
  river.position.set(boundaryX, -0.35, 0);
  river.receiveShadow = true;
  add(river);

  const deckMat = new THREE.MeshStandardMaterial({ color:0x0e0f11, roughness:0.9 });
  const deck = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2+2, 0.5, BRIDGE_HALF_LEN*2), deckMat);
  deck.position.set(boundaryX, 0.05, bridgeZ);
  deck.castShadow = true; deck.receiveShadow = true;
  add(deck);

  const dashMat = new THREE.MeshStandardMaterial({ color:0xffce2e });
  const dashCount = 5;
  const totalLen = RIVER_HALF_WIDTH*2-2;
  for(let i=0;i<dashCount;i++){
    const t = (i+0.5)/dashCount - 0.5;
    const dash = new THREE.Mesh(new THREE.BoxGeometry(1.6,0.06,0.35), dashMat);
    dash.position.set(boundaryX + t*totalLen, 0.32, bridgeZ);
    add(dash);
  }

  const railMat = new THREE.MeshStandardMaterial({ color:0xd9433a, roughness:0.6 });
  const postMat = new THREE.MeshStandardMaterial({ color:0x8a8f96, roughness:0.5, metalness:0.4 });
  [-1,1].forEach(side=>{
    const rail = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2+2, 0.5, 0.25), railMat);
    rail.position.set(boundaryX, 0.55, bridgeZ + side*BRIDGE_HALF_LEN);
    rail.castShadow = true;
    add(rail);
    // Guardrail support posts — turns the railing from a floating bar
    // into something that reads as an actual bridge guardrail.
    for(let t=-1;t<=1;t+=0.5){
      const post = new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,0.7,6), postMat);
      post.position.set(boundaryX + t*(RIVER_HALF_WIDTH-0.3), 0.5, bridgeZ + side*BRIDGE_HALF_LEN);
      post.castShadow = true;
      add(post);
    }
  });
  [-1,1].forEach(side=>{
    const pylon = new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.4,2.4,8), new THREE.MeshStandardMaterial({color:0x6b6b6b}));
    pylon.position.set(boundaryX+side*(RIVER_HALF_WIDTH-0.6), -1.2, bridgeZ);
    pylon.castShadow = true;
    add(pylon);
  });

  const northZ0 = bridgeZ+BRIDGE_HALF_LEN, northZ1 = RIVER_REACH;
  const southZ0 = -RIVER_REACH, southZ1 = bridgeZ-BRIDGE_HALF_LEN;
  const wallEntryNorth = { x:boundaryX, hx:RIVER_HALF_WIDTH, z:(northZ0+northZ1)/2, hz:(northZ1-northZ0)/2 };
  const wallEntrySouth = { x:boundaryX, hx:RIVER_HALF_WIDTH, z:(southZ0+southZ1)/2, hz:(southZ1-southZ0)/2 };
  riverWalls.push(wallEntryNorth, wallEntrySouth);

  const wallMat = new THREE.MeshStandardMaterial({ color:0x736b5e, roughness:0.9 });
  const capMat = new THREE.MeshStandardMaterial({ color:0x9c9384, roughness:0.7 });
  const wallH = 2.4, wallT = 0.7;
  [-1,1].forEach(bank=>{
    const wx = boundaryX + bank*(RIVER_HALF_WIDTH+wallT/2+0.3);
    [[northZ0,northZ1],[southZ0,southZ1]].forEach(([z0,z1])=>{
      const segLen = z1-z0, segCenter = (z0+z1)/2;
      const wall = new THREE.Mesh(new THREE.BoxGeometry(wallT, wallH, segLen), wallMat);
      wall.position.set(wx, wallH/2, segCenter);
      wall.castShadow = true; wall.receiveShadow = true;
      add(wall);
      const cap = new THREE.Mesh(new THREE.BoxGeometry(wallT+0.25, 0.22, segLen), capMat);
      cap.position.set(wx, wallH+0.11, segCenter);
      cap.castShadow = true;
      add(cap);
    });
  });

  riverCrossings[key] = { meshes, wallEntries:[wallEntryNorth, wallEntrySouth], boundaryX };

  // A scatter of rocks along the bank, clear of the bridge approach, for
  // a creek-bed feel. Purely decorative — no collision registered.
  for(let i=0;i<4;i++){
    const side = Math.random()<0.5 ? -1 : 1;
    const rz = TOWN_MIN_Z + Math.random()*(TOWN_MAX_Z-TOWN_MIN_Z);
    if(Math.abs(rz-bridgeZ) < BRIDGE_HALF_LEN+3) continue;
    const rx = boundaryX + side*(RIVER_HALF_WIDTH+wallT+0.8+Math.random()*1.3);
    buildRock(rx, rz);
  }
}

function removeCrossing(key){
  const crossing = riverCrossings[key];
  if(!crossing) return;
  crossing.meshes.forEach(m=>scene.remove(m));
  const bx = crossing.boundaryX;
  for(let i=riverWalls.length-1; i>=0; i--){
    if(Math.abs(riverWalls[i].x - bx) < 0.1) riverWalls.splice(i,1);
  }
  const roadLen = TOWN_MAX_Z - TOWN_MIN_Z + ROAD_W*2;
  const roadMat = new THREE.MeshStandardMaterial({ color:0x0e0f11, roughness:0.9 });
  const roadStrip = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2, 0.08, roadLen), roadMat);
  roadStrip.position.set(bx, 0.04, (TOWN_MIN_Z+TOWN_MAX_Z)/2);
  roadStrip.receiveShadow = true;
  scene.add(roadStrip);
  const dashMat = new THREE.MeshStandardMaterial({ color:0xffce2e });
  const dashStep = 38, dashLen = 24, dashW = 2.4;
  for(let z = TOWN_MIN_Z; z <= TOWN_MAX_Z; z += dashStep){
    const dash = new THREE.Mesh(new THREE.BoxGeometry(dashW, 0.1, dashLen), dashMat);
    dash.position.set(bx, 0.1, z);
    scene.add(dash);
  }
  delete riverCrossings[key];
}

