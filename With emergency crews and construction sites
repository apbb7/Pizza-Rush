function addBarn(m,x,z,flip){
  const prof = new THREE.Shape();
  [[-5,0],[5,0],[5,5],[3.3,7.3],[0,8.6],[-3.3,7.3],[-5,5]].forEach(([a,b],i)=> i?prof.lineTo(a,b):prof.moveTo(a,b));
  const geo = new THREE.ExtrudeGeometry(prof,{ depth:16, bevelEnabled:false });
  geo.translate(0,0,-8);
  m.shape(geo,x,0,z,0xa8322a,flip?Math.PI/2:0);
  const c = Math.cos(flip?Math.PI/2:0), s = Math.sin(flip?Math.PI/2:0);
  const W = (lx,lz)=>[x+lx*c+lz*s, z+lz*c-lx*s];
  // roof slabs
  [[5.15,5.0,3.4,7.3],[3.4,7.3,0,8.7],[-5.15,5.0,-3.4,7.3],[-3.4,7.3,0,8.7]].forEach(([x0,y0,x1,y1])=>{
    const len = Math.hypot(x1-x0,y1-y0), ang = Math.atan2(y1-y0,x1-x0), [wx,wz] = W((x0+x1)/2,0);
    m.box(len,0.28,16.8,wx,(y0+y1)/2,wz,0x4a4d52,0,flip?Math.PI/2:0,ang);
  });
  // double doors with white X braces, trim
  const [dx,dz] = W(0,8.05);
  const ry = flip?Math.PI/2:0;
  m.box(4.6,4.2,0.25,dx,2.1,dz,0x7a2520,0,ry,0);
  m.box(4.8,0.25,0.3,dx,4.3,dz,0xf2efe6,0,ry,0); m.box(0.25,4.3,0.3,dx,2.15,dz,0xf2efe6,0,ry,0);
  [-1,1].forEach(sg=>{ m.box(0.2,5.0,0.3,dx,2.1,dz,0xf2efe6,0,ry,sg*0.8); });
  const [hx,hz] = W(0,8.1); m.box(1.6,1.2,0.3,hx,6.2,hz,0x3b1512,0,ry,0);
}
