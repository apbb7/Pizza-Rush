    case 'SUSHI': ell(0,0,r*0.8,r*0.8,true); c.fillStyle=ac; ell(0,0,r*0.5,r*0.5,true); c.fillStyle='#fff'; ell(0,0,r*0.28,r*0.28,true); break;
    case 'TACOS': c.beginPath(); c.arc(0,r*0.25,r*0.85,Math.PI,0); c.closePath(); c.fill();
      c.fillStyle=ac; for(let i=-2;i<=2;i++){ ell(i*r*0.3,-r*0.15+Math.abs(i)*r*0.05,r*0.14,r*0.14,true); } break;
    case 'BURGERS': c.beginPath(); c.arc(0,-r*0.1,r*0.8,Math.PI,0); c.closePath(); c.fill();
      c.fillStyle=ac; c.fillRect(-r*0.85,-r*0.05,r*1.7,r*0.18);
      c.fillStyle=fg; c.fillRect(-r*0.8,r*0.2,r*1.6,r*0.22); c.beginPath(); c.arc(0,r*0.45,r*0.8,0,Math.PI); c.fill(); break;
    case 'TRATTORIA': ell(0,r*0.12,r*0.7,r*0.65,true); c.fillStyle=ac;
      c.beginPath(); c.moveTo(0,-r*0.5); c.quadraticCurveTo(r*0.5,-r*0.95,r*0.55,-r*0.45); c.quadraticCurveTo(r*0.1,-r*0.45,0,-r*0.5); c.fill(); break;
    case 'NOODLES': c.beginPath(); c.arc(0,0,r*0.8,0,Math.PI); c.closePath(); c.fill();
      c.strokeStyle=ac; c.lineWidth=r*0.12; for(let i=-1;i<=1;i++){ c.beginPath(); c.moveTo(i*r*0.35,-r*0.1); c.quadraticCurveTo(i*r*0.35+r*0.2,-r*0.45,i*r*0.35,-r*0.85); c.stroke(); } break;
