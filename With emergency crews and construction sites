}

const OBSTACLE_TYPES = {
  tree:    { r:0.7,  dmg:5,   weight:80,  build:buildTree },
  lamp:    { r:0.35, dmg:4,   weight:60,  build:buildLamp },
  cone:    { r:0.45, dmg:1,   weight:1,   build:buildCone,    light:true },
  mailbox: { r:0.5,  dmg:1.5, weight:3,   build:buildMailbox, light:true },
  rock:    { r:0.55, dmg:6,   weight:150, build:buildRock }
};
// With no type given, this is a lawn prop (tree or rock) — those only go on grass.
function addObstacle(x,z,typeKey){
  if(!typeKey) typeKey = Math.random()<0.7 ? 'tree' : 'rock';
  const t = OBSTACLE_TYPES[typeKey];
  const mesh = t.build(x,z);
  obstacles.push({x,z,r:t.r,dmg:t.dmg,type:typeKey,weight:t.weight,light:!!t.light,mesh});
}

// Two species (rounded deciduous / conical evergreen), each with random
// trunk height, foliage size, and a scale + rotation jitter on the whole
// group — breaks up what was one identical clip-art tree repeated at
// every spawn point.
const TREE_GREENS = [0x3e8e5b,0x357c4f,0x4a9c66,0x2f7048,0x468a5a];
function buildTree(x,z){
  const g = new THREE.Group();
  const trunkH = 1.3+Math.random()*0.7;
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.15+Math.random()*0.06,0.19+Math.random()*0.08,trunkH,6), new THREE.MeshStandardMaterial({color:0x6b4226}));
  trunk.position.y=trunkH/2; g.add(trunk);
  const fol = TREE_GREENS[Math.floor(Math.random()*TREE_GREENS.length)];
  const folMat = new THREE.MeshStandardMaterial({color:fol});
  if(Math.random()<0.3){
    // Evergreen — a single conical crown.
    const conH = 1.9+Math.random()*0.9;
    const cone = new THREE.Mesh(new THREE.ConeGeometry(0.7+Math.random()*0.3,conH,8), folMat);
    cone.position.y = trunkH+conH*0.42;
    g.add(cone);
  } else {
    // Deciduous — a main canopy plus 1-2 smaller offset clumps so the
    // silhouette isn't a single perfect sphere every time.
    const baseR = 0.8+Math.random()*0.4;
    const main = new THREE.Mesh(new THREE.SphereGeometry(baseR,8,7), folMat);
    main.position.y = trunkH+baseR*0.7;
    g.add(main);
    const clumps = 1+Math.floor(Math.random()*2);
    for(let i=0;i<clumps;i++){
      const r = baseR*(0.5+Math.random()*0.3);
      const clump = new THREE.Mesh(new THREE.SphereGeometry(r,6,6), folMat);
      const ang = Math.random()*Math.PI*2;
      clump.position.set(Math.cos(ang)*baseR*0.55, trunkH+baseR*0.7+(Math.random()-0.5)*baseR*0.6, Math.sin(ang)*baseR*0.55);
      g.add(clump);
    }
  }
  g.rotation.y = Math.random()*Math.PI*2;
  const scale = 0.82+Math.random()*0.4;
  g.scale.set(scale,scale,scale);
  g.position.set(x,terrainHeightAt(x,z),z); castAll(g); scene.add(g);
}
function buildLamp(x,z){
  const g = new THREE.Group();
  const poleH = 3.1+Math.random()*0.6;
  const pole = new THREE.Mesh(new THREE.CylinderGeometry(0.08,0.08,poleH,6), new THREE.MeshStandardMaterial({color:0x333333}));
  pole.position.y=poleH/2; g.add(pole);
  const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.26+Math.random()*0.05,8,8), new THREE.MeshStandardMaterial({color:0xfff0b0, emissive:0xfff0b0, emissiveIntensity:0.7}));
  bulb.position.y=poleH+0.1; g.add(bulb);
  g.position.set(x,terrainHeightAt(x,z),z); castAll(g); scene.add(g);
}
const CONE_GEO = new THREE.ConeGeometry(0.35,0.7,10);
const CONE_MAT = new THREE.MeshStandardMaterial({color:0xe3702c});
function buildCone(x,z){
  const cone = new THREE.Mesh(CONE_GEO, CONE_MAT);
  cone.position.set(x,0.35+terrainHeightAt(x,z),z); cone.castShadow=true; scene.add(cone);
  return cone;
}
function buildMailbox(x,z){
  const box = new THREE.Mesh(new THREE.BoxGeometry(0.5,0.9,0.5), new THREE.MeshStandardMaterial({color:0x3464c4}));
  box.position.set(x,0.6+terrainHeightAt(x,z),z); box.castShadow=true; scene.add(box);
  return box;
}
// Rock outcrop — a cluster of two chunky, irregularly-scaled low-poly
// stones. flatShading keeps them looking rough-hewn instead of smooth.
function buildRock(x,z){
  const g = new THREE.Group();
  const rockColors = [0x8a8a82,0x7a766c,0x94897c,0x6e6a62];
  const mat = new THREE.MeshStandardMaterial({color:rockColors[Math.floor(Math.random()*rockColors.length)], roughness:0.95, flatShading:true});
  const mainR = 0.45+Math.random()*0.35;
  const main = new THREE.Mesh(new THREE.DodecahedronGeometry(mainR,0), mat);
  main.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);
  main.scale.set(1, 0.6+Math.random()*0.25, 1);
  main.position.y = mainR*0.42;
  g.add(main);
  if(Math.random()<0.6){
    const smallR = mainR*0.55;
    const small = new THREE.Mesh(new THREE.DodecahedronGeometry(smallR,0), mat);
    small.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);
    small.position.set(mainR*0.7, smallR*0.35, mainR*0.35);
    g.add(small);
  }
  g.position.set(x,terrainHeightAt(x,z),z);
  castAll(g); scene.add(g);
}

const riverCrossings = {};

function buildRiverCrossing(boundaryX, bridgeZ, key){
  const meshes = [];
  const add = (m)=>{ scene.add(m); meshes.push(m); return m; };

  const riverMat = new THREE.MeshStandardMaterial({ color:0x1fa3b8, roughness:0.2, metalness:0.15, transparent:true, opacity:0.9 });
  const river = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2, 0.5, RIVER_REACH*2), riverMat);
  river.position.set(boundaryX, -0.35, 0);
  river.receiveShadow = true;
  add(river);

  const deckMat = new THREE.MeshStandardMaterial({ color:0x0e0f11, roughness:0.9 });
  const deck = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2+2, 0.5, BRIDGE_HALF_LEN*2), deckMat);
  deck.position.set(boundaryX, 0.05, bridgeZ);
  deck.castShadow = true; deck.receiveShadow = true;
  add(deck);

  const dashMat = new THREE.MeshStandardMaterial({ color:0xffce2e });
  const dashCount = 5;
  const totalLen = RIVER_HALF_WIDTH*2-2;
  for(let i=0;i<dashCount;i++){
    const t = (i+0.5)/dashCount - 0.5;
    const dash = new THREE.Mesh(new THREE.BoxGeometry(1.6,0.06,0.35), dashMat);
    dash.position.set(boundaryX + t*totalLen, 0.32, bridgeZ);
    add(dash);
  }

  const railMat = new THREE.MeshStandardMaterial({ color:0xd9433a, roughness:0.6 });
  const postMat = new THREE.MeshStandardMaterial({ color:0x8a8f96, roughness:0.5, metalness:0.4 });
  [-1,1].forEach(side=>{
    const rail = new THREE.Mesh(new THREE.BoxGeometry(RIVER_HALF_WIDTH*2+2, 0.5, 0.25), railMat);
    rail.position.set(boundaryX, 0.55, bridgeZ + side*BRIDGE_HALF_LEN);
    rail.castShadow = true;
    add(rail);
    // Guardrail support posts — turns the railing from a floating bar
    // into something that reads as an actual bridge guardrail.
    for(let t=-1;t<=1;t+=0.5){
      const post = new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.06,0.7,6), postMat);
      post.position.set(boundaryX + t*(RIVER_HALF_WIDTH-0.3), 0.5, bridgeZ + side*BRIDGE_HALF_LEN);
      post.castShadow = true;
      add(post);
    }
  });
  [-1,1].forEach(side=>{
    const pylon = new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.4,2.4,8), new THREE.MeshStandardMaterial({color:0x6b6b6b}));
    pylon.position.set(boundaryX+side*(RIVER_HALF_WIDTH-0.6), -1.2, bridgeZ);
    pylon.castShadow = true;
    add(pylon);
  });

  const northZ0 = bridgeZ+BRIDGE_HALF_LEN, northZ1 = RIVER_REACH;
  const southZ0 = -RIVER_REACH, southZ1 = bridgeZ-BRIDGE_HALF_LEN;
  const wallEntryNorth = { x:boundaryX, hx:RIVER_HALF_WIDTH, z:(northZ0+northZ1)/2, hz:(northZ1-northZ0)/2 };
  const wallEntrySouth = { x:boundaryX, hx:RIVER_HALF_WIDTH, z:(southZ0+southZ1)/2, hz:(southZ1-southZ0)/2 };
  riverWalls.push(wallEntryNorth, wallEntrySouth);

  const wallMat = new THREE.MeshStandardMaterial({ color:0x736b5e, roughness:0.9 });
  const capMat = new THREE.MeshStandardMaterial({ color:0x9c9384, roughness:0.7 });
  const wallH = 2.4, wallT = 0.7;
  [-1,1].forEach(bank=>{
    const wx = boundaryX + bank*(RIVER_HALF_WIDTH+wallT/2+0.3);
    [[northZ0,northZ1],[southZ0,southZ1]].forEach(([z0,z1])=>{
      const segLen = z1-z0, segCenter = (z0+z1)/2;
      const wall = new THREE.Mesh(new THREE.BoxGeometry(wallT, wallH, segLen), wallMat);
      wall.position.set(wx, wallH/2, segCenter);
      wall.castShadow = true; wall.receiveShadow = true;
      add(wall);
      const cap = new THREE.Mesh(new THREE.BoxGeometry(wallT+0.25, 0.22, segLen), capMat);
      cap.position.set(wx, wallH+0.11, segCenter);
      cap.castShadow = true;
      add(cap);
    });
  });

  riverCrossings[key] = { meshes, wallEntries:[wallEntryNorth, wallEntrySouth], boundaryX };

  // A scatter of rocks along the bank, clear of the bridge approach, for
  // a creek-bed feel. Purely decorative — no collision registered.
  for(let i=0;i<4;i++){
    const side = Math.random()<0.5 ? -1 : 1;
    const rz = TOWN_MIN_Z + Math.random()*(TOWN_MAX_Z-TOWN_MIN_Z);
    if(Math.abs(rz-bridgeZ) < BRIDGE_HALF_LEN+3) continue;
    const rx = boundaryX + side*(RIVER_HALF_WIDTH+wallT+0.8+Math.random()*1.3);
    buildRock(rx, rz);
  }
}

function removeCrossing(key){
  const crossing = riverCrossings[key];
  if(!crossing) return;
  crossing.meshes.forEach(m=>scene.remove(m));
  const bx = crossing.boundaryX;
  for(let i=riverWalls.length-1; i>=0; i--){
    if(Math.abs(riverWalls[i].x - bx) < 0.1) riverWalls.splice(i,1);
  }
  // Once the river is gone the ground's own road texture (same asphalt width,
  // sidewalks and lane dashes as every other street) shows through, so no
  // extra, wider asphalt strip is laid down here.
  delete riverCrossings[key];
}

function buildLockGate(x, bridgeZ, id, label){
