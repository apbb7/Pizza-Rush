const LIGHT_STAGES = [
  { dur:7, x:'green',  z:'red'    },
  { dur:2, x:'yellow', z:'red'    },
  { dur:7, x:'red',    z:'green'  },
  { dur:2, x:'red',    z:'yellow' }
];
const LIGHT_CYCLE = LIGHT_STAGES.reduce((a,s)=>a+s.dur,0);
let lightClock = 0;
const trafficLightProps = [];
function currentLightPhase(){
  let t = lightClock % LIGHT_CYCLE;
  for(const s of LIGHT_STAGES){ if(t<s.dur) return s; t-=s.dur; }
  return LIGHT_STAGES[0];
}
const trafficLensMats = [];   // {axis, color, mat}
let _lastLightPhase = null;
function updateTrafficLightVisuals(){
  const phase = currentLightPhase();
  if(phase === _lastLightPhase) return;
  _lastLightPhase = phase;
  for(let i=0;i<trafficLensMats.length;i++){
    const l = trafficLensMats[i];
    const st = l.axis==='x' ? phase.x : phase.z;
    l.mat.emissiveIntensity = st===l.color ? 1.3 : 0;
  }
}

// Every signal in the city is drawn with a handful of instanced meshes. One pole per
// diagonal corner covers all four approaches: each pole has a head facing the cars
// coming along x and another facing the cars coming along z.
function buildTrafficLights(list){
  const N = list.length;
  if(!N) return;
  const poleIM  = new THREE.InstancedMesh(new THREE.CylinderGeometry(0.1,0.12,4.2,8), new THREE.MeshStandardMaterial({color:0x2c2e33, roughness:0.6, metalness:0.3}), N);
  const headMat = new THREE.MeshStandardMaterial({color:0x1a1c20, roughness:0.6});
  const headXIM = new THREE.InstancedMesh(new THREE.BoxGeometry(0.28,0.85,0.3), headMat, N);
  const headZIM = new THREE.InstancedMesh(new THREE.BoxGeometry(0.3,0.85,0.28), headMat, N);
  const lensGeo = new THREE.SphereGeometry(0.085,8,8);
  const lens = { x:[], z:[] };
  [['red',0xff3b30],['yellow',0xf4c24d],['green',0x3ecf6b]].forEach(([name,hex])=>{
    ['x','z'].forEach(ax=>{
      const mat = new THREE.MeshStandardMaterial({ color:new THREE.Color(hex).multiplyScalar(0.3), emissive:hex, emissiveIntensity:0 });
      lens[ax].push(new THREE.InstancedMesh(lensGeo, mat, N));
      trafficLensMats.push({ axis:ax, color:name, mat });
    });
  });
  const m = new THREE.Matrix4(), q = new THREE.Quaternion(), sc = new THREE.Vector3(1,1,1), pos = new THREE.Vector3();
  list.forEach((L,i)=>{
    const gy = terrainHeightAt(L.x, L.z);
    const put = (im,lx,ly,lz)=>{ pos.set(L.x+lx, gy+ly, L.z+lz); m.compose(pos,q,sc); im.setMatrixAt(i,m); };
    put(poleIM, 0, 2.1, 0);
    put(headXIM, 0, 3.85, -L.sz*0.3);
    put(headZIM, -L.sx*0.3, 3.85, 0);
    for(let k=0;k<3;k++){
      put(lens.x[k],  L.sx*0.16, 4.15-k*0.25, -L.sz*0.3);
      put(lens.z[k], -L.sx*0.3,  4.15-k*0.25,  L.sz*0.16);
    }
  });
  [poleIM, headXIM, headZIM, ...lens.x, ...lens.z].forEach(im=>{
    im.instanceMatrix.needsUpdate = true;
    im.frustumCulled = false;   // instances are spread over the whole city
    scene.add(im);
  });
}

let lineXsGlobal = [], lineZsGlobal = [];

function buildTraffic(){
  const carColors = [0x4d8fe3,0xe3402c,0xf4c24d,0x6b6b6b,0x8a5a9c,0x2c8a5a,0xffffff];
  const isRiverLine = (c)=> Math.abs(Math.abs(c)-RIVER_X)<0.01 || Math.abs(Math.abs(c)-RIVER_X2)<0.01;
  const LANE_OFFSET = 3;
  const lanes = [];
  const lineXs = [], lineZs = [];

  // Weight streets and spawn positions by nearby building density, so
  // busy downtown blocks draw noticeably more traffic than a lone
  // warehouse lot, and the total scales with how big the city actually is.
  const countByIx = {}, countByIz = {};
  buildings.forEach(b=>{
    countByIx[b.ix] = (countByIx[b.ix]||0) + 1;
    countByIz[b.iz] = (countByIz[b.iz]||0) + 1;
  });
  function weightedIndex(range, countByIdx){
    let total = 0;
    const items = [];
    for(let k=range[0]; k<=range[1]; k++){
      const w = (countByIdx[k]||0) + 1; // +1 baseline so every block keeps a little traffic
      items.push({k,w});
      total += w;
    }
    let r = Math.random()*total;
    for(const it of items){ r -= it.w; if(r<=0) return it.k; }
    return items[items.length-1].k;
  }

  for(let k=IX_RANGE[0]; k<IX_RANGE[1]; k++){
    const c=(k+0.5)*BLOCK;
    if(isRiverLine(c)) continue;
    lineXs.push(c);
    const weight = (countByIx[k]||0) + (countByIx[k+1]||0) + 1;
    // a north-south street at x=c: cars travel along z, keeping to their side of the centre line
    lanes.push({axis:'z', cross:c-LANE_OFFSET, dir:1, weight});
    lanes.push({axis:'z', cross:c+LANE_OFFSET, dir:-1, weight});
  }
  for(let k=IZ_RANGE[0]; k<IZ_RANGE[1]; k++){
    const c=(k+0.5)*BLOCK;
    lineZs.push(c);
    const weight = (countByIz[k]||0) + (countByIz[k+1]||0) + 1;
    // an east-west street at z=c: cars travel along x
    lanes.push({axis:'x', cross:c+LANE_OFFSET, dir:1, weight});
    lanes.push({axis:'x', cross:c-LANE_OFFSET, dir:-1, weight});
  }
  lineXsGlobal = lineXs; lineZsGlobal = lineZs;

  const totalLaneWeight = lanes.reduce((sum,l)=>sum+l.weight, 0);
  function pickWeightedLane(){
    let r = Math.random()*totalLaneWeight;
    for(const l of lanes){ r -= l.weight; if(r<=0) return l; }
    return lanes[lanes.length-1];
  }

  // Total traffic now scales with the size of the city (total buildings),
  // clamped so an especially large map still stays smooth.
  // Buildings are now cheap (see PERF FIX comments above), so traffic can
  // afford to be much denser than the conservative count from before.
  const carVariants = [
    { build: buildCarMesh,       lenHalf:1.75, widHalf:0.95 },
    { build: buildHatchbackMesh, lenHalf:1.3,  widHalf:0.9  },
    { build: buildSUVMesh,       lenHalf:1.9,  widHalf:1.0  },
    { build: buildPickupMesh,    lenHalf:2.0,  widHalf:0.95 }
  ];
  const truckVariants = [
    { build: buildTruckMesh,    lenHalf:3.3, widHalf:1.15 },
    { build: buildCargoVanMesh, lenHalf:2.1, widHalf:1.05 }
  ];
  const desiredCars = Math.max(120, Math.min(280, Math.round(buildings.length * 0.65)));
  const PATROL_HALF = BLOCK*2.5; // cars stick to a neighborhood instead of roaming the whole map
  for(let i=0;i<desiredCars;i++){
    const lane = pickWeightedLane();
    const fullSpan = (lane.axis==='x') ? (IX_RANGE[1]-IX_RANGE[0])*BLOCK*0.5 : (IZ_RANGE[1]-IZ_RANGE[0])*BLOCK*0.5;
    const homeIdx = lane.axis==='x' ? weightedIndex(IX_RANGE, countByIx) : weightedIndex(IZ_RANGE, countByIz);
    const homePos = homeIdx*BLOCK;
    let min = Math.max(-fullSpan, homePos-PATROL_HALF);
    let max = Math.min(fullSpan, homePos+PATROL_HALF);
    if(lane.axis==='x' && Math.abs(lane.cross-BRIDGE_Z) > 7){      // only the bridge road crosses the rivers
      const rv = [-RIVER_X2,-RIVER_X,RIVER_X,RIVER_X2];
      rv.forEach(r=>{ if(r<homePos) min = Math.max(min, r+RIVER_HALF_WIDTH+12); else max = Math.min(max, r-RIVER_HALF_WIDTH-12); });
      if(max-min<30){ min = homePos-15; max = homePos+15; }
    }

    const isTruck = Math.random()<0.22;
    const variant = (isTruck ? truckVariants : carVariants)[Math.floor(Math.random()*(isTruck?truckVariants:carVariants).length)];
    const color = carColors[Math.floor(Math.random()*carColors.length)];
    const mesh = variant.build(color);
    scene.add(mesh);
    const cruiseSpeed = isTruck ? (8+Math.random()*2.5) : (10+Math.random()*3.5); // ~40 mph average for cars
    const lenHalf = variant.lenHalf, widHalf = variant.widHalf;
    trafficCars.push({
      mesh, axis:lane.axis, cross:lane.cross, laneId:lane.axis+lane.cross+'/'+lane.dir,
      min, max,
      speed: cruiseSpeed,
      curSpeed: cruiseSpeed,
      dir: lane.dir,
      pos: min + Math.random()*(max-min),
      r: isTruck ? 2.0 : 1.6,
      type: isTruck ? 'truck' : 'car',
      dmg: isTruck ? 12 : 6,
      hx: lane.axis==='x' ? lenHalf : widHalf,
      hz: lane.axis==='x' ? widHalf : lenHalf
    });
  }

  // Signals stand on the sidewalk corners of each real intersection (two diagonal poles cover all four approaches).
  const cornerOff = ROAD_W/2 - SIDEWALK_W/2;
  const lightList = [];
  lineXs.forEach(lx=>{
    lineZs.forEach(lz=>{
      lightList.push({ x:lx+cornerOff, z:lz+cornerOff, sx:1,  sz:1  });
      lightList.push({ x:lx-cornerOff, z:lz-cornerOff, sx:-1, sz:-1 });
    });
  });
  buildTrafficLights(lightList);
}


