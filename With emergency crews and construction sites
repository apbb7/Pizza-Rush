      c.quadraticCurveTo(-r*0.95,-r*0.1,0,-r*0.95); c.fill(); c.fillStyle=ac; c.beginPath(); c.moveTo(0,-r*0.1); c.quadraticCurveTo(r*0.45,r*0.3,0,r*0.7); c.quadraticCurveTo(-r*0.45,r*0.3,0,-r*0.1); c.fill(); break;
    case 'CREPES': c.beginPath(); c.moveTo(-r*0.9,r*0.6); c.lineTo(r*0.9,r*0.6); c.lineTo(0,-r*0.8); c.closePath(); c.fill();
      c.fillStyle=ac; ell(0,-r*0.1,r*0.22,r*0.22,true); break;
    case 'CAFE': c.fillRect(-r*0.6,-r*0.4,r*1.2,r*0.95); ell(r*0.7,r*0.05,r*0.3,r*0.3,false);
      c.strokeStyle=ac; c.lineWidth=r*0.1; for(const i of [-0.3,0.1,0.5]){ c.beginPath(); c.moveTo(i*r,-r*0.55); c.quadraticCurveTo(i*r+r*0.15,-r*0.75,i*r,-r*0.95); c.stroke(); } break;
    case 'OYSTERS': c.beginPath(); c.moveTo(0,r*0.85); c.quadraticCurveTo(-r*1.1,r*0.1,-r*0.3,-r*0.75); c.lineTo(r*0.3,-r*0.75); c.quadraticCurveTo(r*1.1,r*0.1,0,r*0.85); c.fill();
      c.fillStyle=ac; ell(0,r*0.05,r*0.2,r*0.2,true); break;
    case 'DINER': c.beginPath(); for(let i=0;i<10;i++){ const a=-Math.PI/2+i*Math.PI/5, rr=i%2?r*0.4:r*0.95; c.lineTo(Math.cos(a)*rr,Math.sin(a)*rr); } c.closePath(); c.fill();
      c.fillStyle=ac; ell(0,0,r*0.2,r*0.2,true); break;
    case 'BISTRO': c.lineWidth=r*0.16; c.beginPath(); c.moveTo(-r*0.45,-r*0.85); c.lineTo(-r*0.45,r*0.85); c.stroke();
      c.beginPath(); c.moveTo(r*0.45,-r*0.85); c.lineTo(r*0.45,r*0.85); c.stroke(); c.fillStyle=ac; ell(0,-r*0.3,r*0.28,r*0.5,true); break;
