// Rough masonry-block texture for the city wall — replaces a flat solid
// gray box with something that reads as stacked stone.
function makeStoneWallTexture(){
  const w=128,h=64;
  const cnv=document.createElement('canvas'); cnv.width=w; cnv.height=h;
  const ctx=cnv.getContext('2d');
  ctx.fillStyle='#4d4740'; ctx.fillRect(0,0,w,h);
  const rows=4, cols=6, cw=w/cols, rh=h/rows;
  for(let r=0;r<rows;r++){
    const offset = (r%2)*(cw/2);
    for(let c=-1;c<=cols;c++){
      const bx=c*cw+offset, by=r*rh;
      const shade = 0.75+Math.random()*0.4;
      ctx.fillStyle = `rgb(${Math.floor(108*shade)},${Math.floor(100*shade)},${Math.floor(90*shade)})`;
      ctx.fillRect(bx+1.2, by+1.2, cw-2.4, rh-2.4);
    }
  }
  const tex = new THREE.CanvasTexture(cnv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  return tex;
}

function buildCityPerimeterWall(){
  const stoneTex = makeStoneWallTexture();
  const capMat = new THREE.MeshStandardMaterial({ color:0x847c6e, roughness:0.7 });
  const wallH = 3.2, wallT = 1.2;
  const segs = [
    { x:0, z:TOWN_MIN_Z, sx:TOWN_MAX_X-TOWN_MIN_X, sz:wallT },
    { x:0, z:TOWN_MAX_Z, sx:TOWN_MAX_X-TOWN_MIN_X, sz:wallT },
    { x:TOWN_MIN_X, z:0, sx:wallT, sz:TOWN_MAX_Z-TOWN_MIN_Z },
    { x:TOWN_MAX_X, z:0, sx:wallT, sz:TOWN_MAX_Z-TOWN_MIN_Z }
  ];
  segs.forEach(s=>{
    const tex = stoneTex.clone();
    tex.needsUpdate = true;
    tex.repeat.set(Math.max(1,Math.round(s.sx/6)), Math.max(1,Math.round(wallH/2)));
    const wallMat = new THREE.MeshStandardMaterial({ map:tex, roughness:0.92 });
    const wall = new THREE.Mesh(new THREE.BoxGeometry(s.sx, wallH, s.sz), wallMat);
    wall.position.set(s.x, terrainHeightAt(s.x,s.z)+wallH/2, s.z);
    wall.castShadow = true; wall.receiveShadow = true;
    scene.add(wall);
    const cap = new THREE.Mesh(new THREE.BoxGeometry(s.sx+0.3, 0.26, s.sz+0.3), capMat);
    cap.position.set(s.x, terrainHeightAt(s.x,s.z)+wallH+0.13, s.z);
    cap.castShadow = true;
    scene.add(cap);
    boundaryWalls.push({ x:s.x, z:s.z, hx:s.sx/2, hz:s.sz/2 });
  });
}

