// Rock outcrop — a cluster of two chunky, irregularly-scaled low-poly
// stones. flatShading keeps them looking rough-hewn instead of smooth.
function buildRock(x,z){
  const g = new THREE.Group();
  const rockColors = [0x8a8a82,0x7a766c,0x94897c,0x6e6a62];
  const mat = new THREE.MeshStandardMaterial({color:rockColors[Math.floor(Math.random()*rockColors.length)], roughness:0.95, flatShading:true});
  const mainR = 0.45+Math.random()*0.35;
  const main = new THREE.Mesh(new THREE.DodecahedronGeometry(mainR,0), mat);
  main.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);
  main.scale.set(1, 0.6+Math.random()*0.25, 1);
  main.position.y = mainR*0.42;
