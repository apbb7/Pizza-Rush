function buildTruckMesh(color){
  const g = new THREE.Group();
  const cab = new THREE.Mesh(new THREE.BoxGeometry(2.1,1.7,2.0), new THREE.MeshStandardMaterial({color, roughness:0.5, metalness:0.2}));
  cab.position.set(0,1.0,2.3); g.add(cab);
  const windshield = new THREE.Mesh(new THREE.BoxGeometry(1.9,0.7,0.1), new THREE.MeshStandardMaterial({color:0x223344, roughness:0.3}));
  windshield.position.set(0,1.55,3.25); g.add(windshield);
  const cargo = new THREE.Mesh(new THREE.BoxGeometry(2.3,2.4,4.6), new THREE.MeshStandardMaterial({color:0xe8e6df, roughness:0.75}));
  cargo.position.set(0,1.6,-1.0); g.add(cargo);
