function resolveBoxCollision(px,pz,box,radius){
  const closeX = Math.max(box.x-box.hx, Math.min(px, box.x+box.hx));
  const closeZ = Math.max(box.z-box.hz, Math.min(pz, box.z+box.hz));
  let dx = px-closeX, dz = pz-closeZ;
  const distSq = dx*dx+dz*dz;
  if(distSq < radius*radius){
    let dist = Math.sqrt(distSq);
    if(dist < 0.0001){
      const oxX = box.hx - Math.abs(px-box.x);
      const oxZ = box.hz - Math.abs(pz-box.z);
      if(oxX < oxZ){ dx = px>box.x ? oxX+radius : -(oxX+radius); dz = 0; }
      else          { dx = 0; dz = pz>box.z ? oxZ+radius : -(oxZ+radius); }
      dist = Math.abs(dx||dz);
    }
    const nx = dx/dist, nz = dz/dist;
    const push = radius-dist;
    return { hit:true, nx, nz, push };
  }
  return { hit:false };
}

function applyDamage(amount){
  const stats = baseStats();
  const speedFrac = Math.min(1, Math.abs(player.speed)/Math.max(1,stats.maxSpeed));
  // Crashes hit harder now: overall damage scaled up, and even a slow bump
  // still costs at least half its damage (was a 0.35 floor) instead of
  // being almost free at low speed.
  const scaled = amount * 1.75 * Math.max(0.5, speedFrac) * stats.armor;
  state.damage = Math.max(0, state.damage - scaled);
  updateDamageUI();
  if(state.damage<=0) breakdown();
}

