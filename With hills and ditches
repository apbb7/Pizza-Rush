function isClearX(x, margin){
  if(x > TOWN_MAX_X-margin || x < TOWN_MIN_X+margin) return false;
  if(Math.abs(Math.abs(x)-RIVER_X)  < RIVER_HALF_WIDTH+margin) return false;
  if(Math.abs(Math.abs(x)-RIVER_X2) < RIVER_HALF_WIDTH+margin) return false;
  return true;
}
function isClearZ(z, margin){
  return z <= TOWN_MAX_Z-margin && z >= TOWN_MIN_Z+margin;
}

function curbsideMarkerPos(b){
  const blockCenterX = b.ix*BLOCK, blockCenterZ = b.iz*BLOCK;
  const sidewalkR = BLOCK_HALF + SIDEWALK_W*0.55;
  const margin = 2;
  if(Math.abs(b.hz - BLOCK_HALF) < 0.5){
    let pz = blockCenterZ + sidewalkR;
    if(!isClearZ(pz, margin)) pz = blockCenterZ - sidewalkR;
    return { x:b.x, z:pz };
  }
  if(Math.abs(b.hx - BLOCK_HALF) < 0.5){
    let px = blockCenterX + sidewalkR;
    if(!isClearX(px, margin)) px = blockCenterX - sidewalkR;
    return { x:px, z:b.z };
  }
  let pz = blockCenterZ + sidewalkR;
  if(!isClearZ(pz, margin)) pz = blockCenterZ - sidewalkR;
  return { x:blockCenterX, z:pz };
}

function pickDestination(){
  const pool = buildings.filter(b=>{
    if(b.isShop) return false; // never deliver back to the shop itself
    if(b.dist==='suburbs' && !state.unlocked.suburbs) return false;
    if(b.dist==='industrial' && !state.unlocked.industrial) return false;
    if(b.dist==='harbor' && !state.unlocked.harbor) return false;
    if(b.dist==='oldtown' && !state.unlocked.oldtown) return false;
    return true;
  });
  return pool[Math.floor(Math.random()*pool.length)];
}

