function buildCityPerimeterWall(){
  const wallMat = new THREE.MeshStandardMaterial({ color:0x5c5650, roughness:0.9 });
  const capMat = new THREE.MeshStandardMaterial({ color:0x847c6e, roughness:0.7 });
  const wallH = 3.2, wallT = 1.2;
  const segs = [
    { x:0, z:TOWN_MIN_Z, sx:TOWN_MAX_X-TOWN_MIN_X, sz:wallT },
    { x:0, z:TOWN_MAX_Z, sx:TOWN_MAX_X-TOWN_MIN_X, sz:wallT },
    { x:TOWN_MIN_X, z:0, sx:wallT, sz:TOWN_MAX_Z-TOWN_MIN_Z },
    { x:TOWN_MAX_X, z:0, sx:wallT, sz:TOWN_MAX_Z-TOWN_MIN_Z }
  ];
  segs.forEach(s=>{
    const wall = new THREE.Mesh(new THREE.BoxGeometry(s.sx, wallH, s.sz), wallMat);
    wall.position.set(s.x, wallH/2, s.z);
    wall.castShadow = true; wall.receiveShadow = true;
    scene.add(wall);
    const cap = new THREE.Mesh(new THREE.BoxGeometry(s.sx+0.3, 0.26, s.sz+0.3), capMat);
    cap.position.set(s.x, wallH+0.13, s.z);
    cap.castShadow = true;
    scene.add(cap);
    boundaryWalls.push({ x:s.x, z:s.z, hx:s.sx/2, hz:s.sz/2 });
  });
}

