  body.position.y=0.55; g.add(body);
  const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.4,0.55,1.7), new THREE.MeshStandardMaterial({color:0x223344, roughness:0.3}));
  cabin.position.set(0,1.05,-0.2); g.add(cabin);
  const wheelMat = new THREE.MeshStandardMaterial({color:0x111111});
  [[0.95,-1.1],[ -0.95,-1.1],[0.95,1.1],[-0.95,1.1]].forEach(([wx,wz])=>{
    const w = new THREE.Mesh(new THREE.CylinderGeometry(0.35,0.35,0.32,10), wheelMat);
    w.rotation.z = Math.PI/2;
    w.position.set(wx,0.35,wz);
    g.add(w);
