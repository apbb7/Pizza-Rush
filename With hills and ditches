document.getElementById('newgame-btn').addEventListener('click', async ()=>{
  if(!confirm('Delete your saved progress and start fresh?')) return;
  if(window.storage) try{ await window.storage.delete(SAVE_KEY); }catch(e){}
  location.reload();
});

async function boot(){
  let hasSave = false;
  if(window.storage){
    try{
      const res = await window.storage.get(SAVE_KEY);
      if(res && res.value){
        const sv = JSON.parse(res.value);
        if(sv.money        != null) state.money        = sv.money;
        if(sv.deliveries   != null) state.deliveries   = sv.deliveries;
        if(sv.unlocked)  Object.keys(sv.unlocked).forEach(k=>{ if(sv.unlocked[k]) state.unlocked[k] = true; });
        if(sv.upgrades){
          ['engine','handling','insulation'].forEach(k=>{
            if(sv.upgrades[k] != null)
              state.upgrades[k].level = Math.min(state.upgrades[k].max, sv.upgrades[k]);
          });
        }
        if(sv.ownedVehicles) Object.assign(state.ownedVehicles, sv.ownedVehicles);
        if(sv.currentVehicle && state.ownedVehicles[sv.currentVehicle])
          state.currentVehicle = sv.currentVehicle;
        hasSave = true;
      }
    } catch(e){}
  }

  const saveEl = document.getElementById('save-status');
  const newBtn = document.getElementById('newgame-btn');
  if(hasSave){
    saveEl.textContent = '💾 Save found — $'+state.money.toFixed(2)+' · '+state.deliveries+' deliveries';
    newBtn.style.display = 'inline-block';
  } else {
    saveEl.textContent = 'No save found — starting fresh.';
  }

  buildTown();
  // Displace the ground now that every building (and the shop's driveway)
  // is registered, so flattened pads under buildings and the driveway
  // line up correctly with the terrain.
  applyTerrainDisplacement();
  buildTraffic();
  spawnPedestrians();
  buildRiverCrossing(RIVER_X, BRIDGE_Z, 'suburbs');
  buildRiverCrossing(-RIVER_X, BRIDGE_Z, 'industrial');
  buildRiverCrossing(RIVER_X2, BRIDGE_Z, 'harbor');
  buildRiverCrossing(-RIVER_X2, BRIDGE_Z, 'oldtown');
  gateSuburbs    = buildLockGate(RIVER_X,  BRIDGE_Z, 'suburbs',    'Suburbs — buy in city map');
  gateIndustrial = buildLockGate(-RIVER_X, BRIDGE_Z, 'industrial', 'Industrial — buy in city map');
  gateHarbor     = buildLockGate(RIVER_X2, BRIDGE_Z, 'harbor',     'Harbor — buy in city map');
  gateOldtown    = buildLockGate(-RIVER_X2,BRIDGE_Z, 'oldtown',    'Old Town — buy in city map');
  buildCityPerimeterWall();

  Object.keys(state.unlocked).forEach(key=>{
    if(state.unlocked[key]){
      const gate = {suburbs:()=>gateSuburbs, industrial:()=>gateIndustrial, harbor:()=>gateHarbor, oldtown:()=>gateOldtown}[key];
      if(gate){ const g=gate(); if(g) scene.remove(g.mesh, g.sprite); }
      removeCrossing(key);
    }
  });

  applyVehicleMesh(state.currentVehicle);

  updateDamageUI();
  updateHUD();
  animate();
}
boot();

})();
</script>
</body>
