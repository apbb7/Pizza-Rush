const buildings = [];   // {x,z,hx,hz,height,mesh}
const obstacles  = [];  // {x,z,r,dmg,type}
const drivewayZones = []; // {x,z,hx,hz} - paved driveways that count as full-speed road
const gates      = [];  // {x,z,hx,hz,mesh,id}
const riverWalls = [];  // {x,z,hx,hz} - permanent impassable river segments
const boundaryWalls = []; // {x,z,hx,hz} - the wall ringing the whole playable city
const trafficCars = [];
const pedestrians = [];

/* =========================================================
   TERRAIN — two layers. A handful of broad, gentle hills affect the whole
   city uniformly (roads included — driving over them is the point), plus
   finer rolling/ditch detail confined to yards and lots. Roads/sidewalks/
   driveway/building footprints are still flattened relative to whichever
   hill they're on, so traffic lanes, the A* route the minimap draws, and
   every (2D, height-blind) collision box keep working — the hills are a
   smooth height field, not a rewrite of where anything actually is.
========================================================= */
function smoothstep01(t){ t=Math.max(0,Math.min(1,t)); return t*t*(3-2*t); }

// Cheap large-wavelength value noise (a handful of summed sine waves) —
// no need for a real Perlin/simplex implementation for gentle rolling
// detail. Kept to long wavelengths (see the low frequency multipliers)
// so it reads as broad undulation rather than choppy per-block bumps.
function terrainNoise(x,z){
  return (
    Math.sin(x*0.010 + 1.7)      + Math.sin(z*0.012 - 0.4) +
    Math.sin((x+z)*0.007 + 3.1)*0.6 +
    Math.sin((x-z)*0.008 - 2.2)*0.4
  ) / 3.0;
}

// A few named hills scattered through the outer districts, each a smooth
// dome (zero slope at both the peak and the outer edge, so there's no
// kink where it meets flat ground) — kept well clear of the shop's block,
// the rivers/bridges, and the city wall so those stay completely flat.
const HILLS = [
  { x: 5*BLOCK,    z: 3*BLOCK,  radius:100, amp:3.4 },  // suburbs
  { x: -5*BLOCK,   z: -3*BLOCK, radius:100, amp:3.2 },  // industrial
  { x: 8.5*BLOCK,  z: -2*BLOCK, radius:100, amp:3.0 },  // harbor
  { x: -8.5*BLOCK, z: 2*BLOCK,  radius:100, amp:3.0 },  // old town
  { x: 2*BLOCK,    z: 4*BLOCK,  radius:85,  amp:2.2 },  // a smaller one downtown-adjacent
];
function bigHillHeight(x,z){
  let h = 0;
  for(let i=0;i<HILLS.length;i++){
    const hl = HILLS[i];
    const d = Math.hypot(x-hl.x, z-hl.z);
    if(d < hl.radius){
      const t = d/hl.radius;
      const contrib = hl.amp * (0.5 + 0.5*Math.cos(t*Math.PI));
      if(contrib > h) h = contrib;
    }
  }
  return h;
}

const TERRAIN_AMPLITUDE = 1.6; // metres of gentle rolling relief in open yards
const DITCH_AT = 2.4, DITCH_WIDTH = 2.0, DITCH_DEPTH = 0.55; // roadside swale
const BUILDING_PAD = 3.5; // flat apron kept clear around every building

// Buildings bucketed by block index so the height function can cheaply
// check "is there a building near this point" without scanning the whole
// city per vertex. Kept in sync as buildings are registered (see
// registerBuilding() below) rather than rebuilt afterward, since obstacles
// placed during world-gen need correct heights immediately too.
let buildingsByCell = {};
function registerBuilding(b){
  buildings.push(b);
  const key = b.ix+','+b.iz;
  (buildingsByCell[key] = buildingsByCell[key] || []).push(b);
}

// Fine local detail — rolling micro-terrain plus the roadside ditch —
// confined to the lot interior and flattened near buildings. Returns 0
// on roads/sidewalks so those surfaces only carry the broad hill shape.
function lotDetailHeight(x,z){
  const ix = Math.round(x/BLOCK), iz = Math.round(z/BLOCK);
  const dx = x-ix*BLOCK, dz = z-iz*BLOCK;
  if(Math.abs(dx) > BLOCK_HALF || Math.abs(dz) > BLOCK_HALF) return 0;

  const edgeDist = BLOCK_HALF - Math.max(Math.abs(dx), Math.abs(dz));

  let h = terrainNoise(x,z) * TERRAIN_AMPLITUDE;

  const dEdge = (edgeDist-DITCH_AT)/DITCH_WIDTH;
  h += -DITCH_DEPTH * Math.exp(-dEdge*dEdge);

  h *= smoothstep01(edgeDist/1.2);

  const cellBuildings = buildingsByCell[ix+','+iz];
  if(cellBuildings){
    for(let i=0;i<cellBuildings.length;i++){
      const b = cellBuildings[i];
      const bdx = Math.abs(x-b.x)-b.hx, bdz = Math.abs(z-b.z)-b.hz;
      const dist = Math.max(bdx, bdz);
      if(dist < BUILDING_PAD) h *= smoothstep01(dist/BUILDING_PAD);
    }
  }
  return h;
}

function terrainHeightAt(x,z){
  // Paved driveways (currently just the shop's) stay flat pavement,
  // guaranteed, regardless of any hill placement.
  for(let i=0;i<drivewayZones.length;i++){
    const d = drivewayZones[i];
    if(Math.abs(x-d.x)<=d.hx && Math.abs(z-d.z)<=d.hz) return 0;
  }
  return bigHillHeight(x,z) + lotDetailHeight(x,z);
}

// Displaces the ground mesh to match terrainHeightAt() — called from
// boot() once every building has been registered, so the flattened pads
// line up with the actual city rather than an empty lot.
function applyTerrainDisplacement(){
  const pos = groundGeo.attributes.position;
  for(let i=0;i<pos.count;i++){
    const lx = pos.getX(i), ly = pos.getY(i);
    // Ground is rotated -90° about X after construction, which maps this
    // local Z displacement to world Y, and local (x,y) to world (x,-z).
    pos.setZ(i, terrainHeightAt(lx, -ly));
  }
  pos.needsUpdate = true;
  groundGeo.computeVertexNormals();
}

