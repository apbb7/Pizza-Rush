  pole.position.y=1.7; g.add(pole);
  const bulb = new THREE.Mesh(new THREE.SphereGeometry(0.28,8,8), new THREE.MeshStandardMaterial({color:0xfff0b0, emissive:0xfff0b0, emissiveIntensity:0.7}));
  bulb.position.y=3.5; g.add(bulb);
