<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Pizza Rush</title>
<style>
  :root{
    --tomato:#e3402c;
    --tomato-dark:#b62c1c;
    --cheese:#f4c24d;
    --cheese-dark:#d99a1f;
    --crust:#8a5a34;
    --basil:#3e8e5b;
    --night:#1b1f2e;
    --night2:#252b40;
    --cream:#fff6e8;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    background:var(--night);}
  #game-container{position:fixed;inset:0;}
  canvas{display:block;width:100%;height:100%;}

  .hud{position:absolute;inset:0;pointer-events:none;z-index:5;
    font-weight:700;color:var(--cream);text-shadow:0 2px 6px rgba(0,0,0,.55);}

  /* ----- top bars ----- */
  .top-row{position:absolute;top:14px;left:14px;right:14px;display:flex;
    justify-content:space-between;align-items:flex-start;gap:10px;}

  .panel{background:rgba(27,31,46,.72);border:2px solid rgba(255,255,255,.12);
    border-radius:14px;padding:8px 12px;backdrop-filter:blur(3px);}

  .stat-label{font-size:10px;letter-spacing:1.5px;opacity:.75;text-transform:uppercase;margin-bottom:3px;}

  .bar-track{width:160px;height:12px;border-radius:8px;background:rgba(0,0,0,.4);
    overflow:hidden;border:1px solid rgba(255,255,255,.15);}
  .bar-fill{height:100%;border-radius:8px;transition:width .15s linear, background .25s linear;}

  /* ----- combined status panel (condition + money) ----- */
  .hud-status{display:flex;flex-direction:column;gap:6px;}
  .status-row{display:flex;align-items:center;gap:8px;}
  .status-row .bar-track{width:110px;height:10px;}
  .money-row{font-size:19px;white-space:nowrap;}

  .icon-btn-group{display:flex;gap:8px;}
  .icon-btn{pointer-events:auto;cursor:pointer;background:var(--cheese);color:var(--night);
    border:2px solid var(--cheese-dark);border-radius:12px;font-size:20px;width:46px;height:46px;
    display:flex;align-items:center;justify-content:center;box-shadow:0 3px 0 var(--cheese-dark);
    transition:transform .08s;}
  .icon-btn:active{transform:translateY(2px);box-shadow:0 1px 0 var(--cheese-dark);}

  /* ----- order panel ----- */
  .order-panel{position:absolute;top:72px;left:50%;transform:translateX(-50%);
    min-width:220px;text-align:center;}
  .order-line{font-size:14px;margin-bottom:4px;}
  .compass-row{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:4px;}
  .compass-arrow{transition:transform .1s linear;display:inline-block;transform-origin:50% 50%;filter:drop-shadow(0 2px 3px rgba(0,0,0,.5));}
  .dist-text{font-size:13px;opacity:.85;}

  .minimap-panel{position:absolute;bottom:18px;left:14px;padding:0;
    background:#fff;border-radius:10px;overflow:hidden;
    box-shadow:0 2px 8px rgba(0,0,0,.35),0 0 0 1px rgba(0,0,0,.12);
    pointer-events:auto;}
  #minimap{display:block;border-radius:10px;}

  /* ----- toast notifications ----- */
  #toast-wrap{position:absolute;top:195px;left:50%;transform:translateX(-50%);
    display:flex;flex-direction:column;gap:6px;align-items:center;z-index:6;}
  .toast{background:rgba(20,22,34,.9);border:2px solid var(--cheese);border-radius:10px;
    padding:8px 16px;font-size:14px;animation:toastIn .25s ease-out, toastOut .4s ease-in 2.1s forwards;
    white-space:nowrap;}
  .toast.bad{border-color:var(--tomato);}
  .toast.good{border-color:var(--basil);}
  @keyframes toastIn{from{opacity:0;transform:translateY(-10px);}to{opacity:1;transform:translateY(0);}}
  @keyframes toastOut{to{opacity:0;transform:translateY(-6px);}}

  /* ----- speed gauge ----- */
  .speed-gauge{position:absolute;bottom:18px;right:18px;text-align:right;}
  .speed-num{font-size:34px;line-height:1;}
  .speed-lbl{font-size:11px;letter-spacing:2px;opacity:.7;}

  .hint{position:absolute;bottom:18px;left:14px;width:260px;height:175px;
    display:flex;align-items:center;justify-content:center;text-align:center;
    font-size:13px;font-weight:600;padding:14px;box-sizing:border-box;
    background:rgba(20,22,34,.75);border-radius:10px;
    transition:opacity 1s ease;z-index:7;}
  .hint.faded{opacity:0;}

  /* ----- touch controls ----- */
  .touch-controls{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);
    display:none;gap:10px;pointer-events:auto;z-index:5;}
  .touch-controls.show{display:flex;}
  .tbtn{width:58px;height:58px;border-radius:16px;background:rgba(244,194,77,.85);
    border:2px solid var(--cheese-dark);font-size:24px;display:flex;align-items:center;justify-content:center;
    color:var(--night);user-select:none;-webkit-user-select:none;touch-action:none;}
  .tbtn:active{background:var(--cheese);}

  /* On narrow/mobile screens the drive buttons would otherwise sit right
     on top of the map now that it lives in the bottom-left corner —
     shift them to the right side, clear of it. */
  @media (max-width:700px){
    .touch-controls{left:auto;right:10px;bottom:14px;transform:none;}
  }

  /* ----- overlays / modals ----- */
  .overlay{position:absolute;inset:0;background:rgba(10,12,20,.78);display:flex;
    align-items:center;justify-content:center;z-index:20;pointer-events:auto;}
  .hidden{display:none !important;}

  .card{background:linear-gradient(160deg,var(--night2),var(--night));border:3px solid var(--cheese);
    border-radius:22px;padding:30px 34px;max-width:480px;width:90%;text-align:center;
    box-shadow:0 20px 60px rgba(0,0,0,.5);color:var(--cream);max-height:88vh;overflow:auto;}

  h1.title{font-size:46px;margin:0 0 4px;color:var(--cheese);letter-spacing:1px;
    text-shadow:3px 3px 0 var(--tomato-dark), -1px -1px 0 rgba(0,0,0,.4);transform:skewX(-3deg);}
  .tagline{font-size:14px;opacity:.85;margin-bottom:18px;letter-spacing:.5px;}

  .btn{cursor:pointer;border:none;border-radius:12px;padding:13px 26px;font-size:16px;font-weight:800;
    color:var(--night);background:var(--cheese);box-shadow:0 4px 0 var(--cheese-dark);
    letter-spacing:.5px;transition:transform .08s;margin:6px 4px;}
  .btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--cheese-dark);}
  .btn.tomato{background:var(--tomato);box-shadow:0 4px 0 var(--tomato-dark);}
  .btn.basil{background:var(--basil);box-shadow:0 4px 0 #285c3c;}
  .btn:disabled{opacity:.4;cursor:not-allowed;}

  .instructions{text-align:left;font-size:13px;line-height:1.6;background:rgba(0,0,0,.25);
    border-radius:12px;padding:12px 16px;margin:14px 0;opacity:.9;}
  .instructions b{color:var(--cheese);}

  .shop-row{display:flex;align-items:center;justify-content:space-between;gap:12px;
    background:rgba(0,0,0,.22);border-radius:12px;padding:10px 14px;margin:8px 0;text-align:left;}
  .shop-info{flex:1;}
  .shop-name{font-size:15px;margin-bottom:2px;}
  .shop-desc{font-size:11.5px;opacity:.75;font-weight:500;}
  .shop-dots{display:flex;gap:4px;margin-top:5px;}
  .dot{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.2);}
  .dot.on{background:var(--cheese);}

  /* ----- garage theme ----- */
  .garage-card{background:
      repeating-linear-gradient(45deg, rgba(0,0,0,.16) 0 10px, rgba(255,255,255,.02) 10px 20px),
      linear-gradient(160deg,#23262f,#15171c);
    border:3px solid #2b2d33;position:relative;overflow-x:hidden;overflow-y:auto;}
  .garage-hazard{position:absolute;top:0;left:0;right:0;height:10px;
    background:repeating-linear-gradient(45deg,var(--cheese) 0 14px,#1b1f2e 14px 28px);}
  .garage-card .title{color:var(--cheese);}
  .garage-sub{font-size:12.5px;opacity:.7;margin-bottom:14px;letter-spacing:.3px;}
  .garage-section-label{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;
    color:var(--cheese);opacity:.85;margin:14px 0 4px;text-align:left;font-weight:800;}

  .stat-readout{display:flex;gap:8px;margin:4px 0 16px;}
  .stat-chip{flex:1;background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.08);
    border-radius:10px;padding:8px 6px;text-align:center;}
  .stat-chip .v{font-size:18px;font-weight:800;color:var(--cheese);}
  .stat-chip .l{font-size:9.5px;letter-spacing:1px;opacity:.65;text-transform:uppercase;margin-top:2px;}

  .gauge-row{display:flex;gap:4px;margin-top:6px;}
  .gauge-seg{flex:1;height:7px;border-radius:3px;background:rgba(255,255,255,.12);
    border:1px solid rgba(0,0,0,.3);}
  .gauge-seg.on{background:linear-gradient(180deg,#ffd95e,var(--cheese-dark));}

  .stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0;text-align:left;font-size:13px;}
  .stats-grid div span{display:block;font-size:20px;color:var(--cheese);font-weight:800;}
</style>
</head>
<body>

<div id="game-container"></div>

<div class="hud">
  <div class="top-row">
    <div class="panel hud-status">
      <div class="status-row">
        🛵 <div class="bar-track"><div id="damage-fill" class="bar-fill" style="width:100%;background:#3e8e5b;"></div></div>
      </div>
      <div class="status-row money-row">🍕 <span id="money-text">$0.00</span></div>
    </div>
    <div class="icon-btn-group">
      <div class="icon-btn" id="districts-btn" title="Buy Districts">🗺️</div>
      <div class="icon-btn" id="shop-btn" title="Garage">🔧</div>
    </div>
  </div>

  <div class="panel order-panel" id="order-panel">
    <div class="order-line" id="order-line">🍕 Head to the shop's driveway</div>
    <div class="bar-track" id="fresh-track" style="margin:0 auto;display:none;"><div id="fresh-fill" class="bar-fill" style="width:100%;background:#f4c24d;"></div></div>
    <div class="compass-row" id="compass-row" style="display:flex;">
      <svg id="compass-arrow" class="compass-arrow" viewBox="0 0 24 24" width="28" height="28">
        <path d="M12 1.5 L21 21 L12 16 L3 21 Z" fill="#f4c24d" stroke="#1b1f2e" stroke-width="1.2" stroke-linejoin="round"/>
      </svg>
      <span class="dist-text" id="dist-text">0m</span>
    </div>
  </div>

  <div class="panel minimap-panel">
    <canvas id="minimap" width="260" height="175"></canvas>
  </div>

  <div id="toast-wrap"></div>

  <div class="speed-gauge">
    <div class="speed-num" id="speed-num">0</div>
    <div class="speed-lbl">MPH</div>
  </div>

  <div class="hint" id="hint">WASD to drive &middot; drag to look &middot; scroll to zoom</div>

  <div class="touch-controls" id="touch-controls">
    <div class="tbtn" id="t-left">⟲</div>
    <div class="tbtn" id="t-back">▼</div>
    <div class="tbtn" id="t-fwd">▲</div>
    <div class="tbtn" id="t-right">⟳</div>
  </div>
</div>

<!-- START SCREEN -->
<div class="overlay" id="start-overlay">
  <div class="card">
    <h1 class="title">PIZZA RUSH</h1>
    <div class="tagline">Hot pizzas. Cold deadlines. One scooter.</div>
    <div class="instructions">
      <div>🍕 <b>Pick up</b> orders on the driveway outside Tony's Pizza Shop — a glowing green beacon marks the spot, even through buildings. The shop itself is solid, so pull up alongside it rather than through it.</div>
      <div>🧭 <b>Follow the arrow</b> above your bike and the red beacon — they always point toward your shop or drop-off.</div>
      <div>⏱️ <b>Deliver</b> before the freshness meter hits zero — fresher pizza pays better.</div>
      <div>🚗 <b>Traffic</b> will brake for you if you're in its way, but don't push your luck — and watch out for buildings, too. Break down and you'll pay a repair fee to get back on the road.</div>
      <div>🌉 <b>Rivers</b> block the way into locked districts — until you buy one, the bridge across is gated shut and there's no way around it. Buy the district and the whole river border opens up for driving, not just the bridge. A wall rings the whole city, too.</div>
      <div>🗺️ <b>Buy districts</b> with the map button next to the wrench — you can only buy one that's next to a district you already own.</div>
      <div>🖱️ <b>Drag the mouse</b> (or swipe) to look around, scroll/pinch to zoom.</div>
      <div>💰 <b>Earn</b> money to upgrade your engine, handling and pizza bag — and buy up new districts.</div>
    </div>
    <button class="btn tomato" id="start-btn">Start Delivering 🍕</button>
    <div id="save-status" style="font-size:12px;opacity:.6;margin-top:8px;min-height:16px;"></div>
    <button class="btn" id="newgame-btn" style="display:none;background:#555;box-shadow:0 4px 0 #333;font-size:13px;">🗑️ New Game</button>
  </div>
</div>

<!-- UPGRADE / SHOP MODAL -->
<div class="overlay hidden" id="shop-overlay">
  <div class="card garage-card">
    <div class="garage-hazard"></div>
    <h1 class="title" style="font-size:32px;margin-top:6px;">🔧 THE GARAGE</h1>
    <div class="garage-sub">Wrench up your ride — balance: <b id="shop-money">$0.00</b></div>
    <div class="stat-readout" id="stat-readout"></div>
    <div class="garage-section-label">🚗 Vehicles</div>
    <div id="vehicle-list"></div>
    <div class="garage-section-label">🔩 Upgrades</div>
    <div id="shop-list"></div>
    <button class="btn" id="shop-close">Back to the Streets</button>
  </div>
</div>

<!-- DISTRICTS MODAL -->
<div class="overlay hidden" id="districts-overlay">
  <div class="card">
    <h1 class="title" style="font-size:30px;">CITY MAP</h1>
    <div class="tagline">Balance: <b id="districts-money">$0.00</b></div>
    <div class="tagline" style="margin-top:-8px;">Buy a district to open it up — you can only buy one next to a district you already own.</div>
    <div id="districts-list"></div>
    <button class="btn" id="districts-close">Back to the Streets</button>
  </div>
</div>

<!-- BREAKDOWN MODAL -->
<div class="overlay hidden" id="breakdown-overlay">
  <div class="card">
    <h1 class="title" style="font-size:32px;color:var(--tomato);">BIKE BROKE DOWN!</h1>
    <div class="tagline">Too many crashes. The shop towed you back and patched it up.</div>
    <div class="stats-grid" style="grid-template-columns:1fr;text-align:center;">
      <div>Repair fee <span id="breakdown-fee">-$5.00</span></div>
    </div>
    <button class="btn tomato" id="breakdown-btn">Pay &amp; Get Back to It</button>
  </div>
</div>

<!-- UNLOCK TOAST MODAL (district unlocked) handled via toast system -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
"use strict";

/* =========================================================
   CONSTANTS
========================================================= */
const SIDEWALK_W = 3;
const ROAD_W = 18;
const BLOCK_HALF = 30;
const BLOCK = ROAD_W + BLOCK_HALF*2;
const IX_RANGE = [-10,10];
const IZ_RANGE = [-6,6];
const TOWN_MIN_X = (IX_RANGE[0]-0.5)*BLOCK;
const TOWN_MAX_X = (IX_RANGE[1]+0.5)*BLOCK;
const TOWN_MIN_Z = (IZ_RANGE[0]-0.5)*BLOCK;
const TOWN_MAX_Z = (IZ_RANGE[1]+0.5)*BLOCK;

const PLAYER_RADIUS = 0.62;

const RIVER_X = 3.5*BLOCK;
const RIVER_X2 = 6.5*BLOCK;
const RIVER_HALF_WIDTH = 9;
const BRIDGE_HALF_LEN = ROAD_W/2 + 3;
const RIVER_REACH = 1800;
const BRIDGE_Z = 0.5*BLOCK;

/* =========================================================
   STATE
========================================================= */
const state = {
  money: 0,
  deliveries: 0,
  damage: 100,
  running: false,
  paused: false,
  order: null,       // {buildingRef, freshness, basePay}
  unlocked: { suburbs:false, industrial:false, harbor:false, oldtown:false },
  ownedVehicles: { scooter:true, sportbike:false, pizzacar:false },
  currentVehicle: 'scooter',
  invuln: 0,          // collision cooldown timer
  keys: { f:false, b:false, l:false, r:false },
  upgrades: {
    engine:    { level:0, max:3, cost:[40,90,160] },
    handling:  { level:0, max:3, cost:[40,90,160] },
    insulation:{ level:0, max:3, cost:[35,70,120] }
  }
};

function baseStats(){
  const v = vehicleDefs[state.currentVehicle];
  return {
    maxSpeed: v.maxSpeed + state.upgrades.engine.level*4,
    accel: v.accel + state.upgrades.engine.level*3,
    turnRate: v.turnRate + state.upgrades.handling.level*0.35,
    armor: v.armor * (1 - state.upgrades.handling.level*0.12),           // damage multiplier
    decay: (100/95) * v.decayMul * (1 - state.upgrades.insulation.level*0.22) // freshness pts/sec
  };
}

/* =========================================================
   SAVE / LOAD — persists across sessions.
========================================================= */
const SAVE_KEY = 'pizza-rush-save-v1';

async function saveProgress(){
  if(!window.storage) return;
  try{
    await window.storage.set(SAVE_KEY, JSON.stringify({
      money:          state.money,
      deliveries:     state.deliveries,
      unlocked:       state.unlocked,
      upgrades: {
        engine:     state.upgrades.engine.level,
        handling:   state.upgrades.handling.level,
        insulation: state.upgrades.insulation.level
      },
      ownedVehicles:  state.ownedVehicles,
      currentVehicle: state.currentVehicle
    }));
  } catch(e){}
}

async function loadAndApply(){
  if(!window.storage) return;
  try{
    const res = await window.storage.get(SAVE_KEY);
    if(!res || !res.value) return;
    const sv = JSON.parse(res.value);
    if(sv.money        != null) state.money        = sv.money;
    if(sv.deliveries   != null) state.deliveries   = sv.deliveries;
    if(sv.unlocked)  Object.keys(sv.unlocked).forEach(k=>{ if(sv.unlocked[k]) state.unlocked[k] = true; });
    if(sv.upgrades){
      ['engine','handling','insulation'].forEach(k=>{
        if(sv.upgrades[k] != null)
          state.upgrades[k].level = Math.min(state.upgrades[k].max, sv.upgrades[k]);
      });
    }
    if(sv.ownedVehicles) Object.assign(state.ownedVehicles, sv.ownedVehicles);
    if(sv.currentVehicle && state.ownedVehicles[sv.currentVehicle])
      state.currentVehicle = sv.currentVehicle;
  } catch(e){}
}

/* =========================================================
   THREE SETUP
========================================================= */
const container = document.getElementById('game-container');
const scene = new THREE.Scene();
scene.fog = new THREE.Fog(0xcfe3ee, 200, 1100);

const camera = new THREE.PerspectiveCamera(62, window.innerWidth/window.innerHeight, 0.1, 1200);
camera.position.set(0, 14, -16);

const renderer = new THREE.WebGLRenderer({ antialias:true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1, 1.5));
// PERF FIX: shadow mapping was doubling the draw-call count every frame
// (once for the camera, once for the shadow-casting light) on top of an
// already huge mesh count from the procedural buildings below. That
// combination was the main cause of multi-second frame times. Turning
// shadows off is the single biggest win here.
renderer.shadowMap.enabled = false;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;
renderer.outputEncoding = THREE.sRGBEncoding;
container.appendChild(renderer.domElement);

window.addEventListener('resize', ()=>{
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

function castAll(obj){ obj.traverse(o=>{ if(o.isMesh) o.castShadow = true; }); }

const hemi = new THREE.HemisphereLight(0xfff0d6, 0x4a6b3a, 0.85);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff1d0, 1.7);
sun.position.set(220, 260, 130);
sun.castShadow = true;
sun.shadow.mapSize.set(2048,2048);
sun.shadow.camera.left = -900; sun.shadow.camera.right = 900;
sun.shadow.camera.top = 900; sun.shadow.camera.bottom = -900;
sun.shadow.camera.near = 10; sun.shadow.camera.far = 1800;
sun.shadow.bias = -0.0015;
scene.add(sun);
scene.add(sun.target);
const fillLight = new THREE.AmbientLight(0xffffff, 0.22);
scene.add(fillLight);

/* ----- sky dome ----- */
function buildSky(){
  const cnv = document.createElement('canvas'); cnv.width=8; cnv.height=256;
  const ctx = cnv.getContext('2d');
  const grad = ctx.createLinearGradient(0,0,0,256);
  grad.addColorStop(0, '#3f86d6');
  grad.addColorStop(0.45, '#7fb8e8');
  grad.addColorStop(0.78, '#d6e8ee');
  grad.addColorStop(1, '#ffe9c2');
  ctx.fillStyle = grad; ctx.fillRect(0,0,8,256);
  const tex = new THREE.CanvasTexture(cnv);
  const geo = new THREE.SphereGeometry(1000, 24, 16);
  const mat = new THREE.MeshBasicMaterial({ map:tex, side:THREE.BackSide, fog:false });
  const sky = new THREE.Mesh(geo, mat);
  scene.add(sky);
  // sun glow sprite
  const gcnv = document.createElement('canvas'); gcnv.width=128; gcnv.height=128;
  const gctx = gcnv.getContext('2d');
  const rg = gctx.createRadialGradient(64,64,0,64,64,64);
  rg.addColorStop(0,'rgba(255,250,220,0.9)');
  rg.addColorStop(1,'rgba(255,250,220,0)');
  gctx.fillStyle = rg; gctx.fillRect(0,0,128,128);
  const gtex = new THREE.CanvasTexture(gcnv);
  const glow = new THREE.Sprite(new THREE.SpriteMaterial({ map:gtex, fog:false, transparent:true }));
  glow.scale.set(280,280,1);
  glow.position.copy(sun.position).normalize().multiplyScalar(950);
  scene.add(glow);
}
buildSky();

/* =========================================================
   GROUND TEXTURE (grass + road grid)
========================================================= */
function makeGroundTexture(){
  const T = 512;
  const scale = T/BLOCK;
  const cnv = document.createElement('canvas');
  cnv.width = T; cnv.height = T;
  const ctx = cnv.getContext('2d');

  // base asphalt
  ctx.fillStyle = '#0e0f11';
  ctx.fillRect(0,0,T,T);
  for(let i=0;i<260;i++){
    ctx.fillStyle = 'rgba(255,255,255,'+(Math.random()*0.035)+')';
    ctx.fillRect(Math.random()*T, Math.random()*T, 2,2);
  }

  const grassHalf = BLOCK_HALF*scale;
  const sidewalkW = SIDEWALK_W*scale;
  const gx0 = T/2-grassHalf, gy0 = T/2-grassHalf;

  // sidewalk (concrete) ring around the grass/building lot
  ctx.fillStyle = '#cfc9ba';
  ctx.fillRect(gx0-sidewalkW, gy0-sidewalkW, grassHalf*2+sidewalkW*2, grassHalf*2+sidewalkW*2);
  ctx.strokeStyle = '#9b9684'; ctx.lineWidth = 3;
  ctx.strokeRect(gx0-sidewalkW, gy0-sidewalkW, grassHalf*2+sidewalkW*2, grassHalf*2+sidewalkW*2);

  // grass / lot interior
  ctx.fillStyle = '#5f9a4c';
  ctx.fillRect(gx0,gy0, grassHalf*2, grassHalf*2);
  for(let i=0;i<140;i++){
    ctx.fillStyle = Math.random()<0.5 ? 'rgba(255,255,255,0.05)' : 'rgba(0,40,0,0.06)';
    ctx.fillRect(gx0+Math.random()*grassHalf*2, gy0+Math.random()*grassHalf*2, 3,3);
  }
  ctx.strokeStyle='rgba(0,0,0,0.15)'; ctx.lineWidth=2;
  ctx.strokeRect(gx0,gy0,grassHalf*2,grassHalf*2);

  // road lane dashes along centerlines (skip the intersection squares)
  const corner = (ROAD_W/2)*scale;
  ctx.fillStyle = '#ffce2e';
  const dashLen = 24, dashGap = 14, dashW = 2.4;
  for(let yy = corner; yy < T-corner; yy += dashLen+dashGap){
    ctx.fillRect(0-dashW/2, yy, dashW, dashLen);
    ctx.fillRect(T-dashW/2, yy, dashW, dashLen);
  }
  for(let xx = corner; xx < T-corner; xx += dashLen+dashGap){
    ctx.fillRect(xx, 0-dashW/2, dashLen, dashW);
    ctx.fillRect(xx, T-dashW/2, dashLen, dashW);
  }

  // crosswalk zebra stripes at the four intersection corners
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  const stripeW = 7, stripeGap = 7;
  [[0,0],[T,0],[0,T],[T,T]].forEach(([ccx,ccy])=>{
    ctx.save();
    ctx.beginPath();
    ctx.rect(ccx-corner, ccy-corner, corner*2, corner*2);
    ctx.clip();
    for(let s=-corner; s<corner; s+=stripeW+stripeGap){
      ctx.fillRect(ccx+s, ccy-corner, stripeW, corner*2);
    }
    ctx.restore();
  });

  const tex = new THREE.CanvasTexture(cnv);
  tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
  tex.repeat.set(GROUND_TILE_COUNT, GROUND_TILE_COUNT);
  tex.anisotropy = 8;
  return tex;
}
// GROUND_TILE_COUNT must be an odd integer and the ground plane must be
// exactly GROUND_TILE_COUNT*BLOCK across — that's what guarantees every
// repeated texture tile (one block's worth of grass/sidewalk/road) lines up
// exactly with the actual block grid the buildings are placed on.
const GROUND_TILE_COUNT = 25;
const GROUND_SIZE = BLOCK*GROUND_TILE_COUNT;
// Enough tessellation to carry gentle terrain (rolling yards, roadside
// ditches) — displaced later in boot(), once buildings exist, so the
// flattened pads under them line up correctly.
const GROUND_SEGMENTS = GROUND_TILE_COUNT*12;
const groundGeo = new THREE.PlaneGeometry(GROUND_SIZE,GROUND_SIZE, GROUND_SEGMENTS, GROUND_SEGMENTS);
const groundMat = new THREE.MeshStandardMaterial({ map: makeGroundTexture(), roughness:1 });
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

